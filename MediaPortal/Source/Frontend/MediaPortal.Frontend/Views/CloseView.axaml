<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MediaPortal.Frontend.ViewModels"
        xmlns:views="using:MediaPortal.Frontend.Views"
        xmlns:theming="using:MediaPortal.Frontend.Theming"
        x:Class="MediaPortal.Frontend.Views.CloseView"
        x:DataType="vm:CloseViewModel"
        Name="closeScreen"
        Classes="nereus-dialog-screen"
        >

  <!--
    The way out of the machine, dialog for dialog the way the reference drew it in dialogSystemState:
    the heading says "Shutdown menu" and the rows underneath are the machine's ways out - sleep,
    hibernate, shutdown, the sleep timer, restart, and the application's own two - each a shape out of
    images\PowerMenu and the reference's word beside it. A row IS the answer: the reference had no
    OK button, and pressing "Close MediaPortal" closes MediaPortal. While a sleep timer runs, its row
    reads "Stop sleep timer" and the standing order is written under the list, "Shutdown in 12 minutes",
    exactly where the reference wrote it.
  -->

  <ContentControl HorizontalAlignment="Center" VerticalAlignment="Center"
                  theming:SkinTemplates.OverlayTemplate="DialogHeadedFrameTemplate">
    <!-- The body of a dialog keeps the screen's data: the frame shows a body under the presenter's own
         data, so a plain {Binding} here would ask the body for the screen's words and find none. -->
    <StackPanel MinWidth="640" DataContext="{Binding $parent[UserControl].DataContext}">
      <ListBox Name="choiceList"
               Classes="nereus-editor-rows"
               ItemsSource="{Binding Choices}"
               Focusable="True"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               MaxHeight="420">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,2"/>
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ShutdownChoice">
            <!-- The editor dialog's row, one for one: a Grid the skin knows, its name at sixty per cent
                 until the keyboard stands on the row. The only thing the reference adds here is the way
                 out's own face to the left of the word - a shape out of the skin's vector catalog rather
                 than the reference's picture, so it tints with the word it stands beside - 28 by 28 as
                 dialogSystemState drew it. -->
            <Grid Classes="nereus-editor-row" ColumnDefinitions="Auto,*">
              <Path Grid.Column="0"
                    Classes="nereus-editor-icon"
                    Width="28" Height="28"
                    Stretch="Uniform"
                    VerticalAlignment="Center"
                    Data="{Binding Icon, Converter={x:Static views:SkinIconGeometryConverter.Instance}, ConverterParameter='{}{0}'}"/>
              <TextBlock Grid.Column="1"
                         Classes="nereus-editor-name"
                         Text="{Binding Name}"
                         VerticalAlignment="Center"
                         Margin="10,0,10,0"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- The standing order, said only while one stands. -->
      <TextBlock Name="noticeLine"
                 Classes="nereus-editor-sub"
                 Text="{Binding Notice}"
                 IsVisible="{Binding HasNotice}"
                 Margin="15"
                 HorizontalAlignment="Center"/>
    </StackPanel>
  </ContentControl>
</UserControl>
