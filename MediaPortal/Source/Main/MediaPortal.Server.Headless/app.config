<?xml version="1.0"?>
<configuration>

  <!--
    Log configuration for the headless server host. MP2-Server has the same appenders in its
    app.config; the differences are deliberate:

      - The console appender is first and stays. In a container the console is the only log anyone
        reads before the volume mount is figured out, and a headless process has no window to be
        quiet for.
      - There is no <system.runtime.remoting> section. That channel served the .NET Framework
        TvControl remoting endpoint; System.Runtime.Remoting does not exist on .NET, so carrying it
        over would be a claim about a feature this host does not have.
      - There are no binding redirects. They were for assemblies loaded by plugins at run time, and
        the portable plugin layout is still being decided; a redirect nobody needs is a way to
        silently load the wrong assembly later.

    The Log4NetLogger rewrites the "value" of every appender/file attribute to <LOG>\<file>, so the
    file names here stay relative.
  -->
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net"/>
  </configSections>

  <log4net>
    <appender name="DefaultLogAppender" type="log4net.Appender.RollingFileAppender">
      <file value="Server.log"/>
      <appendToFile value="false"/>
      <rollingStyle value="Size"/>
      <PreserveLogFileNameExtension value="true"/>
      <maxSizeRollBackups value="4"/>
      <maximumFileSize value="10MB"/>
      <staticLogFileName value="true"/>
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="[%date] [%-7timestamp] [%-9thread] [%-5level] - %message%newline"/>
      </layout>
    </appender>

    <appender name="ErrorLogAppender" type="log4net.Appender.RollingFileAppender">
      <file value="ServerError.log"/>
      <appendToFile value="true"/>
      <rollingStyle value="Once"/>
      <PreserveLogFileNameExtension value="true"/>
      <maxSizeRollBackups value="4"/>
      <maximumFileSize value="1MB"/>
      <staticLogFileName value="true"/>
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="[%date] [%-7timestamp] [%-9thread] [%-5level] - %message%newline"/>
      </layout>
    </appender>

    <appender name="LossyFileAppender" type="log4net.Appender.BufferingForwardingAppender">
      <bufferSize value="25"/>
      <lossy value="true"/>
      <evaluator type="log4net.Core.LevelEvaluator">
        <threshold value="ERROR"/>
      </evaluator>
      <appender-ref ref="ErrorLogAppender"/>
    </appender>

    <appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="[%date{HH:mm:ss,fff}] [%-9thread] [%-5level] - %message%newline"/>
      </layout>
    </appender>

    <root>
      <level value="INFO"/>
      <appender-ref ref="ConsoleAppender"/>
      <appender-ref ref="LossyFileAppender"/>
      <appender-ref ref="DefaultLogAppender"/>
    </root>
  </log4net>

</configuration>
