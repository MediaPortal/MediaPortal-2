<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MediaPortal.Frontend.ViewModels"
        x:Class="MediaPortal.Frontend.Views.MediaBrowserWindow"
        x:DataType="vm:MediaBrowserViewModel"
        Name="browser"
        Width="1280" Height="720"
        WindowState="Maximized"
        Background="#FF101418"
        Title="MediaPortal 2">

  <!--
    One section of the library, as a television shows it: a long list, one row per title, big enough to read
    from a sofa, walked with the four arrow keys. OK plays the selected row, "More" at the end of the list asks
    for the next page, and Back goes home. The row itself says when a title cannot be watched from this machine,
    so that the viewer does not have to discover it by pressing OK.
  -->

  <DockPanel Margin="48,36">

    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,12">
      <TextBlock Text="{Binding Heading}"
                 FontSize="40"
                 FontWeight="SemiBold" />
      <TextBlock Text="{Binding Status}"
                 FontSize="18"
                 Opacity="0.7"
                 TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <!--
      Finding a title by typing its name, because paging through two thousand rows to reach the one in your head
      is not searching. It is always on screen rather than behind a key: a viewer who cannot see the box will never
      think to look for it. Escape in the box puts the whole shelf back, Enter asks the server.
    -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="14" Margin="0,0,0,16">
      <TextBox Name="searchBox"
               Text="{Binding SearchText, Mode=TwoWay}"
               PlaceholderText="Find a title by name"
               Width="520"
               FontSize="22"
               Padding="14,8" />
      <Button Name="findButton"
              Content="Find"
              Command="{Binding FindCommand}"
              MinWidth="150"
              Padding="24,8"
              FontSize="22" />
      <Button Name="clearButton"
              Content="Clear"
              Command="{Binding ClearSearchCommand}"
              IsVisible="{Binding HasSearch}"
              MinWidth="150"
              Padding="24,8"
              FontSize="22" />
    </StackPanel>

    <TextBlock DockPanel.Dock="Bottom"
               FontSize="14"
               Opacity="0.45"
               Margin="0,12,0,0"
               Text="Arrows move · OK plays · I reads more · F finds · Esc clears the search or closes the details · Back returns" />

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">

      <ListBox Name="titlesList"
               Focusable="True"
               ItemsSource="{Binding Titles}"
               SelectedItem="{Binding Selected, Mode=TwoWay}"
               FontSize="24">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TitleViewModel">
            <Grid ColumnDefinitions="5*,1.4*" ColumnSpacing="20" MinWidth="700" Margin="0,8">
              <TextBlock Text="{Binding Line}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1"
                         Text="{Binding Detail}"
                         HorizontalAlignment="Right"
                         Opacity="0.65"
                         TextTrimming="CharacterEllipsis" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Grid.Column="1" Spacing="16" VerticalAlignment="Top">
        <Button Name="playButton"
                Content="Play"
                Command="{Binding PlayCommand}"
                IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"
                MinWidth="180"
                Padding="28,10"
                FontSize="22" />
        <Button Name="moreButton"
                Content="More"
                Command="{Binding LoadMoreCommand}"
                IsVisible="{Binding CanLoadMore}"
                MinWidth="180"
                Padding="28,10"
                FontSize="22" />
      </StackPanel>

      <!--
        What the server knows about the selected title, over the button column: the list stays where it is, so
        closing the panel returns to the same row. Nothing in it takes the focus, because a details panel you have
        to navigate to is a screen inside a screen, and the remote has one set of arrows.
      -->
      <Border Name="detailsPanel"
              Grid.Column="1"
              IsVisible="{Binding DetailsVisible}"
              Background="#FF161F29"
              BorderBrush="#FF2E4A63"
              BorderThickness="2"
              Padding="26,22"
              MinWidth="420"
              VerticalAlignment="Stretch">
        <StackPanel Spacing="14">
          <TextBlock Text="{Binding DetailsHeading}"
                     FontSize="28"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding DetailsLine}"
                     FontSize="17"
                     Opacity="0.72"
                     TextWrapping="Wrap" />
          <TextBlock Name="detailsText"
                     Text="{Binding DetailsText}"
                     FontSize="18"
                     LineHeight="26"
                     MaxHeight="380"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding DetailsPath}"
                     FontSize="13"
                     Opacity="0.42"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

    </Grid>
  </DockPanel>
</Window>
