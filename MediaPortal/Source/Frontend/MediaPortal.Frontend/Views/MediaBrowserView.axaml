<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MediaPortal.Frontend.ViewModels"
        xmlns:theming="using:MediaPortal.Frontend.Theming"
        xmlns:views="using:MediaPortal.Frontend.Views"
        x:Class="MediaPortal.Frontend.Views.MediaBrowserView"
        x:DataType="vm:MediaBrowserViewModel"
        Name="browser"
        Background="{DynamicResource ScreenBackgroundBrush}"
        >

  <!--
    The three frames every screen can be laid in when the worn skin answers none of the tile keys - and the
    rows, which are what the screen was written with. The reference let only a skin dress a shelf; a viewer
    who asked for tiles or covers on a machine wearing no skin got rows, which is the "only visible for
    Nereus" complaint in its oldest form. Views are the screen's own promise now: the skin may dress them
    better, and these are what it falls back to.
  -->
  <UserControl.Resources>

    <!-- One row of the shelf, the way this screen is written: picture, mark, name, state. -->
    <DataTemplate x:Key="BuiltinRowsTemplate" x:DataType="vm:TitleViewModel">
      <Grid ColumnDefinitions="Auto,Auto,5*,1.4*" ColumnSpacing="20" MinWidth="700" Margin="0,8">
        <!--
          The title's picture, in the column MP2's own shelves put it: first, so that the eye runs down a
          column of pictures rather than past the names to find out what a row is. The box behind the image
          is what a viewer sees when the library has no picture for a title, which is most of them; it is
          drawn as a fixed square so that a shelf of titles with art and one without line up identically,
          and the image is laid over it rather than swapped for it because a poster that arrives a moment
          after the row should not move the row.
        -->
        <Panel Width="64" Height="64">
          <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" />
          <Image Source="{Binding Artwork, Converter={StaticResource artwork}}"
                 Stretch="Uniform"
                 Width="64"
                 Height="64" />
        </Panel>
        <!--
          The tick in front of a title the library was told was watched. It is a column of its own rather
          than a character glued to the name so that the names of marked and unmarked rows start at the same
          x, which is what lets a viewer scan a shelf by eye; the reserved width says nothing about a row,
          only the mark does.
        -->
        <TextBlock Grid.Column="1"
                   Text="{Binding SeenMark}"
                   MinWidth="34"
                   Opacity="0.55" />
        <TextBlock Grid.Column="2" Text="{Binding Line}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="3"
                   Text="{Binding Detail}"
                   HorizontalAlignment="Right"
                   Opacity="0.65"
                   TextTrimming="CharacterEllipsis" />
      </Grid>
    </DataTemplate>

    <!--
      A tile for a skin that draws none: the poster standing in its frame with the name under it, the watched
      corner obeying the layout's flag like the skin tiles do. Narrow enough that a full-hd shelf lays four
      across, which is what the reference's grid laid.
    -->
    <DataTemplate x:Key="BuiltinTilesTemplate" x:DataType="vm:TitleViewModel">
      <Border Width="232"
              Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource OutlineBrush}"
              BorderThickness="1"
              Padding="10"
              Margin="8">
        <StackPanel Spacing="7">
          <Panel Width="208" Height="300">
            <Border Background="{DynamicResource ScreenBackgroundBrush}" />
            <Image Source="{Binding Artwork, Converter={x:Static views:ArtworkConverter.Instance}}" Stretch="Uniform" />
          </Panel>
          <TextBlock Text="{Binding SeenMark}"
                     IsVisible="{Binding WatchFlagsShown}"
                     HorizontalAlignment="Center"
                     Opacity="0.8" />
          <TextBlock Text="{Binding Line}"
                     FontSize="18"
                     TextAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     TextWrapping="Wrap"
                     MaxHeight="48" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- A cover for a skin that draws none: the same poster one step larger and the name larger with it,
         which is the difference the reference drew between its grid tile and its cover. -->
    <DataTemplate x:Key="BuiltinCoversTemplate" x:DataType="vm:TitleViewModel">
      <Border Width="300"
              Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource OutlineBrush}"
              BorderThickness="1"
              Padding="12"
              Margin="10">
        <StackPanel Spacing="9">
          <Panel Width="272" Height="392">
            <Border Background="{DynamicResource ScreenBackgroundBrush}" />
            <Image Source="{Binding Artwork, Converter={x:Static views:ArtworkConverter.Instance}}" Stretch="Uniform" />
          </Panel>
          <TextBlock Text="{Binding SeenMark}"
                     IsVisible="{Binding WatchFlagsShown}"
                     HorizontalAlignment="Center"
                     Opacity="0.8" />
          <TextBlock Text="{Binding Line}"
                     FontSize="22"
                     TextAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     TextWrapping="Wrap"
                     MaxHeight="60" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <!--
    One section of the library, as a television shows it: a long list, one row per title, big enough to read
    from a sofa, walked with the four arrow keys. OK plays the selected row, "More" at the end of the list asks
    for the next page, and Back goes home. The row itself says when a title cannot be watched from this machine,
    so that the viewer does not have to discover it by pressing OK.
  -->

  <!--
    The two layers the reference's FanArtBackground_Template painted, and in the same order: the selected
    title's fanart stretched over the whole screen, and the skin's darkening over it at the opacity the skin's
    own setting says - which is why the room stays readable while the mood of the shelf changes underneath.
    Whether there is a fanart at all is the skin setting's answer, not this file's.
  -->
  <Panel>

    <Image Source="{Binding BackgroundArtwork, Converter={StaticResource artwork}}"
           Stretch="UniformToFill"
           IsVisible="{Binding HasBackgroundArtwork}" />
    <Border Background="Black"
            Opacity="{Binding FanartOverlay}"
            IsVisible="{Binding HasBackgroundArtwork}" />

  <DockPanel Margin="44,20">

    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,6">
      <TextBlock Text="{Binding Heading}"
                 x:Name="shelfHeading"
                 FontSize="40"
                 FontWeight="SemiBold" />
      <TextBlock Text="{Binding Status}"
                 FontSize="18"
                 Opacity="0.7"
                 TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <!--
      Finding a title by typing its name, because paging through two thousand rows to reach the one in your head
      is not searching. It is always on screen rather than behind a key: a viewer who cannot see the box will never
      think to look for it. Escape in the box puts the whole shelf back, Enter asks the server.
    -->
    <!--
      The row holds the search box, the watched filter and the three screen questions - view, media, details -
      inside 1280 pixels: narrow enough to walk in one line on the sofa screen, because a second line would
      push the fifth row of the shelf off the frame. It wraps anyway on narrower windows; nothing may vanish.
    -->
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBox Name="searchBox"
               views:VirtualKeyboardService.Trigger="Menu"
               Text="{Binding SearchText, Mode=TwoWay}"
               PlaceholderText="Find a title"
               Width="300"
               FontSize="22"
               Padding="14,8"
               Margin="0,0,10,4" />
      <Button Name="findButton"
              Content="Find"
              Command="{Binding FindCommand}"
              MinWidth="110"
              Padding="20,8"
              FontSize="22"
              Margin="0,0,10,4" />
      <Button Name="clearButton"
              Content="Clear"
              Command="{Binding ClearSearchCommand}"
              IsVisible="{Binding HasSearch}"
              MinWidth="110"
              Padding="20,8"
              FontSize="22"
              Margin="0,0,10,4" />
      <!--
        The watched filter, on the same row as the search because it is the same kind of question - which of my
        titles am I looking at - and a viewer who wants one usually wants to know the other. Its label says the
        state it will leave, not the state it is in, so the screen reads as an answer without pressing anything.
      -->
      <Button Name="seenButton"
              Content="{Binding SeenLabel}"
              Command="{Binding CycleSeenCommand}"
              MinWidth="170"
              Padding="20,8"
              FontSize="22"
              Margin="0,0,10,4" />
      <!--
        The view of this screen - rows, tiles or covers - on every screen whatever it wears, because a view
        is the screen's promise and not one skin's privilege. The tile shape inside the grid is still the
        skin's own settings' answer; this button only chooses the shape the shelf is walked in, and the
        screen remembers the answer it was last given.
      -->
      <Button Name="viewButton"
              Content="{Binding LayoutLabel}"
              Command="{Binding SwitchViewCommand}"
              MinWidth="160"
              Padding="20,8"
              FontSize="22"
              Margin="0,0,10,4" />
      <!--
        Which picture the tiles wear - poster, banner or thumbnail - asked next to the view it appears in
        rather than buried in a skin's settings, and remembered for this screen alone. The button adds a
        question, it never takes the view question away: view says the shape, media says the picture.
      -->
      <Button Name="mediaButton"
              Content="{Binding MediaLabel}"
              Command="{Binding SwitchMediaCommand}"
              MinWidth="180"
              Padding="20,8"
              FontSize="22"
              Margin="0,0,10,4" />
      <!--
        Whether the selected title's details stand beside the shelf, asked here rather than buried in a
        skin's settings, and remembered for this screen alone: the films may wear their details while the
        episodes stay quiet.
      -->
      <Button Name="detailsButton"
              Content="{Binding DetailsLabel}"
              Command="{Binding ToggleDetailsCommand}"
              MinWidth="170"
              Padding="20,8"
              FontSize="22"
              Margin="0,0,10,4" />
      <!--
        The selected title's menu, so that the mouse finds what the remote's Menu key opens. It stands with
        the screen's other buttons but asks a different kind of question: those answer "how does this screen
        look", this one answers "what about this title" - and today that is the one thing the server takes
        word about, whether the title was watched.
      -->
      <Button Name="menuButton"
              Content="Title menu"
              Command="{Binding ShowMenuCommand}"
              IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"
              MinWidth="150"
              Padding="20,8"
              FontSize="22"
              Margin="0,0,10,4" />
    </WrapPanel>

    <TextBlock DockPanel.Dock="Bottom"
               FontSize="14"
               Opacity="0.45"
               Margin="0,12,0,0"
               Text="Arrows move · OK plays · F finds · W filters watched · V switches rows, tiles or covers · M switches the tile picture · I shows or hides the details · Menu opens the title menu · Esc clears the search · Back returns" />

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">

      <ListBox Name="titlesList"
               Focusable="True"
               ItemsSource="{Binding Titles}"
               SelectedItem="{Binding Selected, Mode=TwoWay}"
               ItemTemplate="{StaticResource BuiltinRowsTemplate}"
               FontSize="24" />

      <StackPanel Grid.Column="1" Spacing="16" VerticalAlignment="Top">
        <Button Name="playButton"
                Content="Play"
                Command="{Binding PlayCommand}"
                IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"
                MinWidth="180"
                Padding="28,10"
                FontSize="22" />
        <Button Name="moreButton"
                Content="More"
                Command="{Binding LoadMoreCommand}"
                IsVisible="{Binding CanLoadMore}"
                MinWidth="180"
                Padding="28,10"
                FontSize="22" />
      </StackPanel>

      <!--
        What the server knows about the selected title, over the button column: the list stays where it is, so
        closing the panel returns to the same row. Nothing in it takes the focus, because a details panel you have
        to navigate to is a screen inside a screen, and the remote has one set of arrows.
      -->
      <Border Name="detailsPanel"
              Grid.Column="1"
              IsVisible="{Binding DetailsVisible}"
              Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource OutlineBrush}"
              BorderThickness="2"
              Padding="26,22"
              Width="440"
              VerticalAlignment="Stretch">
        <StackPanel Spacing="14">
          <!--
            The title's picture above its own words, which is where MP2's details screens put it and where a
            viewer looking for "is this the one with the red helicopter in it" looks first. The panel is not
            reserved when there is no picture: a details panel is a tall column of text already, and an empty
            frame above the plot would be a frame asking to be filled. When the picture does exist it arrives a
            moment after the words, so the panel grows - which is the right way round for something that is a
            confirmation rather than the answer.
          -->
          <Panel IsVisible="{Binding DetailsArtwork, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Image Source="{Binding DetailsArtwork, Converter={StaticResource artwork}}"
                   Stretch="Uniform"
                   MaxHeight="240" />
          </Panel>
          <TextBlock Text="{Binding DetailsHeading}"
                     FontSize="28"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding DetailsLine}"
                     FontSize="17"
                     Opacity="0.72"
                     TextWrapping="Wrap" />
          <TextBlock Name="detailsText"
                     Text="{Binding DetailsText}"
                     FontSize="18"
                     LineHeight="26"
                     MaxHeight="380"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding DetailsPath}"
                     FontSize="13"
                     Opacity="0.42"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

    </Grid>
  </DockPanel>

  <!--
    The reference's foot, in the same two pieces it drew there: a gradient rising from the bottom edge so
    that names stay readable over whatever fanart the shelf wears, and the shelf's two numbers - where the
    highlight stands, and how many titles there are - at the right hand end. The gradient belongs to grid
    and list and hides when the details stand open, exactly like the reference's band; the numbers answer
    in every view, covers included, because a cover viewer wants to know how deep the shelf is too.
    Neither catches a click - they are paint, not controls.
  -->
  <Border Height="100"
          VerticalAlignment="Bottom"
          IsHitTestVisible="False"
          IsVisible="{Binding ShowsFloorGradient}">
    <Border.Background>
      <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#E6000000" Offset="1" />
      </LinearGradientBrush>
    </Border.Background>
  </Border>

  <StackPanel Orientation="Horizontal"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="0,0,54,8"
              Spacing="9"
              IsHitTestVisible="False"
              IsVisible="{Binding HasTitles}">
    <TextBlock Text="{Binding SelectedNumber}" FontSize="18" VerticalAlignment="Center" Opacity="0.75" />
    <TextBlock Text="|" FontSize="22" VerticalAlignment="Center" Opacity="0.45" />
    <TextBlock Text="{Binding TotalNumber}" FontSize="18" VerticalAlignment="Center" Opacity="0.75" />
  </StackPanel>

  <!--
    The selected title's menu, standing over the shelf the way the reference's DialogEditMenu stood over the
    list it was opened for: the shelf stays where it is, the menu speaks about one row, and Back puts it
    away. What the menu asks is decided by what the server can actually answer - today exactly one thing,
    whether a title was watched through - and where the library has no answer to give, the menu says so in
    words instead of pressing a button that would do nothing. The markup is palette-only on purpose: the
    worn skins' dialog frame is what makes this their style, and a screen that waits for its skin's
    dressing never opens the dialog.
  -->
  <Border Background="{DynamicResource ScrimBrush}" IsVisible="{Binding MenuVisible}">
    <Border Background="{DynamicResource PanelRaisedBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="2"
            Padding="30,24"
            MinWidth="480"
            MaxWidth="760"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
      <StackPanel Spacing="14">
        <TextBlock Text="{Binding MenuTitle}"
                   FontSize="28"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />
        <Button Name="menuMarkButton"
                Content="Mark watched"
                Command="{Binding MarkWatchedCommand}"
                IsVisible="{Binding CanMarkWatched}"
                MinWidth="240"
                Padding="26,10"
                FontSize="22"
                HorizontalAlignment="Left" />
        <TextBlock Text="{Binding MenuWords}"
                   FontSize="18"
                   Opacity="0.75"
                   TextWrapping="Wrap"
                   IsVisible="{Binding MenuWords, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Button Name="menuBackButton"
                Content="Back"
                Command="{Binding CloseMenuCommand}"
                MinWidth="140"
                Padding="24,10"
                FontSize="22"
                HorizontalAlignment="Left" />
      </StackPanel>
    </Border>
  </Border>

  </Panel>
</UserControl>
