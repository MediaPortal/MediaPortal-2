<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>MP2-LogCollector</AssemblyName>
    <SolutionDir Condition="$(SolutionDir) == '' Or $(SolutionDir) == '*Undefined*'">..\..\Source\</SolutionDir>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
    <StartupObject>MediaPortal.LogCollector.Program</StartupObject>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>MP2-LogCollector.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Source\Core\MediaPortal.Common\VersionInfo\VersionInfo.cs">
      <Link>Properties\VersionInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Content Include="MP2-LogCollector.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommandLineParser">
      <Version>2.9.1</Version>
    </PackageReference>
    <!-- DotNetZip removed: unmaintained, and its final release still carries GHSA-xhg6-9j5j-w4vf
         (directory traversal, no patched version). Program.cs now uses System.IO.Compression. It was
         also what dragged System.Drawing.Common 5.0.0 - a Critical advisory - into this tool.
         Microsoft.CSharp removed because the SDK provides it implicitly on net10.0 (NU1510). -->
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="6.0.0" />
  </ItemGroup>
  <Import Project="build.targets" />
</Project>