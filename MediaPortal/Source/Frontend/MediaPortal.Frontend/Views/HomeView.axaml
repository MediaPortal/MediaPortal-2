<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MediaPortal.Frontend.ViewModels"
        xmlns:theming="using:MediaPortal.Frontend.Theming"
        xmlns:views="using:MediaPortal.Frontend.Views"
        xmlns:acrylic="using:Fluid.Avalonia.Acrylic"
        x:Class="MediaPortal.Frontend.Views.HomeView"
        x:DataType="vm:HomeViewModel"
        Name="home"
        Background="Transparent"
        >

  <UserControl.Styles>
    <Style Selector="ScrollViewer#nereusContentPane">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.35"/>
          <VectorTransition Property="Offset" Duration="0:0:0.2"/>
        </Transitions>
      </Setter>
    </Style>
    <!-- What a tile of this face's content wall is dressed in - the quiet dark ground, the edge it wears when
         something stands on it, the rounding of its corners and the shadow it casts - is said by the face
         itself, in Skins/Nereus/themes/default/styles.xaml. The classes the tiles wear are named there:
         'nereus-content-tile' for the press and 'home-tile-face' for the face it shows. -->
  </UserControl.Styles>

  <!--
    The home screen, arranged the way the worn face arranges its own. Each rescued skin is not only pictures -
    Nereus and WMC each ship a home screen of their own (screens/master_homemenu.xaml) and a home model of their
    own (HomeMenuModel), and the two differ in where things stand, not just in how a tile looks:

      - Nereus stands the tile rail flush at the edge, lets the content grid fill everything beside it, and
        draws two black gradients over the whole screen (master_homemenu.xaml, "Top/Bottom Gradient Overlay");
      - WMC stands its menu well in from the edge (a margin of 300,50 in its 1280x720 frame) and hangs the
        content pane top-right, right-aligned and capped (its HomeContentGrid, 1000x615 of 1280x720);
      - a face that ships no home of its own gets the plain arrangement - menu, content, and the server's
        aspect list in three columns, which is what this port drew before either face was worn.

    The areas are the same three lists in every arrangement, so the remote's ring walks the same road; only
    where they stand changes - see ApplyHomeLayout in the code-behind, which moves them when the face changes.

    Font sizes are large because the viewer is three metres away.
  -->

  <Panel>

    <!--
      What the worn face paints behind everything, and the face its menu wears. These two hosts carry nothing
      of their own: each rescued skin answers the keys HomeBackgroundTemplate and HomeMenuFaceTemplate in
      home.xaml under its own roof, and what the face hangs there is this screen's business no further than
      the frame it stands in. A face that answers neither key leaves the fallback below standing, which is a
      fanart over the window's own background and nothing else - the arrangement this port drew before either
      face was rescued.

      Neither host catches a click or a key: they are the picture the screen stands on, while everything the
      viewer can walk on lives above them.
    -->
    <ContentControl Name="homeBackground" IsTabStop="False" Focusable="False" IsHitTestVisible="False"/>
    <ContentControl Name="homeMenuFace" IsTabStop="False" Focusable="False" IsHitTestVisible="False"/>
    <Panel Name="plainBackground" IsHitTestVisible="False">
      <!-- The chosen title's fanart, behind everything, for a face that ships no home of its own. Both
           rescued skins put the highlighted title's fanart across the whole home screen (Nereus'
           "fanart_image" in master_homemenu.xaml, WMC's FanArtImageBackground) and paint their own ground and
           screening around it - so they answer the background host with their own layers and this one steps
           aside. A face that switched fanart off, and the plain arrangement that belongs to no face, never
           see this picture. -->
      <Image Stretch="UniformToFill"
             IsVisible="{Binding HasBackgroundArtwork}">
        <Image.Source>
          <MultiBinding Converter="{x:Static views:SkinFanartConverter.Instance}">
            <Binding Path="BackgroundArtwork"/>
            <Binding Path="FanartBlurRadius"/>
          </MultiBinding>
        </Image.Source>
      </Image>
    </Panel>

    <!-- WMC stands its home on a cross of names and pictures, and every line of that cross - its arms, its
         frame, the Huge word behind the standing place - is written in home.xaml under WMC's own roof. What
         stands above is the host it is painted on. The pane of lists stands to the right of the cross exactly
         where the reference hangs its HomeContentGrid, and the cross never catches a click: it is the menu's
         face, while the (invisible) menu list underneath stays its memory, its keyboard and its command. See
         RebuildCross in the code-behind, which fills the arms from WMC's own home model. -->

    <DockPanel Name="homeLayout" Margin="48,30">

    <StackPanel Name="headerPane" DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,18"
                IsVisible="{Binding IsPlainHome}">
      <TextBlock Text="MediaPortal 2"
                 FontSize="34"
                 FontWeight="SemiBold" />
      <TextBlock Text="{Binding ServerDescription}"
                 FontSize="18"
                 Opacity="0.85"
                 TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding Status}"
                 FontSize="15"
                 Opacity="0.6"
                 TextTrimming="CharacterEllipsis" />
      <!-- What the server is doing right now, as the server itself said so: "Filing 120 of 340 in D:\Films" while
           an import runs, "Listening to the server" when it is idle, "Lost the server" when the connection went.
           Gone when nothing is being listened to, because a media centre that has nothing to say should not spend
           a line of a television saying it. -->
      <TextBlock Text="{Binding ServerActivity}"
                 FontSize="13"
                 Opacity="0.5"
                 IsVisible="{Binding HasServerActivity}"
                 TextTrimming="CharacterEllipsis" />
      <TextBlock FontSize="13"
                 Opacity="0.4"
                 Text="{Binding ServerUrl, StringFormat='Server: {0}'}" />
    </StackPanel>

    <!-- What a viewer can do from here, in one line at the bottom: ask the server again, open what is playing, and
         say which machine the server lives on. The playback button is only there when the application has a player
         to show (see App), so a machine without libVLC does not get a button that leads to a screen that cannot
         play anything. MP2 keeps its equivalent of these off the home screen entirely - they are setup, not
         content - which is why they are small, at the bottom, and not what the eye lands on. -->
    <StackPanel Name="bottomRow" DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="14" Margin="0,16,0,0">
      <Button Name="refreshButton"
              Content="Refresh"
              Command="{Binding RefreshCommand}"
              Padding="20,7"
              FontSize="17" />
      <Button Name="nowPlayingButton"
              Content="Now playing"
              Click="OnNowPlaying"
              IsVisible="False"
              Padding="20,7"
              FontSize="17" />
      <!-- Where the server is comes from a screen, not from a command line: whoever sits in front of a television
           cannot edit an argument, and a machine whose address changed (a reinstalled server, a new router) would
           otherwise be a media centre that only ever says it found no media. -->
      <Button Name="connectButton"
              Content="Server"
              Click="OnConnect"
              IsVisible="False"
              Padding="20,7"
              FontSize="17" />

      <!-- A server whose owner turned on "Web authorization" keeps its titles from strangers, and only for such a
           server do these boxes appear: the reference's basic installation asked nobody for a name and a password,
           user management being a thing a household enables and fills in its settings. The password is a box with
           dots rather than a PasswordBox because a PasswordBox cannot be bound: a screen that cannot read what was
           typed cannot sign anybody in. What is typed is handed to the server and forgotten straight afterwards. -->
      <!-- The names the server keeps, as a press. Picking one fills the box; the typed boxes stay for
           servers without the users endpoint and for viewers who would rather spell their own name.
           The buttons are put here by the code-behind, from the view model's list, because a picked name
           must also move the highlight to the password box - which is a screen's business, not a
           command's. -->
      <StackPanel Name="signInNames" Orientation="Horizontal" Spacing="8" Margin="18,0,0,0"
                  IsVisible="{Binding SignInOffered}" />

      <StackPanel Name="signInRow" Orientation="Horizontal" Spacing="10" Margin="18,0,0,0"
                  IsVisible="{Binding SignInOffered}">
        <TextBox Name="signInName"
                 views:VirtualKeyboardService.Trigger="EnterOrMenu"
                 Text="{Binding SignInName}"
                 Watermark="User name"
                 FontSize="15"
                 MinWidth="150" />
        <TextBox Name="signInPassword"
                 views:VirtualKeyboardService.Trigger="EnterOrMenu"
                 Text="{Binding SignInPassword}"
                 PasswordChar="•"
                 Watermark="Password"
                 FontSize="15"
                 MinWidth="150" />
        <Button Name="signInButton"
                Content="Sign in"
                Command="{Binding SignInCommand}"
                FontSize="15"
                Padding="16,6" />
      </StackPanel>
      <TextBlock Name="signedInAs"
                 FontSize="15"
                 Opacity="0.75"
                 VerticalAlignment="Center"
                 IsVisible="{Binding SignedInAs, Converter={x:Static ObjectConverters.IsNotNull}}"
                 Text="{Binding SignedInAs, StringFormat='Signed in as {0}'}" />
    </StackPanel>

    <Grid Name="homeAreas" ColumnDefinitions="330,*,270" ColumnSpacing="34">

      <!-- The black column this face's menu rail is drawn on is not drawn here: Nereus paints it in home.xaml
           and it stands behind this grid, at the same width as the first column. -->

      <!-- The main menu: MP2's own entries, in MP2's own order, each with either its count or the reason it cannot
           be opened here. See MainMenu for which plugin's workflow file contributes which line - the menu is not a
           selection this front end made, it is the list the previous code assembled from the installed plugins, with
           the plugins this build cannot run still named and still explaining themselves.
           Focusable is stated rather than trusted: measured on this very screen, a list reported itself not
           focusable, which left the remote's arrow keys unable to reach it at all. -->
      <ListBox Name="menuList"
               Classes="nereus-home-menu"
               Focusable="True"
               theming:SkinTemplates.TileTemplate="HomeMenuTileTemplate"
               ItemsSource="{Binding DisplayMenu}"
               SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
               FontSize="21"
               Padding="0"
               Background="Transparent"
               BorderThickness="0"
               ScrollViewer.VerticalScrollBarVisibility="Hidden"
               ScrollViewer.HorizontalScrollBarVisibility="Hidden">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:MainMenuEntry">
            <StackPanel Spacing="1" Margin="0,5,10,7">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <!-- The entry's own home picture, asked for by the name the entry carries - the folder it
                     lives in is the worn face's answer (Nereus keeps round tiles for its circle switch),
                     which is why the format here is bare. Where no skin is worn, or the skin has no such
                     picture, the letter badge below is what the tile wears; see MainMenuEntry.HomeImageId
                     and SkinImageConverter. -->
                <Panel Width="36">
                  <Image Source="{Binding HomeImagePath, Converter={x:Static views:SkinImageConverter.Instance},
                                          ConverterParameter='{}{0}'}"
                         Height="34"
                         Stretch="Uniform"
                         HorizontalAlignment="Center" />
                  <!-- The "this shelf is playing" mark: the very picture both rescued skins carry under the
                       name IsPlaying, worn by the tile whose shelf a film, an album or a show is read from.
                       No skin, no picture, no claim - the tile says nothing it cannot show. -->
                  <Image Source="{Binding Label, Converter={x:Static views:SkinImageConverter.Instance},
                                         ConverterParameter=IsPlaying}"
                         Height="14"
                         Stretch="Uniform"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,1,4,0"
                         IsVisible="{Binding IsPlaying}" />
                  <TextBlock Text="{Binding Badge}"
                             FontSize="21"
                             TextAlignment="Center"
                             Opacity="0.7"
                             IsVisible="{Binding HomeImagePath, Converter={x:Static views:SkinImageMissingConverter.Instance},
                                                 ConverterParameter='{}{0}'}" />
                </Panel>
                <TextBlock Text="{Binding Label}"
                           FontSize="21"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <!-- What pressing does, or what stops it: "4 films" on a tile that opens, "not on this server" on one
                   that does not, and "no TV backend" on one this build has no way to serve. A tile that is silent
                   about all three reads as a broken front end. -->
              <TextBlock Text="{Binding Detail}"
                         FontSize="13"
                         Opacity="0.5"
                         Margin="46,0,0,0"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- The content of the highlighted entry: its lists one after another, with their headings. This is the half
           of MP2's home screen the menu alone cannot say - not "here are three thousand films" but "these six are
           the newest, and this is the one you stopped half way through". -->
      <DockPanel Name="contentPane" Grid.Column="1" IsVisible="{Binding HomeContentShown}">

        <!-- What somebody left half way is not a strip of its own here: the reference kept "where was I" inside
             the highlighted entry's own lists (MovieHomeContent's ContinuePlayMovies, SeriesHomeContent's
             ContinuePlaySeries), so a series left half way belongs to the series tile alone - see
             HomeViewModel and HomeContentList. The pane below is what fills that role now. -->
        <ListBox Name="contentList"
                 Focusable="True"
                 ItemsSource="{Binding ContentRows}"
                 SelectedItem="{Binding SelectedContent, Mode=TwoWay}"
                 FontSize="17"
                 Background="Transparent"
                 BorderThickness="0"
                 theming:SkinTemplates.TileTemplate="HomeContentRowTemplate">
          <ListBox.ItemTemplate>
            <!-- One template for three kinds of line, because the pane is a single walkable list - see HomeRow for
                 why headings and titles are rows of one list rather than four lists of their own. -->
            <DataTemplate x:DataType="vm:HomeRow">
              <Panel Margin="0,2">
                <TextBlock Text="{Binding Text}"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Margin="0,8,0,2"
                           IsVisible="{Binding IsHeading}" />
                <TextBlock Text="{Binding Text}"
                           FontSize="14"
                           Opacity="0.5"
                           Margin="12,1,0,3"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding IsNote}" />
                <StackPanel Margin="12,1,0,3" IsVisible="{Binding IsMenuEntry}">
                  <TextBlock Text="{Binding MenuEntry.Label}"
                             FontSize="17"
                             FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding MenuEntry.Detail}"
                             FontSize="13"
                             Opacity="0.55"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Grid ColumnDefinitions="2.2*,1*" ColumnSpacing="14" MinWidth="380"
                      IsVisible="{Binding IsTitle}">
                  <TextBlock Grid.Column="0"
                             Text="{Binding Title.Line}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding Title.Detail}"
                             Opacity="0.55"
                             TextTrimming="CharacterEllipsis" />
                </Grid>
              </Panel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <ScrollViewer Name="nereusContentPane"
                      Focusable="True"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled"
                      IsVisible="False">
          <!-- The wall is one thing that scales: the code-behind puts a LayoutTransform on this control so the
               whole shelf - headings, tiles and their gaps - grows to the share of the panel the worn skin asks
               for (HomeWallHeightRatio, 0.8 of the height under Nereus), and stands it centred in that panel
               rather than hanging it under the header row the reference drew. -->
          <LayoutTransformControl Name="nereusContentWall" VerticalAlignment="Center">
          <ItemsControl ItemsSource="{Binding ContentGroups}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HomeContentGroup">
                <Grid Width="{Binding OccupiedWidth}" Height="{Binding BoxHeight}" Margin="0,0,24,0"
                      VerticalAlignment="Top">
                  <TextBlock Text="{Binding Heading}"
                             FontSize="21"
                             FontWeight="SemiBold"
                             Margin="12,6,0,0"
                             VerticalAlignment="Top"/>
                  <!-- Not clipped, and that is deliberate: this panel is exactly the size of the tiles it holds, so
                       clipping it is a cut along the outside edge of every tile in the row. The shortcut's glass
                       throws its shadow a dozen DIP past that edge, and the covers dress themselves with a shadow
                       of their own; cut at the row's bounds, both of them ended in a straight line a finger's
                       breadth from where the tile's rounding turns, which is the notch in the corner that no
                       setting on the glass could reach because it was never the glass drawing it. Nothing here
                       scrolls and nothing here overflows on purpose - only shadows do. -->
                  <ItemsControl ItemsSource="{Binding Tiles}" x:CompileBindings="False" ClipToBounds="False">
                    <ItemsControl.Styles>
                      <Style Selector="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                      </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas Width="{Binding OccupiedWidth}" Height="{Binding BoxHeight}"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:HomeContentTile">
                        <!-- Two kinds of tile, written apart rather than sharing one Button with switches, because
                             a cover and an icon want opposite things from the surface they stand on: a cover wants
                             a plate and a picture filling it, an icon wants the room behind it and is dressed as
                             glass. Apart, the shortcut's glass, its plaque and its morph are nowhere in a tile that
                             is not one, and whoever changes the icons cannot move a cover's numbers by accident. -->
                        <Panel>
                        <!-- Two surfaces, because a shadow cannot live on a clipped edge: the outer one is the
                             ground the tile stands on and casts its BoxShadow (which must fall outside its own
                             edges, so it clips nothing), the inner one is the face the picture stands on and
                             does the clipping. Both are dressed by the worn skin's styles, not here. -->
                        <Border Classes="home-tile-shadow" IsVisible="{Binding !IsShortcut}">
                        <Button Classes="nereus-content-tile"
                                Width="{Binding Width}"
                                Height="{Binding Height}"
                                Focusable="{Binding IsFocusable}"
                                Tag="{Binding}"
                                GotFocus="OnNereusTileGotFocus"
                                Click="OnNereusTileClick">
                          <Panel>
                          <Border Classes="home-tile-face" ClipToBounds="True">
                          <Grid>
                            <!-- The frost, and only where the tile has no picture of its own. A cover that has
                                 its fanart stands on its dark plate exactly as it always did; one whose artwork
                                 is missing or still arriving would otherwise be a bare black square with a word
                                 on it, so it frosts the piece of wall behind it the way the glasses do. Out of
                                 the frosting's backdrop for the same reason the shortcut tiles are: a wall of
                                 these sampling each other drifts to a pale plate. -->
                            <acrylic:AcrylicSurface Classes="home-tile-frost"
                                                    IsVisible="{Binding HasNoPicture}"
                                                    CornerRadius="10"
                                                    BlurRadius="8"
                                                    Vibrancy="1.15"
                                                    SurfaceColor="#33030810"
                                                    RefractionHeight="0"
                                                    RefractionAmount="0"
                                                    HighlightEnabled="False"
                                                    ShadowEnabled="False"
                                                    acrylic:AcrylicBackdrop.IsExcludedFromCapture="True"/>
                            <Image Classes="home-tile-art"
                                   Source="{Binding Title.Artwork, Converter={x:Static views:ArtworkConverter.Instance}}"
                                   Stretch="UniformToFill"
                                   IsVisible="{Binding IsTitle}"/>
                            <Image Classes="home-tile-art"
                                   Source="{Binding MenuEntry.HomeImagePath, Converter={x:Static views:SkinImageConverter.Instance}, ConverterParameter='{}{0}'}"
                                   Stretch="UniformToFill"
                                   IsVisible="{Binding IsMenuEntry}"/>
                            <Border Classes="home-tile-caption"
                                    VerticalAlignment="Bottom"
                                    Padding="8,5">
                              <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="home-tile-caption-title"
                                           Text="{Binding Label}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="2"/>
                                <TextBlock Classes="home-tile-caption-detail"
                                           Text="{Binding Detail}"
                                           FontSize="12"
                                           Opacity="0.65"
                                           TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding IsMenuEntry}"/>
                              </StackPanel>
                            </Border>
                          </Grid>
                          </Border>
                          <!-- The frame, laid over the edge of the face and not around it: the same ring the
                               shortcut glasses wear (one class, one set of numbers, brightened by the same
                               rule), drawn after the face so the face's own clip cannot saw off its outer half.
                               This tile used to answer focus with a hard four pixel white frame of its own; that
                               frame is gone, and what a viewer sees now is the ghost edge coming up to full light
                               on the tile they stand on. Out of the pointer's way, because the Button is what
                               gets stood on. -->
                          <Border Classes="home-tile-edge" IsHitTestVisible="False"/>
                          </Panel>
                        </Button>
                        </Border>

                        <!-- The shortcut, as glass. Glass is not a white rectangle with an icon on it: it lets the
                             picture behind it through, frosted, it has body, and it has an edge that catches the
                             light. So the tile frosts the screen itself behind it - the piece of the wall standing
                             behind THIS tile - through a shader, with the veil of the glass over that frost and
                             the glyph on top of the veil, standing centred on the tile with no box around it at
                             all. The frame is a gradient rather than one flat line because a glass edge is bright
                             where it catches the light and dark where it does not. Standing on the tile lifts its
                             background lighter, brings the edge up from a ghost to full light and draws the
                             outline of the glyph round the icon; nothing travels across the glass, nothing zooms,
                             the corner stays the corner, and no band lies across the bottom of the frame. Every number of this - how deep the frost, how much veil,
                             how bright the edge - lives either here on the frosting surface or in styles.xaml. -->
                        <!-- Out of the frosting's backdrop, on purpose and for every one of them at once.

                             The shader does not look at the screen; it asks for a snapshot of the visuals BEHIND
                             the glass, and the library leaves each surface's own subtree out of that snapshot -
                             each surface's OWN, no more. Five of these tiles stand side by side in a rail, so
                             every one of them sampled its neighbours' finished glass, frosted it, and handed the
                             result back to the neighbours to frost again on the next capture. Every round trip
                             adds the tint's white and the vibrancy's lift, so a rail of these left standing a
                             while drifts to a pale plate: not a rounding problem, not a clip problem, and not
                             anything a fresh frame would show - which is why it looked fine in a screenshot
                             taken straight after a start and wrong after that.

                             Excluded, a tile frosts the wall and the artwork behind it and nothing else, which
                             is what glass does, and the loop has no way to close. -->
                        <!-- The same ground the covers stand on: the shared Border.home-tile-shadow, so a shortcut
                             is laid on the wall by the one BoxShadow the skin knows and not by a second shadow of
                             the glass's own invention. The border is transparent - it carries the shadow and
                             nothing else - and the glass sits in it as the cover's face sits in its own. -->
                        <Border Classes="home-tile-shadow" IsVisible="{Binding IsShortcut}">
                        <Button Classes="nereus-shortcut-tile"
                                acrylic:AcrylicBackdrop.IsExcludedFromCapture="True"
                                IsVisible="{Binding IsShortcut}"
                                Width="{Binding Width}"
                                Height="{Binding Height}"
                                Focusable="{Binding IsFocusable}"
                                Tag="{Binding}"
                                GotFocus="OnNereusTileGotFocus"
                                Click="OnNereusTileClick">
                          <Panel>
                            <!-- ONE surface for the glass itself: the frosting and its rounding are drawn by this
                                 one surface, and the frame is a ring laid over its edge afterwards. The shadow it
                                 stands away from the wall on is deliberately NOT its own - the tile wears the
                                 skin's shared Border.home-tile-shadow, wrapped round this Button above - because
                                 every other tile on the wall is laid down by that one shadow, and a shortcut
                                 casting a shadow of its own invention sat in a darkness none of its neighbours had.

                                 It took three attempts to see why anything else fails. Two roundings cannot be
                                 right: the face was rounded at ten while the surface, inset by the frame's own
                                 three, was rounded at seven or eight, and where the two circles disagree a viewer
                                 sees a step in the corner - which is the artifact that survived every clip I
                                 moved around, because clipping was never the problem, the two circles were.

                                 So the surface rounds at the tile's own ten and frosts within that path, and it
                                 casts nothing of its own: ShadowEnabled is off. A shader shadow laid next to the
                                 skin's BoxShadow is two shadows under one tile, and the shadow that belongs to a
                                 tile is the one every cover on the wall already wears - round at the same ten, so
                                 the two agree about where the edge is. Nothing here clips either: the shadow falls
                                 outside the tile's bounds, and the ring on top is drawn at the same ten, so it
                                 covers the seam of the edge rather than fighting it, and it is out of the way of
                                 the pointer because the Button is what gets stood on.

                                 Two things a photograph of the running screen taught about this surface, both of
                                 them against the obvious setting:

                                 The shadow was there and invisible, because it falls outside the surface's bounds
                                 while the Button it stands in is 159x159 - exactly the tile - and clips, as does
                                 the row of tiles around it. Every pixel of a shadow that lies outside the tile was
                                 being sawn off by those two cuts, and no amount of deepening it could show
                                 through - which is also where the notch in the tile's bottom corners came from, a
                                 shadow ending in a straight line a finger's breadth before its rounding turns.
                                 Neither clips any more (see the row above and the tile's style in styles.xaml),
                                 and that - not any number written on the glass - is what lets the tile's shadow
                                 reach past the tile.

                                 The plate going white was the same kind of mistake on the other side of the glass.
                                 TintColor is not a wash laid over the frost: the library puts it down once at full
                                 alpha in the Hue blend mode and once more as a fill, so a near-white tint is a
                                 full-strength wash over everything behind the pane. A veil meant to sit inside the
                                 glass therefore goes through SurfaceColor - one ordinary fill at its own alpha,
                                 dark here, so the glass is darker than the wall it covers and reads as smoke
                                 rather than as card. -->
                            <acrylic:AcrylicSurface Classes="home-shortcut-frost"
                                                    CornerRadius="10"
                                                    BlurRadius="8"
                                                    Vibrancy="1.15"
                                                    SurfaceColor="#33030810"
                                                    RefractionHeight="0"
                                                    RefractionAmount="0"
                                                    HighlightEnabled="False"
                                                    ShadowEnabled="False">
                                <!-- The glass's own content, and nothing here is clipped: the veil, the glyph and
                                     the name all stay inside the glass on their own, and the one thing that ever
                                     needed ending at the tile's edge - a reflection travelling across it - is out
                                     of the skin. -->
                                <Panel>
                                  <!-- The tint of the glass itself, over the frost it frosts. -->
                                  <Border Classes="home-shortcut-tint"/>
                                  <!-- The glyph stands on the glass, centred above the name, eight-tenths of
                                       its old half-width - its own box, no box around it. It is a shape rather
                                       than a picture, so the tile decides its colour and its state. -->
                                  <Path Classes="home-shortcut-glyph"
                                        Width="{Binding IconSize}"
                                        Height="{Binding IconSize}"
                                        Stretch="Uniform"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="{Binding IconName, Converter={x:Static views:SkinIconGeometryConverter.Instance}, ConverterParameter='{}{0}'}"/>
                                  <!-- The name, on the glass and not on a band: a band is a rectangle, and a
                                       rectangle inside a rounded frame lies across the frame's corners. -->
                                  <TextBlock Classes="home-shortcut-caption"
                                             Text="{Binding Label}"
                                             TextTrimming="CharacterEllipsis"/>
                                </Panel>
                            </acrylic:AcrylicSurface>
                            <!-- The frame, laid OVER the edge of the glass rather than around it: a ring, and
                                 nothing else - no background, no clip - because the glass beneath it has already
                                 decided where its edge is, at the very same ten. Laid over that edge the ring
                                 hides the seam of the cut instead of arguing with it, and it stays out of the
                                 pointer's way because the Button is what a viewer stands on. -->
                            <Border Classes="home-tile-edge" IsHitTestVisible="False"/>
                          </Panel>
                        </Button>
                        </Border>
                        </Panel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </LayoutTransformControl>
        </ScrollViewer>
      </DockPanel>

      <!-- What the database is made of, in the third column and out of the way: it is the answer to "why is there no
           number on that tile?", and MP2's home screen has no equivalent of it at all - it is this front end's way
           of letting a viewer see the server's own aspect names, which is what a bug report needs. -->
      <DockPanel Name="aspectsPane" Grid.Column="2" IsVisible="{Binding IsPlainHome}">
        <TextBlock DockPanel.Dock="Top"
                   Text="On this server"
                   FontSize="15"
                   Opacity="0.5"
                   Margin="0,0,0,6" />
        <ListBox Name="aspectsList"
                 Focusable="True"
                 ItemsSource="{Binding Aspects}"
                 SelectedItem="{Binding SelectedAspect, Mode=TwoWay}"
                 FontSize="17"
                 Background="Transparent"
                 BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AspectViewModel">
              <DockPanel MinWidth="200" Margin="0,4">
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding CountText}"
                           Opacity="0.7"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>
    </DockPanel>

    <!--
      What floats over the finished screen belongs to the face, not to this file: Nereus screens the screen
      with the two gradients of its master_homemenu.xaml, hangs the line about the standing title beside its
      rail, and stands the four corner buttons of master_home.xaml's WindowButtonsPanel at the top edge - all
      of that is written in home.xaml under Nereus' own roof and painted on the host below. A face that ships
      no home of its own keeps the general line below it, which this host's presence quietly steps aside.
    -->
    <ContentControl Name="homeOverlays" IsTabStop="False" Focusable="False"/>
    <Panel Name="plainOverlays">
      <!-- What the reference shows at the bottom left of its home screen about the title the walker is
           standing on: its name, the year, how long it runs and how much of it was watched, in one line over
           whatever the screen wears. It rides on the same choice that puts the fanart up, so the line and the
           picture always speak about one and the same title. -->
      <TextBlock Name="contentInfoLine"
                 IsHitTestVisible="False"
                 Text="{Binding ContentInfo}"
                 FontSize="22"
                 Foreground="{DynamicResource TextBrush}"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Margin="46,0,0,34"
                 IsVisible="{Binding HasContentInfo}"
                 TextTrimming="CharacterEllipsis"/>
    </Panel>
  </Panel>
</UserControl>
