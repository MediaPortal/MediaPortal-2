<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MediaPortal.Frontend.ViewModels"
        xmlns:views="using:MediaPortal.Frontend.Views"
        xmlns:theming="using:MediaPortal.Frontend.Theming"
        x:Class="MediaPortal.Frontend.Views.NowPlayingView"
        x:DataType="vm:NowPlayingViewModel"
        Name="nowPlaying"
        Background="{DynamicResource ScreenBackgroundBrush}"
        >

  <!--
    The playback screen, sized for a television like the home screen: the name of what is playing, the picture
    area, the position, and a row of transport buttons that a remote can reach with the d-pad. Everything on it
    is bound to NowPlayingViewModel, which is the only thing between this screen and the player library - the
    screen itself never asks what an engine is.
  -->

  <UserControl.Styles>
    <Style Selector="Button.transport">
      <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="MinWidth" Value="130"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.transport:focus /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="3"/>
    </Style>
    <Style Selector="Button.track">
      <Setter Property="Background" Value="{DynamicResource PanelPressedBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Focusable" Value="True"/>
    </Style>
    <Style Selector="Button.track:focus /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="TextBlock.trackLabel">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,18,0"/>
    </Style>
  </UserControl.Styles>

  <Panel>
  <DockPanel Margin="48,32">

    <StackPanel Name="titleArea" DockPanel.Dock="Top" Spacing="4">
      <TextBlock Text="{Binding Title}"
                 FontSize="32"
                 TextTrimming="CharacterEllipsis"
                 HorizontalAlignment="Left"/>
      <TextBlock Text="{Binding StateText}" FontSize="16" Foreground="{DynamicResource MutedTextBrush}"/>
    </StackPanel>

    <Border Name="statusArea" DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock Text="{Binding StatusLine}"
                 FontSize="15"
                 Foreground="{DynamicResource MutedTextBrush}"
                 TextWrapping="Wrap"
                 HorizontalAlignment="Left"/>
    </Border>

    <!--
      The bar the worn skin draws along the foot of the playback screen, above the one line that says what went
      wrong, which is where the reference read out what played: its master screen's footer carried the title, a
      progress line and the state of play along the bottom and took itself off while nothing played. Nereus drew
      that reading on a flat dark slab with the line filled with the accent, WMC on a blue band with the word set
      bold on it, and both drawings live in the skins' own files now.

      The screen names the key and keeps its own answer to it, which is an invisible nothing, so a viewer wearing no
      skin sees the rows this screen was written with and exactly those, and the day a skin answers the key that
      skin's bar arrives below them without this file being touched again.

      The keys a viewer presses stay in the rows above and are not the skin's to draw: markup read off a skin's disk
      has no code behind it to catch a press, and a button on the television that answers nothing is worse than no
      button at all.
    -->
    <ContentControl Name="skinOverlay"
                    DockPanel.Dock="Bottom"
                    Content="{Binding}"
                    HorizontalContentAlignment="Stretch"
                    theming:SkinTemplates.OverlayTemplate="NowPlayingOverlayTemplate">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="vm:NowPlayingViewModel">
          <Panel IsVisible="False"/>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <Grid RowDefinitions="*,Auto,Auto,Auto">

      <!--
        The picture. VideoSurface draws the frames the player hands over and stays empty when there are none - an
        empty black frame that tells the viewer what the player is doing is the truth, and a fake preview would
        not be. The state text sits on top of it, because the first seconds of a file are black anyway and a
        viewer wants to know whether "Starting" means starting.
      -->
      <Border Grid.Row="0"
              Name="videoArea"
              Background="{DynamicResource VideoBrush}"
              BorderBrush="{DynamicResource VideoOutlineBrush}"
              BorderThickness="1">
        <Panel>
          <!--
            The playing title's own picture, behind the frames on purpose: a film covers it by playing, and a
            song - which hands over no frames at all - wears it, which is the picture the reference's audio
            screen showed large next to the transport. Asked of the library once per title, cleared with it.
          -->
          <Image Source="{Binding Cover, Converter={x:Static views:ArtworkConverter.Instance},
                                  ConverterParameter=600}"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="0,0,0,0"/>
          <views:VideoSurface Name="videoSurface"/>

          <!--
            The reference's player-state overlay: a big centred icon at seventy per cent strength saying the
            picture is waiting for something. The reference shows it while its player is rate-seeking; this
            engine seeks by jumping, so the icon answers the escalating skip ladder instead - the moment a
            viewer is actually in, on this front end - fast-forward while the run is pointing forwards,
            fast-rewind while it points back, gone the moment the jump lands or is cancelled. The pictures
            are the skins' own fastforward.png / fastrewind.png; a skin without them draws nothing, which is
            the same silence the reference keeps on a missing texture. (The reference's pause icon in this
            overlay binds "pause.png", a picture neither shipped skin carries - only the PlayerControl button
            states - so it is not ported: not a decision to skip, just nothing to draw.)
          -->
          <Image Name="stateIcon" Width="250" Opacity="0.7" IsVisible="False"
                 IsHitTestVisible="False"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>

          <TextBlock Text="{Binding StateText}"
                     FontSize="22"
                     Foreground="{DynamicResource DimTextBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
          <!-- What the library knows about this title, said over the picture at the corner where it does not
               cover the story: the Info button in the transport row calls it and hides it again (the I key
               got the reference's own job instead - it is the Info key, and that toggles the display).
               It is read once per title and cleared with it, so an old film's plot never outlives its film. -->
          <Border Name="mediaInfo"
                  IsVisible="False"
                  MaxWidth="860"
                  Margin="16"
                  Padding="16,12"
                  Opacity="0.94"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Background="{DynamicResource PanelRaisedBrush}"
                  BorderBrush="{DynamicResource OutlineBrush}"
                  BorderThickness="1">
            <TextBlock Text="{Binding MediaInfoText}"
                       FontSize="18"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextBrush}"/>
          </Border>
        </Panel>
      </Border>

      <StackPanel Name="progressRow" Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="0,18,0,0">
        <TextBlock Text="{Binding PositionText}" FontSize="22" VerticalAlignment="Center"/>
        <ProgressBar Name="progressBar"
                     Width="820"
                     MinHeight="14"
                     Minimum="0"
                     Maximum="1"
                     Value="{Binding Progress}"
                     VerticalAlignment="Center"/>
      </StackPanel>

      <!--
        The transport row, in the reference's order (PrimaryVideoOSD): rewind, play/pause, stop, forward, then
        the title's information, then the volume pair (up first, as the reference stacks them), and the leave
        buttons last. The buttons the reference also draws - previous and next track, player configuration,
        DVD title and chapter pickers - wait for a front end that owns a playlist of its own or a dialog
        behind the button; a button that leads nowhere is worse than a missing one. The captions say the
        reach the viewer answered in the playback settings, not a hard-worn thirty.
      -->
      <StackPanel Name="transportRow" Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,18,0,0">
        <Button Name="backButton" Classes="transport" Content="-30 s" Click="OnBack"/>
        <Button Name="pauseButton" Classes="transport" Content="{Binding TransportLabel}" Click="OnPause"/>
        <Button Name="stopButton" Classes="transport" Content="Stop" Click="OnStop"/>
        <Button Name="forwardButton" Classes="transport" Content="+30 s" Click="OnForward"/>
        <Button Name="infoButton" Classes="transport" Content="Info" Click="OnMediaInfo"/>
        <Button Name="volumeUpButton" Classes="transport" Content="Vol +" Click="OnVolumeUp"/>
        <Button Name="volumeDownButton" Classes="transport" Content="Vol -" Click="OnVolumeDown"/>
        <Button Name="muteButton" Classes="transport" Content="Mute" Click="OnMute"/>
        <Button Name="closeButton" Classes="transport" Content="Close" Click="OnClose"/>
      </StackPanel>

      <!--
        Sound and subtitles, on their own row because a viewer reaches for them once per film and then never
        again - which is exactly the wrong shape for a row of eight transport keys. Each button moves to the
        next track and the line beside it says what is now chosen, so the answer arrives without a dialog to
        close. The row disappears for a media with one track: a button that can only do one thing is noise.
      -->
      <StackPanel Name="trackRow">
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,14,0,0"
                  IsVisible="{Binding HasTrackChoice}">
        <Button Name="audioButton" Classes="track" Content="Sound" Click="OnNextAudioTrack"/>
        <TextBlock Text="{Binding AudioTrackLine}" Classes="trackLabel"/>
        <Button Name="subtitleButton" Classes="track" Content="Subtitles" Click="OnNextSubtitleTrack"/>
        <TextBlock Text="{Binding SubtitleTrackLine}" Classes="trackLabel"/>
      </StackPanel>
      </StackPanel>
    </Grid>
  </DockPanel>

    <!--
      The reference's opening breath (AnimationL on its full-screen grid): the picture starts behind a black
      overlay that fades away within half a second of the screen showing, so a film does not begin with a
      hard cut from whatever screen came before. It replays every time this screen is shown, because the
      reference's trigger fires on showing, not once per application.
    -->
    <Border Name="openFade" Background="Black" IsHitTestVisible="False"/>
  </Panel>
</UserControl>
