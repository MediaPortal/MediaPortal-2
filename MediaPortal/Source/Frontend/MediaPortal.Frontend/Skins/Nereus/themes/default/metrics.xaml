<?xml version="1.0" encoding="utf-8"?>
<!--
  Nereus' measurements, the role its reference Consts.xaml played.

  The reference skin was drawn for a 1920x1080 television and these numbers
  are what its Consts.xaml held, unchanged; chrome.xml divides them by the
  same scale the reference header and footer used when it lays out the
  master for the window this front end actually gets. Where a number below is
  this face's own rather than the reference's, the comment above it says so.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The master: the reference header and footer were both 100 of 1080 lines high. -->
  <x:Double x:Key="HeaderHeight">100</x:Double>
  <x:Double x:Key="FooterHeight">100</x:Double>
  <x:Double x:Key="MultiDetailsFooterHeight">210</x:Double>

  <!-- Type, at the sizes the reference sized it. -->
  <x:Double x:Key="HeaderFontSize">80</x:Double>
  <x:Double x:Key="DateTimeFontSize">55</x:Double>
  <x:Double x:Key="HugeFontSize">72</x:Double>
  <x:Double x:Key="NormalFontSize">40</x:Double>
  <x:Double x:Key="SmallFontSize">33</x:Double>
  <x:Double x:Key="SmallerFontSize">27</x:Double>
  <x:Double x:Key="InfoFontSize">20</x:Double>
  <x:Double x:Key="TinyFontSize">13</x:Double>
  <x:Double x:Key="DialogTitleFontSize">30</x:Double>
  <x:Double x:Key="InfoTabFontSize">55</x:Double>

  <!-- The home head line's clock. master_home.xaml drew its clock at DateTimeFontSize (55) and the two lines
       beside it - the day of the week over the temperature - at 21, so the clock stood exactly as high as the
       two lines stacked: 21 lines are 27.7 of their 1080 lines tall, and two of them are 55. This face draws
       those two lines at SmallerFontSize, five of the reference's lines louder, so the clock grows by the same
       step - 27 times 55 over 21 - and comes to as high as the two lines under it again. -->
  <x:Double x:Key="HeadlineTimeFontSize">71</x:Double>

  <!-- Edges. Nereus drew its buttons square; its dialogs were rounded a little. -->
  <x:Double x:Key="ButtonControlRadiusX">0</x:Double>
  <x:Double x:Key="DialogBorderCornerRadius">6</x:Double>

  <!-- How round a dialog panel is, which is NOT the number above: the reference hung its volume bar, its skip
       overlay and its channel zap on DialogBorderCornerRadius too, and at twenty five of those a twenty pixel
       bar is a pill. Both dialog frames wear this number - the headed one and the plain one - so that a dialog
       is the same shape whether or not it brings a heading, and it is a corner the eye reads across the room. -->
  <CornerRadius x:Key="DialogFrameCornerRadius">25</CornerRadius>
  <x:Double x:Key="TextBoxBorderThickness">3</x:Double>
  <x:Double x:Key="TextBoxCornerRadius">5</x:Double>
  <x:Double x:Key="ProgressBarRadius">2</x:Double>
  <x:Double x:Key="DefaultPlayerControlBorderThickness">1</x:Double>
  <x:Double x:Key="DefaultPlayerControlCornerRadius">4</x:Double>
  <x:Double x:Key="ScrollBarWidth">8</x:Double>
  <x:Double x:Key="ScrollBarKnobWidth">8</x:Double>
  <x:Double x:Key="DialogButtonMinWidth">300</x:Double>

  <!-- How far the screen behind a dialog is thrown out of focus: the shell photographs that screen at one
       number-th of the size it is drawn in and stretches the photograph back over the window, so this number IS
       the blur - five takes a wall of covers down to soft rectangles the viewer still recognises as where they
       were standing, three leaves the covers as shapes with their colours intact, nine runs the whole home into
       one wash the viewer cannot place. The reference dimmed its master screen behind a dialog and left it
       sharp, which was enough over its still pictures; this home keeps moving behind the question, and detail
       moving under the letters of a question is what the dialog is there to put an end to. Named here and worn
       by the shell, softened on the way (see ShellWindow.BlurScreenBehind and SoftFocus), so that the ground comes back as a soft focus and not as a mosaic of the home's edges; a skin that names no number - or less than two - keeps
       its dialogs over a sharp background, which is what a face drawn over a still picture wants. -->
  <x:Double x:Key="DialogBackdropBlur">7</x:Double>

  <!-- The home's content wall - the shortcuts, the latest added, the continue watching - fills this share of
       the panel's height and stands centred in what the rail leaves beside it, so the same wall that filled a
       1080 television fills a taller panel without hanging under it. The reference drew its content grid over
       880 of its 1080 lines, which is 0.81 of the screen; the number is kept round at eight tenths. -->
  <x:Double x:Key="HomeWallHeightRatio">0.8</x:Double>

  <!-- The head over a band of the content wall. The reference draws one label for every band - "Latest added",
       "Continue watching", "Others" - in its bold face at SmallerFontSize, which Consts.xaml sets to twenty-seven
       of its 1080 lines, standing left-aligned over the band's own margin. One number for every band, because the
       distance from a head to what stands under it is one decision about the wall. -->
  <x:Double x:Key="HomeBandHeadingFontSize">27</x:Double>

  <!-- A leftover plugin's plaque, measured off the reference's OtherPluginsControlTemplate: the band its name
       stands on is forty lines of the 1080 high, the name is SmallerFontSize again (the same twenty-seven that
       heads a band), and it rests at six tenths of light, coming to full light only under a viewer - which is the
       whole of what the reference does when a plugin's square is stood on. -->
  <x:Double x:Key="PluginTileBandHeight">40</x:Double>
  <x:Double x:Key="PluginTileNameFontSize">27</x:Double>
  <x:Double x:Key="PluginTileNameRestingOpacity">0.6</x:Double>

  <!-- The main menu's tiles, the same way: this face drew a tile of 170 standing in a column of 200, and both
       numbers below are those grown by a fifth - 204 of the 1440 lines this front end is drawn on for the square
       a tile wears, and 240 for the column it stands in - so the rail grows with the panel instead of staying
       the size a 2010 television happened to be. Because both are read off the height, the rail keeps its
       proportion on a tall panel and on a short one, and a tile stays the square it was drawn as. -->
  <x:Double x:Key="HomeMenuTileHeightRatio">0.1417</x:Double>
  <x:Double x:Key="HomeMenuRailWidthRatio">0.1667</x:Double>
</ResourceDictionary>
