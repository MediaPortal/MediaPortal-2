<?xml version="1.0" encoding="utf-8"?>
<!--
  Nereus screen templates: how this skin draws the items of the screens that ask.

  This is the part of the reference skin that was never a colour. The reference screens bound their lists to
  models and left the item trees to the skin - master_homemenu spelled a menu entry as a quiet text row with
  the entry's own words underneath - and that markup is what lives here, translated into the markup this front
  end reads. The x:DataType on each template is kept on purpose: the runtime loader compiles these bindings, so
  a rename of a view model property is a complaint when the skin goes on, not a silently blank tile.

  A screen asks for a template by name (SkinTemplates.TileTemplate on its list). A key nobody asks about costs
  nothing; a key the skin does not answer leaves the screen drawing the tree it was written with.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:MediaPortal.Frontend.ViewModels"
                    xmlns:dis="using:MediaPortal.Frontend.Discovery"
                    xmlns:views="clr-namespace:MediaPortal.Frontend.Views">

  <!--
    The home menu, as Nereus wore it: the entry's own picture from this skin's images/HomeMenu - which the
    reference painted for exactly these workflow action Ids and this skin carries verbatim - the entry's own
    words in Nereus' size, and the answer to "what happens when you press" - the count, or the reason it
    cannot - small and grey underneath, lined up under the words rather than under the picture. Nereus files
    each tile by the bare Id, so that is the format this skin spells; an entry the skin has no picture for -
    one this front end added on top of MP2's menu - wears its letter badge instead.
  -->
  <!--
    The settings list, as Nereus wore its configuration menu: the section's own name in the reading size,
    whose machine it belongs to said under it in the quiet colour, and the one sentence of what you can do
    here under both. No pictures: the reference asked the skin for a SettingsMenu\<section>.jpg and this
    tree has never carried one, and a row that invents a picture is a row with a hole in it.
  -->
  <DataTemplate x:Key="SettingsRowTemplate" x:DataType="vm:SettingsSection">
    <StackPanel Spacing="1" Margin="0,6,10,8">
      <TextBlock Text="{Binding Name}"
                 FontSize="{DynamicResource NormalFontSize}"
                 Foreground="{DynamicResource TextBrush}"/>
      <TextBlock Text="{Binding Description}"
                 FontSize="{DynamicResource SmallerFontSize}"
                 Foreground="{DynamicResource MutedTextBrush}"
                 TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Owner}"
                 FontSize="{DynamicResource SmallerFontSize}"
                 Foreground="{DynamicResource AccentBrush}"
                 Opacity="0.8"/>
    </StackPanel>
  </DataTemplate>

  <!--
    The component screens in Nereus' reading: a headline is the thing and its paper and hour underneath,
    a coming day is its date and its weather and its span, a song coming up in the party is its line with
    who sings it under. One voice with the settings rows - the skin says the sizes and the colours, the
    screen only says which question the row answers.
  -->
  <DataTemplate x:Key="NewsHeadlineTemplate" x:DataType="vm:NewsHeadlineRow">
    <StackPanel Spacing="2" Margin="0,6,10,8">
      <TextBlock Text="{Binding Title}"
                 FontSize="{DynamicResource NormalFontSize}"
                 Foreground="{DynamicResource TextBrush}"
                 TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" Spacing="14">
        <TextBlock Text="{Binding FeedName}"
                   FontSize="{DynamicResource SmallerFontSize}"
                   Foreground="{DynamicResource AccentBrush}"
                   Opacity="0.8"/>
        <TextBlock Text="{Binding DateText}"
                   FontSize="{DynamicResource SmallerFontSize}"
                   Foreground="{DynamicResource MutedTextBrush}"/>
      </StackPanel>
    </StackPanel>
  </DataTemplate>

  <DataTemplate x:Key="WeatherDayTemplate" x:DataType="vm:WeatherDayRow">
    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,7,10,9">
      <!-- The day's picture, named as the reference's weather rows named theirs and answered by the worn
           skin; no skin or no code, and the row simply stands without it. -->
      <Image Source="{Binding Icon,
                              Converter={x:Static views:SkinImageConverter.Instance},
                              ConverterParameter='Weather/64x64/{0}'}"
             Width="44"
             Height="44"
             Stretch="Uniform"
             VerticalAlignment="Center"/>
      <StackPanel Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="{Binding DateText}"
                   FontSize="{DynamicResource NormalFontSize}"
                   Foreground="{DynamicResource TextBrush}"/>
        <TextBlock Text="{Binding Overview}"
                   FontSize="{DynamicResource SmallerFontSize}"
                   Foreground="{DynamicResource MutedTextBrush}"
                   TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="16">
          <TextBlock Text="{Binding Range}"
                     FontSize="{DynamicResource SmallerFontSize}"
                     Foreground="{DynamicResource AccentBrush}"/>
          <TextBlock Text="{Binding Rain}"
                     FontSize="{DynamicResource SmallerFontSize}"
                     Foreground="{DynamicResource MutedTextBrush}"/>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </DataTemplate>

  <DataTemplate x:Key="PartyQueueTemplate" x:DataType="vm:TitleViewModel">
    <StackPanel Spacing="1" Margin="0,6,10,8">
      <TextBlock Text="{Binding Line}"
                 FontSize="{DynamicResource NormalFontSize}"
                 Foreground="{DynamicResource TextBrush}"
                 TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding Detail}"
                 FontSize="{DynamicResource SmallerFontSize}"
                 Foreground="{DynamicResource MutedTextBrush}"
                 TextTrimming="CharacterEllipsis"/>
    </StackPanel>
  </DataTemplate>

  <!--
    Nereus' home rail: a square tile carrying its artwork over a band that says the entry's name.

    The tile is cut to rounded corners - the same ten the covers on the wall wear - and clipped to them, so the
    ground, the artwork, the band and the selection bar all end at the same curve instead of running into a right
    angle the corner has to hide. How big the square stands is deliberately not written here: a menu tile has to
    grow and shrink with the screen it is drawn on, so the screen reads this face's metric, works the size out of
    the lines it actually has, and hands it to the tile. What stays in this file is the shape - the two rows are
    shares of the square (artwork over band, 130 to 40 as the face drew them), so any size keeps the proportion.
  -->
  <DataTemplate x:Key="HomeMenuTileTemplate"
                x:CompileBindings="False"
                x:DataType="vm:MainMenuEntry">
    <Border Classes="nereus-menu-tile"
            ClipToBounds="True"
            Width="{Binding $parent[ListBox].DataContext.MenuTileSize}"
            Height="{Binding $parent[ListBox].DataContext.MenuTileSize}"
            Margin="6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="130*"/>
          <RowDefinition Height="40*"/>
        </Grid.RowDefinitions>
        <Rectangle Grid.RowSpan="2"
                   Fill="#222222"
                   IsVisible="{Binding IsSquareHomeImage}"/>
        <!-- The tile's picture, dressed by the face's styles: three quarters lit and at its own size while
             nothing stands on the tile, full light and a tenth larger when something does. No
             number is written here on purpose - a number written on the element itself outranks every style
             and the tile would never brighten or grow. -->
        <Image Grid.RowSpan="2"
               Classes="nereus-menu-art"
               Source="{Binding HomeImagePath,
                                Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='{}{0}'}"
               Stretch="Fill"
               IsVisible="{Binding IsSquareHomeImage}"/>
        <Image Grid.RowSpan="2"
               Classes="nereus-menu-art"
               Source="{Binding HomeImagePath,
                                Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='{}{0}'}"
               Width="150"
               Height="150"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Stretch="Fill"
               IsVisible="{Binding IsCircleHomeImage}"/>
        <TextBlock Grid.RowSpan="2"
                   Text="{Binding Badge}"
                   TextAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="48"
                   Opacity="0.7"
                   Foreground="{DynamicResource TextBrush}"
                   IsVisible="{Binding HomeImagePath,
                                       Converter={x:Static views:SkinImageMissingConverter.Instance},
                                       ConverterParameter='{}{0}'}"/>
        <Grid Grid.Row="1"
              Name="nereusSelectionBand"
              VerticalAlignment="Stretch"
              IsHitTestVisible="False">
          <Rectangle Classes="nereus-menu-band"/>
          <TextBlock Text="{Binding Label}"
                     FontSize="{DynamicResource SmallerFontSize}"
                     FontWeight="Bold"
                     Foreground="{DynamicResource TextBrush}"
                     TextAlignment="Center"
                     VerticalAlignment="Center"
                     Margin="5,0"/>
        </Grid>
        <Image Grid.RowSpan="2"
               Source="{Binding Label,
                                Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter=IsPlaying}"
               Height="24"
               Stretch="Uniform"
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               Margin="0,3,3,0"
               IsVisible="{Binding IsPlaying}"/>
        <Image Grid.RowSpan="2"
               Source="{Binding Label,
                                Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter=Horizontal_gradient.png}"
               Width="15"
               Stretch="Fill"
               HorizontalAlignment="Left"
               IsVisible="{Binding IsSquareSelected}"/>
        <Rectangle Grid.RowSpan="2"
                   Fill="White"
                   Width="5"
                   HorizontalAlignment="Left"
                   IsVisible="{Binding IsSquareSelected}"/>
        <Image Grid.RowSpan="2"
               Source="{Binding Label,
                                Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter=focus.png}"
               Width="25"
               Height="93"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               Margin="10,13,10,10"
               Stretch="Fill"
               IsVisible="{Binding IsCircleSelected}"/>
      </Grid>
    </Border>
  </DataTemplate>

  <!--
    A photograph in the pictures grid. Nereus showed pictures as pictures: the photograph on a plain
    ground with its name in quiet type under it, and when the bytes never came the ground keeps the
    tile's place and says why.
  -->
  <DataTemplate x:Key="PictureTileTemplate" x:DataType="vm:PictureTile">
    <StackPanel Width="216" Spacing="4" Margin="6,8">
      <Panel Height="150">
        <Border Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1"/>
        <Image Source="{Binding Picture, Converter={x:Static views:ArtworkConverter.Instance},
                                ConverterParameter='tile'}"
               Stretch="Uniform"
               Margin="5"/>
        <TextBlock Text="{Binding PictureNote}"
                   IsVisible="{Binding HasNoPicture}"
                   FontSize="{DynamicResource TinyFontSize}"
                   Opacity="0.45"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,8"
                   Foreground="{DynamicResource MutedTextBrush}"/>
      </Panel>
      <TextBlock Text="{Binding Name}" FontSize="{DynamicResource TinyFontSize}"
                 TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource TextBrush}"/>
    </StackPanel>
  </DataTemplate>

  <!--
    The plainest row there is - an item that only has a Text - drawn with the same hairline rule as the
    label rows, for the third Browse column.
  -->
  <DataTemplate x:Key="TextRowTemplate" x:CompileBindings="False">
    <Panel>
      <TextBlock Text="{Binding Text}" FontSize="{DynamicResource SmallerFontSize}"
                 Margin="6,8"
                 TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource TextBrush}"/>
      <Border Height="1" Background="{DynamicResource AccentBrush}" Opacity="0.18"
              VerticalAlignment="Bottom"/>
    </Panel>
  </DataTemplate>

  <!--
    A line of the metadata page: the word it asks on the left in the skin's quiet grey, the control -
    switch or keyboard-ready field - on the right. The hairline under it keeps the page reading as a list.
  -->
  <DataTemplate x:Key="MetadataRowTemplate" x:DataType="vm:MetadataRow">
    <Panel>
      <Grid ColumnDefinitions="300,*" ColumnSpacing="12" Margin="4,7">
        <TextBlock Grid.Column="0" Text="{Binding Label}" TextWrapping="Wrap"
                   FontSize="{DynamicResource TinyFontSize}"
                   Foreground="{DynamicResource TextBrush}"/>
        <CheckBox Grid.Column="1" IsChecked="{Binding IsOn}" IsVisible="{Binding IsToggle}"
                  VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Text="{Binding Text}" IsVisible="{Binding IsText}" Width="160"
                 HorizontalAlignment="Left" Watermark="en-GB"
                 views:VirtualKeyboardService.Trigger="EnterOrMenu"/>
      </Grid>
      <Border Height="1" Background="{DynamicResource AccentBrush}" Opacity="0.15"
              VerticalAlignment="Bottom"/>
    </Panel>
  </DataTemplate>

  <!--
    A line of the system status screen: the word it asks on the left in the skin's quiet grey, the answer
    on the right in loud white.
  -->
  <DataTemplate x:Key="StatusRowTemplate" x:DataType="vm:SystemStatusViewModel+Line">
    <Grid ColumnDefinitions="260,*" ColumnSpacing="16" Margin="4,5">
      <TextBlock Grid.Column="0" Text="{Binding Label}"
                 FontSize="{DynamicResource TinyFontSize}"
                 Opacity="0.6"
                 Foreground="{DynamicResource MutedTextBrush}"/>
      <TextBlock Grid.Column="1" Text="{Binding Value}"
                 FontSize="{DynamicResource SmallerFontSize}"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextBrush}"/>
    </Grid>
  </DataTemplate>

  <!--
    A server the finder discovered: its name in the loud type, address and version in quiet type under it,
    with Nereus' hairline rule so the pickable rows read as a list.
  -->
  <DataTemplate x:Key="ServerRowTemplate" x:DataType="dis:DetectedServer">
    <Panel Margin="4,6">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Name}" FontSize="{DynamicResource HugeFontSize}"
                   Foreground="{DynamicResource TextBrush}"/>
        <TextBlock Text="{Binding DetailLine}" FontSize="{DynamicResource TinyFontSize}"
                   Opacity="0.6"
                   Foreground="{DynamicResource MutedTextBrush}"/>
      </StackPanel>
      <Border Height="1" Background="{DynamicResource AccentBrush}" Opacity="0.18"
              VerticalAlignment="Bottom"/>
    </Panel>
  </DataTemplate>

  <!--
    A row of the skin's own settings page, and of the other two settings pages that share its shape:
    the label on the left, the answer in the middle - the checkbox for a switch, the button of the
    current answer for a choice - and the explanation greyed on the right. The button carries the
    option's own command, so a loose skin template needs no code behind it.
  -->
  <DataTemplate x:Key="SettingsOptionTemplate" x:DataType="vm:SkinSettingOption">
    <Grid ColumnDefinitions="380,170,*" ColumnSpacing="10" Margin="2,3">
      <TextBlock Text="{Binding Label}" FontSize="{DynamicResource SmallerFontSize}"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource TextBrush}"/>
      <CheckBox Grid.Column="1"
                IsChecked="{Binding IsChecked, Mode=TwoWay}"
                IsVisible="{Binding IsToggle}"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"/>
      <Button Grid.Column="1"
              Content="{Binding ValueText}"
              Command="{Binding PressCommand}"
              IsVisible="{Binding !IsToggle}"
              MinWidth="150"
              HorizontalAlignment="Left"/>
      <TextBlock Grid.Column="2" Text="{Binding Description}"
                 FontSize="{DynamicResource TinyFontSize}"
                 Opacity="0.6"
                 TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource MutedTextBrush}"/>
    </Grid>
  </DataTemplate>

  <!--
    A one-word row in the side lists Browse and the user picker walk: the label with the hairline rule
    under it, the way Nereus separated its sidebar entries.
  -->
  <DataTemplate x:Key="LabelRowTemplate" x:CompileBindings="False">
    <Panel>
      <TextBlock Text="{Binding Label}" FontSize="{DynamicResource SmallerFontSize}"
                 Margin="6,8"
                 Foreground="{DynamicResource TextBrush}"/>
      <Border Height="1" Background="{DynamicResource AccentBrush}" Opacity="0.18"
              VerticalAlignment="Bottom"/>
    </Panel>
  </DataTemplate>

  <!--
    A share in the folders screen: the name in the loud white, and under it what the share holds and where
    it lives on disk, both greyed the way Nereus greys everything that is not the headline.
  -->
  <DataTemplate x:Key="FolderRowTemplate" x:DataType="vm:FolderShare">
    <StackPanel Spacing="2" Margin="4,9">
      <TextBlock Text="{Binding Name}" FontSize="{DynamicResource SmallerFontSize}"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextBrush}"/>
      <TextBlock Text="{Binding CategoriesText}" FontSize="{DynamicResource TinyFontSize}"
                 Opacity="0.6"
                 Foreground="{DynamicResource MutedTextBrush}"/>
      <TextBlock Text="{Binding Path}" FontSize="{DynamicResource TinyFontSize}"
                 Opacity="0.45"
                 TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource MutedTextBrush}"/>
    </StackPanel>
  </DataTemplate>

  <!--
    One row of the home content pane. The pane is a single walkable list of headings, notes and titles
    (see HomeRow), so this one template draws all three: the heading in the skin's loud white with the
    thin accent rule Nereus put under its section titles, the note quiet and indented, the title line
    with the detail greyed to its right exactly as the title rows do.
  -->
  <!--
    One row of the home pane, which in the reference is not a row at all but a wall: the pane's list wraps, a
    heading takes a line of its own, and every title is a cover - the skin's own poster ground with the title's
    picture on it, exactly the tile the media grid draws, so a film looks the same at home as it does in its
    shelf. A title whose picture the server has none of wears the skin's ground and its name, like the grid's
    tile does.
  -->
  <DataTemplate x:Key="HomeContentRowTemplate" x:DataType="vm:HomeRow">
    <Panel>
      <!-- a heading spans the wall: wider than any pane, so the wrap starts a new line after it -->
      <StackPanel IsVisible="{Binding IsHeading}" Spacing="4" Width="4000" Margin="0,14,0,8">
        <TextBlock Text="{Binding Text}"
                   FontSize="{DynamicResource NormalFontSize}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}"/>
      </StackPanel>
      <TextBlock Text="{Binding Text}"
                 FontSize="{DynamicResource TinyFontSize}"
                 Margin="12,4,0,6"
                 Opacity="0.55"
                 TextTrimming="CharacterEllipsis"
                 IsVisible="{Binding IsNote}"
                 Foreground="{DynamicResource MutedTextBrush}"/>
      <!-- the cover: the grid's poster tile, at twice the reference's 162.5x250 - the doubled size the
           whole port uses, since this screen shows the reference's 720 lines at 1440 -->
      <Panel Width="326" Height="500" Margin="10,6,10,20" IsVisible="{Binding IsTitle}">
        <Image Source="{Binding Title.Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='Poster_small.png'}"
               Stretch="Fill"/>
        <Image Source="{Binding Title.Artwork, Converter={x:Static views:ArtworkConverter.Instance},
                                ConverterParameter='tile'}"
               Stretch="UniformToFill" Margin="5"
               IsVisible="{Binding Title.HasArtwork}"/>
        <Panel IsVisible="{Binding Title.HasNoArtwork}">
          <Image Source="{Binding Title.Name, Converter={x:Static views:SkinImageConverter.Instance},
                                  ConverterParameter='media_item_background.jpg'}"
                 Stretch="UniformToFill" Margin="5" Opacity="0.7"/>
          <TextBlock Text="{Binding Title.Name}" Foreground="{DynamicResource TextBrush}"
                     FontSize="{DynamicResource SmallFontSize}" TextWrapping="Wrap"
                     TextTrimming="CharacterEllipsis" MaxLines="4" TextAlignment="Center"
                     Margin="20,80,15,15" VerticalAlignment="Center"/>
        </Panel>
        <Border Background="#80000000" Height="70" VerticalAlignment="Bottom" Margin="4"
                IsVisible="{Binding Title.HasArtwork}">
          <TextBlock Text="{Binding Title.Name}" Foreground="{DynamicResource TextBrush}"
                     FontSize="{DynamicResource SmallFontSize}" TextTrimming="CharacterEllipsis"
                     TextAlignment="Center" VerticalAlignment="Center" Margin="8,0"/>
        </Border>
        <Image Source="{Binding Title.Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='watched.png'}"
               Height="60" Stretch="Uniform" Opacity="0.9"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
               IsVisible="{Binding Title.IsWatched}"/>
        <Image Source="{Binding Title.Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='partlywatched.png'}"
               Height="60" Stretch="Uniform" Opacity="0.9"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
               IsVisible="{Binding Title.IsPartlyWatched}"/>
      </Panel>
    </Panel>
  </DataTemplate>

  <!--
    A title's row in the shelf: the name, and what the library knows about it - length, year, where you left
    off - in the right column, greyed the way Nereus greys everything that is not the headline.
  -->
  <DataTemplate x:Key="TitleRowTemplate" x:DataType="vm:TitleViewModel">
    <Grid ColumnDefinitions="Auto,5*,1.4*" ColumnSpacing="20" MinWidth="700" Margin="0,8">
      <TextBlock Text="{Binding SeenMark}" MinWidth="34" Opacity="0.55"
                 Foreground="{DynamicResource TextBrush}"/>
      <TextBlock Grid.Column="1" Text="{Binding Line}" TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource TextBrush}"/>
      <TextBlock Grid.Column="2" Text="{Binding Detail}" HorizontalAlignment="Right" Opacity="0.65"
                 TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource TextBrush}"/>
    </Grid>
  </DataTemplate>

  <!--
    The media tiles, as Nereus spelled its grid: the skin's own frame picture under everything, the library's
    picture over it, and - when the library has no picture - the skin's ground with its type mark and the name
    standing in for the art, which is the reference's fallback word for word (media_item_background.jpg under,
    video.png at the corner, the title in the middle). A finished title wears the skin's watched corner, a
    started one the partly flag, and the screen asks permission for both from the viewer's own grid setting -
    the panel behind them carries that answer, so the rows can stay silent about it. The sizes are the
    reference's MediaConsts: poster 162.5x250, banner 417x95, thumbnail 275x168.
  -->
  <DataTemplate x:Key="MediaTilePosterTemplate" x:DataType="vm:TitleViewModel">
    <Panel Width="163" Height="250" Margin="8,8,8,14">
      <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                              ConverterParameter='Poster_small.png'}"
             Stretch="Fill"/>
      <Image Source="{Binding Artwork, Converter={x:Static views:ArtworkConverter.Instance},
                              ConverterParameter='tile'}"
             Stretch="UniformToFill" Margin="3"
             IsVisible="{Binding HasArtwork}"/>
      <!-- no picture: the skin's ground, its mark, the name -->
      <Panel IsVisible="{Binding HasNoArtwork}">
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='media_item_background.jpg'}"
               Stretch="UniformToFill" Margin="3" Opacity="0.7"/>
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='video.png'}"
               Stretch="Uniform" Width="70" Height="70" Opacity="0.6"
               HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"
                   FontSize="{DynamicResource SmallFontSize}" TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis" MaxLines="4" TextAlignment="Center"
                   Margin="15,50,10,10" VerticalAlignment="Center"/>
      </Panel>
      <!-- the name under a picture, on the skin's quiet bar -->
      <Border Background="#80000000" Height="45" VerticalAlignment="Bottom" Margin="3"
              IsVisible="{Binding HasArtwork}">
        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"
                   FontSize="{DynamicResource SmallFontSize}" TextTrimming="CharacterEllipsis"
                   TextAlignment="Center" VerticalAlignment="Center" Margin="5,0"/>
      </Border>
      <!-- watched corners, if the grid's setting allows corners at all -->
      <Panel IsVisible="{Binding WatchFlagsShown}">
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='watched.png'}"
               Height="33" Stretch="Uniform" Opacity="0.9"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
               IsVisible="{Binding IsWatched}"/>
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='partlywatched.png'}"
               Height="33" Stretch="Uniform" Opacity="0.9"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
               IsVisible="{Binding IsPartlyWatched}"/>
      </Panel>
      <!-- a title without a file behind it: the reference's corner flag with its offline mark -->
      <Panel IsVisible="{Binding IsOffline}">
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='flag.png'}"
               Height="90" Stretch="Uniform"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"/>
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='offline.png'}"
               Height="35" Stretch="Uniform"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,7,0"/>
      </Panel>
    </Panel>
  </DataTemplate>

  <DataTemplate x:Key="MediaTileBannerTemplate" x:DataType="vm:TitleViewModel">
    <Panel Width="417" Height="95" Margin="8,6,8,10">
      <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                              ConverterParameter='banner_small.png'}"
             Stretch="Fill"/>
      <Image Source="{Binding Artwork, Converter={x:Static views:ArtworkConverter.Instance},
                              ConverterParameter='tile'}"
             Stretch="UniformToFill" Margin="3"
             IsVisible="{Binding HasArtwork}"/>
      <Panel IsVisible="{Binding HasNoArtwork}">
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='media_item_background.jpg'}"
               Stretch="UniformToFill" Margin="3" Opacity="0.7"/>
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='video.png'}"
               Stretch="Uniform" Width="60" Height="60" Opacity="0.6"
               HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"
                   FontSize="{DynamicResource SmallFontSize}" TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis" MaxLines="2"
                   Margin="60,10,10,10" VerticalAlignment="Center"/>
      </Panel>
      <Panel IsVisible="{Binding WatchFlagsShown}">
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='watched.png'}"
               Height="28" Stretch="Uniform" Opacity="0.9"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
               IsVisible="{Binding IsWatched}"/>
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='partlywatched.png'}"
               Height="28" Stretch="Uniform" Opacity="0.9"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
               IsVisible="{Binding IsPartlyWatched}"/>
      </Panel>
      <!-- the corner flag of a title without a file, shrunk to the banner's height -->
      <Panel IsVisible="{Binding IsOffline}">
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='flag.png'}"
               Height="45" Stretch="Uniform"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"/>
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='offline.png'}"
               Height="22" Stretch="Uniform"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"/>
      </Panel>
    </Panel>
  </DataTemplate>

  <DataTemplate x:Key="MediaTileThumbnailTemplate" x:DataType="vm:TitleViewModel">
    <Panel Width="275" Height="168" Margin="8,6,8,10">
      <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                              ConverterParameter='thumbnail_small.png'}"
             Stretch="Fill"/>
      <Image Source="{Binding Artwork, Converter={x:Static views:ArtworkConverter.Instance},
                              ConverterParameter='tile'}"
             Stretch="UniformToFill" Margin="3"
             IsVisible="{Binding HasArtwork}"/>
      <Panel IsVisible="{Binding HasNoArtwork}">
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='media_item_background.jpg'}"
               Stretch="UniformToFill" Margin="3" Opacity="0.7"/>
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='video.png'}"
               Stretch="Uniform" Width="60" Height="60" Opacity="0.6"
               HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"
                   FontSize="{DynamicResource SmallFontSize}" TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis" MaxLines="3" TextAlignment="Center"
                   Margin="5,40,5,8" VerticalAlignment="Stretch"/>
      </Panel>
      <Border Background="#80000000" Height="45" VerticalAlignment="Bottom" Margin="3"
              IsVisible="{Binding HasArtwork}">
        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"
                   FontSize="{DynamicResource SmallFontSize}" TextTrimming="CharacterEllipsis"
                   TextAlignment="Center" VerticalAlignment="Center" Margin="5,0"/>
      </Border>
      <Panel IsVisible="{Binding WatchFlagsShown}">
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='watched.png'}"
               Height="28" Stretch="Uniform" Opacity="0.9"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
               IsVisible="{Binding IsWatched}"/>
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='partlywatched.png'}"
               Height="28" Stretch="Uniform" Opacity="0.9"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
               IsVisible="{Binding IsPartlyWatched}"/>
      </Panel>
      <!-- the corner flag of a title without a file, at the thumbnail's height -->
      <Panel IsVisible="{Binding IsOffline}">
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='flag.png'}"
               Height="60" Stretch="Uniform"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"/>
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='offline.png'}"
               Height="28" Stretch="Uniform"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0"/>
      </Panel>
    </Panel>
  </DataTemplate>

  <!--
    The cover, as Nereus hung it in its third view: the reference's CoverView item is the poster frame
    Poster_large.png, the title's poster in a 260x410 field (MediaConsts POSTER_COVER_WIDTH/HEIGHT) and the
    name standing under the picture rather than on a bar over it - a cover is read like a shelf of DVDs, where
    the box art and the title beneath are two things. A cover without a picture wears the skin's video mark in
    the frame, and the corners are the cover's own setting's answer, scaled to the cover's size.
  -->
  <DataTemplate x:Key="MediaTileCoverTemplate" x:DataType="vm:TitleViewModel">
    <StackPanel Width="276" Margin="8,8,8,10">
      <Panel Width="260" Height="410">
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='Poster_large.png'}"
               Stretch="Fill"/>
        <Image Source="{Binding Artwork, Converter={x:Static views:ArtworkConverter.Instance},
                                ConverterParameter='tile'}"
               Stretch="UniformToFill" Margin="7"
               IsVisible="{Binding HasArtwork}"/>
        <!-- no picture: the skin's mark in the frame, which is all the reference drew here -->
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='video.png'}"
               Stretch="Uniform" Width="110" Height="110" Opacity="0.6"
               IsVisible="{Binding HasNoArtwork}"/>
        <!-- watched corners, if the cover's setting allows corners at all -->
        <Panel IsVisible="{Binding WatchFlagsShown}">
          <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                  ConverterParameter='watched.png'}"
                 Height="53" Stretch="Uniform" Opacity="0.9"
                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0"
                 IsVisible="{Binding IsWatched}"/>
          <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                  ConverterParameter='partlywatched.png'}"
                 Height="53" Stretch="Uniform" Opacity="0.9"
                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0"
                 IsVisible="{Binding IsPartlyWatched}"/>
        </Panel>
        <!-- a title without a file behind it: the reference's corner flag with its offline mark -->
        <Panel IsVisible="{Binding IsOffline}">
          <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                  ConverterParameter='flag.png'}"
                 Height="144" Stretch="Uniform"
                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0"/>
          <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                  ConverterParameter='offline.png'}"
                 Height="56" Stretch="Uniform"
                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,11,11,0"/>
        </Panel>
      </Panel>
      <!-- the name under the cover, on the ground the reference left it: no bar, just the words -->
      <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"
                 FontSize="{DynamicResource SmallFontSize}" FontWeight="SemiBold"
                 TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2"
                 TextAlignment="Center" Margin="0,6,0,0"/>
    </StackPanel>
  </DataTemplate>

  <!--
    The playback screen's bar, which is where both of this skin's currently-playing screens put the reading of
    what plays: the words over a flat dark ground at the bottom of the picture, the position under them, and the
    line that says how far the film has got filled with the accent. The line is the reference's OSDProgressBarStyle
    sentence for sentence - a quiet track with ProgressBarFillColor in it, which is this skin's AccentBrush - and
    the three things in this order (what plays, how far, what state) are the order the master screen's footer drew
    them in, hidden altogether while nothing played.

    The bar reads the playback and does not drive it. A skin's markup is read off disk with nothing behind it to
    catch a press, so the keys a viewer uses stay the screen's own row above; a control that looks pressable and
    answers nothing is the one thing a television must never show.
  -->
  <DataTemplate x:Key="NowPlayingOverlayTemplate" x:DataType="vm:NowPlayingViewModel">
    <Border Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,2,0,0"
            Padding="22,10,22,12" Margin="0,14,0,0"
            IsVisible="{Binding HasMedia}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Title}"
                     FontSize="{DynamicResource SmallFontSize}"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource TextBrush}"/>
          <StackPanel Orientation="Horizontal" Spacing="14">
            <TextBlock Text="{Binding PositionText}"
                       FontSize="{DynamicResource SmallerFontSize}"
                       Foreground="{DynamicResource AccentBrush}"
                       VerticalAlignment="Center"/>
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}"
                         Width="520" Height="8" VerticalAlignment="Center"
                         Foreground="{DynamicResource AccentBrush}"
                         Background="{DynamicResource OutlineBrush}"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
          <!--
            What the player is doing, in this skin's own picture of it. These are the transport pictures the
            reference drew - themes/default/styles/Buttons.xaml hangs PlayerControl\PLAY.NOFOCUS.PNG and its
            PAUSE sibling at height 80 - worn here at a bar's height rather than a button's, because a bar has
            nobody behind it to catch a press and so says the state instead of asking for one. Only one of the
            two is ever up: playing wears PLAY, a pause wears PAUSE, and a film that stopped, finished or failed
            wears neither, which leaves the word beside it to say what the picture cannot.

            The bound word only gives the converter something to answer with; the name the skin spells is the
            parameter, exactly as the home tiles spell their IsPlaying mark. A skin without these pictures draws
            an empty space rather than a hole.
          -->
          <Image Source="{Binding Title, Converter={x:Static views:SkinImageConverter.Instance},
                                  ConverterParameter='PlayerControl/PLAY.NOFOCUS'}"
                 Height="34" Stretch="Uniform" VerticalAlignment="Center"
                 IsVisible="{Binding IsPlaying, Mode=OneWay}"/>
          <Image Source="{Binding Title, Converter={x:Static views:SkinImageConverter.Instance},
                                  ConverterParameter='PlayerControl/PAUSE.NOFOCUS'}"
                 Height="34" Stretch="Uniform" VerticalAlignment="Center"
                 IsVisible="{Binding IsPaused, Mode=OneWay}"/>
          <TextBlock Text="{Binding StateText}"
                     FontSize="{DynamicResource SmallerFontSize}"
                     Foreground="{DynamicResource MutedTextBrush}"
                     VerticalAlignment="Center"/>
          <!-- The loudness, in the words the screen itself uses for it. Said as two blocks rather than one
               formatted line because a skin's file is read at run time and nothing here compiles a format string
               to check it. -->
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="Volume"
                       FontSize="{DynamicResource SmallerFontSize}"
                       Foreground="{DynamicResource MutedTextBrush}"/>
            <TextBlock Text="{Binding Volume}"
                       FontSize="{DynamicResource SmallerFontSize}"
                       Foreground="{DynamicResource TextBrush}"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
  </DataTemplate>

  <!--
    The dialog frame: the slab a dialog stands on. The reference's dialog master (master_dialog_bare) laid a
    dialog's contents on a panel whose glow was white, focus-coloured or absent and whose corners were round
    only while the rounding switch said so - three dials on the skin settings screen, written into the palette
    by FrontendTheme.TintFromSkinSettings as DialogBorderBrush and DialogPanelBrush. This face dresses its
    dialogs itself though: DialogGroundBrush for the panel and DialogFrameCornerRadius for its corners, so that
    every dialog is the same dark grey at the same rounding and the tinted slab is left to the volume bar that
    still reads it. The frame frames whatever a screen opens, which is no view model's property bag, so this is
    the one template in the file that names no view model: it is pinned to Object, and its single pathless
    binding only passes the dialog's own body through.

    What the dialog stands IN FRONT of is no frame's business either: the shell throws the screen behind the
    question out of focus for the length of it, off the DialogBackdropBlur this skin's metrics carry, and washes
    it dark with DialogWashBrush. A dialog over a wall of readable detail asks the viewer to read two things at
    once, and dimming alone does not settle that - a dimmed cover is still a readable cover. See
    ShellWindow.BlurScreenBehind.

    What the frames glow with is written as a BoxShadow on each of them - spelled out twice, because a shadow
    keeps its colour inside its own value and no DynamicResource reaches in there: white falling off outward from
    the panel's rounded edge, nothing of it spread, since spread pads a shadow out to the panel's shape before it
    falls off and that is a mat rather than a glow. Both frames wear the same numbers, so a dialog is recognised
    by its halo whether or not it brings a heading. Nothing here clips, which a shadow needs: it is drawn outside
    the bounds of the thing that carries it.
  -->
  <DataTemplate x:Key="DialogFrameTemplate" x:DataType="x:Object">
    <Border Background="{DynamicResource DialogGroundBrush}"
            BorderBrush="{DynamicResource DialogBorderBrush}"
            CornerRadius="{DynamicResource DialogFrameCornerRadius}"
            BorderThickness="2"
            BoxShadow="0 0 120 0 #00FFFFFF, 0 0 26 0 #FFFFFFFF"
            Padding="30,24"
            MaxWidth="760"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
      <ContentPresenter Content="{Binding}"/>
    </Border>
  </DataTemplate>

  <!--
    The dialog the reference actually drew (master_dialog_bare), for the screens that come with a heading of
    their own - today the menu editor. The panel is the same dark grey as the frame above and rounded the same
    way: opaque, because a dialog asks its question over a picture that is still moving about behind it and
    whatever the home shows through the letters is one thing less the viewer can read. Its heading stands
    centred at the top in white at the dialog title's size, on the same ground as the contents and with nothing
    drawn between them.

    There is no line around it. Not the reference's rings and not the glass edge the tiles wear: the only thing
    between the panel and the blurred home behind is the glow described above, white falling off outward from the
    panel's rounded edge with nothing painted for it - the same trick the rail and the tiles of this skin use.
    Nothing here clips, which a shadow needs: it is drawn outside the bounds of the thing that carries it.
    Standing over a home that is out of focus and washed dark at once, the halo is the brightest thing on the
    television, which is what makes the panel read as lit rather than as pasted on.

    The heading is read from the dialog's own body ({Binding Heading}), because the reference spelled it the
    same way: the screen named its title and the master drew it. A body with no such property is not this
    frame's business; DialogFrameTemplate above stays the frame for dialogs that bring no heading.
  -->
  <DataTemplate x:Key="DialogHeadedFrameTemplate" x:DataType="x:Object" x:CompileBindings="False">
    <Panel Margin="50" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="900">
      <Border Background="{DynamicResource DialogGroundBrush}"
              CornerRadius="{DynamicResource DialogFrameCornerRadius}"
              BoxShadow="0 0 120 0 #00FFFFFF, 0 0 26 0 #FFFFFFFF">
        <DockPanel>
          <!-- The head is the same grey as the rest of the panel and carries no line under it: one surface with
               a word at its top, not a band laid over a body. The reference drew its band in the medium accent
               with six pixels of the light accent beneath, which is a thing a dialog seen over a lit master
               screen needs and a dialog standing on a blurred home does not. -->
          <TextBlock DockPanel.Dock="Top"
                     Text="{Binding $parent[ContentControl].DataContext.Heading}"
                     FontSize="{DynamicResource DialogTitleFontSize}"
                     FontWeight="Bold"
                     Foreground="{DynamicResource TextBrush}"
                     Margin="10,5"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
          <ContentPresenter Content="{Binding}" Margin="10"/>
        </DockPanel>
      </Border>
    </Panel>
  </DataTemplate>

</ResourceDictionary>
