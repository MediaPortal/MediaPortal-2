<Project>

  <!--
    Twin of Source\Directory.Build.targets. MSBuild stops walking upwards at the first
    Directory.Build.* file it finds, so projects outside Source\ (Incubator\, Tests\, Tools\,
    Setup\, Resources\, Graveyard\) never see the one inside Source\ and need their own copy.
    Same rule as the Directory.Build.props pair: the two files must be kept in sync by hand.

    Summary: clear the two Visual-Studio-only rule set names the project files still carry, so
    severity comes from MediaPortal\.editorconfig on every host, and force the .NET analyzers on
    for net48 legs where the SDK would leave them off.
  -->
  <PropertyGroup Condition="'$(CodeAnalysisRuleSet)' == 'AllRules.ruleset' OR '$(CodeAnalysisRuleSet)' == 'MinimumRecommendedRules.ruleset'">
    <CodeAnalysisRuleSet></CodeAnalysisRuleSet>
    <CodeAnalysisRuleSetDirectories></CodeAnalysisRuleSetDirectories>
  </PropertyGroup>

  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

  <!--
    MP2IsSolutionBuild - see Source\Directory.Build.targets for the full reasoning. In short: a
    solution is being built only if SolutionName is set to something other than the SDK's
    "*Undefined*" sentinel, and the Bin\<SolutionName>\ deployment steps in build.targets use this
    property as their condition.
  -->
  <PropertyGroup>
    <MP2IsSolutionBuild Condition="'$(SolutionName)' != '' AND '$(SolutionName)' != '*Undefined*'">true</MP2IsSolutionBuild>
  </PropertyGroup>

</Project>
