<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>MediaPortal.Server</RootNamespace>
    <AssemblyName>MP2-Server</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationIcon>MP2.ico</ApplicationIcon>
    <CodeAnalysisRuleSet>AllRules.ruleset</CodeAnalysisRuleSet>
    <StartupObject>MediaPortal.Server.ApplicationLauncher</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <!--
    x64 only (docs/multiplatform/ROADMAP.md). Three 32-bit leftovers were removed here:

    * The two x86 configuration groups. MP2-Server.sln and MP2-Setup.sln both map their x86 solution
      platform to this project's "Any CPU" configuration, so the groups were unreachable from any
      solution build in the tree; leaving them meant a hand-run "-p:Platform=x86" still produced an
      image declaring itself 32-bit-only.
    * <Prefer32Bit>true</Prefer32Bit> from the AnyCPU groups. That was the switch that actually made
      MP2 32-bit: on .NET Framework, AnyCPU + Prefer32Bit means "run 32-bit on a 64-bit OS", so the
      shipped server was a 32-bit process while nothing in the tree called itself x86. On .NET Core
      and later the flag is ignored and bitness comes from the apphost RID, so the retarget alone
      already yields an x64 process - scripts/ci/architecture.ps1 reads the PE header of the built
      apphosts to prove it. The declaration is gone because a flag that is silently ignored is a flag
      somebody will trust again one day.
    * <LargeAddressAware>, the 4 GB address-space workaround that only means anything for a 32-bit
      image.
  -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>..\..\..\Bin\MP2-Server\bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <NoWarn>CS3001,CS3003,CS3008</NoWarn>
    <DebugType>full</DebugType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <ErrorReport>prompt</ErrorReport>
    <CodeAnalysisRuleSet>AllRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <OutputPath>..\..\..\Bin\MP2-Server\bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <NoWarn>CS3001,CS3003,CS3008</NoWarn>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <ErrorReport>prompt</ErrorReport>
    <CodeAnalysisRuleSet>AllRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup>
    <AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <PropertyGroup>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="WindowsServiceInstaller.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\Core\MediaPortal.Common\VersionInfo\VersionInfo.cs" Link="Properties\VersionInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\MediaPortal.Backend\MediaPortal.Backend.csproj" />
    <ProjectReference Include="..\..\Core\MediaPortal.Common\MediaPortal.Common.csproj" />
    <ProjectReference Include="..\..\Core\MediaPortal.Common.Windows\MediaPortal.Common.Windows.csproj" />
    <ProjectReference Include="..\..\Core\MediaPortal.Server.Api\MediaPortal.Server.Api.csproj" />
    <ProjectReference Include="..\..\Core\MediaPortal.Utilities\MediaPortal.Utilities.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommandLineParser">
      <Version>2.9.1</Version>
    </PackageReference>
  </ItemGroup>
  <Import Project="build.targets" />
</Project>