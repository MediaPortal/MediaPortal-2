<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MediaPortal.Frontend.ViewModels"
        xmlns:api="using:MediaPortal.Frontend.Api"
        xmlns:theming="clr-namespace:MediaPortal.Frontend.Theming"
        x:Class="MediaPortal.Frontend.Views.ViewerPickerView"
        x:DataType="vm:ViewerPickerViewModel"
        Name="viewerPicker"
        Background="Transparent"
        >

  <!--
    Who is watching. The reference opened the screen the same way: a list of names, a press that takes
    one, and an escape for the room that wants nothing of names. The list is the whole screen - there is
    nothing to edit here - so the presses under it carry every answer the household can give: this is me,
    nobody in particular, or read the list again when the server has just changed it.
  -->

  <DockPanel Margin="48,14">

    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,8">
      <TextBlock Text="{Binding Heading}"
                 FontSize="24"
                 FontWeight="SemiBold" />
      <TextBlock Text="{Binding Subtitle}"
                 FontSize="14"
                 Opacity="0.7"
                 TextWrapping="Wrap"
                 MaxWidth="1500"
                 HorizontalAlignment="Left" />
    </StackPanel>

    <TextBlock DockPanel.Dock="Bottom"
               Name="statusLine"
               Text="{Binding Status}"
               FontSize="14"
               Opacity="0.85"
               Margin="0,8,0,0"
               TextWrapping="Wrap" />

    <DockPanel>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="14" Margin="0,10,0,0">
        <Button Name="pickButton"
                Content="This is me"
                Command="{Binding PickSelectedCommand}"
                FontSize="16"
                Focusable="True"
                Padding="18,8" />
        <Button Name="ownButton"
                Content="Watch on my own"
                Command="{Binding WatchOnOwnCommand}"
                FontSize="16"
                Focusable="True"
                Padding="18,8" />
        <Button Name="reloadButton"
                Content="Read the list again"
                Command="{Binding LoadCommand}"
                FontSize="16"
                Focusable="True"
                Padding="18,8" />
      </StackPanel>

      <ListBox Name="peopleList" theming:SkinTemplates.TileTemplate="LabelRowTemplate"
               Focusable="True"
               ItemsSource="{Binding People}"
               SelectedItem="{Binding Selected, Mode=TwoWay}"
               FontSize="18">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="api:UserInfo">
            <TextBlock Text="{Binding Label}"
                       FontSize="18"
                       Margin="2,6" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </DockPanel>
</UserControl>
