<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:MediaPortal.Frontend.Views"
             x:Class="MediaPortal.Frontend.App"
             RequestedThemeVariant="Dark">

  <!--
    Dark, because this runs on a television in a darkened room; the Fluent theme is the one Avalonia ships
    and styles, and it is the same on every platform, which is the point of replacing the MP2 skin engine
    rather than emulating it.
  -->
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

  <!--
    One converter for the whole application, because the memory it holds is the decoded pictures of the library
    and a second window of the same library should draw the same posters out of the same memory rather than
    decode them again.
  -->
  <Application.Resources>
    <views:ArtworkConverter x:Key="artwork" />
  </Application.Resources>

</Application>
