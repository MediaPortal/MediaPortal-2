<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>MP2-Client</AssemblyName>
    <ApplicationIcon>MP2.ico</ApplicationIcon>
    <StartupObject>MediaPortal.Client.ApplicationLauncher</StartupObject>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <LargeAddressAware>true</LargeAddressAware>
    <Platforms>AnyCPU;x64</Platforms>
    <!--
      Was win7-x86;win7-x64. .NET 10 no longer knows the win7-* RIDs (NETSDK1083), and the port
      is x64-only, so a single modern RID is both the fix and the intent.
    -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Prefer32Bit>true</Prefer32Bit>
    <OutputPath>..\..\..\Bin\MP2-Client\bin\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <OutputPath>bin\x64\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <Prefer32Bit>true</Prefer32Bit>
    <OutputPath>..\..\..\Bin\MP2-Client\bin\Release\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <OutputPath>bin\x64\Release\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Core\MediaPortal.Common\VersionInfo\VersionInfo.cs">
      <Link>Properties\VersionInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\MediaPortal.Common\MediaPortal.Common.csproj" />
    <ProjectReference Include="..\..\Core\MediaPortal.Common.Windows\MediaPortal.Common.Windows.csproj" />
    <ProjectReference Include="..\..\Core\MediaPortal.UI\MediaPortal.UI.csproj" />
    <ProjectReference Include="..\..\Core\MediaPortal.Utilities\MediaPortal.Utilities.csproj" />
    <!-- The client launcher shows SplashScreen and calls SafeActivate, both WinForms. -->
    <ProjectReference Include="..\..\Core\MediaPortal.Utilities.Windows\MediaPortal.Utilities.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="MP2.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommandLineParser">
      <Version>2.9.1</Version>
    </PackageReference>
  </ItemGroup>
  <Import Project="build.targets" />
</Project>