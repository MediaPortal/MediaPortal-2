<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MediaPortal.Frontend.Views.VirtualKeyboardView"
             Name="keyboardScreen">

  <!--
    The on-screen keyboard, shaped by the reference: the dialog chrome (a bordered slab over the dialog's own
    background, Nereus' VirtualKeyboardControlStyle), the text being edited standing above the keys like its
    VisibleText label, the modifier and clipboard column on the left like its ControlArea, and the keyboard
    itself sitting at the bottom of the screen with the reference's own margins. The key rows are built in
    code from the ported layout - four grids, shown one at a time by the same rule the reference's visibility
    expressions use.
  -->

  <UserControl.Styles>
    <!--
      The keys of this keyboard are the program's own plates, not the toolkit's: with a remote there is no cursor
      to follow, so the key the caret stands on has to light up by itself, and the plate has to say so the way the
      search field does (Border.search-field, MediaBrowserView.axaml:560-569) - white glass of differing strength,
      a ring of whole white three lines thick, and a quiet light standing round it.  EVERY strength here is white
      over grey: the skin's own panel is NereusColorDark_Turquoise #FF244043 (colors.xaml:21) and its focus ground
      #46658BAA is blue, and this face is grey, not turquoise - so the plate stands on the dialog's neutral ground
      #FF1B1B1B (DialogGroundBrush, FrontendTheme.cs:284) and the keys are white glass over it.  The dress is
      written on the plate INSIDE the template too, because the theme paints that one and would outbid a colour
      written on the button alone, and the dotted rectangle of the theme is off for the same reason it is off on
      the row of glass: the ring below is the answer.
    -->
    <Style Selector="Button.keyboard-key, ToggleButton.keyboard-key">
      <Setter Property="Background" Value="#2BFFFFFF"/>
      <Setter Property="BorderBrush" Value="#00FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="MinHeight" Value="60"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.keyboard-key /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{TemplateBinding Background}"/>
      <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}"/>
      <Setter Property="BorderThickness" Value="{TemplateBinding BorderThickness}"/>
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}"/>
    </Style>
    <Style Selector="ToggleButton.keyboard-key /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{TemplateBinding Background}"/>
      <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}"/>
      <Setter Property="BorderThickness" Value="{TemplateBinding BorderThickness}"/>
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}"/>
    </Style>
    <!--
      STOOD ON: the ring belongs to the caret alone, so that a sticky modifier (which wears the lighter ground
      below, without a ring) can never be mistaken for the key a viewer is about to press.  NO light stands round
      the stood-on key (the ring of glass and the row of plates paint a "0 0 22 4" glow): the glow is the one
      thing a plate paints OUTSIDE its own box, and on a keyboard whose keys stand six points apart it spills
      over the neighbours' corners and reads as a square haze hanging over the rounded ring.  Here the ring and
      the lighter ground are the whole answer, so nothing is painted past the plate.
    -->
    <Style Selector="Button.keyboard-key:focus, ToggleButton.keyboard-key:focus">
      <Setter Property="Background" Value="#4DFFFFFF"/>
      <Setter Property="BorderBrush" Value="#FFFFFFFF"/>
      <Setter Property="BorderThickness" Value="3"/>
    </Style>
    <Style Selector="Window:not(.pointer-resting) Button.keyboard-key:pointerover">
      <Setter Property="Background" Value="#4DFFFFFF"/>
      <Setter Property="BorderBrush" Value="#FFFFFFFF"/>
      <Setter Property="BorderThickness" Value="3"/>
    </Style>
    <Style Selector="Window:not(.pointer-resting) ToggleButton.keyboard-key:pointerover">
      <Setter Property="Background" Value="#4DFFFFFF"/>
      <Setter Property="BorderBrush" Value="#FFFFFFFF"/>
      <Setter Property="BorderThickness" Value="3"/>
    </Style>
    <!-- HELD DOWN: the same answer the glass row gives. -->
    <Style Selector="Button.keyboard-key:pressed, ToggleButton.keyboard-key:pressed">
      <Setter Property="Background" Value="{DynamicResource PanelPressedBrush}"/>
      <Setter Property="Opacity" Value="0.75"/>
    </Style>
    <!-- STICKY (Shift, Alt Gr, Caps Lock while they hold): the stood-on ground without the ring, so that a
         modifier that is on is readable beside one that is merely stood on. -->
    <Style Selector="ToggleButton.keyboard-key:checked">
      <Setter Property="Background" Value="#3DFFFFFF"/>
    </Style>
    <!--
      The line the edit stands on: the toolkit paints this box as a light input field, which is the one thing
      that cannot sit on our dark plate. So the box becomes a quiet plate of the house - a trace of ground, a
      hairline of the chip edge, the text and the caret in the skin's own white, as on the search box
      (MediaBrowserView.axaml:669) - and the box keeps the caret and the selection, because that is where the
      edit really lives.
    -->
    <Style Selector="TextBox.keyboard-edit /template/ Border">
      <Setter Property="Background" Value="#14FFFFFF"/>
      <Setter Property="BorderBrush" Value="#33FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
  </UserControl.Styles>

  <Border Name="slab"
          Background="{DynamicResource DialogGroundBrush}"
          BorderBrush="{DynamicResource OutlineBrush}"
          BorderThickness="5"
          CornerRadius="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Bottom"
          Margin="60,80,60,50">
    <StackPanel Name="body" Spacing="10" Margin="14">

      <TextBox Name="editText"
               Classes="keyboard-edit"
               IsEnabled="False"
               IsTabStop="False"
               TextAlignment="Center"
               Foreground="{DynamicResource TextBrush}"
               CaretBrush="{DynamicResource TextBrush}"
               SelectionBrush="#4DFFFFFF"
               SelectionForegroundBrush="{DynamicResource TextBrush}"
               FontSize="28"
               MinHeight="58"
               Padding="12,8"
               BorderThickness="0"
               Background="Transparent"/>

      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

        <!-- The reference's ControlArea: its three sticky modifiers, then Copy and Paste. -->
        <StackPanel Grid.Column="0" Spacing="6" MinWidth="150">
          <ToggleButton Name="altGrButton"
                        Classes="keyboard-key"
                        Content="Alt Gr"
                        HorizontalContentAlignment="Center"
                        FontSize="20"
                        Padding="8,10"/>
          <ToggleButton Name="shiftButton"
                        Classes="keyboard-key"
                        Content="Shift"
                        HorizontalContentAlignment="Center"
                        FontSize="20"
                        Padding="8,10"/>
          <ToggleButton Name="capsButton"
                        Classes="keyboard-key"
                        Content="Caps Lock"
                        HorizontalContentAlignment="Center"
                        FontSize="20"
                        Padding="8,10"/>
          <Button Name="copyButton"
                  Classes="keyboard-key"
                  Content="Copy"
                  FontSize="20"
                  Padding="8,10"/>
          <Button Name="pasteButton"
                  Classes="keyboard-key"
                  Content="Paste"
                  FontSize="20"
                  Padding="8,10"/>
        </StackPanel>

        <!-- The four grids; exactly one is visible, per the reference's state expressions. -->
        <StackPanel Grid.Column="1" Name="gridArea" Spacing="6"/>

      </Grid>
    </StackPanel>
  </Border>
</UserControl>
