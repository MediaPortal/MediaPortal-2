<?xml version="1.0" encoding="utf-8"?>
<!--
  How WMC dresses the controls no screen draws itself - the part of the
  reference skin's Buttons.xaml and MediaStyles.xaml that applies to the
  controls this front end uses, written as XAML a person can edit.

  WMC's grip differs from Nereus' in its edges: WMC rounded everything a
  little (DialogBorderCornerRadius 2, player controls 4), and its selected
  row took the header's solid blue rather than a bright accent.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
    <Setter Property="CornerRadius" Value="2"/>
  </Style>
  <!-- Hovering dresses a control only while the pointer is about. The window wears "pointer-resting" while the
       front end has put an invisible pointer away, and a row that stayed lit afterwards would claim to be stood
       on by nobody; the arrangement is explained in the Nereus skin's styles file. -->
  <Style Selector="Window:not(.pointer-resting) Button:pointerover">
    <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}"/>
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="Background" Value="{DynamicResource PanelPressedBrush}"/>
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="Window:not(.pointer-resting) ListBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}"/>
  </Style>
  <Style Selector="ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource ScreenBackgroundBrush}"/>
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource OutlineBrush}"/>
  </Style>

  <!-- The strip a home tile's title stands on. WMC lays its names on a quiet full plate, the way the shared
       shelf always drew it; Nereus fades its names out of the tile's bottom edge instead. -->
  <Style Selector="Border.home-tile-caption">
    <Setter Property="MinHeight" Value="38"/>
    <Setter Property="Background" Value="#CC000000"/>
  </Style>

  <!--
    The settings wall. The wall's plates dress themselves - ground, underline, name - so the list behind them
    wears nothing at all: no panel, no outline, no platform selection rectangle, which under this skin would be
    a blue slab with a plate floating on it. The item's own template is replaced rather than merely restyled,
    because the platform paints its selection through the item template's content presenter and a theme value
    outranks a plain setter; under a presenter of this skin's own naming the plate keeps its own ground in every
    state, and the answer to being stood on is the plate's underline growing from three lines to six.
  -->
  <Style Selector="ListBox.settings-tile-wall">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
  </Style>
  <Style Selector="ListBox.settings-tile-wall ListBoxItem">
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="wmcTilePresenter"
                          BorderThickness="0"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
          <ContentPresenter.Styles>
            <Style Selector="ContentPresenter">
              <Style Selector="^:pointerover">
                <Setter Property="Background" Value="Transparent"/>
              </Style>
              <Style Selector="^:pressed">
                <Setter Property="Background" Value="Transparent"/>
              </Style>
              <Style Selector="^:selected">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
              </Style>
              <Style Selector="^:selected:pointerover">
                <Setter Property="Background" Value="Transparent"/>
              </Style>
            </Style>
          </ContentPresenter.Styles>
        </ContentPresenter>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.settings-tile-wall ListBoxItem:pointerover">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.settings-tile-wall ListBoxItem:selected">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="ListBox.settings-tile-wall ListBoxItem:selected Border.wmc-tile-face">
    <Setter Property="BorderThickness" Value="0,0,0,6"/>
  </Style>
  <Style Selector="ListBox.settings-tile-wall ListBoxItem:focus Border.wmc-tile-face">
    <Setter Property="BorderThickness" Value="0,0,0,6"/>
  </Style>
  <!-- The name and the icon come to full light under a viewer as well, which is what the reference's
       SettingsItemContainerStyle does to ItemLabel and IconImage (WMC's OtherControlsOverrides.xaml:637).
       WMC's underline is the loud half of the answer; this is the quiet half, and the plate itself does not
       move, scale or change colour. -->
  <Style Selector="ListBox.settings-tile-wall ListBoxItem:focus TextBlock.wmc-tile-name">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="ListBox.settings-tile-wall ListBoxItem:focus Image.wmc-tile-icon">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="Window:not(.pointer-resting) ListBox.settings-tile-wall ListBoxItem:pointerover TextBlock.wmc-tile-name">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="Window:not(.pointer-resting) ListBox.settings-tile-wall ListBoxItem:pointerover Image.wmc-tile-icon">
    <Setter Property="Opacity" Value="1"/>
  </Style>
</Styles>
