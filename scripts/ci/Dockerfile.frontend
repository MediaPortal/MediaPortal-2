# Linux verification for the new front end (Phase 2).
#
#   docker build -f scripts/ci/Dockerfile.frontend -t mp2-frontend .
#   docker run --rm -v "$HOME/.nuget/packages:/nuget-cache:ro" \
#       -e NUGET_FALLBACK_PACKAGES=/nuget-cache mp2-frontend
#
# This is not Dockerfile.cross. That file asks "does the server solution compile on Linux?"; this one
# asks the stronger question the front end exists to answer: does the UI code *run* there? The suite it
# executes builds the real `HomeWindow.axaml`, loads the real Fluent theme, and drives it through
# Avalonia's headless platform - so a green run here means Avalonia's XAML compiler, the theme, the
# data bindings, the D-pad handler and the API client all work on a host that has neither Windows nor a
# display. "No display" is the point: a TV front end has to survive a set-top box, a container and a
# device, and `UseHeadlessDrawing = true` is the same pure-managed rasterizer path those hosts use.
#
# Deliberately absent: `-p:EnableWindowsTargeting=true`.
#
# Dockerfile.cross needs it because MP2-Server.sln still contains `net10.0-windows` projects. Every
# project in MP2-Frontend.sln is `net10.0` - the front end, its test suite, and the API/Backend/Common/
# UPnP/Utilities closure the tests host to get real controllers - so passing the flag here would hide
# the exact regression that matters: the day a `-windows` project is referenced from this side, the
# build answers NETSDK1100 and says so, instead of quietly succeeding on a Linux SDK.
#
# Restore still needs the fallback package folder, for the same reason as every other gate on this
# tree: the MyGet feed in MediaPortal/NuGet.Config answers HTTP 500 (its line is removed below so the
# 500 does not fail the whole restore), and packages like MediaPortal.TagLib exist only in a cache that
# a machine which built the old tree still has.
#
# MP2_SERVER is read by Frontend.RenderProbe: set it to a server the container can reach and the rendered frame
# becomes the populated screen instead of the "no server" one. `test-frontend-linux.ps1 -ServeFromHost` points it
# at the Windows host through `host.docker.internal`, which was measured from inside this image answering
# `HTTP/1.1 200 OK` / `Server: Microsoft-HTTPAPI/2.0` on port 55555 (the alternative `172.17.0.1` does not connect
# on Docker Desktop). When MP2_SERVER is set the CMD *requires* the rendered status line to say "aspects on", so a
# screenshot cannot silently degrade into the offline picture; when it is unset the OK line says the frame is the
# offline screen, which is a real state and is labelled as one.
#
# Base tag is a build ARG so the probe can be replayed against another toolchain on purpose.
ARG SDK_TAG=10.0
FROM mcr.microsoft.com/dotnet/sdk:${SDK_TAG}

WORKDIR /src

# fontconfig and freetype are for the render probe, not for the tests. The native libSkiaSharp.so that
# Avalonia.Skia loads lists both as DT_NEEDED, and without them `Setup()` dies inside SkiaSharp.SKImageInfo
# with a TypeInitializationException - measured on the first container run of Frontend.RenderProbe. The test
# suite never notices, because its pure-managed headless rasterizer calls no native code at all; that is
# exactly the blind spot the probe exists to close, and it is why the probe has to run in this image too.
#
# libVLC is for the player tests. MediaPortal.Frontend.Player drives libVLC,
# which is found on the machine and never vendored or downloaded, so an image
# without it would report the sixteen decoder tests as skips and the run would
# quietly be about the seam's vocabulary only. The headless meta-package
# `vlc-nox` does not exist in noble - the first draft of this line named it and
# apt failed the build - so the engine comes from `libvlc5` and the plugins
# from `vlc-plugin-base`. The plugins land in the multiarch directory
# /usr/lib/x86_64-linux-gnu/vlc/plugins, NOT in /usr/lib/vlc/plugins, which is
# empty; that distinction decided one debugging run, so the check below refuses
# an image that has the library but no demuxers. Such an image is worse than no
# engine at all: libVLC initialises, plays nothing, and the tests fail as
# timeouts rather than as a missing engine.
# The CMD further fails if the tests skip anyway, so the packages cannot rot away unnoticed.
# The index cache is deleted in the same layer so it does not cost ~50 MB of image size.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libfontconfig1 \
      libfreetype6 \
      libvlc5 \
      vlc-plugin-base \
 && rm -rf /var/lib/apt/lists/* \
 && lib="$(find /usr/lib -name 'libvlc.so*' -print -quit)" \
 && test -n "$lib" \
 && plugins="$(dirname "$lib")/vlc/plugins" \
 && test -d "$plugins" \
 && test -n "$(ls "$plugins/demux" 2>/dev/null)" \
 && echo "libVLC engine $lib with plugins in $plugins"

COPY . .

RUN sed -i '/myget/Id' /src/MediaPortal/NuGet.Config \
 && dotnet --info | head -n 8 && uname -a

CMD bash -c '\
  echo "== running on: $(uname -srmi), dotnet $(dotnet --version)"; \
  mkdir -p /out; \
  dotnet build /src/MediaPortal/Source/MP2-Frontend.sln -c Debug --nologo -v m || exit 1; \
  out=$(dotnet test /src/MediaPortal/Tests/Tests.Frontend/Tests.Frontend.csproj -c Debug --nologo -v m --no-build 2>&1); rc=$?; \
  echo "$out"; \
  echo "$out" | grep -E "Passed!|Failed!|Total:|error" | tail -n 20; \
  total=$(echo "$out" | sed -n "s/.*Total: *\([0-9][0-9]*\).*/\1/p" | tail -n 1); \
  if [ "$rc" -ne 0 ]; then echo "TEST RUN FAILED ($rc)"; exit "$rc"; fi; \
  if [ "${total:-0}" -lt 1 ]; then echo "ZERO TESTS DISCOVERED - a green run here would mean nothing"; exit 1; fi; \
  skipped=$(echo "$out" | sed -n "s/.*Skipped: *\([0-9][0-9]*\).*/\1/p" | tail -n 1); \
  if [ "${skipped:-0}" -ne 0 ]; then echo "THE SUITE SKIPPED $skipped TESTS - this image installs libvlc5 and vlc-plugin-base, so the libVLC player tests have an engine and must run"; exit "$rc"; fi; \
  probe=/src/MediaPortal/Tests/Frontend.RenderProbe/bin/Debug/net10.0/Frontend.RenderProbe.dll; \
  out=$(dotnet $probe --out /out/home-linux.png 2>&1); rc=$?; echo "$out"; \
  if [ "$rc" -ne 0 ]; then echo "RENDER PROBE FAILED (home, $rc) - see its output above"; exit "$rc"; fi; \
  out2=$(dotnet $probe --screen nowplaying --out /out/nowplaying-linux.png 2>&1); rc2=$?; echo "$out2"; \
  if [ "$rc2" -ne 0 ]; then echo "RENDER PROBE FAILED (nowplaying, $rc2) - see its output above"; exit "$rc2"; fi; \
  out3=$(dotnet $probe --screen connect --out /out/connect-linux.png 2>&1); rc3=$?; echo "$out3"; \
  if [ "$rc3" -ne 0 ]; then echo "RENDER PROBE FAILED (connect, $rc3) - see its output above"; exit "$rc3"; fi; \
  out4=$(dotnet $probe --screen browser --out /out/browser-linux.png 2>&1); rc4=$?; echo "$out4"; \
  if [ "$rc4" -ne 0 ]; then echo "RENDER PROBE FAILED (browser, $rc4) - see its output above"; exit "$rc4"; fi; \
  out5=$(dotnet $probe --screen details --out /out/details-linux.png 2>&1); rc5=$?; echo "$out5"; \
  if [ "$rc5" -ne 0 ]; then echo "RENDER PROBE FAILED (details, $rc5) - see its output above"; exit "$rc5"; fi; \
  frame="offline (no MP2_SERVER given), so the home screen shows its own no-server state"; \
  if [ -n "$MP2_SERVER" ]; then \
    if echo "$out" | grep -q "populated from"; then frame="populated from $MP2_SERVER"; \
    else echo "THE SCREEN NEVER SHOWED THE SERVER AT $MP2_SERVER - the frame is an error screen, not a data screen"; exit 1; fi; \
  fi; \
  echo "FRONTEND LINUX OK: $total tests ran headless on $(uname -sm), $frame screenshots in /out/home-linux.png, /out/browser-linux.png, /out/details-linux.png, /out/nowplaying-linux.png and /out/connect-linux.png"'
