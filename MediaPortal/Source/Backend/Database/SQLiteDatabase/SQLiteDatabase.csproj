<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Portable since the server started running headless: the database provider is on the startup path
    of every platform, so a -windows target framework here means the server cannot open its own
    library anywhere else.

    What was still Windows about it, and what replaced it:
      - SQLiteSettings sized the page cache with GlobalMemoryStatusEx. Now GC.GetGCMemoryInfo(),
        which also tells the truth inside a container (the Win32 call reports the host's RAM).
      - LexicographicComparer implemented SQLite's NOCASE collation with kernel32's CompareStringEx.
        The native call stays on Windows, where existing databases were built with that ordering;
        elsewhere it delegates to NaturalStringComparer. The P/Invoke is annotated
        [SupportedOSPlatform("windows")], and CA1416 is an error in this project - so deleting the
        guard is a build failure rather than a runtime surprise.
      - The driver itself. System.Data.SQLite's managed assembly is .NET Standard but the native
        SQLite.Interop.dll it P/Invokes ships for win-x64 and win-x86 only, so opening a database off
        Windows threw DllNotFoundException (measured in the Linux container, see
        scripts/ci/test-server-run-linux.ps1). Microsoft.Data.Sqlite's e_sqlite3 covers every platform
        this tree targets. What that swap changed in behaviour - Guid storage, per-connection
        collations, no driver pool, PRAGMAs instead of keywords - is documented at each site in
        SQLiteDatabase.cs, with the measurement that forced it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>MediaPortal.Database.SQLite</RootNamespace>
    <AssemblyName>SQLiteDatabase</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CodeAnalysisRuleSet>AllRules.ruleset</CodeAnalysisRuleSet>
    <WarningsAsErrors>CA1416</WarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup>
    <!--required for assemblies from nuget packages to be copied to output folder, so our build.targets can copy them further -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>bin\Debug\</OutputPath>
    <!--
      NO_POOL used to be defined here, which compiled out MediaPortal's own ConnectionPool and let the
      driver pool connections instead. That is no longer possible: the new driver resets pooled
      connections when they are returned, and the reset removes registered collations - after one
      NOCASE override, the next consumer of a pooled handle got "no such collation sequence: NOCASE",
      i.e. not even SQLite's own. So Pooling=False in the connection string (see SQLiteDatabase) and
      MP2's pool, which hands back the connections it initialized, is live in every configuration.
    -->
    <DefineConstants>TRACE;DEBUG</DefineConstants>
    <DebugType>full</DebugType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <ErrorReport>prompt</ErrorReport>
    <CodeAnalysisRuleSet>AllRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <ErrorReport>prompt</ErrorReport>
    <CodeAnalysisRuleSet>AllRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\Core\MediaPortal.Common\VersionInfo\VersionInfo.cs" Link="Properties\VersionInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\MediaPortal.Backend\MediaPortal.Backend.csproj" />
    <ProjectReference Include="..\..\..\Core\MediaPortal.Common\MediaPortal.Common.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' != '.NETFramework'">
    <!--
      Microsoft.Data.Sqlite instead of System.Data.SQLite, because of one measured fact: the
      SQLite.Interop.dll that System.Data.SQLite P/Invokes ships for win-x64 and win-x86 only, so the
      provider could open a database on Windows and nowhere else (`test-server-run-linux.ps1` shows
      the DllNotFoundException). SQLitePCLRaw's e_sqlite3 covers win-x64, linux-x64/arm64, osx and
      android/ios, which is the whole target list.
      The swap is not free - three behaviours differ and are handled in SQLiteDatabase.cs, each one
      measured against a database the old provider wrote:
        - Guid parameters bind as TEXT, while the old provider's BinaryGUID=true stored 16-byte
          BLOBs. A Guid parameter therefore matches nothing in an existing database, silently. The
          provider binds Guid.ToByteArray() instead.
        - Collations are registered per connection and are not carried across connections. With the
          driver's own pool active, overriding the built-in NOCASE even leaves later pooled
          connections without any NOCASE at all, so Pooling=False and MP2's own ConnectionPool.
        - The connection string accepts only the driver's own keywords: journal_mode, page_size,
          synchronous and cache_size have to be PRAGMA statements, which is what the existing
          InitializationCommand mechanism is for.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>
  <Import Project="build.targets" />
</Project>
