<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windows-only companion to MediaPortal.Common.

    MediaPortal.Common has to compile without a -windows target for the Linux and Android
    server, but a few of its types are WinForms by nature (a Form DPI helper, a Control
    awaiter) and cannot be made portable - they are Win32, not Windows-specific incidental
    code. Those live here instead, so that Common's assembly does not pull in
    UseWindowsForms and therefore does not force a -windows target framework on everything
    that references it.

    Rule for this project: it may reference MediaPortal.Common, never the other way round.
    If you are about to add code here, first check whether it is genuinely Win32 or only
    written with a Win32 API by accident - most of the spine is the latter and should be
    replaced with a portable equivalent rather than moved here.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>MediaPortal.Common.Windows</AssemblyName>
    <RootNamespace>MediaPortal.Common</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <CodeAnalysisRuleSet>AllRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaPortal.Common\MediaPortal.Common.csproj" />
    <!--
      Explicit, not inherited: this assembly's compile-time references do not arrive through
      MediaPortal.Common. ImageUtilities is the reason - the transformer reuses its scaling
      arithmetic so that switching to IImageTransformer does not change stored image bytes.
    -->
    <ProjectReference Include="..\MediaPortal.Utilities.Windows\MediaPortal.Utilities.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Declare the platform instead of leaving it implied. As long as no assembly in a call chain
      declares one, CA1416 cannot judge a cross-assembly call at all and every caller looks
      platform-neutral - which is exactly how the two callers of TryEnableDPIAwareness stayed
      invisible for years. Declaring it means any call from portable (non -windows) code becomes a
      diagnostic at the call site, which is the point of having a satellite at all.

      This used to be conditioned on the target framework because the attribute type does not
      exist on .NET Framework; the net48 legs are gone, so the condition went with them.
    -->
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>