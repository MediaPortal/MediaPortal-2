<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:MediaPortal.Frontend.Views"
        xmlns:vm="using:MediaPortal.Frontend.ViewModels"
        xmlns:api="using:MediaPortal.Frontend.Api"
        xmlns:theming="clr-namespace:MediaPortal.Frontend.Theming"
        x:Class="MediaPortal.Frontend.Views.UsersSettingsView"
        x:DataType="vm:UsersSettingsViewModel"
        Name="usersSettings"
        Background="Transparent"
        >

  <!--
    Who may sign in on the server. The list of names on the left the way the reference's user window led
    with them, and the editor on the right: the name, a password box that starts empty every time (a
    stored password never travels to this side), and four presses with one meaning each - add, save, take
    the password off, remove. Every press writes to the server right there and the status line says what
    came back.
  -->

  <DockPanel Margin="48,14">

    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,8">
      <TextBlock Text="{Binding Heading}"
                 FontSize="24"
                 FontWeight="SemiBold" />
      <TextBlock Text="{Binding Subtitle}"
                 FontSize="14"
                 Opacity="0.7"
                 TextWrapping="Wrap"
                 MaxWidth="1500"
                 HorizontalAlignment="Left" />
    </StackPanel>

    <TextBlock DockPanel.Dock="Bottom"
               Name="statusLine"
               Text="{Binding Status}"
               FontSize="14"
               Opacity="0.85"
               Margin="0,8,0,0"
               TextWrapping="Wrap" />

    <Grid ColumnDefinitions="460,*" ColumnSpacing="30">

      <DockPanel>
        <Button DockPanel.Dock="Bottom"
                Name="reloadButton"
                Content="Read the list again"
                Command="{Binding LoadCommand}"
                FontSize="16"
                Focusable="True"
                HorizontalAlignment="Left"
                Margin="0,10,0,0" />

        <ListBox Name="usersList" theming:SkinTemplates.TileTemplate="LabelRowTemplate"
                 Focusable="True"
                 ItemsSource="{Binding Users}"
                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                 FontSize="18">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="api:UserInfo">
              <TextBlock Text="{Binding Label}"
                         FontSize="18"
                         Margin="2,6" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Top">

        <Grid ColumnDefinitions="200,320" RowDefinitions="Auto,Auto" Margin="0,4,0,4">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" FontSize="16" VerticalAlignment="Center" Margin="0,6" />
          <TextBox Grid.Row="0" Grid.Column="1"
                   Name="nameBox"
                   views:VirtualKeyboardService.Trigger="EnterOrMenu"
                   Text="{Binding NameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   FontSize="16"
                   Focusable="True"
                   Padding="10,4"
                   Margin="0,4" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="New password" FontSize="16" VerticalAlignment="Center" Margin="0,6" />
          <TextBox Grid.Row="1" Grid.Column="1"
                   Name="passwordBox"
                   views:VirtualKeyboardService.Trigger="EnterOrMenu"
                   Text="{Binding PasswordText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   FontSize="16"
                   Focusable="True"
                   PasswordChar="•"
                   RevealPassword="True"
                   Padding="10,4"
                   Margin="0,4" />
        </Grid>

        <TextBlock Text="{Binding SelectionSays}"
                   FontSize="14"
                   Opacity="0.6"
                   TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,8,0,0">
          <Button Name="addButton"
                  Content="Add this name"
                  Command="{Binding AddCommand}"
                  FontSize="16"
                  Focusable="True"
                  Padding="18,8" />
          <Button Name="saveButton"
                  Content="Save the picked user"
                  Command="{Binding SaveSelectedCommand}"
                  IsEnabled="{Binding HasSelection}"
                  FontSize="16"
                  Focusable="True"
                  Padding="18,8" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="14">
          <Button Name="removePasswordButton"
                  Content="Take the password off"
                  Command="{Binding RemovePasswordCommand}"
                  IsEnabled="{Binding HasSelection}"
                  FontSize="16"
                  Focusable="True"
                  Padding="18,8" />
          <Button Name="removeButton"
                  Content="Remove this user"
                  Command="{Binding RemoveSelectedCommand}"
                  IsEnabled="{Binding HasSelection}"
                  FontSize="16"
                  Focusable="True"
                  Padding="18,8" />
        </StackPanel>

        <!--
          Who is watching, which the reference kept under these very users: the switch that turns the
          waking question on, today's answer beside it, and the press that forgets the answer so the
          next start asks again. It lives here, on this box, and not in the server's store - the
          question is asked in the living room.
        -->
        <StackPanel Spacing="6" Margin="0,16,0,0">
          <CheckBox Name="askViewerBox"
                    Content="Ask who is watching when the screen wakes"
                    IsChecked="{Binding AskForViewer, Mode=TwoWay}"
                    FontSize="16"
                    Focusable="True" />
          <TextBlock Text="{Binding WatchingSays}"
                     FontSize="14"
                     Opacity="0.6"
                     TextWrapping="Wrap" />
          <Button Name="askAgainButton"
                  Content="Ask again next start"
                  Command="{Binding AskAgainNextStartCommand}"
                  FontSize="16"
                  Focusable="True"
                  HorizontalAlignment="Left"
                  Padding="18,8" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </DockPanel>
</UserControl>
