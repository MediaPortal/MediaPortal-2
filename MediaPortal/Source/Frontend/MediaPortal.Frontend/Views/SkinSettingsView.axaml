<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MediaPortal.Frontend.ViewModels"
        x:Class="MediaPortal.Frontend.Views.SkinSettingsView"
        x:DataType="vm:SkinSettingsViewModel"
        Name="skinSettings"
        Background="{DynamicResource ScreenBackgroundBrush}"
        >

  <!--
    The worn skin's own switches, one row each, in the order the reference's settings class filed them.
    Unlike the skin picker this screen keeps navigation and change apart: walking the rows with the d-pad
    shows what each switch would mean, and a press (Enter, the remote's OK, a click) changes and saves it
    - the way the reference's configuration menu behaved, and because these rows are switches a viewer
    must be able to look at without flipping. See SkinSettingsViewModel for why the colour of Nereus is
    one row that walks eight families rather than eight rows.
  -->

  <DockPanel Margin="48,14">

    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,8">
      <TextBlock Text="{Binding Heading}"
                 FontSize="24"
                 FontWeight="SemiBold" />
      <TextBlock Text="{Binding Subtitle}"
                 FontSize="14"
                 Opacity="0.7"
                 TextWrapping="Wrap"
                 MaxWidth="1500"
                 HorizontalAlignment="Left" />
    </StackPanel>

    <TextBlock DockPanel.Dock="Bottom"
               Name="statusLine"
               Text="{Binding Status}"
               FontSize="14"
               Opacity="0.85"
               Margin="0,8,0,0"
               TextWrapping="Wrap" />

    <ListBox Name="settingsList"
             Focusable="True"
             ItemsSource="{Binding Options}"
             SelectedItem="{Binding Selected, Mode=TwoWay}"
             FontSize="15">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="12,2"/>
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:SkinSettingOption">
          <Grid ColumnDefinitions="380,150,*" Margin="2,1">
            <TextBlock Text="{Binding Label}"
                       FontSize="16"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding ValueText}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="2"
                       Text="{Binding Description}"
                       FontSize="13"
                       Opacity="0.6"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>