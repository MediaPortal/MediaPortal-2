<?xml version="1.0" encoding="utf-8"?>
<!--
  Nereus master chrome: the header row and the footer row the reference wrapped around every screen.
  The header is the screen's title growing into the space it is given, then the clock; the footer is the
  three PlayerControl columns - title, progress, state - which hid themselves while nothing played.

  The chrome binds against ChromeInfo (x:DataType at the root): a typo in a binding name is a compile
  error in this file rather than a blank header at run time.
-->
<ResourceDictionary xmlns:chrome="clr-namespace:MediaPortal.Frontend.Theming"
                    xmlns:views="clr-namespace:MediaPortal.Frontend.Views"
                    xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:DataType="chrome:ChromeInfo">

  <!-- The header: the screen's words first, then - in the reference's right column - master_home.xaml's
       "Time Label" grid, which is three columns standing side by side and read from the right inwards: the
       clock at the far right, the day's weather picture in the middle, and the two quiet lines (the day of
       the week over the temperature) to the left of the picture, right aligned against it. The clock is
       HeadlineTimeFontSize, not DateTimeFontSize: the reference drew its two lines at 21 of its 1080 lines
       and its clock at 55, so the clock came as high as the two lines stacked, and this face draws those
       lines at SmallerFontSize (27) - 27 grown by 55 over 21 is the 71 below. What the machines at home are doing is
       said at this same end of the line, in pictures and left of the clock: the reference's right corner carried the
       clock, the day and the weather and nothing else (master_home.xaml:189) - see the bar below. -->
  <ControlTemplate x:Key="ChromeHeaderTemplate" TargetType="ContentControl">
    <!-- No background here. The reference's header row is transparent - master_home.xaml docks a HeaderPanel
         that carries no fill, so the fanart of the screen below reaches the very top edge behind the words,
         which is the whole reason the time and date read as painted onto the picture rather than sitting on
         a bar above it. The window already paints the same dark ground behind everything, so a transparent
         header is safe where no screen stands under it. -->
    <!-- DockPanel and not a two column Grid, and the reason is a measurement: a Grid asks an Auto column what it
         wants and gives it that whether or not the window has it, so on a narrow window - a small window on the
         desktop, a television that stands further away than the head line was drawn for - the clock ran past the
         right edge and the last digit of it was cut off by the window's clip. A docked child is asked against
         what is left over instead, which is the question the head line actually needs answering. The head line
         docks first and the screen title fills what remains, so a title gives way to the time rather than the
         other way round: the reference's masters always kept the clock and trimmed the words. -->
    <DockPanel Margin="10,0" Background="Transparent">
      <!-- master_home.xaml's "Time Label" grid: three Auto columns, the clock in the one furthest right, the
           weather picture in the middle, and the two lines - the day over the temperature - in the one furthest
           left, right aligned. Each part answers to the skin setting that guarded it in the reference:
           ShowTime for the clock, ShowDate for the day, ShowTemperature for the number, and
           ShowWeatherCondition for the picture, which is what the reference's condition dial did - the picture
           says the condition, so no line of words repeats it. The weather half only stands on the screen whose
           master carried the slot (ShowWeatherSlot), which is the home.
           The Viewbox around that grid is what keeps the whole of it on the screen. Grown it does nothing at all
           (StretchDirection="DownOnly"), so on a wide screen every part measures and draws at the size the skin
           asked for; shrunk it scales the cluster down as a whole, which keeps the reference's ratio of the two
           quiet lines to the clock intact instead of robbing one part of its height. The gutter to the screen
           title sits on the Viewbox rather than inside it, so it stays a full 10 when the rest is scaled down. -->
      <Viewbox DockPanel.Dock="Right" Stretch="Uniform" StretchDirection="DownOnly"
               VerticalAlignment="Center" Margin="10,0">
        <Grid ColumnDefinitions="Auto,Auto,Auto">
          <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="{Binding Date}" HorizontalAlignment="Right"
                       IsVisible="{Binding ShowDate}"
                       Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource SmallerFontSize}"/>
            <TextBlock Text="{Binding WeatherTemperature}" HorizontalAlignment="Right"
                       IsVisible="{Binding HasWeatherTemperature}"
                       Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource SmallerFontSize}"/>
          </StackPanel>
          <Image Grid.Column="1" Width="85" Stretch="Uniform" Margin="10,0"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding HasWeatherIcon}"
                 Source="{Binding WeatherIcon, Converter={x:Static views:SkinImageConverter.Instance},
                                   ConverterParameter='Weather/128x128/{0}'}"/>
          <TextBlock Grid.Column="2" Text="{Binding Clock}" HorizontalAlignment="Right" VerticalAlignment="Center"
                     IsVisible="{Binding ShowTime}"
                     Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource HeadlineTimeFontSize}"/>
        </Grid>
      </Viewbox>
      <!--
        What the machines at home are doing while the viewer stands here, said the way the reference said it: as
        pictures, with no sentence and no word beside them. Its bar (NotificationsBar.inc, hung into every master's
        top row - master_home.xaml:184, master_bare.xaml:109) carried three: the hint, which was an eighty square
        holding the picture of the loudest thing waiting and "(2)" under it as soon as a second one joined
        (Buttons.xaml:1983-2029), the importer, which was a turning circle with nothing but its percentage under it
        (Buttons.xaml:1740 with NotificationsBar.inc:29-31), and the recording, which was a blinking picture and
        nothing at all beside it (Buttons.xaml:1717-1731). So there is no "recording" here, no "connected" and no
        "disconnected": the glyph is the whole saying, and the long sentence that came with a state - how long until
        the next try, which directory is being filed, what the TV machine just wrote down - waits on that glyph's
        tooltip, where it can be read without taking room off the line.

        It stands at the right end of the line, and to the LEFT of the clock: the corner furthest right belongs to the
        time, the day and the weather and nothing else (master_home.xaml:189), while the left end belongs to the screen
        - which at home is the menu this very line floats over, so a mark put there lies across the menu entries.

        Every picture is handed a ceiling rather than a box to fill. A shape stretched uniformly into a box of a told
        size keeps to the top of that box, so the wide link of a connected mark - which is half as tall as it is wide -
        would hang at the top edge of its plate while the full circle of a recording filled its plate right through,
        and the row of pictures would walk downhill. Given a ceiling, a mark measures at its own shape and the plate it
        stands on centres it, which is what puts every one of them on the same line.
      -->
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                  Margin="0,0,14,0">
        <!-- The hint, and the number of what waits under it. -->
        <Button Command="{Binding OpenNotificationsCommand}" IsVisible="{Binding HasNotifications}"
                ToolTip.Tip="Things the household has been told and has not read"
                Width="66" Height="66" Background="Transparent" BorderThickness="0" Padding="0">
          <DockPanel>
            <!--
              Every plate keeps the same strip at its bottom for the number that belongs under its picture, whether
              that number is being said or not. That is what lets the reference's stacking - the picture, and the
              "(2)" or the "40%" underneath it (Buttons.xaml:2023-2029, NotificationsBar.inc:29-31) - stand next to a
              picture with nothing under it without the three of them coming to rest on different lines.
            -->
            <TextBlock DockPanel.Dock="Bottom" Height="18" TextAlignment="Center"
                       Text="{Binding NotificationCountWords}" Foreground="{DynamicResource TextBrush}"
                       FontSize="{DynamicResource TinyFontSize}"/>
            <Path Data="{Binding NotificationIcon, Converter={x:Static views:SkinIconGeometryConverter.Instance}}"
                  Fill="{DynamicResource TextBrush}" MaxWidth="46" MaxHeight="46" Stretch="Uniform" Opacity="0.75"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </DockPanel>
        </Button>
        <!--
          What the deal with the server is: connected while its news arrives on its own, disconnected when it has
          stopped or been refused at the door, the importer's circle - and the one number worth the ink - while it is
          at work in the library.
        -->
        <Panel IsVisible="{Binding HasActivity}" Width="66" Height="66" ToolTip.Tip="{Binding ServerNotice}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Height="18" TextAlignment="Center"
                       Text="{Binding ActivityPercent}" Foreground="{DynamicResource TextBrush}"
                       FontSize="{DynamicResource TinyFontSize}"/>
            <Path Data="{Binding ActivityIcon, Converter={x:Static views:SkinIconGeometryConverter.Instance}}"
                  Fill="{DynamicResource TextBrush}" MaxWidth="46" MaxHeight="46" Stretch="Uniform" Opacity="0.75"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </DockPanel>
        </Panel>
        <!--
          A recording, blinking the way the reference's recording picture blinked (Buttons.xaml:1722-1731), for as long
          as it runs rather than only at the moment it began - and blinked by the head line's model, because an
          animation is one of the things loose skin markup cannot carry. Red because a recording is the one thing on
          this screen that happens whether the viewer watches it or not; its sentence is what the tooltip says.
        -->
        <Panel IsVisible="{Binding IsRecording}" Width="66" Height="66" ToolTip.Tip="{Binding RecordingNotice}">
          <DockPanel>
            <!-- The recording has no number under it, and keeps the strip anyway: taking it away would lift its
                 mark nine units above the two pictures it stands beside. -->
            <Panel DockPanel.Dock="Bottom" Height="18"/>
            <Path Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                                  ConverterParameter=Notification/recording}"
                  Fill="#D0402F" MaxWidth="46" MaxHeight="46" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsVisible="{Binding RecordingMarkVisible}"/>
          </DockPanel>
        </Panel>
      </StackPanel>
      <!--
        Who is watching is NOT said here. The reference said it through its UserButton in the master's top
        row, and this skin already carries that button where the reference hung it - the person glyph in
        home.xaml's corner row of four, which opens the same wake the machine starts on. A second picture
        in the head line would be a second door to the same room, and an empty one whenever nobody was in
        the chair - the artifact the household noticed and named.
      -->
      <TextBlock Text="{Binding ScreenTitle}"
                 Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource HeaderFontSize}"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
  </ControlTemplate>

  <!--
    The footer: title, a progress line, and the state of play, in the reference's three columns. The whole
    row takes itself off while nothing plays - the AutoVisibility of the reference's PlayerControl elements.
  -->
  <ControlTemplate x:Key="ChromeFooterTemplate" TargetType="ContentControl">
    <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,0" Background="{DynamicResource ScreenBackgroundBrush}"
          IsVisible="{Binding HasMedia}">
      <TextBlock Grid.Column="0" Text="{Binding NowPlayingTitle}"
                 Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource SmallerFontSize}"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="600"/>
      <ProgressBar Grid.Column="1" Value="{Binding NowPlayingProgress}" Maximum="100"
                   Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource OutlineBrush}"
                   Height="2" Margin="20,0" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="2" Text="{Binding NowPlayingState}"
                 Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource SmallerFontSize}"
                 VerticalAlignment="Center"/>
    </Grid>
  </ControlTemplate>
</ResourceDictionary>
