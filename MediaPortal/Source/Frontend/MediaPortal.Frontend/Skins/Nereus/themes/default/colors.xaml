<?xml version="1.0" encoding="utf-8"?>
<!--
  Nereus' colour file, in the place and shape its reference had.

  Every value is the one the reference Colors.xaml held (the same values
  FrontendTheme's palette table was verified against, key by key); the
  accent families are all seven, because the reference skin's settings screen
  let a viewer pick one, and the skin keeps that promise in its own file
  rather than in compiled code.

  The fourteen job-named brushes at the top are what the screens paint with;
  the palette layer writes the same fourteen over these when it merges, so
  the two can never disagree on screen. What only this file answers are the
  reference's own names.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- What the screens paint with, under the job names. -->
  <SolidColorBrush x:Key="ScreenBackgroundBrush">#FF000000</SolidColorBrush>   <!-- DialogBackgroundColor -->
  <SolidColorBrush x:Key="PanelBrush">#FF244043</SolidColorBrush>              <!-- NereusColorDark_Turquoise -->
  <SolidColorBrush x:Key="PanelRaisedBrush">#FF175F5D</SolidColorBrush>        <!-- NereusColorMedium_Torquoise -->
  <SolidColorBrush x:Key="PanelPressedBrush">#FF444444</SolidColorBrush>       <!-- NereusGreyDark -->
  <SolidColorBrush x:Key="OutlineBrush">#33FFFFFF</SolidColorBrush>            <!-- DialogBorderColor -->
  <SolidColorBrush x:Key="VideoOutlineBrush">#FF666666</SolidColorBrush>       <!-- NereusGreyMedium -->
  <SolidColorBrush x:Key="TextBrush">#FFFFFFFF</SolidColorBrush>               <!-- TextColor -->
  <SolidColorBrush x:Key="MutedTextBrush">#FF9D9D9D</SolidColorBrush>          <!-- NereusColorLight_Grey -->
  <SolidColorBrush x:Key="DimTextBrush">#FF474747</SolidColorBrush>            <!-- NereusColorDark_Grey -->
  <SolidColorBrush x:Key="ButtonTextBrush">#FFFFFFFF</SolidColorBrush>         <!-- MenuTextForeground -->
  <SolidColorBrush x:Key="AccentBrush">#FF009592</SolidColorBrush>             <!-- NereusColorLight_Torquoise -->
  <SolidColorBrush x:Key="WarningBrush">#FFED7D31</SolidColorBrush>            <!-- NereusColorLight_Orange -->
  <SolidColorBrush x:Key="ScrimBrush">#80000000</SolidColorBrush>              <!-- DialogScreenBackgroundColor -->

  <!-- What a dialog is asked over, stepped back behind the question. The reference's wash was half black, which
       was enough over a still picture that only dimmed; this home is thrown out of focus and keeps moving, and
       a blurred home at half black still lights the room the panel stands in. Kept apart from the scrim above -
       the loading and notification layers wear that over a SHARP screen, and how dark a dialog likes its ground
       is no business of theirs. -->
  <SolidColorBrush x:Key="DialogWashBrush">#A6000000</SolidColorBrush>

  <!-- What a dialog panel itself is painted with: a very dark grey, and not black. On black the panel reads as a
       hole cut out of the picture and its glow as the edge of that hole; on a grey that is only a little above
       the washed ground behind it, the panel reads as an object standing in the room with light falling off it.
       Deliberately apart from DialogPanelBrush, the tinted slab the reference hung its dialog master and its
       volume bar on, which still follows the viewer's accent and transparency settings. -->
  <SolidColorBrush x:Key="DialogGroundBrush">#FF1B1B1B</SolidColorBrush>
  <SolidColorBrush x:Key="VideoBrush">#FF000000</SolidColorBrush>

  <!-- The fade a title stands on: black at ninety out of a hundred over the picture's own bottom edge, thinning
       to nothing two thirds up, so the name reads without a plate being laid across the cover. One fade, two
       places paint it - the strip under a cover on the wall and the band under a main menu tile - and they are
       the same fade on purpose, so that a title reads the same whether it stands in the wall or in the rail. -->
  <LinearGradientBrush x:Key="TitleFadeBrush" StartPoint="0%,100%" EndPoint="0%,0%">
    <GradientStop Offset="0" Color="#E6000000"/>
    <GradientStop Offset="0.55" Color="#99000000"/>
    <GradientStop Offset="1" Color="#00000000"/>
  </LinearGradientBrush>

  <!-- Nereus' own names, as its reference colour file spelled them. -->
  <Color x:Key="TextColor">#FFFFFFFF</Color>
  <Color x:Key="DialogBackgroundColor">#FF000000</Color>
  <Color x:Key="DialogBorderColor">#33FFFFFF</Color>
  <Color x:Key="DialogScreenBackgroundColor">#80000000</Color>
  <Color x:Key="MenuTextForeground">#FFFFFFFF</Color>
  <Color x:Key="NereusGreyDark">#FF444444</Color>
  <Color x:Key="NereusGreyMedium">#FF666666</Color>

  <!-- The dialog frame's three dials, as the shipped settings read: the panel at the reference's default
       transparency (0.85 on the dark accent), the frame in the focus colour the default choice dyes, and the
       corners square because the rounding switch ships off. The skin settings screen writes these three over
       here whenever a viewer turns a dial - see FrontendTheme.TintFromSkinSettings, which says where each
       value comes from. -->
  <SolidColorBrush x:Key="DialogPanelBrush">#D9244043</SolidColorBrush>
  <SolidColorBrush x:Key="DialogBorderBrush">#FF009592</SolidColorBrush>
  <CornerRadius x:Key="DialogCornerRadius">0</CornerRadius>

  <!-- The seven accent families, each in its Light, Medium and Dark shade. -->
  <Color x:Key="NereusColorLight_Torquoise">#FF009592</Color>
  <Color x:Key="NereusColorMedium_Torquoise">#FF175F5D</Color>
  <Color x:Key="NereusColorDark_Torquoise">#FF244043</Color>
  <Color x:Key="NereusColorLight_Blue">#FF4472C4</Color>
  <Color x:Key="NereusColorMedium_Blue">#FF2F5597</Color>
  <Color x:Key="NereusColorDark_Blue">#FF203864</Color>
  <Color x:Key="NereusColorLight_Green">#FF70AD47</Color>
  <Color x:Key="NereusColorMedium_Green">#FF548235</Color>
  <Color x:Key="NereusColorDark_Green">#FF385723</Color>
  <Color x:Key="NereusColorLight_Orange">#FFED7D31</Color>
  <Color x:Key="NereusColorMedium_Orange">#FFC55A11</Color>
  <Color x:Key="NereusColorDark_Orange">#FF843C0C</Color>
  <Color x:Key="NereusColorLight_Purple">#FF8758CC</Color>
  <Color x:Key="NereusColorMedium_Purple">#FF602FA1</Color>
  <Color x:Key="NereusColorDark_Purple">#FF3B1E66</Color>
  <Color x:Key="NereusColorLight_Red">#FFCC5350</Color>
  <Color x:Key="NereusColorMedium_Red">#FFA03830</Color>
  <Color x:Key="NereusColorDark_Red">#FF68150C</Color>
  <Color x:Key="NereusColorLight_Yellow">#FFD3AC1B</Color>
  <Color x:Key="NereusColorMedium_Yellow">#FFAE8C0E</Color>
  <Color x:Key="NereusColorDark_Yellow">#FF7F6000</Color>
  <Color x:Key="NereusColorLight_Grey">#FF9D9D9D</Color>
  <Color x:Key="NereusColorMedium_Grey">#FF666666</Color>
  <Color x:Key="NereusColorDark_Grey">#FF474747</Color>
</ResourceDictionary>
