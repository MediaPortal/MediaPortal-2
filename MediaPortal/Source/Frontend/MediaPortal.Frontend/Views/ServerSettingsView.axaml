<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MediaPortal.Frontend.ViewModels"
             x:Class="MediaPortal.Frontend.Views.ServerSettingsView"
             x:DataType="vm:ServerSettingsViewModel">
  <!--
    The server's own settings, over the API. Same shape as the other rows: label left,
    control right. Everything below the divider changes the address the server listens
    on, and a wrong value there can leave the front end unable to reach the server it is
    configured against - so those rows carry the warning where they are, not only in the
    status line at the bottom.
  -->
  <StackPanel Spacing="10" MaxWidth="560" HorizontalAlignment="Left">
    <TextBlock Text="Server settings" FontSize="17" FontWeight="SemiBold"/>
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="These are the server's own settings, stored on its machine. Login, import schedule and port number are server settings; how this client plays or looks are under the other rows."/>

    <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,6,0,0">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Require login" Classes="settinglabel"/>
      <CheckBox Grid.Row="0" Grid.Column="1" Content="Every call needs a signed-in user"
                IsChecked="{Binding WebAuth}"/>

      <TextBlock Grid.Row="1" Grid.Column="0" Text="Keep library fresh" Classes="settinglabel"/>
      <CheckBox Grid.Row="1" Grid.Column="1" Content="Re-scan the shares on its own"
                IsChecked="{Binding Importer}"/>

      <TextBlock Grid.Row="2" Grid.Column="0" Text="Every ... hours" Classes="settinglabel"/>
      <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <TextBox Width="80" Text="{Binding ImporterHours}"/>
        <TextBlock Classes="hint" VerticalAlignment="Center" Text="Between 0 and 24."/>
      </StackPanel>

      <TextBlock Grid.Row="3" Grid.Column="0" Text="Port" Classes="settinglabel"/>
      <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <TextBox Width="120" Text="{Binding Port}"/>
        <TextBlock Classes="hint" VerticalAlignment="Center"
                   Text="Stored only - this server build always listens on the shared port 55555."/>
      </StackPanel>

      <TextBlock Grid.Row="4" Grid.Column="0" Text="Protocols" Classes="settinglabel"/>
      <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="14">
        <CheckBox Content="IPv4" IsChecked="{Binding UseIPv4}"/>
        <CheckBox Content="IPv6" IsChecked="{Binding UseIPv6}"/>
      </StackPanel>

      <TextBlock Grid.Row="5" Grid.Column="0" Text="Fixed addresses" Classes="settinglabel"/>
      <CheckBox Grid.Row="5" Grid.Column="1" Content="Listen only on the addresses below"
                IsChecked="{Binding LimitEndpoints}"/>

      <TextBlock Grid.Row="6" Grid.Column="0" Text="Addresses" Classes="settinglabel"/>
      <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Bindings}" Watermark="192.168.1.10, 127.0.0.1"/>

      <TextBlock Grid.Row="7" Grid.Column="0" Classes="settinglabel"
                 Text="Only one address will do"/>
      <TextBlock Grid.Row="7" Grid.Column="1" Classes="hint" TextWrapping="Wrap"
                 Text="If IPv4 and IPv6 are both off, or the list holds nothing the machine has, the server cannot start its web server again - and this screen talks to it over exactly that. Get it wrong and the way back in is the settings.xml on the server's disk."/>
    </Grid>

    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
      <Button Content="Reload" Command="{Binding ReloadCommand}"/>
      <Button Content="Save on the server" Command="{Binding SaveCommand}"/>
    </StackPanel>

    <TextBlock Text="{Binding Status}" Classes="hint" TextWrapping="Wrap"/>
  </StackPanel>
</UserControl>
