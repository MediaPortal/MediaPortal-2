<Project>

  <!--
    Analyzer configuration, evaluated AFTER every project body (that is the only place where a
    project's own <CodeAnalysisRuleSet> can be overridden).

    Why this exists: 116 projects asked for "AllRules.ruleset" and 131 for
    "MinimumRecommendedRules.ruleset". Those two names only resolve inside a Visual Studio
    installation. On any other host - `dotnet build` on Windows, the Linux container, CI - MSBuild
    reported MSB3884 "rule set not found" 216 times and analysed the tree with a different, smaller
    rule set than the Windows gate used. Two hosts, two measurements of the same source, which made
    the warning ratchet unreadable across platforms.

    Severity now lives in exactly one place, MediaPortal\.editorconfig, which every host and every
    editor reads. The property below clears the legacy names so MSBuild stops looking for them, and
    the stale "Visual Studio 10.0" CodeAnalysisRuleSetDirectories entries in 34 project files go
    with them.

    EnableNETAnalyzers is forced on because the SDK enables the .NET analyzers by default only for
    TargetFramework >= net5.0; without this, every net48 leg would be analysed less strictly than
    the net6.0 legs while the port is being measured.
  -->
  <PropertyGroup Condition="'$(CodeAnalysisRuleSet)' == 'AllRules.ruleset' OR '$(CodeAnalysisRuleSet)' == 'MinimumRecommendedRules.ruleset'">
    <CodeAnalysisRuleSet></CodeAnalysisRuleSet>
    <CodeAnalysisRuleSetDirectories></CodeAnalysisRuleSetDirectories>
  </PropertyGroup>

  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

  <!--
    MP2IsSolutionBuild: "true" only when MSBuild is driving a .sln.

    120 build.targets files in this tree end with a "CopyToOutput" step that deploys the built
    assembly into Bin\<SolutionName>\, which only makes sense when a solution asked for the build.
    Guarding them needs a reliable test, and the obvious ones do not work:

      - Exists('$(SolutionDir)') is true even for a single project build, because the SDK
        auto-detects a .sln in an ancestor directory and because many project files carry the old
        NuGet boilerplate <SolutionDir Condition="$(SolutionDir) == '' Or ...>..\..\</SolutionDir>.
      - '$(SolutionName)' == '' is never true: Microsoft.Common.CurrentVersion.targets fills an
        empty SolutionName with the literal string "*Undefined*", which is why a stray standalone
        build used to deploy into MediaPortal\Bin\*Undefined*\ (MSB3021 "the filename, directory
        name, or volume label syntax is incorrect") instead of skipping.

    So the sentinel has to be excluded explicitly. This is what makes `dotnet test <project>` work:
    a test run builds the project graph without a solution, and the deployment steps now step aside
    instead of failing the build. Target conditions are evaluated at execution time, so defining
    the property here (after the project's own <Import Project="build.targets"/>) is early enough.
  -->
  <PropertyGroup>
    <MP2IsSolutionBuild Condition="'$(SolutionName)' != '' AND '$(SolutionName)' != '*Undefined*'">true</MP2IsSolutionBuild>
  </PropertyGroup>

</Project>
