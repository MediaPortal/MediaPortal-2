<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:MediaPortal.Frontend.Views"
        xmlns:vm="using:MediaPortal.Frontend.ViewModels"
        x:Class="MediaPortal.Frontend.Views.TvSettingsView"
        x:DataType="vm:TvSettingsViewModel"
        Name="tvSettings"
        Background="Transparent"
        >

  <!--
    Where the television comes from, and what the television screens do with the answer. The boxes and switches
    below the address are the reference's own SlimTvClient settings - the same twelve questions its settings screen
    asked (plugin.xml:218-300), in its own order and in its own words. What it asked as a multiple-choice list of
    "visible channel information" is two switches here, because a remote has no way of holding a list down; what it
    asked with colour pickers per genre stays in the skin, which is where those eight colours already live.
  -->

  <DockPanel Margin="48,14">

    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,8">
      <TextBlock Text="Television"
                 FontSize="24"
                 FontWeight="SemiBold" />
      <TextBlock Text="{Binding Subtitle}"
                 FontSize="14"
                 Opacity="0.7"
                 TextWrapping="Wrap"
                 MaxWidth="1500"
                 HorizontalAlignment="Left" />
    </StackPanel>

    <TextBlock DockPanel.Dock="Bottom"
               Name="statusLine"
               Text="{Binding Status}"
               FontSize="14"
               Opacity="0.85"
               Margin="0,10,0,0"
               TextWrapping="Wrap" />

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Spacing="10" VerticalAlignment="Top" MaxWidth="1100" HorizontalAlignment="Left">

      <Grid ColumnDefinitions="240,320" RowDefinitions="Auto,Auto,Auto,Auto,Auto">

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Machine" FontSize="16" VerticalAlignment="Center" Margin="0,6" />
        <TextBox Grid.Row="0" Grid.Column="1"
                 Name="hostBox"
                 views:VirtualKeyboardService.Trigger="EnterOrMenu"
                 Text="{Binding Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Watermark="tvserver, or tvserver.lan"
                 FontSize="16"
                 Focusable="True"
                 Padding="10,4"
                 Margin="0,4" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Port" FontSize="16" VerticalAlignment="Center" Margin="0,6" />
        <TextBox Grid.Row="1" Grid.Column="1"
                 Name="portBox"
                 views:VirtualKeyboardService.Trigger="EnterOrMenu"
                 Text="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Watermark="9981"
                 FontSize="16"
                 Focusable="True"
                 Padding="10,4"
                 Margin="0,4" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Username" FontSize="16" VerticalAlignment="Center" Margin="0,6" />
        <TextBox Grid.Row="2" Grid.Column="1"
                 Name="userBox"
                 views:VirtualKeyboardService.Trigger="EnterOrMenu"
                 Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Watermark="only if the backend asks"
                 FontSize="16"
                 Focusable="True"
                 PasswordChar="•"
                 RevealPassword="True"
                 Padding="10,4"
                 Margin="0,4" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Password" FontSize="16" VerticalAlignment="Center" Margin="0,6" />
        <TextBox Grid.Row="3" Grid.Column="1"
                 Name="passwordBox"
                 views:VirtualKeyboardService.Trigger="EnterOrMenu"
                 Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="16"
                 Focusable="True"
                 PasswordChar="•"
                 RevealPassword="True"
                 Padding="10,4"
                 Margin="0,4" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Days of guide" FontSize="16" VerticalAlignment="Center" Margin="0,6" />
        <TextBox Grid.Row="4" Grid.Column="1"
                 Name="daysBox"
                 views:VirtualKeyboardService.Trigger="EnterOrMenu"
                 Text="{Binding GuideDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Watermark="14"
                 FontSize="16"
                 Focusable="True"
                 Padding="10,4"
                 Margin="0,4" />
      </Grid>

      <!-- The one switch the reference had no reason to have: an invented backend instead of a machine, so that
           the guide can be looked at by a box with no TVHeadend in the house. -->
      <CheckBox Name="demoCheck" Content="Demo data instead of a real TV backend" FontSize="16" Focusable="True"
                IsChecked="{Binding DemoData, Mode=TwoWay}"
                ToolTip.Tip="Fills the guide, the channel lists and the timers with channels and programmes this front end makes up." />
      <TextBlock Text="With this on there is no machine to ask: the channels, the programmes and the timers are invented, and the guide is never empty. There is no picture, because nothing stands behind a demo stream address."
                 FontSize="13"
                 Opacity="0.75"
                 TextWrapping="Wrap"
                 MaxWidth="900"
                 Margin="0,0,0,4" />

      <!-- The guide's own shape, which is the reference's EpgNumberOfHours and EpgNumberOfRows. -->
      <TextBlock Text="The programme guide" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" />

      <Grid ColumnDefinitions="240,320" RowDefinitions="Auto,Auto,Auto">

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Hours in the guide" FontSize="16"
                   VerticalAlignment="Center" Margin="0,6"
                   ToolTip.Tip="How much of the evening one screen of the guide covers." />
        <TextBox Grid.Row="0" Grid.Column="1"
                 Name="hoursBox"
                 views:VirtualKeyboardService.Trigger="EnterOrMenu"
                 Text="{Binding VisibleHours, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Watermark="3"
                 FontSize="16"
                 Focusable="True"
                 Padding="10,4"
                 Margin="0,4" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Rows in the guide" FontSize="16"
                   VerticalAlignment="Center" Margin="0,6"
                   ToolTip.Tip="How many channels are on the screen at once. Fewer rows are taller rows." />
        <TextBox Grid.Row="1" Grid.Column="1"
                 Name="rowsBox"
                 views:VirtualKeyboardService.Trigger="EnterOrMenu"
                 Text="{Binding VisibleRows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Watermark="9"
                 FontSize="16"
                 Focusable="True"
                 Padding="10,4"
                 Margin="0,4" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Zap timeout" FontSize="16"
                   VerticalAlignment="Center" Margin="0,6"
                   ToolTip.Tip="Seconds of quiet before the number typed on the remote is taken as a channel." />
        <TextBox Grid.Row="2" Grid.Column="1"
                 Name="zapBox"
                 views:VirtualKeyboardService.Trigger="EnterOrMenu"
                 Text="{Binding ZapTimeout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Watermark="2"
                 FontSize="16"
                 Focusable="True"
                 Padding="10,4"
                 Margin="0,4" />
      </Grid>

      <TextBlock Text="What the guide says" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" />

      <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="60">
        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
          <CheckBox Name="namesCheck" Content="Channel names in the guide" FontSize="16" Focusable="True"
                    IsChecked="{Binding ShowChannelNames, Mode=TwoWay}" />
          <CheckBox Name="numbersCheck" Content="Channel numbers in the guide" FontSize="16" Focusable="True"
                    IsChecked="{Binding ShowChannelNumbers, Mode=TwoWay}" />
          <CheckBox Name="genreCheck" Content="Genre colors in the guide" FontSize="16" Focusable="True"
                    IsChecked="{Binding ShowGenreColors, Mode=TwoWay}" />
          <CheckBox Name="seriesCheck" Content="Series infos" FontSize="16" Focusable="True"
                    IsChecked="{Binding ShowSeriesInfo, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
          <CheckBox Name="zapGuideCheck" Content="Zap from the guide" FontSize="16" Focusable="True"
                    IsChecked="{Binding ZapFromGuide, Mode=TwoWay}"
                    ToolTip.Tip="Pressing a programme that is running now goes straight to it." />
          <CheckBox Name="zapIndexCheck" Content="Zap by channel index" FontSize="16" Focusable="True"
                    IsChecked="{Binding ZapByChannelIndex, Mode=TwoWay}"
                    ToolTip.Tip="A typed number is a place in the bouquet. Off, it is the number printed on a channel." />
          <CheckBox Name="autoStartCheck" Content="Automatically start TV" FontSize="16" Focusable="True"
                    IsChecked="{Binding AutoStartTV, Mode=TwoWay}"
                    ToolTip.Tip="The tile called Live TV opens with a picture instead of waiting for a channel." />
          <CheckBox Name="hideAllCheck" Content='Hide "All Channels" group' FontSize="16" Focusable="True"
                    IsChecked="{Binding HideAllChannelsGroup, Mode=TwoWay}" />
        </StackPanel>
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,8,0,0">
        <Button Name="checkButton"
                Content="Ask the backend"
                Command="{Binding CheckCommand}"
                IsEnabled="{Binding CanCheck}"
                FontSize="16"
                Focusable="True"
                Padding="18,8" />
        <Button Name="saveButton"
                Content="Write this down"
                Command="{Binding SaveCommand}"
                FontSize="16"
                Focusable="True"
                Padding="18,8" />
      </StackPanel>
    </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
