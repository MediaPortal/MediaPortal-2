<?xml version="1.0" encoding="utf-8"?>
<!--
  Nereus superlayers: the overlays that briefly cover the screen to say one thing - the volume reading
  while the volume keys are held, and the busy spinner while something loads. The reference drew these as
  whole-screen layers of the master window; the window here keeps one host for them and swaps the template.

  Both templates are ContentControl templates: whatever the window puts in Content is the sentence, and
  nothing here binds against the chrome - TemplateBinding only.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The volume: one big line of text, Nereus-sized, lower third of the screen like the reference. -->
  <ControlTemplate x:Key="Superlayer_Volume" TargetType="ContentControl">
    <Border Background="{DynamicResource ScrimBrush}" IsHitTestVisible="False">
      <TextBlock Text="{TemplateBinding Content}"
                 Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource DateTimeFontSize}"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,120"/>
    </Border>
  </ControlTemplate>

  <!--
    The skip step: the reference's SkipStepOSD measured from its file - a 350x100 dialog panel held in
    the centre (pushed down a hundred and right-inset fifty, exactly as the reference places it), wrapped
    in the six glow rings the reference stacks at growing opacity, the last ring a quarter-lit outline.
    The rings and the panel are the dialog frame's three dials - the same white/focus/none expression, the
    same transparency and the same rounding switch that master_dialog_bare reads and this file's dialog
    frame reads; the reference bound all of them to the same settings, and so here. Normal font size, like
    the reference label - this says a number, it does not shout it.
  -->
  <ControlTemplate x:Key="Superlayer_SkipStep" TargetType="ContentControl">
    <Border Background="Transparent" IsHitTestVisible="False">
      <Border Width="350" Height="100" Background="{DynamicResource DialogPanelBrush}"
              CornerRadius="{DynamicResource DialogCornerRadius}"
              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,100,50,0">
        <Panel>
          <Border BorderBrush="{DynamicResource DialogBorderBrush}" BorderThickness="3" Opacity="0.04" Margin="-15"
                  CornerRadius="{DynamicResource DialogCornerRadius}"/>
          <Border BorderBrush="{DynamicResource DialogBorderBrush}" BorderThickness="2" Opacity="0.06" Margin="-12"
                  CornerRadius="{DynamicResource DialogCornerRadius}"/>
          <Border BorderBrush="{DynamicResource DialogBorderBrush}" BorderThickness="2" Opacity="0.08" Margin="-10"
                  CornerRadius="{DynamicResource DialogCornerRadius}"/>
          <Border BorderBrush="{DynamicResource DialogBorderBrush}" BorderThickness="2" Opacity="0.10" Margin="-8"
                  CornerRadius="{DynamicResource DialogCornerRadius}"/>
          <Border BorderBrush="{DynamicResource DialogBorderBrush}" BorderThickness="2" Opacity="0.13" Margin="-6"
                  CornerRadius="{DynamicResource DialogCornerRadius}"/>
          <Border BorderBrush="{DynamicResource DialogBorderBrush}" BorderThickness="2" Opacity="0.18" Margin="-4"
                  CornerRadius="{DynamicResource DialogCornerRadius}"/>
          <Border BorderBrush="{DynamicResource DialogBorderBrush}" BorderThickness="2" Opacity="0.25" Margin="-2"
                  CornerRadius="{DynamicResource DialogCornerRadius}"/>
          <TextBlock Text="{TemplateBinding Content}" Margin="10,5"
                     Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource NormalFontSize}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Panel>
      </Border>
    </Border>
  </ControlTemplate>

  <!-- Busy: the screen dims, the words are centred, and the accent line underneath is still moving. -->
  <ControlTemplate x:Key="Superlayer_Busy" TargetType="ContentControl">
    <Border Background="{DynamicResource ScrimBrush}" IsHitTestVisible="False">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
        <TextBlock Text="{TemplateBinding Content}"
                   Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource DateTimeFontSize}"
                   HorizontalAlignment="Center"/>
        <ProgressBar IsIndeterminate="True" Width="400" Height="3"
                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource OutlineBrush}"/>
      </StackPanel>
    </Border>
  </ControlTemplate>
</ResourceDictionary>
