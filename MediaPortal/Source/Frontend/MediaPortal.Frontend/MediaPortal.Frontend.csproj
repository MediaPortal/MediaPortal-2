<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The new front end, in an assembly of its own.

    It is not connected to any MP2 assembly on purpose. It reaches the server through the HTTP API that
    MediaPortal.Server.Api serves and knows nothing about MediaPortal.Common, the media library types, or the
    WinForms UI it replaces. That separation is what makes it buildable and testable on a host without Windows,
    which the old client never was; the price is that its picture of the server is only ever what the API
    chooses to say, so the API is the contract and is versioned like one.

    Rules, same shape as the API assembly's:
      - net10.0, never a -windows suffix, and CA1416 as an error. A platform-specific call here is a crash on
        the platform that lacks it, not a cosmetic warning.
      - No MP2 project references. If something in the server has to be visible to the front end, an endpoint
        exposes it; the front end does not reach into the process. The one project reference allowed is
        MediaPortal.Frontend.Player, which is part of this front end rather than of the server: it carries no MP2
        reference of its own, no UI toolkit and no platform suffix, so referencing it costs this assembly nothing
        it could not do itself - and playing is a thing the front end has to do in its own process anyway.
      - The UI is Avalonia and the presentation pattern is MVVM (CommunityToolkit.Mvvm). Views contain no
        decisions; view models contain no Avalonia types except where a view model *is* the thing under
        test, which is rare and said out loud when it happens.

    GenerateAssemblyInfo is off because VersionInfo.cs is linked in, the way MediaPortal.Server.Api does it, so
    the front end reports the same version as the server it talks to. With generation off, the
    SupportedOSPlatform attribute the SDK would have written is not written either - the correct result, since
    this assembly declares no platform.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>MediaPortal.Frontend</RootNamespace>
    <AssemblyName>MediaPortal.Frontend</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>CA1416</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Core\MediaPortal.Common\VersionInfo\VersionInfo.cs" Link="Properties\VersionInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Installed skins, as data. The Skins folder is this front end's answer to the reference Source\UI\Skins:
      a manifest and directories of XAML that the SkinEngine reads at run time - loose markup, not compiled
      views, exactly as the reference skin engine read them. The files ride along as AvaloniaResource because
      that is Avalonia's own way to ship loose XAML: ResourceInclude and StyleInclude parse such files when
      the screen is dressed, while the views in this project stay compiled. index.txt lists the skin folders
      (Avalonia's asset system cannot enumerate a folder); a test says out loud when the listing and the
      folders drift apart.
    -->
    <AvaloniaResource Include="Skins\**\*.xaml" />
    <AvaloniaResource Include="Skins\**\skin.xml" />
    <AvaloniaResource Include="Skins\index.txt" />
    <!--
      The pictures, fonts and sounds a skin carries are hundreds of files and tens of megabytes; embedding
      them in the assembly would bloat it for files a running front end reads from the skin folder on disk
      anyway. They ride to the output folder as loose files instead, so an installed front end is a skin
      folder the same way the reference's was. The theme's own background picture is the one image small
      enough to ride inside too - the shipped fallback wears it without any disk folder.
    -->
    <AvaloniaResource Include="Skins\**\*.png" Exclude="Skins\**\images\**\*.png" />
    <AvaloniaResource Include="Skins\**\fonts\**\*" />
    <AvaloniaResource Include="Skins\**\sounds\**\*" />
    <None Update="Skins\**\images\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The player. Part of this front end, not of the server - see the rule in the header above. -->
    <ProjectReference Include="..\MediaPortal.Frontend.Player\MediaPortal.Frontend.Player.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <!-- The skin files are read off disk at run time, so they are parsed here rather than compiled in;
         this package is Avalonia's own XAML compiler, used the way the reference skin engine used its one. -->
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.ServiceModel.Syndication" Version="10.0.13" />
  </ItemGroup>

</Project>
