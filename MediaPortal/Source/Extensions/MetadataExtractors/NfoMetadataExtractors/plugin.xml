<Plugin
    DescriptorVersion="1.0"
    Name="NfoMetadataExtractors"
    PluginId="{2505C495-28AA-4D1C-BDEE-CA4A3A89B0D5}"
    Author = "MJGraf"
    Copyright="GPL"
    Description="Metadata extractors reading metadata from local nfo-files, and the video resource detection that they depend on">

  <Version
    PluginVersion="1.1"
    ReleaseDate="2016-12-20 01:00:00 GMT+01:00"
    CurrentAPI="2"/>

  <DependsOn>
    <CoreDependency Name="MediaPortal.Common" CompatibleAPI="2" />
    <CoreDependency Name="MediaPortal.Utilities" CompatibleAPI="1" />
  </DependsOn>

  <Runtime>
    <Assembly FileName="NfoMetadataExtractors.dll"/>
    <!--
      Newtonsoft.Json comes from this plugin's own directory now. It used to be reached through the
      OnlineLibraries plugin with a relative path above this one, because that plugin happened to
      carry the same library; the NFO readers never used a type from OnlineLibraries itself, and the
      dependency kept this plugin on a Windows-only target framework for nothing.
    -->
    <Assembly FileName="Newtonsoft.Json.dll"/>
  </Runtime>

  <Register Location="/Media/MetadataExtractors">
    <!--
      Not an nfo reader, but it has to be applied before every one of them: the nfo extractors only
      touch a resource that an earlier extractor has marked as a video, and the extractor that used
      to do that on Windows needs MediaInfo and OpenCV, which have no Linux or Android build. With
      this one the nfo chain works on every platform.
    -->
    <Instance
        Id="VideoContainerMetadataExtractor"
        ClassName="MediaPortal.Extensions.MetadataExtractors.NfoMetadataExtractors.VideoContainerMetadataExtractor"/>
    <Instance
        Id="NfoVideoMetadataExtractor"
        ClassName="MediaPortal.Extensions.MetadataExtractors.NfoMetadataExtractors.NfoVideoMetadataExtractor"/>
    <Instance
        Id="NfoMovieMetadataExtractor"
        ClassName="MediaPortal.Extensions.MetadataExtractors.NfoMetadataExtractors.NfoMovieMetadataExtractor"/>
    <Instance
        Id="NfoSeriesMetadataExtractor"
        ClassName="MediaPortal.Extensions.MetadataExtractors.NfoMetadataExtractors.NfoSeriesMetadataExtractor"/>
    <Instance
        Id="NfoAudioMetadataExtractor"
        ClassName="MediaPortal.Extensions.MetadataExtractors.NfoMetadataExtractors.NfoAudioMetadataExtractor"/>
  </Register>

  <Register Location="/Media/RelationshipExtractors">
    <Instance
        Id="NfoMovieRelationshipExtractor"
        ClassName="MediaPortal.Extensions.MetadataExtractors.NfoMetadataExtractors.MovieRelationshipExtractor"/>
    <Instance
        Id="NfoSeriesRelationshipExtractor"
        ClassName="MediaPortal.Extensions.MetadataExtractors.NfoMetadataExtractors.SeriesRelationshipExtractor"/>
    <Instance
        Id="NfoAudioRelationshipExtractor"
        ClassName="MediaPortal.Extensions.MetadataExtractors.NfoMetadataExtractors.AudioRelationshipExtractor"/>
  </Register>

  <Register Location="/Media/FanArtHandlers">
    <Instance
      Id="NfoMovieFanArtHandler"
      ClassName="MediaPortal.Extensions.MetadataExtractors.NfoMetadataExtractors.MovieFanArtHandler"/>
    <Instance
      Id="NfoSeriesFanArtHandler"
      ClassName="MediaPortal.Extensions.MetadataExtractors.NfoMetadataExtractors.SeriesFanArtHandler"/>
    <Instance
      Id="NfoAudioFanArtHandler"
      ClassName="MediaPortal.Extensions.MetadataExtractors.NfoMetadataExtractors.AudioFanArtHandler"/>
  </Register>
</Plugin>
