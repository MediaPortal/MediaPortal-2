<?xml version="1.0" encoding="utf-8"?>
<!--
  How Nereus dresses the controls no screen draws itself - the part of the
  reference skin's styles directory (Buttons.xaml, MediaStyles.xaml) that
  applies to the controls this front end uses.

  They are written as XAML, in the skin, read at run time: a person who wants
  a button that looks different opens this file and says so here, without
  recompiling the front end. That is the whole argument for the skin folder
  existing on disk instead of in code.

  {DynamicResource ...} rather than {StaticResource ...}: a palette may be put
  over the skin later - the accent families and WMC schemes are chosen at run
  time - and an author style that resolved its colour when the skin loaded
  would keep painting yesterday's accent.

  x:CompileBindings="False" for the one kind of binding this file can hold: a
  face asked for by name. The menu editor's buttons below bind their glyph
  through the skin's icon converter, whose converter parameter IS the name and
  which therefore binds nothing - while a compiled binding insists on knowing
  the data type it starts from, which a style that dresses a button in a list
  row, a header button and a dialog button all at once cannot have.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MediaPortal.Frontend.Views"
        x:CompileBindings="False">

  <!-- STANDING ON A TILE, AND WHEN NOBODY IS.
       Every rule below that answers ":pointerover" says the same thing as its ":focus" twin - the lit edge, the
       lightened glass, the picture stepped nearer - because a tile that is stood on is the tile the viewer means,
       whether they reached it with the mouse or with the arrows. That is right while the pointer is about. It is
       wrong the moment the pointer has been left alone: the front end puts an invisible pointer away after ten
       seconds of quiet (Views/ShellWindow.cs), and a tile keeping its lit edge afterwards claims to be stood on
       by nobody, quarrelling with the tile the keyboard actually holds.

       So the window says where the pointer is. While it rests the window wears the class "pointer-resting", and
       each rule that gives a dressing for hover is written under Window:not(.pointer-resting): the dressing goes
       out of sight with the pointer, the ":focus" rules are untouched, and a viewer who never touches the mouse -
       a window that never carries the class at all - sees exactly what this file has always said. The values stay
       where they were; only the condition grew. The hover rules that paint "Transparent" are guards against the
       platform's own selection panel, and they keep working in both states: they suppress a dressing rather than
       give one. -->

  <!-- Buttons: flat, square, the dark of the accent as resting colour. -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
    <!-- Nereus drew its buttons square; its colour file's ButtonControlRadiusX says 0. -->
    <Setter Property="CornerRadius" Value="0"/>
  </Style>
  <Style Selector="Window:not(.pointer-resting) Button:pointerover">
    <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}"/>
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="Background" Value="{DynamicResource PanelPressedBrush}"/>
  </Style>

  <!-- Lists stand on the panel; a selected row takes the accent and the screen's own black. -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="Window:not(.pointer-resting) ListBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}"/>
  </Style>
  <Style Selector="ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource ScreenBackgroundBrush}"/>
  </Style>

  <!--
    The ground of a music tile that has no cover. The reference painted the skin's own colour behind the music
    mark - the medium of the skin's family at rest, the light of it stood on - because an album whose art was
    never found is not a film, and a film still laid under it says the wrong thing about the shelf.
  -->
  <Style Selector="Border.nereus-music-ground">
    <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}"/>
  </Style>
  <Style Selector="ListBoxItem:selected Border.nereus-music-ground">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="ListBoxItem:focus Border.nereus-music-ground">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="Window:not(.pointer-resting) ListBoxItem:pointerover Border.nereus-music-ground">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
  </Style>

  <!-- The home rail uses its artwork and selection markers, not the generic selected-row panel. The settings
       wall wears the same treatment: its tiles dress themselves too, and a platform selection rectangle under a
       plate that is already a plate of its own is a blue box with a tile floating in it. -->
  <Style Selector="ListBox.nereus-home-menu, ListBox.settings-tile-wall, ListBox.nereus-shelf-tiles">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <!-- The reference lights its own selection band and nothing else; the plain blue rectangle that the
         platform draws around a focused list has no part in Nereus. The items lose theirs below, and the
         list itself loses it here - which is where the frame stood, because the list is what holds the
         focus before a tile takes it. -->
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
  </Style>
  <!-- Nothing of the PLATFORM's is left on the rail: its selection panel and focus rectangle are switched off
       down to the item's template, so neither the selected tile nor the focused one can grow a border of the
       toolkit's own no matter which pseudo-class it wears. What the rail does wear is the skin's resting edge -
       Border.home-tile-edge, laid over the tile by the tile's own template, the ghost ring the whole wall wears
       while nothing stands on a tile. It stays a ring at rest here and is NOT lit by standing on the tile: the
       rail already answers a viewer with its band, its artwork and its bar, and a ring brightening over them was
       not asked for. Being lit under a viewer remains the covers' and the shortcuts' answer, not the rail's. -->
  <Style Selector="ListBox.nereus-home-menu ListBoxItem, ListBox.settings-tile-wall ListBoxItem,
                  ListBox.nereus-shelf-tiles ListBoxItem">
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <!-- Every tile's shadow is drawn by the border round the tile, and that border stands twelve points
         clear of its neighbour: the shadow, which reaches twenty points, therefore has nowhere to go but
         outside the item's own rectangle. An item is a TemplatedControl, and TemplatedControl hands its
         ClipToBounds default over as TRUE, so the rectangle was the end of the shadow - a straight edge
         six points under a tile, which is the middle of the gap and read as a shadow cut off mid-fade.
         (Only below, because the item is as wide as the widened rail but only a tile tall.) The wall's own
         ItemsControl puts its clip off for the very same reason, and the shortcut rail needs no such
         setting because it has no item container at all: its tiles stand on the wall's canvas directly,
         which is why this never bothered them. The rail itself keeps its clip one level up, in its
         ScrollContentPresenter, so nothing escapes the rail at its ends. -->
    <Setter Property="ClipToBounds" Value="False"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Deliberately NOT named PART_ContentPresenter: the platform's item ControlTheme carries styles
             aimed at that part name ("/template/ ContentPresenter#PART_ContentPresenter:selected" and
             friends) and they would reach into this foreign template too, painting the accent brush over
             the reference's own artwork. Under its own name the tile wears nothing but what the skin gives
             it; the state styles below are only the extra guarantee. -->
        <ContentPresenter Name="nereusTilePresenter"
                          BorderThickness="0"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
          <!-- A plain Background="Transparent" loses to the platform's ListItemBackground{Selected,...}
               theme resources, which reach the presenter through its own ControlTheme; the platform also
               ignores the ListBox's SelectionMode="None" for the item pseudo-classes. Triggers outrank
               theme values, so the tile stays the reference's own artwork in every state. -->
          <ContentPresenter.Styles>
            <Style Selector="ContentPresenter">
              <Style Selector="^:pointerover">
                <Setter Property="Background" Value="Transparent"/>
              </Style>
              <Style Selector="^:pressed">
                <Setter Property="Background" Value="Transparent"/>
              </Style>
              <Style Selector="^:selected">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
              </Style>
              <Style Selector="^:selected:pointerover">
                <Setter Property="Background" Value="Transparent"/>
              </Style>
            </Style>
          </ContentPresenter.Styles>
        </ContentPresenter>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.nereus-home-menu ListBoxItem:pointerover">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.nereus-home-menu ListBoxItem:selected">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>

  <!--
    The library's shelf dresses its own tiles - the plate, the picture, the name's band and the ring are all
    drawn by the tile, exactly as on the wall - so the container must not paint a row panel under them. A
    selected row of tiles wearing the accent colour is a coloured box with a tile floating in it, which is the
    very thing the home rail was given this treatment for.

    What the container does answer instead is the walking, and with the same three things the wall's covers
    answer: the light of the tile a viewer stands on, the ring at its edge coming up to full, and its picture
    stepping a tenth nearer. The shelf's tiles are the wall's tiles, so the same numbers carry over; growth is
    meant strictly here too, and only the tile that is both the title the screen is about and the tile someone
    is actually on grows.
  -->
  <Style Selector="ListBox.nereus-shelf-tiles ListBoxItem:pointerover">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.nereus-shelf-tiles ListBoxItem:selected">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="ListBox.nereus-shelf-tiles Border.home-tile-shadow">
    <Setter Property="Opacity" Value="0.86"/>
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.nereus-shelf-tiles ListBoxItem:selected Border.home-tile-shadow">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="ListBox.nereus-shelf-tiles ListBoxItem:focus Border.home-tile-shadow">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="Window:not(.pointer-resting) ListBox.nereus-shelf-tiles ListBoxItem:pointerover Border.home-tile-shadow">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <!-- Which of these two answers the shelf's tiles with is written on the wall's own rules below, where the ring
       and the picture are dressed: this list's tiles ARE the wall's tiles, so they are spelled into those rules
       rather than given a copy of them here.  A copy is what used to sit here, and it lost - the copy stood above
       the wall's own base rules in this file, and a resting tile retook its ghost ring from the base rule it
       shared with them.  A tile that keeps its resting ring while somebody stands on it is a shelf nobody can
       read, so the shelf wears the wall's rules themselves and nothing else. -->


  <!--
    A shelf of ROWS is dressed the way the reference dressed a row: ButtonListViewControlStyle laid the medium
    of the skin's colour over the whole row, a bar of the light of it eight points wide along the row's left
    edge, a shadow hanging a tenth of a point below it and a whisper of white at its right end, and the row's
    own labels came up to white (MediaItemFocussedColor).  Nothing of the platform's is left on top of that:
    the selected row's rectangle, the focus rectangle and the list's own ground are all switched off here,
    because a square of the accent behind a row of names - which is what the generic rule draws - is neither
    the reference's row nor readable, and a frame of the toolkit's own stands around a row the skin already
    drew a ground for.  The ground itself is part of the row's template and only ever shows through these
    selectors.
  -->
  <Style Selector="ListBox.nereus-shelf-rows">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
  </Style>
  <Style Selector="ListBox.nereus-shelf-rows ListBoxItem:pointerover">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
  </Style>
  <Style Selector="ListBox.nereus-shelf-rows ListBoxItem:selected">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <!--
    At rest a row wears nothing: the ground waits for the viewer to stand on the row, which is when the
    reference brought ButtonListViewControlStyle into sight.  The rule is here rather than IsVisible="False"
    on the row's own markup on purpose - a value written into the control is the last word and no trigger
    could take the ground back up.
  -->
  <Style Selector="ListBox.nereus-shelf-rows Panel.nereus-row-ground">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="ListBox.nereus-shelf-rows ListBoxItem:selected Panel.nereus-row-ground,
                  ListBox.nereus-shelf-rows ListBoxItem:focus Panel.nereus-row-ground">
    <Setter Property="IsVisible" Value="True"/>
  </Style>
  <Style Selector="Window:not(.pointer-resting) ListBox.nereus-shelf-rows ListBoxItem:pointerover Panel.nereus-row-ground">
    <Setter Property="IsVisible" Value="True"/>
  </Style>
  <Style Selector="ListBox.nereus-shelf-rows Panel.nereus-row-ground">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.nereus-home-menu ListBoxItem Grid#nereusSelectionBand">
    <!-- The reference's selection band grows out of the bottom edge of its tile: ItemBandGrid turns on with
         ScaleY 0 to 1 over 0.7 seconds on a BackEase of amplitude 0.6, and shrinks back over 0.35 seconds on
         the way out. Scaling rather than fading, and springing rather than gliding - a band that merely
         dimmed in would be a highlight, and the reference made a bounce. -->
    <Setter Property="RenderTransformOrigin" Value="0.5,1"/>
    <Setter Property="RenderTransform" Value="scaleY(0)"/>
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.35" Easing="CubicEaseOut"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.nereus-home-menu ListBoxItem:selected Grid#nereusSelectionBand">
    <Setter Property="RenderTransform" Value="scaleY(1)"/>
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.7" Easing="BackEaseOut"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.nereus-home-menu ScrollViewer">
    <!-- Two things the reference's VerticalMediaScrollViewerStyle did to the menu's viewport, and both were
         missing here: it slides its content over 0.4 seconds rather than jumping (the AnimatedStackPanel
         behind the reference's scrolling), and it fades the top and bottom twelve percent of the column
         away with an OpacityMask, so items dissolve as they leave instead of being cut at the edge. -->
    <Setter Property="Transitions">
      <Transitions>
        <VectorTransition Property="Offset" Duration="0:0:0.4" Easing="CubicEaseOut"/>
      </Transitions>
    </Setter>
    <Setter Property="OpacityMask">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#00000000"/>
        <GradientStop Offset="0.12" Color="#FF000000"/>
        <GradientStop Offset="0.88" Color="#FF000000"/>
        <GradientStop Offset="1" Color="#00000000"/>
      </LinearGradientBrush>
    </Setter>
  </Style>

  <!--
    The wall of settings plates, which is the reference's SettingsMenuItemDataTemplate
    (themes/default/styles/OtherControlsOverrides.xaml:632) dressed in this skin's own numbers. The reference's
    plate is three hundred fifty-five square: a picture area two hundred ninety lines high over a band of sixty
    five, the plate itself #222222, the band black at a half, and the name standing at the left of the band
    seventy six lines in at six tenths of light.

    Three layers make the plate, in the reference's order: the #222222 square, the section's own picture
    (SettingsMenu\<path>.jpg) stretched over the whole of it at eight tenths, and the band with its icon
    (SettingsMenu\Icon_<path>.png) and its name. Those pictures are the reference's own - they ship with MP2's
    default skin images (Source\UI\UiComponents\SkinBase\Skin\default\images\SettingsMenu) and are named after
    the section's place in the configuration tree, so a plate here asks for the same name and gets the same
    picture. A section the reference never drew a plate for - one this front end added on top of MP2's tree -
    asks for a name the skin does not carry and stands as a bare #222222 square, which is what the reference's
    own converter answered with.
    (The square_large.png the reference also painted under all this is covered by the #222222 rectangle it put
    over it, so it is not painted here: it changes nothing there and would change nothing here.)

    What changes under a viewer is the name's and the icon's light, from six tenths to full, exactly as the
    reference's SettingsItemContainerStyle answers focus (:978-996). No scale, no colour, no frame: the wall is
    the same plate stood in a different light.
  -->
  <Style Selector="Border.settings-tile-plate">
    <Setter Property="Width" Value="{DynamicResource SettingsTilePlateWidth}"/>
    <Setter Property="Height" Value="{DynamicResource SettingsTilePlateHeight}"/>
    <Setter Property="Background" Value="{DynamicResource SettingsTilePlateBrush}"/>
  </Style>
  <Style Selector="Image.settings-tile-art">
    <Setter Property="Opacity" Value="{DynamicResource SettingsTileArtOpacity}"/>
    <Setter Property="Stretch" Value="Fill"/>
  </Style>
  <Style Selector="Border.settings-tile-band">
    <Setter Property="Height" Value="{DynamicResource SettingsTileBandHeight}"/>
    <Setter Property="Background" Value="{DynamicResource SettingsTileBandBrush}"/>
  </Style>
  <Style Selector="Image.settings-tile-icon">
    <Setter Property="Margin" Value="{DynamicResource SettingsTileIconMargin}"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Opacity" Value="{DynamicResource SettingsTileIconRestingOpacity}"/>
  </Style>
  <Style Selector="TextBlock.settings-tile-name">
    <Setter Property="Margin" Value="{DynamicResource SettingsTileNameMargin}"/>
    <Setter Property="FontSize" Value="{DynamicResource SmallerFontSize}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Opacity" Value="{DynamicResource SettingsTileNameRestingOpacity}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="MaxLines" Value="1"/>
  </Style>
  <Style Selector="ListBox.settings-tile-wall ListBoxItem:focus TextBlock.settings-tile-name">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="ListBox.settings-tile-wall ListBoxItem:focus Image.settings-tile-icon">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="Window:not(.pointer-resting) ListBox.settings-tile-wall ListBoxItem:pointerover TextBlock.settings-tile-name">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="Window:not(.pointer-resting) ListBox.settings-tile-wall ListBoxItem:pointerover Image.settings-tile-icon">
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <!-- Writing into the front end: the panel, the hairline, the text's own white. -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource OutlineBrush}"/>
  </Style>

  <!-- The four corner buttons of master_home.xaml's WindowButtonsPanel, which this face's home.xaml hangs at
       the top edge: eighty quiet squares, half lit until something stands on them - Buttons.xaml's own
       numbers (Opacity 0.5, and 1 while focused or touched), grown to this screen. They are styled here
       rather than in the screen because they are this face's buttons and no other face hangs them. -->
  <Style Selector="Button.nereus-corner-button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Width" Value="66"/>
    <Setter Property="Height" Value="66"/>
    <!-- The light a stood-on button takes is painted in the button's own corner, and this face writes its buttons
         square - its colour file's ButtonControlRadiusX says 0. Behind a round mark (a power ring, a person's
         head, a gear, a magnifier's bowl) a square of light reads as a box laid under the glyph, so these four
         carry half their own width and the light comes up as a disc. -->
    <Setter Property="CornerRadius" Value="33"/>
    <Setter Property="Opacity" Value="0.5"/>
    <!-- A control that owns a template clips what it draws to its own rectangle, and these squares are sixty-six
         lines wide with a forty-six glyph standing in the middle of them: ten lines of room, which is less than
         the glow below spreads. The light was therefore cut off on a circle - the button's own rounded corner -
         halfway out of the glyph, which reads as a ring laid under the mark rather than as light coming out of
         it. What leans out of a square is nothing but that light, so the clip goes. -->
    <Setter Property="ClipToBounds" Value="False"/>
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
      </Transitions>
    </Setter>
  </Style>
  <!-- The light and the glow a stood-on button takes are one rule per state, below, so that a viewer cannot
     light one half of the answer and not the other. -->
  <!-- Standing on one of the four lights its mark as well: a glow drawn round the glyph, and round nothing
       else. The light sits on the button and not on the shape inside it, for two reasons that point the same way.
       A control that owns a template clips what it draws to its own rectangle, and the shape is the clipped
       child: a glow written on it was cut on the button's own circle halfway out of the glyph. And the plate the
       mark stands on paints nothing at all - these four wear a transparent ground, which is what keeps the rest
       of the fanart whole - so a light written on the button can only ever come out of the one thing the button
       really draws, which is the glyph. A lit plate would answer the key from the whole sixty-six square instead
       of from the mark the viewer is looking for, and that is what the transparent ground prevents.
       The glow is white and it is generous: sixteen lines of it spread out of the glyph at full strength. A
       coloured glow over this face's pictures - the family's accent, which is what this used to wear - reads as
       a tint laid over the mark rather than as light coming out of it, and a white one of this size lifts the
       glyph off whatever happens to be standing behind it, which is the whole point of the answer.
       Both ways of standing on a button light the mark, and with the same glow: a viewer who walks the row with
       the ring and a viewer who drags a mouse across it must see the same thing happen, or the screen looks
       broken to whichever of them arrived second. The pointer's half stands behind the window's own gate, so a
       pointer that was merely left on the screen does not go on claiming somebody stands there. -->
  <Style Selector="Button.nereus-corner-button:focus">
    <Setter Property="Opacity" Value="1"/>
    <Setter Property="Effect">
      <DropShadowEffect BlurRadius="16" Color="#FFFFFFFF" OffsetX="0" OffsetY="0" Opacity="1"/>
    </Setter>
  </Style>
  <Style Selector="Window:not(.pointer-resting) Button.nereus-corner-button:pointerover">
    <Setter Property="Opacity" Value="1"/>
    <Setter Property="Effect">
      <DropShadowEffect BlurRadius="16" Color="#FFFFFFFF" OffsetX="0" OffsetY="0" Opacity="1"/>
    </Setter>
  </Style>

  <!-- The tiles of the home's content wall: the quiet dark they stand on, the edge one wears the moment
       something stands on it, the rounding of their corners and the shadow they cast. The shelf itself is the
       general screen's (it hosts the classes), what a tile looks like is this face's - which is why these
       numbers live here and not in a view.

       The shadow is the native BoxShadow of the tile's ground: a slight lean to the bottom right (3 right, 4
       down) blurred a little wider than it leans, in a black a shade over two-fifths - enough to read as depth
       against the bright fanart without smearing it. The ground carries it because a clipped edge clips its own
       shadow away - the face inside is what clips the picture, and both are rounded to the same 10. -->
  <Style Selector="Button.nereus-content-tile">
    <Setter Property="Background" Value="#222222"/>
    <!-- No border of the button's own, and no focus adorner either. The generic Button style above dresses every
         button in the skin with the palette's OutlineBrush - a fifth-of-white line one pixel thick - and the
         control's own theme answers focus with an adorner drawn OUTSIDE the button's bounds. Both of those are a
         second and a third edge round this tile: a resting line the ring does not sit on, and a focus frame that
         can never meet it because it is drawn a pixel further out. The one edge a cover wears is the ring laid
         over its face (Border.home-tile-edge), at the tile's own corner and its own two of thickness; that is the
         line that brightens when a viewer stands on the tile, and nothing else may draw an edge here. -->
    <Setter Property="BorderBrush" Value="#00000000"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Opacity" Value="0.86"/>
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.nereus-content-tile:focus">
    <Setter Property="Background" Value="#444444"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="Border.home-tile-shadow">
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="BoxShadow" Value="3 4 16 0 #70000000"/>
  </Style>
  <Style Selector="Border.home-tile-face">
    <Setter Property="CornerRadius" Value="10"/>
  </Style>

  <!-- The picture a cover on the wall wears. Standing on the tile steps it a tenth nearer, for the same reason
       the tiles of the main menu do: the tile itself does not change size, its artwork does, and a picture
       growing out of its frame says "this one" without anybody drawing a frame round it. Half a second on a sine,
       so the move is felt rather than watched, and the same curve carries it back when the viewer walks on. The
       face clips the picture to the tile's own rounded square, so nothing of the growth spills past the edge, and
       the name in its band stays where it was - only the picture moves. -->
  <Style Selector="Image.home-tile-art">
    <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
    <Setter Property="RenderTransform" Value="scale(1)"/>
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.5" Easing="SineEaseInOut"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.nereus-content-tile:focus Image.home-tile-art, ListBox.nereus-shelf-tiles ListBoxItem:focus Image.home-tile-art">
    <Setter Property="RenderTransform" Value="scale(1.1)"/>
  </Style>
  <Style Selector="Window:not(.pointer-resting) Button.nereus-content-tile:pointerover Image.home-tile-art, Window:not(.pointer-resting) ListBox.nereus-shelf-tiles ListBoxItem:pointerover Image.home-tile-art">
    <Setter Property="RenderTransform" Value="scale(1.1)"/>
  </Style>

  <!-- A tile of the main menu wears the same ten of rounding as the covers on the wall, and the template clips
       it to that corner: the tile paints its own square ground, its artwork and its label band over the whole
       of itself, and without the clip every one of them ends in a right angle the round corner would only
       cover up. Rounded here rather than drawn in the tile, because the corner is this face's, not the
       screen's. -->
  <Style Selector="Border.nereus-menu-tile">
    <Setter Property="Background" Value="#222222"/>
    <Setter Property="CornerRadius" Value="10"/>
  </Style>

  <!-- The picture a main menu tile wears, which the tile itself leaves undressed so that these numbers win:
       three quarters of light while the tile waits, and the full picture the moment something stands on it.
       Full light is the ceiling a picture has - opacity cannot pass 1, so "brighter than whole" is not a
       thing glass or paint can do; the lift is the quarter the resting tile holds back.
       Standing on a tile is meant strictly here, and in two senses:
       - Light is cheap. The entry whose wall the screen is showing wears the full light wherever the viewer
         is, because the screen is about that entry, and so does any tile a viewer or a pointer is standing on.
       - Growth is not. Only the standing entry's picture steps a tenth nearer, and only while someone is
         actually on it. A tile that is merely the tile the arrow points at has to stay in its frame, because
         the growth means "this entry is what you are looking at", and a tile that grows the moment the focus
         passes it says that about nineteen entries in a row while the viewer walks the rail.
       The growth is meant to be felt rather than watched, so it takes a half second on a sine - no jerk at
       the start, nothing arriving all at once - while the light itself comes quicker, and a leaving tile
       settles back on the same curve. The zoom is about the middle of the picture, not its top left corner,
       and the tile clips the picture to its own rounded square, so the growth reads as the artwork filling
       out of the frame rather than as the frame sliding. -->
  <Style Selector="Image.nereus-menu-art">
    <Setter Property="Opacity" Value="0.75"/>
    <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
    <Setter Property="RenderTransform" Value="scale(1)"/>
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut"/>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.5" Easing="SineEaseInOut"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBoxItem:selected Image.nereus-menu-art">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="ListBoxItem:focus Image.nereus-menu-art">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="Window:not(.pointer-resting) ListBoxItem:pointerover Image.nereus-menu-art">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <!-- The two together, and only these: the entry the screen is about, with someone standing on it. -->
  <Style Selector="ListBoxItem:selected:focus Image.nereus-menu-art">
    <Setter Property="RenderTransform" Value="scale(1.1)"/>
  </Style>
  <Style Selector="Window:not(.pointer-resting) ListBoxItem:selected:pointerover Image.nereus-menu-art">
    <Setter Property="RenderTransform" Value="scale(1.1)"/>
  </Style>

  <!-- The band a main menu tile's name stands on: the same fade the strip under a cover on the wall paints,
     black out of the tile's bottom edge into nothing, instead of the flat plate that hid the picture behind
     it. The band stretches with the tile, so the fade always spans exactly the band. -->
  <Style Selector="Rectangle.nereus-menu-band">
    <Setter Property="Fill" Value="{DynamicResource TitleFadeBrush}"/>
  </Style>

  <!-- The strip the tile's title stands on: Nereus paints no plate but fades black up out of the tile's own
     bottom edge into nothing, over exactly the height the strip has, so the picture stays whole and the name
     still reads. The name is centred, which is how the reference centres it. -->
  <Style Selector="Border.home-tile-caption">
    <Setter Property="MinHeight" Value="45"/>
    <Setter Property="Background" Value="{DynamicResource TitleFadeBrush}"/>
  </Style>
  <Style Selector="TextBlock.home-tile-caption-title">
    <Setter Property="TextAlignment" Value="Center"/>
  </Style>
  <!-- The head over a band of the wall. One label per band, in the face's bold at the size the reference set for
       it (SmallerFontSize), left-aligned over the band's own margin - the size is the skin's number, not the
       screen's, so a face that draws its heads bigger moves one value and every band follows. -->
  <Style Selector="TextBlock.home-band-heading">
    <Setter Property="FontSize" Value="{DynamicResource HomeBandHeadingFontSize}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Margin" Value="12,4,0,0"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
  </Style>

  <!-- A leftover plugin's plaque, dressed the way the reference dresses it and not like a cover.

       A cover stands on a dark plate with a photograph on it, so its picture is cropped to the plate and the
       name fades up out of the tile's own bottom edge. A plugin's plaque is the other way round: its ground IS
       the face's colour - the middle of the three the viewer's chosen colour family is spelled in, which is the
       same brush the reference called NereusColorMedium - and the plugin's picture is stretched over that ground
       rather than cropped to it, because the picture is an emblem and not a photograph: cutting the wing off a
       logo is worse than a little slack at its sides.

       Under the name the reference lays a flat plate of black at four tenths, forty lines of its 1080 high, and
       nothing else: no second line explaining the plugin (nineteen squares cannot hold a sentence), no frost
       behind it (a plaque has a ground of its own), and no picture stepping nearer when a viewer stands on it.
       What does answer being stood on is the name, from six tenths of light to full light - and the shared edge
       every other tile on the wall wears, because one edge for a whole wall is the point. -->
  <Style Selector="Button.nereus-plugin-tile">
    <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}"/>
    <Setter Property="BorderBrush" Value="#00000000"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Border.plugin-tile-face">
    <Setter Property="CornerRadius" Value="10"/>
  </Style>
  <Style Selector="Border.plugin-tile-band">
    <Setter Property="MinHeight" Value="{DynamicResource PluginTileBandHeight}"/>
    <Setter Property="Background" Value="{DynamicResource PluginTileBandBrush}"/>
    <Setter Property="Padding" Value="6,2"/>
  </Style>
  <Style Selector="TextBlock.plugin-tile-name">
    <Setter Property="FontSize" Value="{DynamicResource PluginTileNameFontSize}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="Opacity" Value="{DynamicResource PluginTileNameRestingOpacity}"/>
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.nereus-plugin-tile:focus TextBlock.plugin-tile-name">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="Window:not(.pointer-resting) Button.nereus-plugin-tile:pointerover TextBlock.plugin-tile-name">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <!-- The plaque's edge speaks with the same four stops as the glasses' and the covers', for the same reason. -->
  <Style Selector="Button.nereus-plugin-tile:focus Border.home-tile-edge">
    <Setter Property="BorderBrush">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#FFFFFFFF"/>
        <GradientStop Offset="0.35" Color="#B3FFFFFF"/>
        <GradientStop Offset="0.72" Color="#66FFFFFF"/>
        <GradientStop Offset="1" Color="#CCFFFFFF"/>
      </LinearGradientBrush>
    </Setter>
  </Style>
  <Style Selector="Window:not(.pointer-resting) Button.nereus-plugin-tile:pointerover Border.home-tile-edge">
    <Setter Property="BorderBrush">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#FFFFFFFF"/>
        <GradientStop Offset="0.35" Color="#B3FFFFFF"/>
        <GradientStop Offset="0.72" Color="#66FFFFFF"/>
        <GradientStop Offset="1" Color="#CCFFFFFF"/>
      </LinearGradientBrush>
    </Setter>
  </Style>

  <!-- The shortcut tiles: glass, and only they are. A cover wants a plate to stand on, an icon wants the room
       behind it - so the icons are cut out of the picture behind them rather than painted over a dark square.

       Glass means three things and all three are here.

       It lets the picture through, FROSTED. The tile holds the screen's own fanart and blurs it, and the piece it
       holds is the piece standing behind THAT tile: the front end moves the frosting onto the wall behind it, so
       a tile lower down the rail frosts the bottom of the poster and one at the top frosts its sky. The frosting
       is a property of the glass and not a state - it is on wherever the glass lies, whether or not anything
       stands on it, and it covers the tile completely: frosting that is half transparent lets the sharp picture
       through and is no frosting at all, only a soft smudge over the wall.

       It has body, which is the veil lying over the frost - light thrown back along the top edge, weight
       gathering at the bottom where the name stands. Standing on a tile draws that veil together, and that is the
       morph: the glass reads as thicker than the ones beside it. Nothing scales and nothing changes shape; the
       corner stays the corner it has always had, because glass that changes its own shape is not glass.

       And it has an edge that catches the light: the frame is a gradient, bright where the light comes from, thin
       through the middle, bright again where the glass turns away. One flat line all the way round is what makes
       a rounded rectangle look like a filled shape with a stroke on it rather than something with thickness.

       What is left for the icon is the last thing a viewer's eye lands on, so it is the thing that moves: the
       outline of the glyph draws itself round the filled icon, and the icon lifts a twelfth of its own size off
       the glass.

       Two arrangements matter. The Button is what casts the shadow and it clips nothing - a shadow that lived
       inside a clipped edge would be clipped away with everything else - so the face inside it is the surface
       that clips the frost, and the frosting overshoots the face by more than its own blur so that the edge
       being clipped away is blurred glass rather than a soft transparent fringe. And the veil sits above the
       frost rather than under it: white misted over a picture is what glass looks like, and white behind a
       picture is nothing at all. -->
  <Style Selector="Button.nereus-shortcut-tile">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="10"/>
    <!-- The button the control's own theme hands it is clipped to its bounds, and this button's bounds ARE the
         tile - 159 by 159 - while the glass standing in it throws its shadow outside those bounds. Clipped, the
         shadow was drawn every frame and every pixel of it fell outside the cut: a photograph of the running
         screen shows the tile sitting flat on the wall with no shadow at all, and no setting on the glass could
         deepen its way back through the cut. So the button lets its own child lean over its edge. -->
    <Setter Property="ClipToBounds" Value="False"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
  </Style>

  <!-- The shortcut casts the same shadow as every other tile on the wall, and it wears it the same way: the
       HomeView wraps this tile in the shared Border.home-tile-shadow, the very class the covers stand in, so the
       one BoxShadow the skin knows - three right, four down, sixteen of blur, a shade under half black - lies
       under a shortcut exactly as it lies under a poster. The glass itself draws none: the frosting surface can
       throw a shadow of its own, and it did, and a second shadow next to the skin's is how a shortcut came to sit
       on the wall in a darkness none of its neighbours had. One shadow, and it is the tile's, not the shader's. -->

  <!-- The edge a tile wears, whether it is glass or a cover: thin, brightest where the light comes from, nearly
       gone before it turns away at the bottom. It is laid OVER the edge of the tile rather than wrapped around
       it, at the tile's own corner. A frame around a surface is a second edge: the surface cuts itself to one
       circle and the frame to another, two of its own thickness apart, and the step a viewer sees where those
       two circles disagree is the artifact that sat in every corner of these tiles until the frame stopped
       cutting and started covering.

       At rest it is a ghost of itself - a fifth of the light it used to carry - because a ring that is bright
       while nothing stands on the tile is the thing everybody notices and nobody asked for. It comes up to full
       light when a viewer stands on the tile, which is where an edge that says "this one" earns its place, and
       it says it for the glasses and the covers alike: one edge, one set of numbers, so a rail of shortcuts and
       the covers beside them answer being stood on in the same voice. Both brushes are the same four stops down
       the same line, so the transition moves the light rather than cutting from one ring to another. -->
  <Style Selector="Border.home-tile-edge">
    <Setter Property="CornerRadius" Value="10"/>
    <!-- Two of these, not three: at three the ring measured as a white outline drawn round the tile rather than
         as the edge of the tile catching the light, and the light it catches is above it, not under it. -->
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="BorderBrush">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#21FFFFFF"/>
        <GradientStop Offset="0.35" Color="#0DFFFFFF"/>
        <GradientStop Offset="0.72" Color="#08FFFFFF"/>
        <GradientStop Offset="1" Color="#16FFFFFF"/>
      </LinearGradientBrush>
    </Setter>
    <!-- Deliberately no transition on this brush. A ring that has to fade UP is a ring that is not there while
         it fades: at three tenths of a second, a viewer walking two tiles to the right in one breath - which is
         how anybody moves along a wall - arrives a third of the way into the fade, reads the tile they landed on
         as standing on nothing, and still sees the light of the tile they left. Nereus knows no fade here at all;
         its skin engine hands the ring from tile to tile in one step, and that is also the only answer which
         stays honest on a screen that paints its frames slower than the walk goes over them. -->
  </Style>

  <!-- The glass is not styled here at all. It is the liquid glass surface in HomeView itself - the shader bends
       the screen as it stands behind THIS tile, so there is no picture to hand it, no place to line it up with,
       and no number a focus state could change: the lensing belongs to the glass and not to standing on it. What
       the glass looks like - how deep the blur, how cool the tint, how the edge bends the picture - is written
       on that surface, next to the tile it dresses. -->

  <!-- The body of the glass, above the frost it frosts: the light the glass throws back at the top, and the
       weight it gathers at the bottom, where the name stands. It is the veil that lets the frosted picture
       THROUGH without letting the sharp one through, so it is no longer near-invisible - over a busy, high
       contrast wall a thin veil leaves the hard edges of the poster reading straight through the glass and the
       tile stops being glass at all. A gradient rather than a band, because a band is a rectangle and a
       rectangle inside a rounded frame lies across the corners of it. -->
  <Style Selector="Border.home-shortcut-tint">
    <Setter Property="IsHitTestVisible" Value="False"/>
    <!-- The veil wears the glass's own corner. It fills the whole of the glass, so a veil with square corners is
         a square lying under a round pane: it shows in all four corners as a light spandrel, and no clip on
         anything above it can be blamed for that. -->
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Opacity" Value="0.9"/>
    <!-- Smoked, not cellared. The veil has to sit under the wall's own brightness or the tile is a pale plate
         again, but it was pressed far past that: four-fifths black at the bottom made the glass darker than a
         shadowed poster and the rail read as five holes cut in the picture. So the bottom keeps half its weight
         rather than seven-tenths, and the light along the top is the top's own.
         Standing on the tile LIGHTENS this - see the focus and pointerover rules at the bottom of the file.
         Both brushes are four stops down the same line, so the veil's background travels between them instead of
         cutting from one to the other. -->
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#2EFFFFFF"/>
        <GradientStop Offset="0.3" Color="#1F0A1018"/>
        <GradientStop Offset="0.7" Color="#4D000000"/>
        <GradientStop Offset="1" Color="#73000000"/>
      </LinearGradientBrush>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut"/>
        <BrushTransition Property="Background" Duration="0:0:0.3" Easing="CubicEaseOut"/>
      </Transitions>
    </Setter>
  </Style>

  <!-- The glyph, on the glass and centred in what is left above its name, at sixty-eight hundredths of the
       screen's own white: an icon at full white shouts over the name under it.

       On top of the filled icon lies its own outline, transparent where the tile rests and lit to the screen's
       white when something stands on it: the icon catches light along its edge. The icon lifts a twenty-fifth off
       the glass while that happens, on a back ease, so it springs past its standing height and settles back -
       and the tile under it stays exactly where it was. -->
  <Style Selector="Path.home-shortcut-glyph">
    <Setter Property="Fill" Value="{DynamicResource TextBrush}"/>
    <!-- These glyphs are solid shapes, not line drawings, so the stroke is not what draws them - it is the rim
         of light that lights up around one when a hand lands on its tile. Thin on purpose: half of it sits on
         the fill and half grows outward, and an icon that swells by five pixels reads as a misprint. Parked
         transparent at rest, because a transition needs something to come from. -->
    <Setter Property="Stroke" Value="Transparent"/>
    <!-- Twenty percent thinner again, on top of the thirty percent it already lost: 0.6 -> 0.42 -> 0.34. At
         nought-six the rim of light that comes up round a focused icon read as a heavy outline drawn round the
         shape rather than as light catching its edge, and a fifth under nought-four-two is still light on an
         edge, not a line round a shape. -->
    <Setter Property="StrokeThickness" Value="0.34"/>
    <Setter Property="StrokeLineCap" Value="Round"/>
    <Setter Property="StrokeJoin" Value="Round"/>
    <!-- Seven-tenths at rest, the same as the name under it: a rail is read as a row, and the tile a viewer
         stands on is the one that comes up to full white. -->
    <Setter Property="Opacity" Value="0.7"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <!-- The name stands under it on the same glass, so the icon does not stand in the middle of the tile but
         in the middle of what is left above the name: a bottom margin twice the lift pulls the centred glyph
         a fifth of the way up the tile - twenty-two pixels on a rail tile - without a wrapper around it. -->
    <Setter Property="Margin" Value="0,0,0,44"/>
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
    <Setter Property="RenderTransform" Value="scale(1)"/>
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.24"/>
        <BrushTransition Property="Stroke" Duration="0:0:0.3"/>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.42" Easing="BackEaseOut"/>
      </Transitions>
    </Setter>
  </Style>

  <!-- Nothing travels across this glass. There used to be a bar of light sent over the tile whenever focus
       moved onto it, and it was wrong twice over: a highlight that sweeps the whole tile is an animation doing
       something to the picture rather than the tile answering the hand that stood on it, and standing on tile
       after tile as the rail walks itself put a reflection through every one of them, one after another, all
       over the artwork. What a tile does when something stands on it is said in its edge, its background and
       its glyph - see the rules at the bottom of the file - and nothing moves across the glass itself. -->

  <!-- The name, on the glass rather than on a band of its own: centred along the bottom of the tile, and given a
       shadow instead of a plate, so it reads over the frost without covering any of it.

       At rest it stands at seven-tenths, the same as the icon above it: the five tiles of a rail are read as a
       row, and the one a viewer stands on is the one that comes up to full white - name included. -->
  <Style Selector="TextBlock.home-shortcut-caption">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Bottom"/>
    <Setter Property="Margin" Value="10,0,10,10"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Opacity" Value="0.7"/>
    <Setter Property="Effect">
      <DropShadowEffect BlurRadius="7" Color="#CC000000" OffsetX="0" OffsetY="1"/>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.24"/>
      </Transitions>
    </Setter>
  </Style>

  <!-- What standing on the glass does. Three things, all of them said by the tile itself and none of them a
       movement across the picture behind it: the BACKGROUND COMES UP, so the glass under the pointer is
       visibly the lighter one; the edge, which at rest is barely there, comes up to full light; and the
       outline of the glyph draws itself round the icon while the icon lifts off the glass. The frost stays
       exactly as it was - it is the glass, not a state of it - and so do the corner, the tile's own size and
       the shadow it stands on, which belongs to the tile and not to standing on it. -->
  <Style Selector="Button.nereus-shortcut-tile:focus Border.home-tile-edge">
    <Setter Property="BorderBrush">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#FFFFFFFF"/>
        <GradientStop Offset="0.35" Color="#B3FFFFFF"/>
        <GradientStop Offset="0.72" Color="#66FFFFFF"/>
        <GradientStop Offset="1" Color="#CCFFFFFF"/>
      </LinearGradientBrush>
    </Setter>
  </Style>
  <Style Selector="Window:not(.pointer-resting) Button.nereus-shortcut-tile:pointerover Border.home-tile-edge">
    <Setter Property="BorderBrush">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#FFFFFFFF"/>
        <GradientStop Offset="0.35" Color="#B3FFFFFF"/>
        <GradientStop Offset="0.72" Color="#66FFFFFF"/>
        <GradientStop Offset="1" Color="#CCFFFFFF"/>
      </LinearGradientBrush>
    </Setter>
  </Style>
  <!-- The covers beside the glasses say it the same way, with the same four stops: the frame they used to answer
       focus with was a flat four pixel white line of their own, and one voice for a whole rail is the point. -->
  <Style Selector="Button.nereus-content-tile:focus Border.home-tile-edge, ListBox.nereus-shelf-tiles ListBoxItem:focus Border.home-tile-edge">
    <Setter Property="BorderBrush">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#FFFFFFFF"/>
        <GradientStop Offset="0.35" Color="#B3FFFFFF"/>
        <GradientStop Offset="0.72" Color="#66FFFFFF"/>
        <GradientStop Offset="1" Color="#CCFFFFFF"/>
      </LinearGradientBrush>
    </Setter>
  </Style>
  <Style Selector="Window:not(.pointer-resting) Button.nereus-content-tile:pointerover Border.home-tile-edge, Window:not(.pointer-resting) ListBox.nereus-shelf-tiles ListBoxItem:pointerover Border.home-tile-edge">
    <Setter Property="BorderBrush">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#FFFFFFFF"/>
        <GradientStop Offset="0.35" Color="#B3FFFFFF"/>
        <GradientStop Offset="0.72" Color="#66FFFFFF"/>
        <GradientStop Offset="1" Color="#CCFFFFFF"/>
      </LinearGradientBrush>
    </Setter>
  </Style>
  <!-- The background of the glass LIGHTENS when something stands on it. The resting veil is dark at the bottom
       because glass has weight and the name has to read on it; the lit veil trades that black for white, so a
       viewer sees which tile is the one under them before they look at the name. Both brushes are four stops
       down the same line, which is what lets the transition carry one into the other. -->
  <Style Selector="Button.nereus-shortcut-tile:focus Border.home-shortcut-tint">
    <Setter Property="Opacity" Value="1"/>
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#66FFFFFF"/>
        <GradientStop Offset="0.3" Color="#40FFFFFF"/>
        <GradientStop Offset="0.7" Color="#33141C26"/>
        <GradientStop Offset="1" Color="#4D0C1218"/>
      </LinearGradientBrush>
    </Setter>
  </Style>
  <Style Selector="Window:not(.pointer-resting) Button.nereus-shortcut-tile:pointerover Border.home-shortcut-tint">
    <Setter Property="Opacity" Value="1"/>
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#66FFFFFF"/>
        <GradientStop Offset="0.3" Color="#40FFFFFF"/>
        <GradientStop Offset="0.7" Color="#33141C26"/>
        <GradientStop Offset="1" Color="#4D0C1218"/>
      </LinearGradientBrush>
    </Setter>
  </Style>
  <!-- And the mark lights the way the four corner buttons light theirs: the same white glow, sixteen lines of
       it, written on the glyph and nothing else - the one thing the tile really draws, so the light comes out
       of the mark the viewer is looking for rather than out of the glass around it. Both ways of standing on
       the tile say it with the same glow, as they must. -->
  <Style Selector="Button.nereus-shortcut-tile:focus Path.home-shortcut-glyph">
    <Setter Property="Opacity" Value="1"/>
    <Setter Property="Stroke" Value="{DynamicResource TextBrush}"/>
    <Setter Property="RenderTransform" Value="scale(1.06)"/>
    <Setter Property="Effect">
      <DropShadowEffect BlurRadius="16" Color="#FFFFFFFF" OffsetX="0" OffsetY="0" Opacity="1"/>
    </Setter>
  </Style>
  <Style Selector="Window:not(.pointer-resting) Button.nereus-shortcut-tile:pointerover Path.home-shortcut-glyph">
    <Setter Property="Opacity" Value="1"/>
    <Setter Property="Stroke" Value="{DynamicResource TextBrush}"/>
    <Setter Property="RenderTransform" Value="scale(1.06)"/>
    <Setter Property="Effect">
      <DropShadowEffect BlurRadius="16" Color="#FFFFFFFF" OffsetX="0" OffsetY="0" Opacity="1"/>
    </Setter>
  </Style>
  <!-- The name comes up with the icon, not after it: standing on the tile takes both to full white. -->
  <Style Selector="Button.nereus-shortcut-tile:focus TextBlock.home-shortcut-caption">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="Window:not(.pointer-resting) Button.nereus-shortcut-tile:pointerover TextBlock.home-shortcut-caption">
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <!-- THE SKIN'S PRIMARY BUTTON (Button.nereus-primary).

       The shortcut tile's design, at corners of fifty per cent: the same veil lying over the pane - light thrown
       back along the top edge, weight gathering at the bottom - the same frame that catches light where the light
       comes from and turns away at the bottom, and the same answer to being stood on: the veil trades its black
       for white, the frame comes up to full light, the word comes to full white. One height for the whole skin,
       fifty-six, which is what makes the corner twenty-eight and the corner therefore fifty per cent of the
       button by construction: whoever puts a primary button somewhere writes the class and not the numbers.

       Two things the tile does and this button leaves out, both for the same reason. It frosts nothing, because a
       shortcut frosts the fanart standing behind it while a button in a dialog has the dialog's own black behind
       it, and there is nothing to frost in black. And it casts no shadow, because the tile's shadow is a black
       shadow thrown on a bright wall and a black shadow on a black ground is a shadow nobody sees. -->
  <Style Selector="Button.nereus-primary">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <!-- The height is written here rather than left to the word inside, because a primary button that only knows
         the height of its letters is a button a crowded dialog can squeeze into a sliver - which is exactly what
         this file got wrong once, with an OK the viewer could only guess at. -->
    <Setter Property="Height" Value="56"/>
    <Setter Property="CornerRadius" Value="28"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource SmallerFontSize}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="ClipToBounds" Value="False"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
    <Setter Property="Template">
      <ControlTemplate TargetType="Button">
        <Panel>
          <Border Classes="nereus-primary-veil"/>
          <Border Classes="nereus-primary-edge"/>
          <!-- The word has to be handed over by name. A ContentPresenter standing in a template does not pick up
               what the button was given; the platform's own templates say Content="{TemplateBinding Content}" and
               an omitted one of those is a button that shows its glass, its edge and its height and no word at
               all - which is precisely how this button came to look empty twice over. -->
          <ContentPresenter Margin="20,0"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- The veil, at rest: the glass's own four stops, light at the top and weight at the bottom, and the corner
       the button has. Nothing about the button is dressed with a local value, so every one of these numbers is
       something a state rule can out-rank. -->
  <Style Selector="Button.nereus-primary /template/ Border.nereus-primary-veil">
    <Setter Property="CornerRadius" Value="28"/>
    <Setter Property="Opacity" Value="0.9"/>
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#2EFFFFFF"/>
        <GradientStop Offset="0.3" Color="#1F0A1018"/>
        <GradientStop Offset="0.7" Color="#4D000000"/>
        <GradientStop Offset="1" Color="#73000000"/>
      </LinearGradientBrush>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <!-- The fade that matters is the one between the two veils, and it is the brush travelling; the ten per
             cent of opacity a button carries at rest is nothing to animate, and an opacity that animates cannot
             be read at the moment a state is asked for - which is what a test has to do to find out whether the
             skin still answers being stood on. -->
        <BrushTransition Property="Background" Duration="0:0:0.3" Easing="CubicEaseOut"/>
      </Transitions>
    </Setter>
  </Style>
  <!-- The edge at rest is a ghost of the light it carries, the same as the tile's: a frame that is bright while
       nothing stands on the button is the thing everybody notices and nobody asked for. -->
  <Style Selector="Button.nereus-primary /template/ Border.nereus-primary-edge">
    <Setter Property="CornerRadius" Value="28"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="BorderBrush">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#21FFFFFF"/>
        <GradientStop Offset="0.35" Color="#0DFFFFFF"/>
        <GradientStop Offset="0.72" Color="#08FFFFFF"/>
        <GradientStop Offset="1" Color="#16FFFFFF"/>
      </LinearGradientBrush>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.3"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.nereus-primary /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.7"/>
    <Setter Property="TextBlock.TextAlignment" Value="Center"/>
  </Style>
  <!-- What standing on it does, in the tile's own words and with the tile's own stops. -->
  <Style Selector="Button.nereus-primary:focus /template/ Border.nereus-primary-veil">
    <Setter Property="Opacity" Value="1"/>
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#66FFFFFF"/>
        <GradientStop Offset="0.3" Color="#40FFFFFF"/>
        <GradientStop Offset="0.7" Color="#33141C26"/>
        <GradientStop Offset="1" Color="#4D0C1218"/>
      </LinearGradientBrush>
    </Setter>
  </Style>
  <Style Selector="Window:not(.pointer-resting) Button.nereus-primary:pointerover /template/ Border.nereus-primary-veil">
    <Setter Property="Opacity" Value="1"/>
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#66FFFFFF"/>
        <GradientStop Offset="0.3" Color="#40FFFFFF"/>
        <GradientStop Offset="0.7" Color="#33141C26"/>
        <GradientStop Offset="1" Color="#4D0C1218"/>
      </LinearGradientBrush>
    </Setter>
  </Style>
  <Style Selector="Button.nereus-primary:focus /template/ Border.nereus-primary-edge">
    <Setter Property="BorderBrush">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#FFFFFFFF"/>
        <GradientStop Offset="0.35" Color="#B3FFFFFF"/>
        <GradientStop Offset="0.72" Color="#66FFFFFF"/>
        <GradientStop Offset="1" Color="#CCFFFFFF"/>
      </LinearGradientBrush>
    </Setter>
  </Style>
  <Style Selector="Window:not(.pointer-resting) Button.nereus-primary:pointerover /template/ Border.nereus-primary-edge">
    <Setter Property="BorderBrush">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#FFFFFFFF"/>
        <GradientStop Offset="0.35" Color="#B3FFFFFF"/>
        <GradientStop Offset="0.72" Color="#66FFFFFF"/>
        <GradientStop Offset="1" Color="#CCFFFFFF"/>
      </LinearGradientBrush>
    </Setter>
  </Style>
  <Style Selector="Button.nereus-primary:focus /template/ ContentPresenter">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="Window:not(.pointer-resting) Button.nereus-primary:pointerover /template/ ContentPresenter">
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <!-- NEREUS' OWN HOME MENU EDITOR (Views/NereusMenuEditView.axaml).
       The reference dressed these rows in its own styles directory - EditMenuStyles.xaml - and the numbers there
       are the numbers here: the name of the line, then up and down at fifty-four by thirty-four, the bin at thirty
       square and the gear at thirty-two, each in its own margin. The name stands at sixty per cent until one of
       those four buttons is stood on, because the line being worked on belongs to its buttons and not to its
       label, and a label shouting over the button the viewer is holding is the wrong way round.

       The pictures are the skin's own, out of the player controls and the entry list: Up.small, Down.small,
       remove and configure, each in a focused and an unfocused face like every other button of this face, and the
       plus above the list. They are asked for by name, so a face that would rather draw these as shapes answers
       the same names with shapes. -->
  <Style Selector="Grid.nereus-editor-row">
    <Setter Property="MinHeight" Value="42"/>
  </Style>
  <Style Selector="TextBlock.nereus-editor-name">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Opacity" Value="0.6"/>
  </Style>
  <Style Selector="Grid.nereus-editor-row:focus-within TextBlock.nereus-editor-name">
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <!-- Neither list brings a ground of its own: the dialog's black IS the ground. What the control theme paints
       behind a list otherwise - a translucent plate, which over this black reads as a coloured panel standing
       inside a dialog that has already said where its surface is - is therefore switched off here, and so is
       the horizontal bar that appears under a list the moment one row wants a pixel more width than the pane
       gives it. Nothing in the editor is meant to slide sideways. -->
  <Style Selector="ListBox.nereus-editor-rows, ListBox.nereus-editor-picks">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <!--
    The home content stop hides the gear out of its lines. The reference showed it there greyed and commandless -
    DialogEditMediaListMenu.xaml defines MoveUp, MoveDown and Remove and no Config_Command, and MenuEditModel
    builds every media list line with IsConfigButtonEnabled false - which is honest but reads as a broken button
    standing on every row of a screen that has one job. Hiding it says the same thing more plainly: the gear
    belongs to a tile of the menu, where it opens that tile's home content, and a line of home content has no
    lists of its own to open. Everything else about the line - name, arrows, bin - stays as the reference drew it.
  -->
  <Style Selector="ListBox.nereus-editor-lists Button.nereus-editor-config">
    <Setter Property="IsVisible" Value="False"/>
  </Style>

  <!-- The picking list is a plain menu of names, as the reference's pickers were: no buttons, and the name the
       viewer is standing on is the only one at full white. -->
  <Style Selector="TextBlock.nereus-editor-pick">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Opacity" Value="0.75"/>
  </Style>
  <Style Selector="ListBox.nereus-editor-picks ListBoxItem:selected TextBlock.nereus-editor-pick">
    <Setter Property="Opacity" Value="1"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="ListBox.nereus-editor-picks ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
  </Style>

  <!-- The five buttons of the editor. Flat and borderless, because the face is the button; the face is what
       steps from its quiet half-light to full white when something stands on it. -->
  <Style Selector="Button.nereus-editor-up, Button.nereus-editor-down, Button.nereus-editor-remove,
                   Button.nereus-editor-config, Button.nereus-editor-add">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.nereus-editor-up, Button.nereus-editor-down">
    <Setter Property="Width" Value="44"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="Margin" Value="3,2"/>
  </Style>
  <Style Selector="Button.nereus-editor-remove">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Margin" Value="3,2,13,2"/>
  </Style>
  <Style Selector="Button.nereus-editor-config">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Margin" Value="13,2"/>
  </Style>
  <Style Selector="Button.nereus-editor-add">
    <Setter Property="Width" Value="56"/>
    <Setter Property="Height" Value="56"/>
  </Style>
  <!-- The five faces of the editor are shapes rather than pictures. The skin carries them as vectors under
       images\Editor (the same arrangement the shortcuts were moved to), a button asks for one by name through
       the skin's icon converter, and the shape then takes the screen's own white - so the same glyph can stand
       half lit at rest, come to full white under a hand or the keyboard, and fall to a tenth for a button that
       cannot be pressed, none of which a photograph of a glyph could ever do. Every face stands INSIDE its
       button and every button inside the row: the reference let its faces overhang their buttons, which it
       could do in rows sixty tall that drew no ground and clipped nothing, while a face here that reaches past
       its row is cut off by that row and the viewer sees the middle of a bin where a bin should be. Templated
       rather than merely dressed because a default button keeps its own plate of a background, and a grey plate
       standing behind a glyph is the mistake this file has made before. -->
  <Style Selector="Button.nereus-editor-glyph">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="Button.nereus-editor-glyph /template/ Path.nereus-editor-face">
    <Setter Property="Fill" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="Opacity" Value="0.5"/>
  </Style>
  <Style Selector="Button.nereus-editor-glyph:focus /template/ Path.nereus-editor-face">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="Window:not(.pointer-resting) Button.nereus-editor-glyph:pointerover /template/ Path.nereus-editor-face">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <!-- A button that cannot be pressed now - the first tile's up, the last tile's down, the gear of a tile that
       opens no list - stands at a tenth lit, so the row keeps its shape while tiles are moved about in it. -->
  <Style Selector="Button.nereus-editor-glyph:disabled /template/ Path.nereus-editor-face">
    <Setter Property="Opacity" Value="0.1"/>
  </Style>

  <Style Selector="Button.nereus-editor-up">
    <Setter Property="Template">
      <ControlTemplate TargetType="Button">
        <Panel Background="Transparent">
          <Path Classes="nereus-editor-face" Width="36" Height="24"
                Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance}, ConverterParameter=Editor/up}"/>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.nereus-editor-down">
    <Setter Property="Template">
      <ControlTemplate TargetType="Button">
        <Panel Background="Transparent">
          <Path Classes="nereus-editor-face" Width="36" Height="24"
                Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance}, ConverterParameter=Editor/down}"/>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.nereus-editor-remove">
    <Setter Property="Template">
      <ControlTemplate TargetType="Button">
        <Panel Background="Transparent">
          <Path Classes="nereus-editor-face" Width="28" Height="28"
                Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance}, ConverterParameter=Editor/remove}"/>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.nereus-editor-config">
    <Setter Property="Template">
      <ControlTemplate TargetType="Button">
        <Panel Background="Transparent">
          <Path Classes="nereus-editor-face" Width="28" Height="28"
                Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance}, ConverterParameter=Editor/configure}"/>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.nereus-editor-add">
    <Setter Property="Template">
      <ControlTemplate TargetType="Button">
        <Panel Background="Transparent">
          <Path Classes="nereus-editor-face" Width="52" Height="52"
                Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance}, ConverterParameter=Editor/add}"/>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- OK is not dressed here. It is the skin's primary button (Button.nereus-primary above), which is the
       shortcut tile's glass with its corners at fifty per cent - the reference dressed its dialog buttons as
       pills too, and a pill is what this is, but a pill of the skin's own glass rather than of two flat whites
       said to turn into the accent. -->

  <!-- The letters of the editor, at the sizes this skin counts in: the name of a tile is SmallFontSize like
       every other line of a reference menu, the tile under the lists and the two lines of small print are not.
       The name stands at sixty per cent until one of its four buttons is stood on. -->
  <Style Selector="TextBlock.nereus-editor-name">
    <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}"/>
  </Style>
  <Style Selector="TextBlock.nereus-editor-pick">
    <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}"/>
  </Style>
  <Style Selector="TextBlock.nereus-editor-sub">
    <Setter Property="FontSize" Value="{DynamicResource SmallerFontSize}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Opacity" Value="0.7"/>
  </Style>
  <Style Selector="TextBlock.nereus-editor-hint">
    <Setter Property="FontSize" Value="{DynamicResource TinyFontSize}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Opacity" Value="0.45"/>
  </Style>
  <Style Selector="TextBlock.nereus-editor-status">
    <Setter Property="FontSize" Value="{DynamicResource TinyFontSize}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Opacity" Value="0.85"/>
  </Style>

  <!-- The home behind an open dialog stands back behind the reference's DialogScreenBackgroundColor, which this
       face wears a little darker than the reference wrote it: the dialog is the only thing lit, and its panel is
       the only thing brighter than what it covers. The shell throws that same home out of focus for the length of
       the question - DialogBackdropBlur in the metrics - so what reaches the viewer is shape and colour rather
       than detail, darkened enough that nothing behind the panel competes with the question. See
       DialogWashBrush in the colours for why this is not the plain scrim.

       :is(UserControl) and not UserControl, because a dialog screen is never a UserControl off the shelf: it is
       a view of the front end, a type written below UserControl, and a plain type name in a selector means that
       type exactly. Written the short way this rule dressed no dialog at all - the wall of faces, the menu
       editor and the notification shelf each stood over a home that went on washed by nothing - and only a bare
       UserControl, which no screen ever is, ever got its ground. -->
  <Style Selector=":is(UserControl).nereus-dialog-screen">
    <Setter Property="Background" Value="{DynamicResource DialogWashBrush}"/>
  </Style>

  <!-- And the same for what holds the frame: every dialog screen of the front end hands its body to the frame
       template through one ContentControl filling it, and such a control is measured to the frame it hosts - to
       the frame's own bounds, not to the halo drawn outside them. Left to clip there, the glow is cut to a
       rectangle at the panel's edge, which is precisely the difference between a dialog that reads as lit and one
       that reads as pasted on; the frames say so themselves ("Nothing here clips, which a shadow needs"). -->
  <Style Selector=":is(UserControl).nereus-dialog-screen > ContentControl">
    <Setter Property="ClipToBounds" Value="False"/>
  </Style>
</Styles>
