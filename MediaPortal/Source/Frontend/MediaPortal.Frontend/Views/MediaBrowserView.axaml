<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MediaPortal.Frontend.ViewModels"
        xmlns:theming="using:MediaPortal.Frontend.Theming"
        xmlns:views="using:MediaPortal.Frontend.Views"
        xmlns:lg="using:LiquidGlassAvaloniaUI"
        xmlns:sys="using:System"
        x:Class="MediaPortal.Frontend.Views.MediaBrowserView"
        x:DataType="vm:MediaBrowserViewModel"
        Name="browser"
        Background="Transparent"
        >

  <!--
    THE LIBRARY SCREEN AS NEREUS LAID IT OUT

    Everything here is a translation of two reference files: <c>master_bare_media.xaml</c> (the room: a hundred
    points of head, the shelf in the middle, two hundred and sixty points of floor) and
    <c>master_mediamenu.xaml</c> (the way a screen's own menu is hung into that room). What those two files say,
    and what is therefore done here:

    - The whole content is one grid shifted two hundred points off the left edge (ClientGrid Margin
      "-200,0,0,-200", columns "200,*"), and the menu panel stands in the two hundred points that are off the
      screen. Opening the menu does not show anything - it slides the content two hundred points to the right and
      the menu walks into the space that used to be off the screen, which is why the menu never covers the shelf.
    - Covers are the exception: their menu hangs under the screen (rows "*,200" with the panel in the second row,
      pushed two hundred points down) and slides up, because a row of covers has nothing to the left of it that a
      rail could stand in.
    - The details are a wide column beside the shelf, drawn on a translucent ground with the title's fanart
      behind it; only covers put their details above their own row instead, centred on a horizontal gradient.
    - Where the details are not beside the shelf, its bottom edge carries the home strip: the title, the studio's
      sentence, the plot and the facts, over the fanart.
    - A hundred points of gradient fall from the top edge and rise from the bottom, so that whatever the shelf
      stands on stays readable.
  -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://MediaPortal.Frontend/Views/ShelfChrome.axaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- A cover for a skin that draws none: the same poster one step larger and the name larger with it,
           which is the difference the reference drew between its grid tile and its cover. -->
      <DataTemplate x:Key="BuiltinCoversTemplate" x:DataType="vm:TitleViewModel">
        <Border Width="300"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1"
                Padding="12"
                Margin="10">
          <StackPanel Spacing="9">
            <Panel Width="272" Height="392">
              <Border Background="{DynamicResource ScreenBackgroundBrush}" />
              <Image Source="{Binding Artwork, Converter={x:Static views:ArtworkConverter.Instance}, ConverterParameter=tile}" Stretch="Uniform" />
            </Panel>
            <TextBlock Text="{Binding SeenMark}"
                       IsVisible="{Binding WatchFlagsShown}"
                       HorizontalAlignment="Center"
                       Opacity="0.8" />
            <TextBlock Text="{Binding Line}"
                       FontSize="22"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap"
                       MaxHeight="60" />
          </StackPanel>
        </Border>
      </DataTemplate>

      <!--
        The same cover with its picture taken out, for the one shape whose covers are PAINTED (BrowserLayout.
        Carousel).  Under the drawn row the list keeps nothing but the caret, and yet its containers wore the frame
        above: every container the panel stood up asked the artwork converter for its poster and had it decoded -
        measured at fourteen decodes a step of the caret, one of which was on the screen at all, while the covers
        the viewer does see were still waiting for the same thread.  The plate stays, the name stays, and every
        number stays where the cover frame has it, because the caret still stands in a container of this size and
        the scroller still measures its extent by it; only the picture is gone, which nothing under the row can
        show.
      -->
      <DataTemplate x:Key="BuiltinCoversBlindTemplate" x:DataType="vm:TitleViewModel">
        <Border Width="300"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1"
                Padding="12"
                Margin="10">
          <StackPanel Spacing="9">
            <Panel Width="272" Height="392">
              <Border Background="{DynamicResource ScreenBackgroundBrush}" />
            </Panel>
            <TextBlock Text="{Binding SeenMark}"
                       IsVisible="{Binding WatchFlagsShown}"
                       HorizontalAlignment="Center"
                       Opacity="0.8" />
            <TextBlock Text="{Binding Line}"
                       FontSize="22"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap"
                       MaxHeight="60" />
          </StackPanel>
        </Border>
      </DataTemplate>

      <!--
        One pair of what is known about a title: the answer, and the word under it, exactly as the reference's
        detail panels wrote it (MediaItemListDetails.inc:109 - the answer first, the word under it in the smaller
        size and at four tenths of its light). A pair is only ever in this list when the library knows the answer,
        so the word never stands over an empty space.
      -->
      <DataTemplate x:Key="MediaFactTemplate" x:DataType="vm:MediaBrowserFact">
        <StackPanel Spacing="2" Margin="0,0,26,10">
          <TextBlock Text="{Binding Value}"
                     FontSize="22"
                     Foreground="{DynamicResource TextBrush}"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Label}"
                     FontSize="15"
                     Foreground="{DynamicResource TextBrush}"
                     Opacity="0.4"/>
        </StackPanel>
      </DataTemplate>

      <!--
        The same pair, measured for the gradient over the row of covers.  Nothing here may drink the column it
        stands in: the answer is cut with points at three hundred forty lines, because "Science-Fiction, Thriller,
        Mystery" is a longer answer than a six hundred twenty line column and the row of covers has a great deal
        less to give than the information screen.  Cut, and said so with the three points - never allowed to push
        its neighbours out of the panel.
      -->
      <DataTemplate x:Key="CoverFactTemplate" x:DataType="vm:MediaBrowserFact">
        <StackPanel Spacing="2" Margin="0,0,26,10">
          <TextBlock Text="{Binding Value}"
                     FontSize="22"
                     MaxWidth="340"
                     Foreground="{DynamicResource TextBrush}"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Label}"
                     FontSize="15"
                     Foreground="{DynamicResource TextBrush}"
                     Opacity="0.4"/>
        </StackPanel>
      </DataTemplate>

      <!-- A film of the collection being read, as it stands in the collection's band: one poster, walked and pressed
           like a person's card.  Its height is the height the collection's card always had - a hundred and fifty five
           points - and its width is that height read at the poster's own proportion of two to three, which is the
           proportion the shelf's posters are cut to: a hundred and three points.  The tile is the size of the tile it
           replaced so that the band's head, the band, and everything above them stay exactly where they were. -->
      <DataTemplate x:Key="CollectionFilmTile" x:DataType="vm:CollectionFilmCard">
        <Border Classes="trackcard collection-film-card home-tile-shadow"
                Focusable="True"
                Width="103"
                Height="155"
                Margin="0,0,8,0"
                ToolTip.Tip="{Binding Title}"
                Tapped="OnCollectionFilmTapped">
          <Panel>
            <Border Classes="collection-film-face" ClipToBounds="True">
              <Image Classes="home-tile-art"
                     Source="{Binding Poster,
                                      Converter={x:Static views:ArtworkConverter.Instance},
                                      ConverterParameter=small}"
                     Stretch="UniformToFill"
                     IsVisible="{Binding ShowsPoster}"
                     IsHitTestVisible="False"/>
            </Border>
            <!-- The poster answers a caret with the same edge the person cards and the wall's covers wear, laid over
                 its own corner.  Its placeholder under a poster that has not landed is the plate's #222222, which is
                 what a cover of the wall stands on for the same moment (HomeView.axaml:781-785). -->
            <Border Classes="home-tile-edge" IsHitTestVisible="False"/>
          </Panel>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <!--
    What this screen dresses for itself alone: the plaques the details row wears as pictures, and the field a
    viewer types a question into. Both are here rather than in the worn skin's styles for the reason the tile
    templates give: no skin was ever written for this screen's own furniture, and a plaque that came from skin
    styles would be invisible on a machine wearing no skin.

    The plates that MORE THAN this screen wears - the rail's tiles, the person's card, the collection's film and
    the track row - are dressed by ShelfChromeStyles.axaml, included at the end of this block; where they sit in
    the order of these rules is the order they always had, so nothing here is overruled that was not overruled
    before.
  -->
  <UserControl.Styles>
    <!--
      One plaque for every answer the details row wears as a picture, so that the row's boxes are one and the
      same box: the subtitle glyph, the 3D logo, the codec, the size and the proportion's glyph all stand in a
      plaque of the same height, and a figure the worn skin carries no picture of stands in the very same plaque
      written in words.  A height is written here rather than padding, because padding lets every picture decide
      the size of its own box - which is what made the row's boxes differ by a dozen lines.
    -->
    <Style Selector="Border.details-logo">
      <Setter Property="Background" Value="#33FFFFFF"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!--
      The plaque the search field stands in, and the box inside it.  The plaque is the details row's plaque
      asked to hold a question instead of an answer - the same forty-eight lines, the same six of corner, the
      same third-of-white ground - because the viewer is being asked to read what they type against the wall
      behind it, and that is exactly what the row's plaques were made for.

      The box inside it is the toolkit's text box undressed.  Left to itself it brings its own white plate, its
      own edge and - the part that cannot be seen coming - its own word colour for the moment the caret stands
      in it, which on this face's light theme is near black: a search field whose typed words turn black on a
      white slab in the middle of a dark wall.  The theme writes those three on the plate INSIDE its template
      (Avalonia.Themes.Fluent's TextBox theme, Border#PART_BorderElement, for the ":pointerover" and ":focus"
      states), so a colour written on the box itself is outbid and the states have to be answered one by one -
      the same lesson the corner marks learned (see Button.nereus-corner-button in this face's styles).
    -->
    <Style Selector="Border.search-field">
      <Setter Property="Background" Value="#33FFFFFF"/>
      <Setter Property="CornerRadius" Value="6"/>
      <!-- Five points lower than the details row's plaques (Border.details-logo, 48), and hung from the head of
           the screen at its top edge: the plate grows downward out of the band, so a lower plate costs the wall
           nothing it had. -->
      <Setter Property="Height" Value="43"/>
      <Setter Property="Padding" Value="12,0,4,0"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <!--  Off, as it is on every plate that lights: the ring's light has to spread past the plate's own
            box, and a Border is one of the few controls whose default is to paint over its edges anyway. -->
      <Setter Property="ClipToBounds" Value="False"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <!-- The plate wears the same ring as the keyboard button beside it, so that the two read as one bench with
         one stood-on end rather than two controls dressed by different hands: the ground lightens, a ring of
         whole white comes up three lines thick and a quiet light stands round the plate.  The ground is the
         house's lightened glass rather than the blue #46658BAA the row wore of old, which stood out as colour
         against everything else here.  The padding gives three points back to the ring, so the magnifier and
         the words under it do not slide right when the plate is stood on. -->
    <Style Selector="Border.search-field:focus-within">
      <Setter Property="Background" Value="#4DFFFFFF"/>
      <Setter Property="BorderBrush" Value="#FFFFFFFF"/>
      <Setter Property="BorderThickness" Value="3"/>
      <Setter Property="Padding" Value="9,0,1,0"/>
      <Setter Property="BoxShadow" Value="0 0 22 4 #73FFFFFF"/>
    </Style>
    <Style Selector="Window:not(.pointer-resting) Border.search-field:pointerover">
      <Setter Property="Background" Value="#4DFFFFFF"/>
      <Setter Property="BorderBrush" Value="#FFFFFFFF"/>
      <Setter Property="BorderThickness" Value="3"/>
      <Setter Property="Padding" Value="9,0,1,0"/>
      <Setter Property="BoxShadow" Value="0 0 22 4 #73FFFFFF"/>
    </Style>
    <!-- The magnifier is the field's own face, so it is the thing that has to say "this plate is the one you are
         in": whole white with a light standing round it once the caret - or the pointer - is on the field, and
         the quiet 0.72 it wears otherwise, which is written here rather than on the mark so that this rule can
         actually outbid it. -->
    <Style Selector="Path.search-mark">
      <Setter Property="Opacity" Value="0.72"/>
    </Style>
    <Style Selector="Border.search-field:focus-within Path.search-mark">
      <Setter Property="Opacity" Value="1"/>
      <Setter Property="Effect">
        <DropShadowEffect BlurRadius="10" Color="#99FFFFFF" OffsetX="0" OffsetY="0"/>
      </Setter>
    </Style>
    <Style Selector="Window:not(.pointer-resting) Border.search-field:pointerover Path.search-mark">
      <Setter Property="Opacity" Value="1"/>
      <Setter Property="Effect">
        <DropShadowEffect BlurRadius="10" Color="#99FFFFFF" OffsetX="0" OffsetY="0"/>
      </Setter>
    </Style>
    <!--
      The keyboard button to the keys that stand over the wall, and one plate with the field's own look: a viewer holding
      the pointer has nothing to type with, and a keyboard button that only a keyboard can open (the reference hung its
      keyboard on a Menu key no remote sends) is no keyButton.  Ten points away from the plate of the field, so the
      two read as one bench of plaques rather than one wide slab, and the same forty-three tall, hung from the
      same head of the screen.  It wears the skin's picture of a keyboard, and that picture of a keyboard with a
      bar through it while the keys stand - which is the whole of its story, so no word is written on it, as
      nowhere else on this row spells out what a picture says.
    -->
    <Style Selector="Button.search-keyboard">
      <Setter Property="Background" Value="#33FFFFFF"/>
      <Setter Property="BorderBrush" Value="#00FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Height" Value="43"/>
      <Setter Property="Width" Value="58"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="10,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <!-- The theme's dotted rectangle is off here as it is on the row of glass: the ring below is the answer
           for a hand and for a remote both, and a dotted box on top of it would be two answers to one question.
           And the button's own clip is off, because the light belonging to the ring has to spread past the
           fifty-eight points of the plate - a button is a ContentControl, which clips by default, and the halo
           would be cut clean at the plate's box (see Button.glass). -->
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
      <Setter Property="ClipToBounds" Value="False"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <!-- What the dress of this plate really is: the theme paints the presenter INSIDE the template rather than
         the button, so a state written on the button alone would be outbid by the grey the theme paints there.
         The binding is live, which is what carries the ring through the states. -->
    <Style Selector="Button.search-keyboard /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{TemplateBinding Background}"/>
      <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}"/>
      <Setter Property="BorderThickness" Value="{TemplateBinding BorderThickness}"/>
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}"/>
    </Style>
    <!-- STOOD ON. A mark that shows nothing when the caret stands on it is a keyboard button the viewer has to find twice:
         with a remote there is no cursor to follow, so the plate itself has to say "here I am". Spelled in the
         one language this face uses for a stood-on plate - the ground lightens, a ring of whole white comes up
         three lines thick, a quiet light stands round it, and the picture inside catches that light (see
         Button.glass:focus). Written twice over, once for the remote and once for the pointer, for the same
         reason the glass row spells it twice: the worn skin dresses every button of the program under a pointer
         with a rule that outranks a short one. -->
    <Style Selector="Button.search-keyboard:focus">
      <Setter Property="Background" Value="#4DFFFFFF"/>
      <Setter Property="BorderBrush" Value="#FFFFFFFF"/>
      <Setter Property="BorderThickness" Value="3"/>
    </Style>
    <Style Selector="Window:not(.pointer-resting) Button.search-keyboard:pointerover">
      <Setter Property="Background" Value="#4DFFFFFF"/>
      <Setter Property="BorderBrush" Value="#FFFFFFFF"/>
      <Setter Property="BorderThickness" Value="3"/>
    </Style>
    <Style Selector="Button.search-keyboard:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="0 0 22 4 #73FFFFFF"/>
    </Style>
    <Style Selector="Window:not(.pointer-resting) Button.search-keyboard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="0 0 22 4 #73FFFFFF"/>
    </Style>
    <!-- The picture inside the plate is whole white, and the plate is a glass that lets the wall's own light
         through - so over a bright part of the wall the two are the same colour and the state the picture tells
         (keys away / keys standing) is unreadable.  A quiet dark standing behind the white settles that on a
         bright wall and costs nothing on a dark one, which is why it is worn at rest and not only when stood on. -->
    <Style Selector="Button.search-keyboard Path">
      <Setter Property="Effect">
        <DropShadowEffect BlurRadius="6" Color="#B3000000" OffsetX="0" OffsetY="0"/>
      </Setter>
    </Style>
    <Style Selector="Button.search-keyboard:focus Path">
      <Setter Property="Effect">
        <DropShadowEffect BlurRadius="8" Color="#CC000000" OffsetX="0" OffsetY="0"/>
      </Setter>
    </Style>
    <Style Selector="Window:not(.pointer-resting) Button.search-keyboard:pointerover Path">
      <Setter Property="Effect">
        <DropShadowEffect BlurRadius="8" Color="#CC000000" OffsetX="0" OffsetY="0"/>
      </Setter>
    </Style>
    <Style Selector="Button.search-keyboard:pressed">
      <Setter Property="Background" Value="{DynamicResource PanelPressedBrush}"/>
      <Setter Property="Opacity" Value="0.75"/>
    </Style>
    <Style Selector="TextBox.search-box">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
      <Setter Property="PlaceholderForeground" Value="{DynamicResource MutedTextBrush}"/>
    </Style>
    <Style Selector="TextBox.search-box:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.search-box:focus">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style Selector="TextBox.search-box:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- The rail plates, the person card and the track row are dressed by ShelfChromeStyles.axaml now,
         because the people screens wear the same plates. -->
    <StyleInclude Source="avares://MediaPortal.Frontend/Views/ShelfChromeStyles.axaml"/>
  </UserControl.Styles>
  <!--
    The ground the whole screen stands on, in the one arrangement the worn skin uses everywhere and therefore
    on the home screen too: this skin's Background.PNG fills the screen, and the highlighted title's fanart
    lies over it wearing the skin setting's opacity as its OWN opacity - so the setting dims the fanart towards
    the ground instead of dropping a black veil over everything, and a screen whose titles carry no fanart was
    always only ever the ground. Whether there is a fanart at all is the skin setting's answer, not this file's.
  -->
  <Panel>

    <Image Classes="shelf-backdrop"
           Source="{Binding Converter={x:Static views:SkinImageConverter.Instance}, ConverterParameter=Background.PNG}"/>
    <views:DissolveImage Stretch="UniformToFill"
           Opacity="{Binding FanartOverlay}"
           IsVisible="{Binding HasBackgroundArtwork}">
      <views:DissolveImage.Source>
        <MultiBinding Converter="{x:Static views:SkinFanartConverter.Instance}">
          <Binding Path="BackgroundArtwork"/>
          <Binding Path="FanartBlurRadius"/>
        </MultiBinding>
      </views:DissolveImage.Source>
    </views:DissolveImage>

    <!--
      THE TWO BANDS AT THE EDGES.  Nothing but paint, and it stands between the picture and everything the screen
      has to say: the ground and the fanart are darkened at the top and bottom edges, the wall, the menu and the
      details column are laid over them untouched.

      This is not an invention of this front end.  The reference's own media master hung exactly these two controls
      over its layout (master_bare_media.xaml:69-73, TopGradient in the head row and BottomGradient in the floor
      row, both drawn from TopGradient_Template and BottomGradient_Template), and those templates carry the seven
      stops that the home's bands carry too - the same brush read from the top edge down and from the bottom edge
      up.  The depths are what that master's rows measured: a hundred points of head, two hundred and sixty of
      floor.  IsHitTestVisible="False" on the panel, so that a band which only paints can never stand between a
      pointer and a tile.
    -->
    <Panel IsHitTestVisible="False">
      <Border Classes="shelf-band-top"/>
      <Border Classes="shelf-band-bottom"/>
    </Panel>

    <!--
      THE ROOM. Two hundred points of its left edge and two hundred of its bottom are off the screen: that is
      where the two menus stand while they are shut (master_mediamenu.xaml:124-186). The code behind moves this
      panel right by the two hundred points of the rail or up by the two hundred points of the floor, which is
      the whole of the reference's opening animation - the menu does not appear, the room makes room for it.

      Nothing here clips. The menu's picture (MenuGlow) is made to spill past the edge of the panel it stands
      in, and the details column is laid with negative margins so that its ground reaches the
      very top and bottom edges of the window behind the shelf.
    -->
    <Grid Name="room"
          Margin="-200,0,0,-200"
          ColumnDefinitions="200,*"
          RowDefinitions="*,200"
          ClipToBounds="False">
      <Grid.RenderTransform>
        <!--
          The transform the screen's menu slides the room along, and the two transitions that make the sliding:
          the reference animated exactly this transform on exactly these two axes with two storyboards of three
          hundred and fifty milliseconds each (Animations.xaml:8-38, aimed at ClientGrid's TranslateTransform), so
          the sliding here is declared the same way rather than driven from a timer of the front end's own. That
          is not a preference: a dispatcher timer of one's own ticks on a window that is really being drawn and
          nowhere else - neither in a test queue that is pumped by hand nor in the render probe, which is headless
          - so a slide built on one is a slide that nobody but a television has ever seen arrive, while a
          transition is the same mechanism the worn skin's own tile glow and the home wall's scrolling move on.
          What a test and a probe read is the value the room was told to stand at; what happens between the old
          value and that one belongs to the transition, exactly as it belonged to the storyboard there.
        -->
        <TranslateTransform X="0" Y="0">
          <TranslateTransform.Transitions>
            <Transitions>
              <DoubleTransition Property="X" Duration="00:00:00.35"/>
              <DoubleTransition Property="Y" Duration="00:00:00.35"/>
            </Transitions>
          </TranslateTransform.Transitions>
        </TranslateTransform>
      </Grid.RenderTransform>

      <!--
        What the two hundred off-screen points to the left hold: the screen's menu, for grid and list. Its top
        edge starts below the head band (the reference's rail began where its master's head band ended), and it
        runs past the bottom edge so that the glow along its right edge has ground to stand on; the glow itself is
        lifted off the bottom by the two hundred points of the floor band, exactly as the reference's was.

        No visibility is declared here on purpose. Which of this panel and the one under the floor is the shelf's
        menu is the layout's word, and whether that menu hangs in the tree at all is the room's word - a shut menu
        is a menu the room slid back over, and it keeps its rows standing two hundred points off the picture for
        the rest of the shelf's life if nobody says otherwise. Both words are said by SlideMenu, where the sliding
        itself is said, because the second one must be said when the room has arrived and not before.
      -->
      <Panel Name="sideMenu"
             Grid.RowSpan="2"
             Grid.Column="0"
             Margin="0,90,0,0"
             ClipToBounds="False">
        <!-- The ground. The reference laid a black rectangle at nine tenths over the whole panel and the glow
             picture along its right edge, so that the rail does not end at a line but pales into the shelf. -->
        <!--border Background="Black" Opacity="0.9"/-->

        <DockPanel Margin="10,0,0,0">
          <!-- Every row of the screen's menu. The list is the reference's ListView with MediaMenuListViewStyle
               on it; the styles that dress it are with the other menu styles above, for both halves. It is docked
               rather than stacked so that the list is measured against the height that is left and can scroll a
               menu longer than the rail.  The panel is a plain stack and not the toolkit's virtualizing one:
               the rail never carries more than eight rows, and the virtualizing panel - measured against the
               collapsed height a closing animation leaves behind while the room slides - realized a single row
               and left the rows below it as empty plates until a key press woke the list up.

               The bottom margin is the two hundred points of the floor band: the rail's ground runs past the
               window's bottom edge on purpose (the glow stands on it), but the LIST is measured to the bottom
               edge a viewer can see, so a menu longer than the rail scrolls the way the home's main menu
               scrolls its tiles - under the wheel, and after the caret walks onto a row that stood below.
               The heading left the top of this panel for the line at the room's foot below, which stands
               where the home says its media line. -->
          <ListBox Name="mediaMenuList"
                   Classes="media-menu"
                   ItemsSource="{Binding MediaMenu}"
                   ItemTemplate="{StaticResource MediaMenuTile}"
                   Margin="0,14,0,200"
                   Focusable="True"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Hidden">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical"/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>
        </DockPanel>
      </Panel>

      <!--
        What the two hundred off-screen points at the bottom hold: the same menu, for covers. Its row IS the two
        hundred points below the window's bottom edge, so the panel only has to fill the row - the reference's
        panel needed a two hundred and fifty point shove because its row stood in the master's floor band, which
        this room has no floor band to be.
      -->
      <Panel Name="bottomMenu"
             Grid.Row="1"
             Grid.ColumnSpan="2"
             ClipToBounds="False">
        <!--
          No ground at all: the cover menu lies over the room's own picture, and a black slab under its plates
          cut that picture into a strip.  The plates carry their own ground, which is all the reading needs.
          (The glow and the little indicator the reference hung above its cover menu are gone by word of the
          viewer too: over a row that already lifts out of the floor they read as two stray pictures.)
        -->
        <!-- The same rows, laid sideways. The reference's cover menu is its one list in its one style with the
             panel turned; the left margin is the two hundred points that are off the screen while the menu is
             shut, so that the row of plates stands centred on what a viewer can actually see. -->
        <ListBox Name="mediaMenuListBottom"
                 Classes="media-menu"
                 ItemsSource="{Binding MediaMenu}"
                 ItemTemplate="{StaticResource MediaMenuTile}"
                 Margin="200,14,0,0"
                 Focusable="True"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 ScrollViewer.HorizontalScrollBarVisibility="Hidden">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
      </Panel>

      <!--
        THE CONTENT, which the reference called the ContentPanel: the shelf and whatever is laid beside it. It
        stands in the second column and the first row, which together are the part of the room on the screen while
        the menus are shut; when a menu opens, this is the thing that moves.
      -->
      <Panel Name="contentPanel"
             Grid.Row="0"
             Grid.Column="1"
             Margin="10,0,10,10">
        <!--
          The shelf and the details column, measured against each other in proportions rather than in points. The
          reference could afford to hand its details column a thousand fixed points because its screens were
          televisions of a known width; this front end is stood on desktop windows of every shape too, and a
          details column that keeps its thousand points on a small window leaves the shelf a gutter to lay its
          tiles in. At the width the reference drew for - nineteen hundred and twenty - the two columns come out at
          the eight hundred and sixty points of shelf and the thousand of details that file had, because these two
          numbers are that split.
        -->
        <Grid Name="contentGrid" ColumnDefinitions="45,55" ColumnSpacing="0" ClipToBounds="False">

          <!--
            The way out of a reading. The reference's media information was a screen pushed over the list, so its
            Back left the screen; here the reading is a state of this one screen, and with the wall away there is
            nothing left on this side of the window to hold the caret. The caret comes to this button instead, and
            Escape and the back key answer the reading the same way from the keyboard (MediaBrowserView's key
            chain asks the reading before it asks the menus and the screen).
          -->
          <Panel Grid.Column="0" ClipToBounds="False" IsVisible="{Binding InfoShown}">
            <!--
              WHAT THE FILE CARRIES, stood on this side of the window, which is where the reference stood it.  Its
              information screen is a grid of two columns - the words in a thousand points at the right, and
              everything else in the column that is left of them (MediaInfoVideo.xaml:85-89 for the two columns,
              with the details field named Grid.Column="1" at :92).  Into that left column it put four bands under
              one another, in this order and with these measures (MediaInfoVideo.xaml:296-459, the band grid at
              :296): audio tracks, subtitle tracks, actors, director - each one a header of forty lines with a
              twenty seven point picture and a word at half light (the audio header at :326-333, the subtitle
              header at :364-371), and under the header a band of one hundred and seventy five lines carrying a
              row of cards that runs sideways (the two list styles at
              themes/default/styles/CurrentlyPlayingStyles.xaml:304-346, an horizontal stack of three hundred point
              cards, :45-120 for the audio card and :126-192 for the subtitle one).

              Two things are said here rather than left to be found.  The cards wear the reference's own pictures -
              the flag of a language, the loudspeaker of a channel count, the logo of a codec, the frame a format
              stands in - out of the same logo folders the old skin shipped, which this skin carries now too under
              MediaLogos\ (MediaStreamLogos asks for them by name, the view spells the folder); only where the skin
              carries no picture of a name does a corner write its figure in words.  And the caret stands on a card
              rather than on the band around it - the question a viewer asks in front of a track is WHICH track, so
              the arrows walk the cards and the band slides along with the caret, which is what a scroller does when
              the thing it holds walks out of sight.  The cards wear the skin's shared Border.home-tile-shadow, and
              the band gives that shadow the room it needs outside the card - which is what the band's padding is
              for, and not for looks: the shadow the shared class paints stands nineteen points right of a card,
              twenty below it, thirteen left of it and twelve above it, while the band clips at its own bounds (a
              band that did not clip let a scrolled card paint itself across the rest of the screen).  Measured the
              first version of this had the band at one hundred and ninety five lines and the items panel clipping
              at the exact height of a card, which cut the shadow off above and below and left the cards sitting
              flat on the page - a test measures it now
              (TestMediaBrowser.TheShadowOfATrackCardIsNotCutByTheBandItStandsIn), because a cut shadow is exactly
              what a headless picture cannot show.

              The room the shadow asks for is ALL the room a band takes, and that is the whole of the distance a
              header stands above its cards: twenty four points of air at either end, fifteen above a card and
              twenty three below it, which makes a band of one hundred and ninety three lines around a card of a
              hundred and fifty five (and one hundred and ninety eight around a person's card of a hundred and
              sixty).  Thirty above and thirty below it stood until 2026-11-02, which set the header's word forty
              three lines above the cards it names - the viewer called that far too much and asked for a third of
              it, so the header's row keeps no height of its own, stands hard against the band, and everything
              between the word and the cards is the shadow's own air and nothing else.

              On 2026-11-03 the same viewer asked for half of that distance again and three tenths off the room
              under each band, because a reading that says Video, Audiotrack, Subtitle, the people and the
              collection ran past the bottom of the screen and cut its last card off.  The air the shadow lives in
              stayed exactly as it is - fifteen above a card, twenty three below, the test above still measures
              them - and the band steps up into its own air instead: eight points of negative margin on the
              scroller lay the word seven lines above its cards, and its top edge only leans over the word's row,
              where there was nothing to clip.  Under a card the forty one lines of bottom air and band spacing
              became twenty nine, the spacing going from eighteen to six.  A fifth of the reading's height is gone
              and none of it came out of the shadow.

              Ten lines of that shadow's bottom air went above the column on the same day, because the viewer
              asked for the whole left side to stand further down from the top of the screen: forty lines became
              fifty, and the air the reading keeps at the bottom fell from a hundred and seventy to a hundred and
              sixty so that no band was pushed off the screen by the change.
            -->
            <StackPanel VerticalAlignment="Top"
                        Margin="60,50,60,160"
                        Spacing="6"
                        IsVisible="{Binding ShowsBands}">
              <!--
                VIDEO.  What the file's picture is answerable by, read here: whether it is stereoscopic, its codec,
                its size, its high dynamic range, its proportion and its rate.  The viewer moved the row over here
                on 2026-11-02, over the word that says what the band is about, so that the three bands under the
                story read Video - Audiotrack - Subtitle.  Four of these answers are ALSO read behind the rating in
                the details (the codec, the size, the HDR and the first track's channels): the viewer asked for
                those four to be kept there, not carried over, and said so the same evening - a thing that is read
                in two places is read in two places on purpose.  Whether the file carries text is read over there
                only; it travelled back on the same evening and was not left behind here.

                The plaques are the same grey plaques as ever (Border.details-logo, one height written once), and
                they are still asked for by name out of the worn skin's logo folders (MediaStreamLogos); where the
                skin carries no picture of a name the plaque writes its figure in words instead of drawing a hole.
                What the reference could not do - name a codec its 2014 catalog never saw - is still done here.
              -->
              <!-- The band lays its plaques hard against its own bottom edge, and every other band holds twenty
                   three lines of shadow air under its cards.  Without the same air below this one the word of the
                   band under it stood six lines off the plaques while it stands twenty nine off a track card,
                   which the viewer saw on 2026-11-03 and asked to be made even. -->
              <StackPanel Spacing="6"
                          Margin="0,0,0,23"
                          IsVisible="{Binding ShowsPictureLine}">
                <!-- The row of the word wears no height of its own (see the band air note above this panel): with
                     forty points under it the word floated thirteen lines above its plaques while the track bands
                     stood seven above theirs, and the viewer asked on 2026-11-03 for half the distance everywhere
                     so that the reading fits the height of the screen. -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="Video"
                             FontSize="21"
                             Opacity="0.5"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
                <!-- The plaques stand at the same left edge the track and subtitle cards stand at, and not at the
                     edge of the column: the bands put their cards twenty four points in from that edge - the air a
                     card's shadow lies in - and the viewer asked on 2026-11-02 for these plaques to be flush with
                     those cards rather than to start in that air. -->
                <StackPanel Orientation="Horizontal"
                            Spacing="10"
                            Margin="24,0,0,0"
                            HorizontalAlignment="Left">
                  <!-- A stereoscopic file wears its logo with the type's own word under it, and an ordinary file
                       wears nothing (MediaInfoVideo.xaml:176-194, which drew these only for HSBS, SBS, HTAB, TAB). -->
                  <Border Classes="details-logo"
                          IsVisible="{Binding DetailsPicture.ShowsStereoscopic}">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="2">
                      <Image Source="{Binding Converter={x:Static views:SkinImageConverter.Instance},
                                              ConverterParameter='MediaLogos/video/3d'}"
                             Height="24"
                             HorizontalAlignment="Center"
                             Stretch="Uniform"/>
                      <TextBlock Text="{Binding DetailsPicture.StereoscopicType}"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Center"
                                 Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                  </Border>

                  <!-- Which codec the file's picture is packed in, out of the skin's own video folder and at the
                       reference's own size (MediaInfoVideo.xaml:196-203).  Where its 2014 catalog has no picture of
                       the name - "HEVC" was young then - the plaque writes the name instead of drawing a hole. -->
                  <Border Classes="details-logo"
                          IsVisible="{Binding DetailsPicture.ShowsCodec}">
                    <Grid>
                      <Image Source="{Binding DetailsPicture.CodecToken,
                                              Converter={x:Static views:SkinImageConverter.Instance},
                                              ConverterParameter='MediaLogos/video/{0}'}"
                             Height="34"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Stretch="Uniform"/>
                      <TextBlock Text="{Binding DetailsPicture.CodecWord}"
                                 FontSize="17"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding DetailsPicture.CodecToken,
                                                     Converter={x:Static views:SkinImageMissingConverter.Instance},
                                                     ConverterParameter='MediaLogos/video/{0}'}"
                                 Foreground="{DynamicResource TextBrush}"/>
                    </Grid>
                  </Border>

                  <!-- How big the picture is, at the reference's own bounds and out of its own folder
                       (MediaInfoVideo.xaml:205-214), which named the file "1080p" and the word alike. -->
                  <Border Classes="details-logo"
                          IsVisible="{Binding DetailsPicture.ShowsResolution}">
                    <Grid>
                      <Image Source="{Binding DetailsPicture.Resolution,
                                              Converter={x:Static views:SkinImageConverter.Instance},
                                              ConverterParameter='MediaLogos/resolution/{0}'}"
                             Height="34"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Stretch="Uniform"/>
                      <TextBlock Text="{Binding DetailsPicture.Resolution}"
                                 FontSize="17"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding DetailsPicture.Resolution,
                                                     Converter={x:Static views:SkinImageMissingConverter.Instance},
                                                     ConverterParameter='MediaLogos/resolution/{0}'}"
                                 Foreground="{DynamicResource TextBrush}"/>
                    </Grid>
                  </Border>

                  <!-- Whether the picture was mastered in a high dynamic range format, and which one.  The
                       reference never asked this question - it had no HDR answer to give - so this plaque is this
                       front end's own, and it wears its word alone: the word says "HDR" twice over, so a glyph
                       beside it would only repeat the answer.  An ordinary file leaves the plaque away entirely,
                       which is the viewer's rule for it: no HDR, no container. -->
                  <Border Classes="details-logo"
                          IsVisible="{Binding DetailsPicture.ShowsHdr}">
                    <TextBlock Text="{Binding DetailsPicture.HdrFormat}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"/>
                  </Border>

                  <!-- The proportion: the frame's own glyph and both sayings of it together on one line - the class
                       and the measured figure, "21:9 Ã‚Â· 2.39:1".  The reference wrote those two on opposite edges of
                       its proportion picture (MediaInfoVideo.xaml:226-244); read beside a glyph they are one
                       answer, which is what they always were. -->
                  <Border Classes="details-logo"
                          IsVisible="{Binding DetailsPicture.ShowsRatio}">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="10">
                      <Grid Width="24"
                            Height="24">
                        <Path Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                                                ConverterParameter='MediaInfo/aspect_ratio'}"
                              Fill="{DynamicResource TextBrush}"
                              Stretch="Uniform"/>
                      </Grid>
                      <TextBlock Text="{Binding DetailsPicture.RatioText}"
                                 FontSize="17"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                  </Border>

                  <!-- The two figures the reference never had a picture for, said as one line about the file's rate
                       - "3663 kbps Ã‚Â· 24 fps" - with the frame glyph in front of them.  The reference stacked them in
                       its own cell (MediaInfoVideo.xaml:246-255); read together they take one line.  Both figures
                       still stand or fall on their own: a file whose bitrate never arrived says only its frame rate,
                       and says it with the same dot left out. -->
                  <Border Classes="details-logo"
                          IsVisible="{Binding DetailsPicture.ShowsRate}">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="10">
                      <Grid Width="22"
                            Height="22">
                        <Path Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                                                ConverterParameter='MediaInfo/frames'}"
                              Fill="{DynamicResource TextBrush}"
                              Stretch="Uniform"/>
                      </Grid>
                      <TextBlock Text="{Binding DetailsPicture.RateText}"
                                 FontSize="17"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>

              <!--
                AUDIO.  What an audio FILE is answerable by, read here: what it is packed in, how many channels it
                carries, which disc of how many it is, and its two rates.  The worn skin asked the same five
                questions of the same aspect, in a row of six cells of its own above the details
                (MediaInfoAudio.xaml:115-170, an AudioAspectWrapper whose every cell stood or fell on its own
                value), and named the codecs' and the loudspeakers' pictures the same way - 'MediaLogos\audio\{0}.png'
                filled with the importer's word for the codec and with the PLAIN channel count, which is why the
                catalog holds a picture of "6" beside the arrangement it draws.  A plaque whose picture the skin does
                not carry writes its figure in words instead of drawing a hole, exactly as the video plaques above
                have always done.

                The row costs its height on its own answer, so a film never wears it and a song never wears the
                video row above it: the two ask different questions of two different kinds of file.
              -->
              <StackPanel Spacing="6"
                          Margin="0,0,0,23"
                          IsVisible="{Binding ShowsAudioLine}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="Audio"
                             FontSize="21"
                             Opacity="0.5"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Spacing="10"
                            Margin="24,0,0,0"
                            HorizontalAlignment="Left">
                  <!-- What the file is packed in, asked for by that very word (MediaInfoAudio.xaml:118-126). -->
                  <Border Classes="details-logo"
                          Name="infoAudioCodecPlaque"
                          IsVisible="{Binding DetailsAudio.ShowsCodec}">
                    <Grid>
                      <Image Source="{Binding DetailsAudio.CodecToken,
                                              Converter={x:Static views:SkinImageConverter.Instance},
                                              ConverterParameter='MediaLogos/audio/{0}'}"
                             Height="34"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Stretch="Uniform"/>
                      <TextBlock Text="{Binding DetailsAudio.CodecWord}"
                                 FontSize="17"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding DetailsAudio.CodecToken,
                                                     Converter={x:Static views:SkinImageMissingConverter.Instance},
                                                     ConverterParameter='MediaLogos/audio/{0}'}"
                                 Foreground="{DynamicResource TextBrush}"/>
                    </Grid>
                  </Border>

                  <!-- How many channels, at the picture of their count; the trade's word for the arrangement stands
                       where the skin carries no picture of that count (MediaInfoAudio.xaml:128-136). -->
                  <Border Classes="details-logo"
                          IsVisible="{Binding DetailsAudio.ShowsChannels}">
                    <Grid>
                      <Image Source="{Binding DetailsAudio.ChannelsToken,
                                              Converter={x:Static views:SkinImageConverter.Instance},
                                              ConverterParameter='MediaLogos/audio/{0}'}"
                             Height="34"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Stretch="Uniform"/>
                      <TextBlock Text="{Binding DetailsAudio.ChannelsWord}"
                                 FontSize="17"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding DetailsAudio.ChannelsToken,
                                                     Converter={x:Static views:SkinImageMissingConverter.Instance},
                                                     ConverterParameter='MediaLogos/audio/{0}'}"
                                 Foreground="{DynamicResource TextBrush}"/>
                    </Grid>
                  </Border>

                  <!-- Which disc of how many, beside the skin's picture of a disc - and on the COUNT's word, not
                       the number's, which is the reference's own rule and the reason a file counted as disc one of
                       nothing at all says nothing (MediaInfoAudio.xaml:138-148). -->
                  <Border Classes="details-logo"
                          IsVisible="{Binding DetailsAudio.ShowsDisc}">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="10">
                      <Image Source="{Binding Converter={x:Static views:SkinImageConverter.Instance},
                                              ConverterParameter='MediaLogos/audio/disc'}"
                             Height="34"
                             VerticalAlignment="Center"
                             Stretch="Uniform"/>
                      <TextBlock Text="{Binding DetailsAudio.DiscText}"
                                 FontSize="17"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                  </Border>

                  <!-- The bitrate and the sample rate, the two figures the reference stacked in its last cell
                       (MediaInfoAudio.xaml:150-165, "{0} kbps" over "{0} Hz"), said here as one line about the
                       file's rate like the video row's last plaque.  Either of them stands alone: a file whose
                       sample rate never arrived says its bitrate and leaves the dot out. -->
                  <Border Classes="details-logo"
                          IsVisible="{Binding DetailsAudio.ShowsRates}">
                    <TextBlock Text="{Binding DetailsAudio.RatesText}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"/>
                  </Border>
                </StackPanel>
              </StackPanel>

              <!-- AUDIOTRACK, SUBTITLE: the words the viewer asked these two headers to carry on 2026-11-02, in
                   place of the glyph each of them wore.  They are the English words and not the skin's German
                   strings - [Nereus.Info.AudioTracks] and [Nereus.Info.Subtitles] - because a word written into the
                   skin is a word every language would have to translate by hand. -->
              <StackPanel Spacing="0" IsVisible="{Binding ShowsAudioTracks}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="Audiotrack"
                             FontSize="21"
                             Opacity="0.5"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
                <ScrollViewer Name="audioTracksScroller"
                              Height="193"
                              Padding="24,15,24,23"
                              Margin="0,-8,0,0"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              ClipToBounds="True">
                  <ItemsControl ItemsSource="{Binding DetailsAudioTracks}"
                                VerticalAlignment="Center"
                                ClipToBounds="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AudioTrackCard">
                        <!-- What one audio card says, and where the viewer asked to see it said (2026-11-03).  The
                             four facts are the reference's (CurrentlyPlayingStyles.xaml:45-120) - the flag of the
                             language, the channels as a loudspeaker picture of the plain count, the codec as a
                             logo, and the bitrate over the sample rate - and so is the rule that a figure the worn
                             skin has no picture of is written in words instead.  Where they stand is not: the
                             picture, the channels and the codec stand in ONE LINE across the top of the card, and
                             under them the language reads its NAME ("German", not "DE") over its two numbers.  The
                             reference had the language as a two-letter abbreviation beside its flag and the codec
                             under it, which left the top of the card to one picture and the bottom to two words;
                             the line of pictures is what a viewer scans, and the words are what they read after.
                             The card itself takes the caret - the viewer looks AT a track, and the caret standing
                             on it says which one is being looked at, exactly as it does on a tile of the wall.  The
                             shadow is the skin's shared one, the same the wall's tiles, the news cards and the
                             weather cards stand in - a card of this screen is no flatter than a tile of the wall. -->
                        <!-- The ground of a card of words: four tenths of a light grey (#B3B3B3 at 0x66), which the
                             viewer asked for on 2026-11-03 in place of the fifteen per cent white this stood in -
                             a card should read as a card before the picture on it reads. -->
                        <Border Classes="trackcard home-tile-shadow"
                                Focusable="True"
                                Width="300"
                                Height="155"
                                Background="#66B3B3B3"
                                Padding="16,10,16,12"
                                Margin="0,0,8,0">
                          <Grid RowDefinitions="Auto,Auto,*"
                                ColumnDefinitions="Auto,*,Auto"
                                VerticalAlignment="Center">
                            <Panel Grid.Row="0"
                                   Grid.Column="0"
                                   VerticalAlignment="Center">
                              <Image Source="{Binding FlagToken,
                                                      Converter={x:Static views:SkinImageConverter.Instance},
                                                      ConverterParameter='MediaLogos/flags/{0}'}"
                                     Height="44"
                                     Stretch="Uniform"
                                     HorizontalAlignment="Left"
                                     IsVisible="{Binding ShowsFlag}"/>
                              <Image Source="{Binding Converter={x:Static views:SkinImageConverter.Instance},
                                                      ConverterParameter='MediaLogos/flags/Unknown'}"
                                     Height="44"
                                     Stretch="Uniform"
                                     HorizontalAlignment="Left"
                                     IsVisible="{Binding ShowsUnknownFlag}"/>
                            </Panel>
                            <Panel Grid.Row="0"
                                   Grid.Column="1"
                                   Margin="16,0,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center">
                              <Image Source="{Binding ChannelsToken,
                                                      Converter={x:Static views:SkinImageConverter.Instance},
                                                      ConverterParameter='MediaLogos/audio/{0}'}"
                                     Height="48"
                                     Stretch="Uniform"
                                     HorizontalAlignment="Left"
                                     IsVisible="{Binding ShowsChannels}"/>
                              <TextBlock Text="{Binding Channels}"
                                         FontSize="23"
                                         FontWeight="SemiBold"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding ChannelsToken,
                                                     Converter={x:Static views:SkinImageMissingConverter.Instance},
                                                     ConverterParameter='MediaLogos/audio/{0}'}"
                                         Foreground="{DynamicResource TextBrush}"/>
                            </Panel>
                            <Panel Grid.Row="0"
                                   Grid.Column="2"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center">
                              <Image Source="{Binding CodecToken,
                                                      Converter={x:Static views:SkinImageConverter.Instance},
                                                      ConverterParameter='MediaLogos/audio/{0}'}"
                                     Height="44"
                                     Stretch="Uniform"
                                     HorizontalAlignment="Right"
                                     IsVisible="{Binding ShowsCodec}"/>
                              <TextBlock Text="{Binding Encoding}"
                                         FontSize="19"
                                         Opacity="0.85"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding CodecToken,
                                                     Converter={x:Static views:SkinImageMissingConverter.Instance},
                                                     ConverterParameter='MediaLogos/audio/{0}'}"
                                         Foreground="{DynamicResource TextBrush}"/>
                            </Panel>
                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="3"
                                       Margin="0,8,0,0"
                                       Text="{Binding Language}"
                                       FontSize="22"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="3"
                                       Margin="0,2,0,0"
                                       Text="{Binding Detail}"
                                       FontSize="19"
                                       Opacity="0.85"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Foreground="{DynamicResource TextBrush}"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>

              <StackPanel Spacing="0" IsVisible="{Binding ShowsSubtitleTracks}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="Subtitle"
                             FontSize="21"
                             Opacity="0.5"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
                <ScrollViewer Name="subtitleTracksScroller"
                              Height="193"
                              Padding="24,15,24,23"
                              Margin="0,-8,0,0"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              ClipToBounds="True">
                  <ItemsControl ItemsSource="{Binding DetailsSubtitleTracks}"
                                VerticalAlignment="Center"
                                ClipToBounds="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SubtitleTrackCard">
                        <!-- What one subtitle card says, in the order the viewer asked to read it (2026-11-03).  Its
                             facts are the reference's (CurrentlyPlayingStyles.xaml:126-192) - the flag of its
                             language, the picture of whether the track lies inside the file, its format standing
                             inside the skin's picture of a frame, and the word "Forced" for a track the file
                             insists on, that word the reference wrote in English in the skin itself, the one corner
                             of this card it never had a picture for.  Under the line of pictures the language reads
                             its NAME ("German", not "de") and the word "Forced" stands under that, at the left.
                             As in the band above, the card is what the caret stands on, and as in the band above it
                             wears the skin's shared shadow. -->
                        <Border Classes="trackcard home-tile-shadow"
                                Focusable="True"
                                Width="300"
                                Height="155"
                                Background="#66B3B3B3"
                                Padding="16,10,16,12"
                                Margin="0,0,8,0">
                          <Grid RowDefinitions="Auto,Auto,*"
                                ColumnDefinitions="Auto,*,Auto"
                                VerticalAlignment="Center">
                            <Panel Grid.Row="0"
                                   Grid.Column="0"
                                   VerticalAlignment="Center">
                              <Image Source="{Binding FlagToken,
                                                      Converter={x:Static views:SkinImageConverter.Instance},
                                                      ConverterParameter='MediaLogos/flags/{0}'}"
                                     Height="44"
                                     Stretch="Uniform"
                                     HorizontalAlignment="Left"
                                     IsVisible="{Binding ShowsFlag}"/>
                              <Image Source="{Binding Converter={x:Static views:SkinImageConverter.Instance},
                                                      ConverterParameter='MediaLogos/flags/Unknown'}"
                                     Height="44"
                                     Stretch="Uniform"
                                     HorizontalAlignment="Left"
                                     IsVisible="{Binding ShowsUnknownFlag}"/>
                            </Panel>
                            <Panel Grid.Row="0"
                                   Grid.Column="1"
                                   Margin="16,0,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding ShowsFormat}">
                              <TextBlock Text="{Binding Format}"
                                         FontSize="19"
                                         Opacity="0.85"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource TextBrush}"/>
                              <!-- The word stands IN the frame, not beside it (CurrentlyPlayingStyles.xaml:177-182),
                                   and in the middle of it: the reference pinned it to the frame's left edge, which
                                   read as a word that had not quite got into its box. -->
                              <Image Source="{Binding Converter={x:Static views:SkinImageConverter.Instance},
                                                      ConverterParameter='MediaLogos/subtitle/Frame'}"
                                     Height="46"
                                     Stretch="Uniform"
                                     HorizontalAlignment="Left"
                                     IsHitTestVisible="False"/>
                            </Panel>
                            <Panel Grid.Row="0"
                                   Grid.Column="2"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center">
                              <Image Source="{Binding CarriageToken,
                                                      Converter={x:Static views:SkinImageConverter.Instance},
                                                      ConverterParameter='MediaLogos/subtitle/{0}'}"
                                     Height="42"
                                     Stretch="Uniform"
                                     HorizontalAlignment="Right"/>
                              <TextBlock Text="{Binding Carriage}"
                                         FontSize="21"
                                         Opacity="0.85"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding CarriageToken,
                                                     Converter={x:Static views:SkinImageMissingConverter.Instance},
                                                     ConverterParameter='MediaLogos/subtitle/{0}'}"
                                         Foreground="{DynamicResource TextBrush}"/>
                            </Panel>
                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="3"
                                       Margin="0,8,0,0"
                                       Text="{Binding Language}"
                                       FontSize="22"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="3"
                                       Margin="0,2,0,0"
                                       Text="{Binding Forced}"
                                       FontSize="19"
                                       Opacity="0.85"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Foreground="{DynamicResource TextBrush}"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>

              <!--
                ACTORS, DIRECTOR: the people the title names, in the two parts the reference showed them in.  Its
                information screen stood both in the same left column as the tracks - actors in the third row,
                director in the fourth, each a head of forty lines with a twenty seven point picture and a word at
                half light over a band of cards that runs sideways
                (MediaInfoVideo.xaml:384-420 for the actors, :421-457 for the director, both lists wearing
                PersonCPListViewStyle, whose card is a hundred and forty five points of portrait over sixty lines of
                name - themes/default/styles/CurrentlyPlayingStyles.xaml:194-237).

                Here the two bands SHARE one row, which the viewer agreed to on 2026-11-03: four bands of two
                hundred and sixty lines do not stand above the foot of a window that is a thousand and eighty lines
                tall, and a band a viewer cannot reach is no band at all - the same reason the caret walks out of a
                band rather than stopping at its edge.  Since 2026-11-04 the row is split one card to the left: a
                title has ONE director, so the director's column is exactly wide enough for the one card it holds
                and everything left of it belongs to the actors, who are a dozen strong for a series.  The heads
                carry the reference's English words out of its own language file (Language/strings_en.xml:108 and
                :110, "Director" and "Actors") in place of its two glyphs, which is what the viewer asked the track
                heads to wear the same evening.  Neither band shows a scrollbar: the caret walks a band and the
                wheel turns it, so the bar would only eat a line of the picture (see KeepCardInSight for how a
                card walking out of a band is brought back with the reference's own margin around it).

                A portrait is asked for per person, under that person's own id, and where the library has none the
                card draws the skin's standing figure - exactly the two states the reference's card had
                (CurrentlyPlayingStyles.xaml:216-222, Person.png shown by Path=!HasImage).  The cards take the caret
                and wear the skin's shared shadow like the track cards above them, and the shadow is given the room
                it needs outside the card by this band's padding - twenty five lines above and below a card of a
                hundred and sixty standing in a band of two hundred and ten - which is what the test that measures a
                cut shadow looks at.  A band that clips is where a shadow dies, so the clip that keeps a long list
                from painting over its neighbour sits on the row of items and not on the band.
              -->
              <Grid ColumnDefinitions="*,Auto"
                    ColumnSpacing="18"
                    IsVisible="{Binding ShowsPersons}">
                <StackPanel Grid.Column="0" Spacing="0" IsVisible="{Binding ShowsActors}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Actors"
                               FontSize="21"
                               Opacity="0.5"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"/>
                  </StackPanel>
                  <ScrollViewer Name="actorsScroller"
                                Height="198"
                                Padding="24,15,24,23"
                                Margin="0,-8,0,0"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Disabled"
                                ClipToBounds="True">
                    <ItemsControl ItemsSource="{Binding DetailsActors}"
                                  VerticalAlignment="Center"
                                  ClipToBounds="False"
                                  ItemTemplate="{StaticResource PersonCardTile}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
                <!-- Wide enough for the one card a director is, and no wider: a hundred and fifty of card, eight of
                     the gap that separates cards, and the twenty four of shadow air the band keeps at either end
                     (the room Border.home-tile-shadow's shadow falls into, which the shadow test measures). -->
                <StackPanel Grid.Column="1" Spacing="0" Width="206" IsVisible="{Binding ShowsDirectors}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Director"
                               FontSize="21"
                               Opacity="0.5"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"/>
                  </StackPanel>
                  <ScrollViewer Name="directorsScroller"
                                Height="198"
                                Padding="24,15,24,23"
                                Margin="0,-8,0,0"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Disabled"
                                ClipToBounds="True">
                    <ItemsControl ItemsSource="{Binding DetailsDirectors}"
                                  VerticalAlignment="Center"
                                  ClipToBounds="False"
                                  ItemTemplate="{StaticResource PersonCardTile}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </Grid>

              <!--
                ARTISTS, ALBUM ARTISTS, COMPOSERS: the same row of people for the titles that are music, in the
                three parts the reference's audio screen showed them in (MediaInfoAudio.xaml:204-296, three lists
                wearing the very PersonCPListViewStyle the film's two wear, each under a head of its own word with
                the skin's picture of a person in front of it).  The reference stacked its three bands one under the
                other in rows of forty and a hundred and forty lines; here they SHARE one row for the reason the
                film's two already do - the reading's column does not hold three bands of two hundred lines - and a
                band the viewer cannot reach is no band at all.

                Nothing is asked for here that the film's row does not already do: the same card, the same portrait
                asked for per person with the skin's standing figure where the library has none, the same caret that
                walks out of one band into the band beside it, the same shadow with the air it needs around it.  A
                song names no actors and a film names no composers, so exactly one of the two rows is ever drawn.
              -->
              <Grid ColumnDefinitions="*,*,*"
                    ColumnSpacing="18"
                    IsVisible="{Binding ShowsMusicPersons}">
                <StackPanel Grid.Column="0" Spacing="0" IsVisible="{Binding ShowsArtists}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Artist"
                               FontSize="21"
                               Opacity="0.5"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"/>
                  </StackPanel>
                  <ScrollViewer Name="artistsScroller"
                                Height="198"
                                Padding="24,15,24,23"
                                Margin="0,-8,0,0"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Disabled"
                                ClipToBounds="True">
                    <ItemsControl ItemsSource="{Binding DetailsArtists}"
                                  VerticalAlignment="Center"
                                  ClipToBounds="False"
                                  ItemTemplate="{StaticResource PersonCardTile}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="0" IsVisible="{Binding ShowsAlbumArtists}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Album artist"
                               FontSize="21"
                               Opacity="0.5"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"/>
                  </StackPanel>
                  <ScrollViewer Name="albumArtistsScroller"
                                Height="198"
                                Padding="24,15,24,23"
                                Margin="0,-8,0,0"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Disabled"
                                ClipToBounds="True">
                    <ItemsControl ItemsSource="{Binding DetailsAlbumArtists}"
                                  VerticalAlignment="Center"
                                  ClipToBounds="False"
                                  ItemTemplate="{StaticResource PersonCardTile}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="0" IsVisible="{Binding ShowsComposers}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Composer"
                               FontSize="21"
                               Opacity="0.5"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"/>
                  </StackPanel>
                  <ScrollViewer Name="composersScroller"
                                Height="198"
                                Padding="24,15,24,23"
                                Margin="0,-8,0,0"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Disabled"
                                ClipToBounds="True">
                    <ItemsControl ItemsSource="{Binding DetailsComposers}"
                                  VerticalAlignment="Center"
                                  ClipToBounds="False"
                                  ItemTemplate="{StaticResource PersonCardTile}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </Grid>

              <!--
                COLLECTION: the films the read film's collection holds, as the reference's own collection screen
                stood them (MediaItemListMovieCollectionDetails.inc:52-54): the collection's name for a head, and its
                films in a row underneath, every one of them a place the viewer stands on and presses to read that
                film.  Nothing is ever started by standing on one of them - a film of a collection is read, and the
                framed collection button this band replaced carried no command either
                (MediaInfoVideo.xaml:457-530).

                The head wears the collection's name instead of the word "Collection" for the reason every head of
                this reading says what the row under it is, and because the word alone said less than the name those
                films share - the viewer asked for that on 2026-11-09, having seen a card of text about a collection
                instead of the collection.  Like the track heads, the word this head would otherwise have worn is
                the skin's own (Language/strings_en.xml:111) and is not needed a second time here.

                The collection's own picture is not asked for any more, and nothing was lost by stopping: MP2 files a
                collection's artwork as "movieset-*" pictures beside its films
                (FanArtService.Local/LocalMovieCollectionFanartProvider.cs:64-120), and a count over this machine's
                library of eleven hundred and thirty six films found two hundred and twenty eight of them naming one
                of the one hundred and sixty four collections it holds, with not one "movieset-*" picture beside any
                of those films and not one picture under any of the collection titles themselves.

                The band is built the way the bands above it are built and no differently: a head line, then a
                scroller of a hundred and ninety three points holding cards of a hundred and fifty five with the
                shadow's own air of fifteen and twenty three lines around them, the caret walking into the row from
                the band above and back out of it, the row gliding along with the caret inside the reference's
                scroll margin, and its ends dissolving like the ends of every other band
                (see WalksTrackCards for the walk, KeepCardInSight for the margin, FadeBandEnds for the ends).  A
                collection of thirty films therefore costs the reading no height, which is what the viewer asked for
                on 2026-11-09 when the reading was to fit the screen's height: the row is as tall as the card it
                replaced and everything above it stayed where it was measured.

                A tile is a person's card in everything but its picture - the skin's ten points of rounding
                (styles.xaml:501-503), the same shadow, the same ring under a caret, and the same dark plate under a
                film whose poster the library does not keep.  It is a poster and not a portrait, so its width is its
                height read at two to three, a hundred and three points; and it wears no veil and no name, because a
                poster already says which film it is and the name stands in the tip a hovering pointer reads.
              -->
              <StackPanel Spacing="0" IsVisible="{Binding ShowsCollection}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <!-- The collection's own name, worn by the head every other head of this reading dresses the
                       same way.  A collection whose name is the whole screen's subject does not need the word
                       "Collection" over it: the row under the name is what a collection is. -->
                  <TextBlock Text="{Binding DetailsCollection}"
                             FontSize="21"
                             Opacity="0.5"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
                <!-- A poster arrives a moment after its tile does, and the tile is the size it keeps either way, so
                     a row whose first poster lands while the rest are still on the wire does not move under the
                     viewer's eyes - the same reason a shelf tile hangs its poster over its box.  Away goes the
                     whole band when the library cannot name a single film of the collection, because a head over
                     two hundred points of nothing is a hole in the reading, not an answer. -->
                <ScrollViewer Name="collectionScroller"
                              Height="193"
                              Padding="24,15,24,23"
                              Margin="0,-8,0,0"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              ClipToBounds="True"
                              IsVisible="{Binding ShowsCollectionFilms}">
                  <ItemsControl ItemsSource="{Binding DetailsCollectionFilms}"
                                VerticalAlignment="Center"
                                ClipToBounds="False"
                                ItemTemplate="{StaticResource CollectionFilmTile}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </StackPanel>
          </Panel>

          <!-- The shelf itself, with its heading, its search field, its foot and the two overlays the reference
               laid over its bottom or its top edge. Put away while one title is being read, which is what the
               reference's media information screen is: its workflow (MediaInfoAction.cs:69-90) pushed a screen of
               its own over the list rather than drawing another copy of the facts beside the wall. -->
          <Panel Grid.Column="0" ClipToBounds="False" IsVisible="{Binding !InfoShown}">
            <DockPanel>
              <!--
                What the shelf has to say about itself.  The reference gave its media master a head band of a
                hundred points (master_bare_media.xaml:57-59) and let the wall of titles begin under it, which on
                a television of this height hangs the wall low: four rows of posters stand one under the other,
                the last one is cut in half by the bottom edge, and the whole block leans to the floor while the
                details column beside it is read from the top down.  The viewer asked for the wall to be pulled up
                and stood in the middle of the room, so it begins fifty-one points down - still clear of the top
                edge, still under nothing, because this screen wears no head line - and gives seventy-three points
                back to the floor, which is where the count of the wall is said.
              -->
              <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,51,0,6">
                <!--
                  The reference's shelf head carries the heading and nothing else - it never tells the viewer
                  "1130 of 1136, sorted by year", and it never writes a sentence over the wall either.  So this
                  head is empty on purpose: it is here for its fifty-one points of offset, not for a line of
                  speech.  What a search came to is read off the wall itself.
                -->
              </StackPanel>

              <!--
                Finding a title by typing its name used to stand here, in a row of its own that pushed the wall
                down while nobody was typing. It stands in the head line now - see "searchStrip" under the room -
                which is where a viewer looks for a question of this kind and where the shelf is not disturbed.
              -->

              <!--
                The keys this screen answers are not written on it.  A remote carries its labels on itself and
                a keyboard viewer learns the keys by pressing them; a line of small print at the foot of the
                shelf took room from the wall and told anybody who already knew the keys nothing.
              -->
              <!--
                The shelf. The pictures it wears are the worn skin's answer to the tile key its layout names
                (theming:SkinTemplates.TileTemplate), and the panel it lays them in is the view's own promise -
                the wrap for a grid, the sideways stack for covers - which is what the code behind swaps.  The
                wall is not stretched to the scroller: it takes the width its own rows of tiles need and stands
                in the middle of what the scroller offers (VirtualizingTilePanel), which leaves the same breath
                of fanart at its left and at its right hand and keeps the scroller's bar at the edge of the
                room, away from the last column of posters.
              -->
              <!--
                THE COVER ROW, drawn.  The covers of the cover layout are not containers any more: one control owns
                the place the row stands at and paints the eleven covers a viewer can see, which is the shape the
                reference cover flow has.  The list below stays the caret - it is what the keys, the menus and the
                details answer to, and it is put out of sight for this one shape - so that nothing about how a
                title is chosen had to change for the row to be drawn.  Why a drawn row and not a dressed one: a
                recycled container answers with the measurements of the place it came from, which is how a cover
                came to be painted bigger on one side of the stood one than on the other, and no amount of dressing
                over that fixes a number that was never read from where the cover is.
              -->
              <views:CoverCarousel Name="coverRow"
                                   DockPanel.Dock="Bottom"
                                   ItemsSource="{Binding Rows}"
                                   SelectedIndex="{Binding #titlesList.SelectedIndex, Mode=TwoWay}"
                                   Margin="0,0,0,45"
                                   IsVisible="False"/>
              <ListBox Name="titlesList"
                       Focusable="True"
                       ItemsSource="{Binding Rows}"
                       SelectedItem="{Binding Selected, Mode=TwoWay}"
                       ItemTemplate="{StaticResource BuiltinRowsTemplate}"
                       FontSize="24"
                       Margin="0,0,0,53"
                       ScrollViewer.VerticalScrollBarVisibility="Hidden"
                       ClipToBounds="False"/>
            </DockPanel>

            <!--
              THE DETAILS OF A COVER, centred above its row: MultiDetailsCover.inc, which the reference laid over
              a horizontal gradient - dark in the middle of the screen and clear at both edges, so that the strip
              of covers keeps its own light at either end. The cover layout never has a column beside its row,
              which is why its details had to go where the covers are. The panel is a width of its own and
              centred: a wash stretched across a wide screen loses its middle, so the gradient ends where the
              words do.
            -->
            <Border Name="coverDetailsPanel"
                    MaxHeight="480"
                    Width="1400"
                    Padding="0,26,0,26"
                    ClipToBounds="True"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,96,0,0"
                    IsVisible="{Binding ShowsCoverDetails}"
                    IsHitTestVisible="False">
              <!--  The reference's MultiDetailsCoverGradient: dark in the middle of the strip, clear at
                    both edges.  It has to say '%' at both ends: bare numbers are pixels for Avalonia, and
                    a brush "from 0 to 1" is a gradient one pixel long - which is what left a single dark
                    column of black at the panel's left edge instead of a wash across the whole screen.  -->
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                  <GradientStop Color="#00000000" Offset="0"/>
                  <GradientStop Color="#80000000" Offset="0.3"/>
                  <GradientStop Color="#80000000" Offset="0.7"/>
                  <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <!--
                TWO HALVES, the reference's own split (MediaItemCoverAudioAlbumDetails.inc:19-27,
                MediaItemCoverMovieDetails.inc:17-20): the writing and the story in the left half, the answers in
                the right one.  The left half looks to the right, because the reference set its description
                right-aligned - <c>HorizontalContentAlignment="Right"</c> at <c>:26</c> - and the middle of the
                screen is where a reader's eye stands while the row of covers runs under it.

                Nothing in either half may run past its column.  Both are six hundred twenty lines wide out of the
                panel's fourteen hundred, every text wraps and is cut with points - the name at two lines, the
                story at eight, a fact's answer at three hundred forty - and the panel itself clips: a plot longer
                than eight lines ends in "…" rather than in words standing over the covers.  Under the facts stand
                the grey plaques of the FILE, the same six the details row wears, in a panel of their own that
                wraps; what a title IS is said above them, in the pairs the information screen writes.

                The panel is as high as what it has to say - a maximum of four hundred eighty lines, its top edge
                still standing on the ninety-six it was given, and twenty-six lines of ground over the words and
                under them, so that a short album does not wear a tall film's black.
              -->
              <Grid ColumnDefinitions="60,620,*,620,40">
                <StackPanel Grid.Column="1"
                            Spacing="18"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                  <!--
                    The title's own lettering, at the measure this front end already uses for it: a hundred twenty
                    lines high, never wider than two hundred fifty.  An album's is its ClearArt (its Logo when it
                    carries none), a film's and an episode's their ClearArt - both were read long since for the
                    information screen and never shown over the row, though that row is where a film is chosen.
                  -->
                  <Image Source="{Binding CoverLettering, Converter={x:Static views:ArtworkConverter.Instance}, ConverterParameter=250}"
                         Height="120"
                         MaxWidth="250"
                         Stretch="Uniform"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         IsVisible="{Binding ShowsCoverLettering}"/>
                  <TextBlock Text="{Binding DetailsText}"
                             FontSize="22"
                             LineHeight="31"
                             MaxLines="8"
                             TextWrapping="Wrap"
                             TextAlignment="Right"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource TextBrush}"
                             Opacity="0.9"
                             IsVisible="{Binding DetailsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

                <StackPanel Grid.Column="3"
                            Spacing="12"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                  <TextBlock Text="{Binding DetailsHeading}"
                             FontSize="45"
                             FontWeight="SemiBold"
                             MaxLines="2"
                             TextWrapping="Wrap"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource TextBrush}"/>

                  <!--
                    The rating, its stars and its number together, and together absent when the library recorded
                    none - the reference's rule, which for a record means nearly always: only an "album.nfo"
                    carries a rating, so an album's stars are the exception rather than the row.
                  -->
                  <StackPanel Orientation="Horizontal"
                              Spacing="10"
                              VerticalAlignment="Center"
                              IsVisible="{Binding DetailsRating, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <ItemsControl ItemsSource="{Binding DetailsStars}" VerticalAlignment="Center">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:Double">
                          <Image Source="{Binding Converter={x:Static views:SkinImageConverter.Instance},
                                                  ConverterParameter=star}"
                                 Width="25"
                                 Height="25"
                                 Margin="0,0,4,0"
                                 Opacity="{Binding}"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding DetailsRatingWords}"
                               FontSize="22"
                               Opacity="0.85"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"/>
                  </StackPanel>

                  <TextBlock Text="{Binding DetailsTagline}"
                             FontSize="30"
                             FontStyle="Italic"
                             MaxLines="2"
                             TextWrapping="Wrap"
                             TextTrimming="CharacterEllipsis"
                             Opacity="0.75"
                             Foreground="{DynamicResource TextBrush}"
                             IsVisible="{Binding DetailsTagline, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                  <!-- The answers about the title, answer over word, wrapping over as many lines as they need. -->
                  <ItemsControl ItemsSource="{Binding CoverFacts}"
                                ItemTemplate="{StaticResource CoverFactTemplate}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>

                  <!--
                    The answers about the file, in the plaques the details row wears (Border.details-logo, one
                    height written once): whether the file carries text at all, the packing and the size and the
                    high dynamic range of its picture, and the packing, the loudspeakers and the two rates of its
                    sound.  Nothing is asked for them that the details screen does not ask; a sound file wears no
                    picture plaque and a film no sound plaque, so the two families never crowd one row.  Ten lines
                    of ground between neighbours, and the row wraps rather than overflowing its column.
                  -->
                  <WrapPanel>
                    <Border Classes="details-logo"
                            Padding="20,0"
                            Margin="0,0,10,10"
                            IsVisible="{Binding ShowsSubtitlePlaque}">
                      <Grid Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Path Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                                                ConverterParameter='PlayerControl/subtitles'}"
                              Fill="{DynamicResource TextBrush}"
                              Stretch="Uniform"
                              IsVisible="{Binding ShowsFileSubtitles}"/>
                        <Path Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                                                ConverterParameter='PlayerControl/subtitles_off'}"
                              Fill="{DynamicResource TextBrush}"
                              Stretch="Uniform"
                              IsVisible="{Binding !ShowsFileSubtitles}"/>
                      </Grid>
                    </Border>

                    <Border Classes="details-logo"
                            Padding="20,0"
                            Margin="0,0,10,10"
                            IsVisible="{Binding DetailsPicture.ShowsCodec}">
                      <Grid>
                        <Image Source="{Binding DetailsPicture.CodecToken,
                                                Converter={x:Static views:SkinImageConverter.Instance},
                                                ConverterParameter='MediaLogos/video/{0}'}"
                               Height="34"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Stretch="Uniform"/>
                        <TextBlock Text="{Binding DetailsPicture.CodecWord}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding DetailsPicture.CodecToken,
                                                       Converter={x:Static views:SkinImageMissingConverter.Instance},
                                                       ConverterParameter='MediaLogos/video/{0}'}"
                                   Foreground="{DynamicResource TextBrush}"/>
                      </Grid>
                    </Border>

                    <Border Classes="details-logo"
                            Padding="20,0"
                            Margin="0,0,10,10"
                            IsVisible="{Binding DetailsPicture.ShowsResolution}">
                      <Grid>
                        <Image Source="{Binding DetailsPicture.Resolution,
                                                Converter={x:Static views:SkinImageConverter.Instance},
                                                ConverterParameter='MediaLogos/resolution/{0}'}"
                               Height="34"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Stretch="Uniform"/>
                        <TextBlock Text="{Binding DetailsPicture.Resolution}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding DetailsPicture.Resolution,
                                                       Converter={x:Static views:SkinImageMissingConverter.Instance},
                                                       ConverterParameter='MediaLogos/resolution/{0}'}"
                                   Foreground="{DynamicResource TextBrush}"/>
                      </Grid>
                    </Border>

                    <Border Classes="details-logo"
                            Padding="20,0"
                            Margin="0,0,10,10"
                            IsVisible="{Binding DetailsPicture.ShowsHdr}">
                      <TextBlock Text="{Binding DetailsPicture.HdrFormat}"
                                 FontSize="17"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextBrush}"/>
                    </Border>

                    <!-- The sound of a picture file: the loudspeaker of its FIRST audio track's channels, the very
                         plaque the details row wears.  A film answers its sound by this one plaque and by no other
                         - its details answer carries none of the six figures the four plaques below are made of,
                         so without this one a film stood under the row with no sound answer at all while its
                         details screen had had one for weeks (the viewer's word of 2026-11-03).  A series and a
                         season wear it from their first episode, which is the same answer the plaques above are
                         read from. -->
                    <Border Classes="details-logo"
                            Padding="20,0"
                            Margin="0,0,10,10"
                            IsVisible="{Binding ShowsFirstAudioChannels}">
                      <Grid>
                        <Image Source="{Binding FirstAudioChannelsToken,
                                                Converter={x:Static views:SkinImageConverter.Instance},
                                                ConverterParameter='MediaLogos/audio/{0}'}"
                               Height="34"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Stretch="Uniform"/>
                        <TextBlock Text="{Binding FirstAudioChannelsWord}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding FirstAudioChannelsToken,
                                                       Converter={x:Static views:SkinImageMissingConverter.Instance},
                                                       ConverterParameter='MediaLogos/audio/{0}'}"
                                   Foreground="{DynamicResource TextBrush}"/>
                      </Grid>
                    </Border>

                    <Border Classes="details-logo"
                            Padding="20,0"
                            Margin="0,0,10,10"
                            IsVisible="{Binding DetailsAudio.ShowsCodec}">
                      <Grid>
                        <Image Source="{Binding DetailsAudio.CodecToken,
                                                Converter={x:Static views:SkinImageConverter.Instance},
                                                ConverterParameter='MediaLogos/audio/{0}'}"
                               Height="34"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Stretch="Uniform"/>
                        <TextBlock Text="{Binding DetailsAudio.CodecWord}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding DetailsAudio.CodecToken,
                                                       Converter={x:Static views:SkinImageMissingConverter.Instance},
                                                       ConverterParameter='MediaLogos/audio/{0}'}"
                                   Foreground="{DynamicResource TextBrush}"/>
                      </Grid>
                    </Border>

                    <Border Classes="details-logo"
                            Padding="20,0"
                            Margin="0,0,10,10"
                            IsVisible="{Binding DetailsAudio.ShowsChannels}">
                      <Grid>
                        <Image Source="{Binding DetailsAudio.ChannelsToken,
                                                Converter={x:Static views:SkinImageConverter.Instance},
                                                ConverterParameter='MediaLogos/audio/{0}'}"
                               Height="34"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Stretch="Uniform"/>
                        <TextBlock Text="{Binding DetailsAudio.ChannelsWord}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding DetailsAudio.ChannelsToken,
                                                       Converter={x:Static views:SkinImageMissingConverter.Instance},
                                                       ConverterParameter='MediaLogos/audio/{0}'}"
                                   Foreground="{DynamicResource TextBrush}"/>
                      </Grid>
                    </Border>

                    <Border Classes="details-logo"
                            Padding="20,0"
                            Margin="0,0,10,10"
                            IsVisible="{Binding DetailsAudio.ShowsRates}">
                      <TextBlock Text="{Binding DetailsAudio.RatesText}"
                                 FontSize="17"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextBrush}"/>
                    </Border>
                  </WrapPanel>
                </StackPanel>
              </Grid>
            </Border>

            <!--
              The reference's foot, and in the same pieces it drew there: the shelf's two numbers - where the
              highlight stands, and how many titles there are - at the right hand end of the bottom edge, inside
              the room so that they slide with the shelf. The numbers answer in every view, covers included,
              because a cover viewer wants to know how deep the shelf is too. It is paint, not a control.
            -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,40,26"
                        Spacing="9"
                        IsHitTestVisible="False"
                        IsVisible="{Binding HasTitles}">
              <TextBlock Text="{Binding SelectedNumber}" FontSize="18" VerticalAlignment="Center" Opacity="0.75"/>
              <TextBlock Text="|" FontSize="22" VerticalAlignment="Center" Opacity="0.45"/>
              <TextBlock Text="{Binding TotalNumber}" FontSize="18" VerticalAlignment="Center" Opacity="0.75"/>
            </StackPanel>
          </Panel>

          <!--
            THE DETAILS BESIDE THE SHELF: what the reference called MultiDetails.xml, as it laid it for grid and
            list - a thousand points wide, on a ground of a fifth of black over the title's own fanart (which is
            the screen's fanart already, since the fanart follows the highlighted row), with the skin's
            List_overlay darkening that ground further and the skin's ContentGlow along the column's left edge so
            that it does not end at a line. The negative margins are the reference's: the ground has to reach past
            the shelf's head and past the window's bottom edge, because a column that stopped level with the shelf
            would float over the picture it belongs to.
          -->
          <Border Name="detailsPanel"
                  Grid.Column="1"
                  Margin="45,-96,-10,-270"
                  ClipToBounds="False"
                  IsVisible="{Binding ShowsSideDetails}">
            <Border.Background>
              <!--  Avalonia reads a bare number in StartPoint/EndPoint as an amount in
                    device-independent pixels, not as the 0..1 fraction WPF uses: the
                    "1,0.3" -> "0,0.5" version was a line one DIP long in the top left
                    corner, which is why the wash never appeared. Only the '%' suffix
                    means "of the panel". The wash stands 60 % black (#99 = 0.6 * 255)
                    from the right corner out to sixty hundredths of the line and only
                    then thins to nothing at the left edge, so the words sit on an even
                    ground instead of on a gradient that starts thinning behind them.  -->
              <LinearGradientBrush StartPoint="100%,45%" EndPoint="3%,50%">
                <GradientStop Color="#99000000" Offset="0"/>
                <GradientStop Color="#99000000" Offset="0.6"/>
                <GradientStop Color="#00000000" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <Panel ClipToBounds="False">
              <!--Border Background="#33000000"/>
              <Image Source="{Binding Converter={x:Static views:SkinImageConverter.Instance},
                                      ConverterParameter=List_overlay}"
                     Stretch="Fill"
                     IsHitTestVisible="False"/>
              <Image Source="{Binding Converter={x:Static views:SkinImageConverter.Instance},
                                      ConverterParameter=ContentGlow}"
                     Width="13"
                     HorizontalAlignment="Left"
                     Stretch="Fill"
                     IsHitTestVisible="False"/-->

              <!--
                The column of words beside the shelf, laid as the reference laid its MediaItemListMovieDetails.inc:
                a head of everything that is said once - the name, the rating, the studio's sentence and the facts -
                and under it the story, which is given all the height that is left (that file's own row for the
                description is Height="*", under a row of Auto for the name). It is not given a cap of its own,
                because a cap is what left a long story ending mid-sentence while a third of the column stood empty.
                The bottom margin is bigger than the visible window needs: the ground behind these words runs past
                the window's lower edge (the reference's own negative margin), and words may not follow it there.
              -->
              <!--
                The bottom of this grid used to sit three hundred and ten lines above the window's edge, which was
                drawn when the panel's only children were the head, the facts and the story. The progress ring and
                the title's lettering stand at the foot of the head now - where the reference stood them - and on a
                living-room window of nine hundred and sixty lines that pushed the ring, and with it the last lines
                of the story, past the bottom edge of the screen.

                Two hundred stays, because the margin is not what holds the words in any more: a box only keeps to a
                height it is handed, and this one was handed none - the Panel above it let it grow to everything its
                rows asked for, which for a long reading was a hundred lines past the bottom of the screen.  The view
                now hands it its height (MediaBrowserView.FitStoryIntoThePanel), measured from the one line the
                viewer drew under the details: A HUNDRED lines above the lower edge of the space this panel is drawn
                in, which is the window's own edge when the skin is drawn at its own size.  Clipping is the
                same rule written down twice, so that neither a word nor a picture can get past it by some route the
                measuring did not think of.
              -->
              <Grid Name="detailsWords"
                    Margin="0,140,50,200"
                    VerticalAlignment="Top"
                    ClipToBounds="True">
                <Grid.RowDefinitions>
                  <!-- The band the picture used to be described in.  The viewer moved those answers to the left
                       hand side of the reading on 2026-11-02, under the word "Video"; four plaques were asked to
                       stay here, and they now stand behind the stars (see the row below).  The row is not taken
                       out of the grid because every row under it is named by its number, but it asks for nothing:
                       nothing stands in it. -->
                  <RowDefinition Height="Auto"/>
                  <!-- The head, which is said once: the name, its stars and the studio's sentence. -->
                  <RowDefinition Height="Auto"/>
                  <!-- The row the four pairs stand in, under the head and above the story. -->
                  <RowDefinition Height="Auto"/>
                  <!-- The story's row while the story stands beside its picture, and the row the picture stands in
                       once the story is told under it - which only an episode does.  A floor of its own, because a
                       row of "*" shrinks to whatever the head and the foot leave, and on a screen that is stood up
                       small or measured before it has a size that leaves nothing at all - which is not "a short
                       story", it is a control with no room to be laid out.  The reference's row for the description
                       was "*" too (MediaItemListMovieDetails.inc:17).  Both height and floor are asked of the view
                       model because the two rows trade places: whichever of them the story is not told in may not
                       cost the story a hundred and sixty lines of nothing. -->
                  <RowDefinition Height="{Binding DetailsPictureRowHeight}"
                                  MinHeight="{Binding DetailsPictureRowFloor}"/>
                  <!--
                    The row the story is told in once a disc lies under the cover, or once the picture stands over
                    its story as an episode's does.  A disc looking out of the cover's left side needs the column
                    the story stood in (the disc is three hundred sixty one lines wide and a hundred forty four of
                    them stand outside the cover), so the story goes under the cover instead and is given the
                    panel's whole width there - the viewer's word on 2026-11-03.  An episode's story is given that
                    same whole width for the opposite reason: nothing stands beside it any more, and a reading that
                    stops halfway across the panel with an empty column at its right hand side is a hole (the
                    viewer's word on 2026-11-10).  A row of its own rather than a margin, because the story keeps
                    its own scroller and that scroller wants a row to be measured in.
                  -->
                  <RowDefinition Height="{Binding DetailsStoryRowHeight}"
                                  MinHeight="{Binding DetailsStoryRowFloor}"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <!-- Two columns, but only the bottom row uses them: the story's column and the picture's column,
                       which is how the reference split the same panel (MediaItemListMovieDetails.inc:19-23 - six
                       hundred for the description, the rest for the poster).  The picture's column is a written
                       number rather than Auto, because an Auto column is asked what it wants before the story is
                       asked what it needs, and it grew to two thousand one hundred of the panel's pixels on a
                       title whose poster had never been measured. -->
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="400"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="12">
                <!-- The title, and the reference's rule about it: as big as it needs to be, but on one line -
                     its own label style trimmed the title rather than letting three words take two bands off the
                     plot that every viewer actually reads. -->
                <TextBlock Text="{Binding DetailsHeading}"
                           FontSize="45"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <!-- The rating, as the reference's movie panel wrote it: the skin's own five stars filled to half
                     the number the library recorded - TotalRating/2 onto a Maximum of five - and the number itself
                     after them, in brackets and in the smaller light. A library that recorded no rating (no number
                     at all, or a nought) says nothing at all, which is that file's condition too: the stars and
                     their number stand or fall with TotalRating through ReferenceToBoolConverter. -->
                <!-- Fourteen here, twelve that the column itself puts between every pair of its children (the
                     tagline stands here even when a title has none, and an invisible child still costs its
                     twelve), and four the facts band carries above itself: thirty lines of ground between a
                     rating and the answers under it - twenty were asked for first, then ten more on the
                     viewer's word. Measured, not reckoned: the facts stood one hundred ninety-eight lines
                     down with four here, and ten lower with this. -->
                <!--
                  The rating on the left, and the file's answers on the right of the same line.  The viewer set
                  that on 2026-11-02: the rating stays where it has always stood - at the left edge, the first
                  thing said on the line - while the plaques are pushed to the right edge of the panel, so that
                  the two ends of the line are two ends and not one crowded crowd.

                  Five answers stand here: the codec, the size, the high dynamic range the file was mastered in,
                  the loudspeaker of the first audio track's channels (the picture the first audio card wears at
                  its top right corner, which is the answer a viewer reaches for before reading a single track -
                  "is this a surround file?"), and the framed "CC" that says whether the file carries text at all.
                  That last one travelled over from the reader's side on the same evening, and it travelled - it
                  was not copied: it is read here and nowhere else.  Every plaque wears its inner ground on
                  itself (twenty points on each side) rather than taking it from the style, so that a logo of one
                  width and a word of another stand in boxes measured the same way.

                  The row outlives the rating: a library that recorded no number (none at all, or a nought) says
                  nothing with stars - the reference's rule, through ReferenceToBoolConverter - but the file still
                  has a codec, a size and its tracks, and those answers are not the rating's to withhold.  That is
                  why the stars stand in a panel of their own inside this line rather than being the line itself,
                  and why the line is a grid of "what the rating needs" and "all the room that is left": with no
                  rating to its left the row still holds its plaques at the right edge.

                  Fourteen here, twelve that the column itself puts between every pair of its children (the
                  tagline stands here even when a title has none, and an invisible child still costs its
                  twelve), and four the facts band carries above itself: thirty lines of ground between a
                  rating and the answers under it - twenty were asked for first, then ten more on the
                  viewer's word. Measured, not reckoned: the facts stood one hundred ninety-eight lines
                  down with four here, and ten lower with this.
                -->
                <Grid ColumnDefinitions="Auto,*"
                      Margin="0,0,0,14">
                  <StackPanel Grid.Column="0"
                              Orientation="Horizontal"
                              Spacing="12"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              IsVisible="{Binding DetailsRating, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <ItemsControl ItemsSource="{Binding DetailsStars}" VerticalAlignment="Center">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:Double">
                          <!-- The number IS the star's light: whole for a star the rating filled, a quarter of it
                               for a star the rating never reached. Computed where the rating is computed, because a
                               control cannot do arithmetic. -->
                          <Image Source="{Binding Converter={x:Static views:SkinImageConverter.Instance},
                                                  ConverterParameter=star}"
                                 Width="25"
                                 Height="25"
                                 Margin="0,0,4,0"
                                 Opacity="{Binding}"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding DetailsRatingWords}"
                               FontSize="22"
                               Foreground="{DynamicResource TextBrush}"
                               Opacity="0.85"
                               VerticalAlignment="Center"/>
                  </StackPanel>

                  <!-- Every plaque of this row is the same grey plaque the reader's side uses
                       (Border.details-logo, one height written once), and every one of them is a logo the worn skin
                       carries or - where it carries no picture of that name - the figure in words.  Which is the
                       one thing these rows do that the reference could not: a codec its 2014 catalog never saw
                       ("HEVC", "MLP FBA") is named here rather than being silently missing. -->
                  <StackPanel Grid.Column="1"
                              Orientation="Horizontal"
                              Spacing="10"
                              Margin="28,0,0,0"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              IsVisible="{Binding ShowsTracks}">
                    <!-- Whether the file carries subtitle tracks at all, said with the glyph for it rather than with
                         a word: the framed "CC" when the file has text, the same frame crossed out when it has none
                         (MediaInfoVideo.xaml:157-174, "AspectCount < 1").  It stands at the head of this row because
                         the reference asked that question first, and it stands here only: the reader's side lost its
                         copy on 2026-11-02, since two answers of the same question on one screen is one answer too
                         many.  Named because a test asks the screen whether the plaque was moved or copied. -->
                    <!-- Only a picture is asked.  A sound file carries no subtitle and never could, so on the audio
                         reading the whole plaque is away - not its crossed face, which would say "no subtitles"
                         about a title that has nothing to be without (the viewer's word on 2026-11-03, and the
                         reference's own arrangement: MediaInfoAudio.xaml:115-170 asks the packing, the loudspeakers,
                         the disc and the two rates, and never asks about text). -->
                    <Border Classes="details-logo"
                            Name="subtitlesPlaque"
                            Padding="20,0"
                            IsVisible="{Binding ShowsSubtitlePlaque}">
                      <Grid Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Path Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                                                ConverterParameter='PlayerControl/subtitles'}"
                              Fill="{DynamicResource TextBrush}"
                              Stretch="Uniform"
                              IsVisible="{Binding ShowsFileSubtitles}"/>
                        <!-- The crossed frame is the answer to the same question as the framed "CC", so it is said
                             in the same white (the viewer asked for that on 2026-11-03; it stood at six tenths of
                             the light before, which read as a word half spoken). -->
                        <Path Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                                                ConverterParameter='PlayerControl/subtitles_off'}"
                              Fill="{DynamicResource TextBrush}"
                              Stretch="Uniform"
                              IsVisible="{Binding !ShowsFileSubtitles}"/>
                      </Grid>
                    </Border>

                    <Border Classes="details-logo"
                            Padding="20,0"
                            IsVisible="{Binding DetailsPicture.ShowsCodec}">
                      <Grid>
                        <Image Source="{Binding DetailsPicture.CodecToken,
                                                Converter={x:Static views:SkinImageConverter.Instance},
                                                ConverterParameter='MediaLogos/video/{0}'}"
                               Height="34"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Stretch="Uniform"/>
                        <TextBlock Text="{Binding DetailsPicture.CodecWord}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding DetailsPicture.CodecToken,
                                                       Converter={x:Static views:SkinImageMissingConverter.Instance},
                                                       ConverterParameter='MediaLogos/video/{0}'}"
                                   Foreground="{DynamicResource TextBrush}"/>
                      </Grid>
                    </Border>

                    <!-- How big the picture is, at the reference's own bounds and out of its own folder
                         (MediaInfoVideo.xaml:205-214), which named the file "1080p" and the word alike. -->
                    <Border Classes="details-logo"
                            Padding="20,0"
                            IsVisible="{Binding DetailsPicture.ShowsResolution}">
                      <Grid>
                        <Image Source="{Binding DetailsPicture.Resolution,
                                                Converter={x:Static views:SkinImageConverter.Instance},
                                                ConverterParameter='MediaLogos/resolution/{0}'}"
                               Height="34"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Stretch="Uniform"/>
                        <TextBlock Text="{Binding DetailsPicture.Resolution}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding DetailsPicture.Resolution,
                                                       Converter={x:Static views:SkinImageMissingConverter.Instance},
                                                       ConverterParameter='MediaLogos/resolution/{0}'}"
                                   Foreground="{DynamicResource TextBrush}"/>
                      </Grid>
                    </Border>

                    <!-- Whether the picture was mastered in a high dynamic range format, and which one.  The
                         reference never asked this question - it had no HDR answer to give - so this plaque is this
                         front end's own, and it wears its word alone: the word says "HDR" twice over, so a glyph
                         beside it would only repeat the answer.  An ordinary file leaves the plaque away entirely,
                         which is the viewer's rule for it: no HDR, no container. -->
                    <Border Classes="details-logo"
                            Padding="20,0"
                            IsVisible="{Binding DetailsPicture.ShowsHdr}">
                      <TextBlock Text="{Binding DetailsPicture.HdrFormat}"
                                 FontSize="17"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextBrush}"/>
                    </Border>

                    <!-- The channels of the file's FIRST audio track, as the first audio card shows them at its
                         top right corner: the loudspeaker picture of the plain count out of the skin's own folder
                         (MediaLogos\audio\6.png for a 5.1 arrangement), and the trade's word for it where the skin
                         carries no picture of that count.  Said here because it is the one question a viewer asks
                         before reading any track list. -->
                    <Border Classes="details-logo"
                            Padding="20,0"
                            IsVisible="{Binding ShowsFirstAudioChannels}">
                      <Grid>
                        <Image Source="{Binding FirstAudioChannelsToken,
                                                Converter={x:Static views:SkinImageConverter.Instance},
                                                ConverterParameter='MediaLogos/audio/{0}'}"
                               Height="34"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Stretch="Uniform"/>
                        <TextBlock Text="{Binding FirstAudioChannelsWord}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding FirstAudioChannelsToken,
                                                       Converter={x:Static views:SkinImageMissingConverter.Instance},
                                                       ConverterParameter='MediaLogos/audio/{0}'}"
                                   Foreground="{DynamicResource TextBrush}"/>
                      </Grid>
                    </Border>

                    <!--
                      The three plaques a SOUND file answers by, copied onto this line on the viewer's word of
                      2026-11-03: they had always been read here too (DetailsAudio), but only ever drawn on the
                      information screen (the "Audio" band above, MediaInfoAudio.xaml:115-170), so an album stood
                      in its own details with nothing at the end of the line while its codec, its loudspeakers, its
                      disc and its two rates were already in the same answer.  Copied and not moved - the
                      information screen keeps its own row, which is the screen a viewer opens to read a file.

                      The DISC is the one answer of that row that is not copied: the facts band under the name says
                      the same figure as "Discs", and a screen that says a figure twice has one figure too many
                      (the viewer's word on 2026-11-03, pointing at the plaque of "1 | 2" standing over the fact).

                      Nothing is asked for them that was not asked before: like the video plaques above they read
                      the details answer, and each stands or falls on its own answer.  A film wears none of them
                      (no sound file, no audio aspect), and a sound file wears none of the four video plaques
                      above, so the two families never crowd one line.
                    -->
                    <!-- What the file is packed in, asked for by that very word (MediaInfoAudio.xaml:118-126). -->
                    <Border Classes="details-logo"
                            Name="detailsAudioCodecPlaque"
                            Padding="20,0"
                            IsVisible="{Binding DetailsAudio.ShowsCodec}">
                      <Grid>
                        <Image Source="{Binding DetailsAudio.CodecToken,
                                                Converter={x:Static views:SkinImageConverter.Instance},
                                                ConverterParameter='MediaLogos/audio/{0}'}"
                               Height="34"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Stretch="Uniform"/>
                        <TextBlock Text="{Binding DetailsAudio.CodecWord}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding DetailsAudio.CodecToken,
                                                       Converter={x:Static views:SkinImageMissingConverter.Instance},
                                                       ConverterParameter='MediaLogos/audio/{0}'}"
                                   Foreground="{DynamicResource TextBrush}"/>
                      </Grid>
                    </Border>

                    <!-- How many channels, at the picture of their count; the trade's word for the arrangement stands
                         where the skin carries no picture of that count (MediaInfoAudio.xaml:128-136). -->
                    <Border Classes="details-logo"
                            Padding="20,0"
                            IsVisible="{Binding DetailsAudio.ShowsChannels}">
                      <Grid>
                        <Image Source="{Binding DetailsAudio.ChannelsToken,
                                                Converter={x:Static views:SkinImageConverter.Instance},
                                                ConverterParameter='MediaLogos/audio/{0}'}"
                               Height="34"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Stretch="Uniform"/>
                        <TextBlock Text="{Binding DetailsAudio.ChannelsWord}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding DetailsAudio.ChannelsToken,
                                                       Converter={x:Static views:SkinImageMissingConverter.Instance},
                                                       ConverterParameter='MediaLogos/audio/{0}'}"
                                   Foreground="{DynamicResource TextBrush}"/>
                      </Grid>
                    </Border>

                    <!-- The bitrate and the sample rate, the two figures the reference stacked in its last cell
                         (MediaInfoAudio.xaml:150-165, "{0} kbps" over "{0} Hz"), said as one line about the file's
                         rate.  Either of them stands alone: a file whose sample rate never arrived says its bitrate
                         and leaves the dot out. -->
                    <Border Classes="details-logo"
                            Padding="20,0"
                            IsVisible="{Binding DetailsAudio.ShowsRates}">
                      <TextBlock Text="{Binding DetailsAudio.RatesText}"
                                 FontSize="17"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextBrush}"/>
                    </Border>
                  </StackPanel>
                </Grid>
                <TextBlock Text="{Binding DetailsTagline}"
                           FontSize="30"
                           FontStyle="Italic"
                           Foreground="{DynamicResource TextBrush}"
                           Opacity="0.75"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"
                           IsVisible="{Binding DetailsTagline, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

                <!--
                  The facts, in the pairs the reference's panels printed (MediaItemListDetails.inc:109 - the answer
                  first, the word under it in the smaller size).  They stand in their own row under the head and they
                  have the whole width for themselves - only the story and the picture share the panel below them.
                  They used to be said twice, once as a sentence above the story and once here, and to wait at the
                  foot of the column below a band of nothing.
                -->
                <ItemsControl Grid.Row="2"
                              Grid.ColumnSpan="2"
                              ItemsSource="{Binding DetailsFacts}"
                              ItemTemplate="{StaticResource MediaFactTemplate}"
                              Margin="0,4,0,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!--
                  The poster, in the story's row and standing on the story's first line, which is where it was asked
                  for: the top margin is the same forty the story's own column carries, so the two begin together -
                  when the episode's name pushes the story down, the poster is pushed with it and stays flush.
                  The reference stood its MoviePoster at the right hand end of the panel with the picture inset in a
                  box of its own (MediaItemListMovieDetails.inc:23-38); the size here is the box that was drawn for
                  it.  A title the library keeps no poster of leaves the box empty - not a poster standing in for a
                  poster that is not there.

                  The frame is the picture's own and not a fixed box: it is told the greatest width and height the
                  box may take and then shrinks to the poster that arrives in it, because the corners are rounded on
                  the frame and a frame wider than its picture would round nothing.  The rounding is the tiles'
                  rounding (Border.home-tile-face, ten points) at twice the size, which is what the viewer asked for
                  and what a picture this large can carry.
                -->
                <Border Name="coverAlone"
                        Grid.Row="3"
                        Grid.Column="1"
                        MaxWidth="380"
                        MaxHeight="500"
                        Margin="20,40,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        CornerRadius="10"
                        ClipToBounds="True"
                        IsVisible="{Binding ShowsCoverAlone}">
                  <Panel>
                    <Image Source="{Binding DetailsArtwork, Converter={x:Static views:ArtworkConverter.Instance}}"
                           Stretch="Uniform"/>
                    <!--
                      How far this viewer got, as the home tiles say it: a line at the cover's own foot, as wide
                      as the cover and no wider - the frame above shrinks to the poster, so the line measures the
                      picture and not the box (the home learned that lesson the hard way, commit 0515db5598).
                      The line wears the home's ground too: a black fade rising from the cover's bottom edge (the
                      same TitleFadeBrush the tile caption stands on, HomeView.axaml's bar over a 45-line fade),
                      so a white line over a bright cover still reads. Quiet line, the skin's white for the part
                      that was watched, between the ends only: an untouched title has nothing to measure and a
                      finished one is watched, which the watched mark says (HomeContentStyles.xaml:203-207).
                    -->
                    <Border Height="45"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource TitleFadeBrush}"
                            IsVisible="{Binding DetailsProgressShown}"
                            IsHitTestVisible="False"/>
                    <ProgressBar Height="8"
                                 MinWidth="0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding DetailsProgress}"
                                 VerticalAlignment="Bottom"
                                 CornerRadius="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextBrush}"
                                 IsVisible="{Binding DetailsProgressShown}"
                                 IsHitTestVisible="False"/>
                  </Panel>
                </Border>

                <!--
                  THE ROW THE PICTURE STANDS IN, seen from its left column: the title's lettering at the top - where
                  it has always stood, and where it stays for every title whose story is told beside its picture -
                  and the episode's own name at the foot.  The name is flush with the panel's left edge and flush
                  with the thumbnail's foot, so that the two ends of the row are an edge and not a floating word
                  (the viewer's word on 2026-11-10); it stood over its story before, which cost the story two lines.
                  The two children never ask for the same ground: the lettering is the picture of the whole title and
                  keeps the top, the name is one episode's and keeps the foot, and the row asks for the thumbnail
                  alone, so "the foot" here is the thumbnail's foot and not the bottom of the panel.  Only episodes
                  wear the name; every other title answers the empty string and the child costs nothing.
                -->
                <Grid Grid.Row="3"
                      Grid.Column="0"
                      RowDefinitions="*,Auto">
                  <Image Grid.Row="0"
                         Source="{Binding DetailsClearArt,
                                          Converter={x:Static views:ArtworkConverter.Instance},
                                          ConverterParameter=small}"
                         Height="140"
                         MaxWidth="240"
                         Margin="0,40,0,0"
                         Stretch="Uniform"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         IsVisible="{Binding ShowsClearArtOverPicture}"/>
                  <TextBlock Grid.Row="1"
                             VerticalAlignment="Bottom"
                             Text="{Binding DetailsEpisodeName}"
                             FontSize="26"
                             FontWeight="Bold"
                             Foreground="{DynamicResource TextBrush}"
                             TextWrapping="Wrap"
                             IsVisible="{Binding DetailsEpisodeName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </Grid>

                <!--
                  THE DISC UNDER ITS COVER, for the albums a library keeps a picture of the disc of.  The reference
                  laid the two into one box: the disc asked for at four hundred twenty lines, the cover at four
                  hundred forty over it, both in a box of four hundred fifty six
                  (MediaItemListAudioAlbumDetails.inc:41-44, :52, :33), and its disc looked out from under the
                  cover by a hundred ninety of its own four hundred twenty - five parts out of eleven.  These are
                  the same two measures shrunk to this panel's cover (three hundred eighty lines, the frame above)
                  and turned to the left: three hundred sixty one of disc, a hundred forty four of it - forty
                  percent - standing outside the cover's left edge, and the disc's middle on the cover's middle.
                  A disc is a disc and is drawn as one, because the files are square scans of a printed disc and
                  only the round cut reads as the thing itself.

                  The disc is painted first and the cover over it, which is the reference's order, and the shadow
                  is what keeps the two apart on a dark ground.  The panel this stands in is not clipped, and it
                  may not be: the disc's outer part lies outside the cover's frame by design.

                  The cover is a written box here rather than the shrinking frame above, because a disc has to be
                  laid against an edge that does not move: an album's cover is square, which is also why the
                  reference could give its AlbumCover a Width and a Height at all.
                -->
                <Panel Name="discAndCover"
                       Grid.Row="3"
                       Grid.Column="1"
                       Margin="20,40,0,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       ClipToBounds="False"
                       IsVisible="{Binding ShowsDiscBehindCover}">
                  <Border Name="discBehindCover"
                          Width="361"
                          Height="361"
                          Margin="-144,0,0,0"
                          CornerRadius="180"
                          ClipToBounds="True"
                          BoxShadow="0 12 34 0 #A6000000"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center">
                    <Image Source="{Binding DetailsAlbumDisc, Converter={x:Static views:ArtworkConverter.Instance}, ConverterParameter=361}"
                           Stretch="UniformToFill"/>
                  </Border>
                  <Border Name="coverOnDisc"
                          Width="380"
                          Height="380"
                          CornerRadius="10"
                          ClipToBounds="True"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top">
                    <Panel>
                      <Image Source="{Binding DetailsArtwork, Converter={x:Static views:ArtworkConverter.Instance}}"
                             Stretch="Uniform"/>
                      <!-- the same ground and line at the same foot as the stand-alone cover wears -->
                      <Border Height="45"
                              VerticalAlignment="Bottom"
                              Background="{DynamicResource TitleFadeBrush}"
                              IsVisible="{Binding DetailsProgressShown}"
                              IsHitTestVisible="False"/>
                      <ProgressBar Height="8"
                                   MinWidth="0"
                                   Minimum="0"
                                   Maximum="100"
                                   Value="{Binding DetailsProgress}"
                                   VerticalAlignment="Bottom"
                                   CornerRadius="0"
                                   Background="Transparent"
                                   Foreground="{DynamicResource TextBrush}"
                                   IsVisible="{Binding DetailsProgressShown}"
                                   IsHitTestVisible="False"/>
                    </Panel>
                  </Border>
                </Panel>

                <!--
                  Where the file stands is not said here any more.  A viewer choosing a film reads a story, not a
                  resource address, and the line lay across the foot of the screen like a footnote nobody asked
                  for; the screen still knows it (MediaBrowserViewModel.DetailsPath), it is simply not painted.
                -->
                <!--
                  THE WRITING, when a disc lies under the cover.  It keeps the place it was asked for in - the left
                  hand end of the row, its top edge on the cover's top edge, a hundred twenty lines tall and never
                  wider than two hundred fifty (MediaItemListAudioAlbumDetails.inc:26-31) - it only loses the
                  company of the story, which has moved under the cover.  The hundred fifty of right margin are what
                  keeps it out of the disc: the disc stands a hundred forty four lines into this column, and the
                  margin holds the writing clear of it on a window of any width.

                  It stands here rather than being the same frame with a different row, because the row the story
                  is told in moves and this picture's row does not.
                -->
                <Image Grid.Row="3"
                       Grid.Column="0"
                       Source="{Binding DetailsAlbumLettering,
                                        Converter={x:Static views:ArtworkConverter.Instance},
                                        ConverterParameter=small}"
                       Height="120"
                       MaxWidth="250"
                       Margin="0,40,150,0"
                       Stretch="Uniform"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       IsVisible="{Binding ShowsLetteringOverCover}"/>

                <!--
                  The story, in the room that is left. The reference gave its description the whole second row of
                  the panel (MediaItemListMovieDetails.inc:16-19: a row of Auto for the name and a row of "*" for
                  MediaItemDescription, that one wrapping by Wrap="True") and never a height of its own; the plot
                  of the player's own information area (MediaStyles.xaml:156) is the one that additionally reads
                  itself down the screen, which is what PlotAutoScroll is for.  Neither of them was ever veiled:
                  the reference's Label carries no mask of any kind, so a story that ends two thirds down the
                  column ends in readable words rather than in a fade nobody asked for.
                -->
                <!--
                  Its row is asked of the panel rather than written here: as long as no disc lies under the cover
                  the story stands in the column beside the cover, and once a disc does, the story is told under
                  the cover and is given both columns - the disc needs the column this one had, and under the
                  cover nothing stands in the way of the full width any more.
                -->
                <!--
                  A dock and not a stack, because a stack asks every child what it wants and hands out no room:
                  the story then took the height of its whole plot - nine hundred and ten lines of it on a window
                  of seven hundred and sixty-eight - and ran the words down past the bottom of the picture and off
                  the screen. Here the lettering, the title's picture and the episode's name dock to the top as
                  much as they need, and the story is given what is left and no more.  What is left is measured by
                  the view (MediaBrowserView.FitStoryIntoThePanel), which is the only place that can know it: the
                  row this box stands in is a row of "*" beside the cover and a row of "Auto" under it, and a row
                  of "Auto" hands out exactly what it is asked for, which is everything.
                -->
                <DockPanel Name="storyBox"
                           Grid.Row="{Binding DetailsStoryRow}"
                           Grid.Column="0"
                           Grid.ColumnSpan="{Binding DetailsStoryColumns}"
                           LastChildFill="True"
                           Margin="0,40,0,0">
                  <!--
                    THE ALBUM'S OWN LETTERING, over its story and nowhere else: the reference stood it at the left
                    hand end of the album's column, a hundred and twenty lines tall and asked of the server no
                    wider than two hundred and fifty, and put the album's description a row under it
                    (MediaItemListAudioAlbumDetails.inc:26-31, the description at :307).  The measure here is that
                    measure; the one thing it is not is the reference's five line top margin, because the viewer
                    asked for the lettering's top edge to be the poster's top edge - and it is, since this column
                    and the poster's frame both begin forty lines under the facts.

                    It is an album's picture and not a film's: a film's lettering stands in the head's progress
                    row beside the ring (MediaInfoMovieDetails.inc:355-362, DetailsClearArt above), and drawing the
                    same name twice on one screen is not showing it better.  An album that has neither kind says
                    nothing, which the frame below already promises by disappearing with the bytes.
                  -->
                  <Image DockPanel.Dock="Top"
                         Source="{Binding DetailsAlbumLettering,
                                          Converter={x:Static views:ArtworkConverter.Instance},
                                          ConverterParameter=small}"
                         Height="120"
                         MaxWidth="250"
                         Margin="0,0,0,7"
                         Stretch="Uniform"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         IsVisible="{Binding ShowsLetteringOverStory}"/>
                  <!--
                    THE TITLE'S OWN LETTERING, which is a picture of its own kind and not the poster written
                    again: the reference asked for it under the name ClearArt and hung it beside the progress
                    ring (MediaInfoMovieDetails.inc:355-362). The ring is gone - how far this viewer got is read
                    off the line at the cover's foot now, the home tiles' way of saying it - and the lettering
                    keeps the row's right hand end alone, its height and ask unchanged: a hundred and forty
                    lines, no wider than two hundred and forty. Most libraries hold none, and the frame then
                    costs nothing.  It is docked over the reading and not beside the picture, because this is the
                    case where the reading stands next to its picture; an episode, whose reading is told under its
                    thumbnail, keeps its lettering up there with the thumbnail instead.
                  -->
                  <Image DockPanel.Dock="Top"
                         Source="{Binding DetailsClearArt,
                                          Converter={x:Static views:ArtworkConverter.Instance},
                                          ConverterParameter=small}"
                         Height="140"
                         MaxWidth="240"
                         Margin="0,0,0,16"
                         Stretch="Uniform"
                         HorizontalAlignment="Right"
                         IsVisible="{Binding ShowsClearArtOverStory}"/>
                  <!-- Nothing to read, no room spent: a song whose library wrote no prose about it shows an empty
                       strip of nothing, which reads as a broken panel rather than as a record nobody described
                       (the reference drew no prose block on its audio screen at all). -->
                  <ScrollViewer Name="plotScroller"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Hidden"
                                IsVisible="{Binding DetailsText,
                                                    Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Name="detailsText"
                               Text="{Binding DetailsText}"
                               FontSize="23"
                               LineHeight="32"
                               Foreground="{DynamicResource TextBrush}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"/>
                  </ScrollViewer>
                </DockPanel>
              </Grid>
            </Panel>
          </Border>
        </Grid>
      </Panel>

      <!--
        The word the rail speaks, laid at the room's foot. The viewer asked for it moved out of the rail's top
        and down to where the home says its media line - the one line about the title a walker stands on - and
        that line is the measure of this one in position as well as in letters: two and twenty points of the
        face's own text, thirty-four points above the window's bottom edge, and two hundred and forty in from
        the room's left, which is the rail's two hundred and the gap of forty the home leaves beside its rail.
        It spans both columns so the margin counts from the room's own left edge, it is painted over the wall
        the way the home's line is painted over its fanart, and it goes when the rail goes, because it is the
        rail's word and not the wall's.

        It says more than the page's name now: the plate the caret stands on is named here with whatever that
        plate has to add.  A plate on the rail is a picture and one word and has no room for anything else - the
        reference's tiles had none either - so the second word a command carries, such as the end an order reads
        the shelf from, is said down here, where a whole line lies free.
      -->
      <TextBlock Grid.Row="0"
                 Grid.ColumnSpan="2"
                 Text="{Binding MediaMenuFootLine}"
                 FontSize="22"
                 Foreground="{DynamicResource TextBrush}"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Margin="240,0,0,34"
                 IsHitTestVisible="False"
                 TextTrimming="CharacterEllipsis"
                 IsVisible="{Binding MediaMenuVisible}"/>

      <!--
        What the screen says at its foot when it wears no details: the ONE line the home screen says about the
        title a walker stands on - the name, the year, the kinds of thing it is - in the home's letters (two and
        twenty) and at the home's measure, here measured off this room: two hundred and forty in from its left
        edge (the rail's two hundred and the gap of forty) and thirty-four above its floor, the same two numbers
        the menu's word above stands on.

        The viewer turned the details column off, not the knowledge.  Without this line a wall of tiles or rows
        answers nothing about the title the caret is on: the details column is away, the gradient over the covers
        is away, and the name painted on a tile is the whole of what the screen knows out loud.

        It steps aside for the three things that answer the same question better - the details column, the reading
        of one title, and the menu's word at this very place - and it is paint, never a control: a line which
        only speaks can never stand between a pointer and a tile.
      -->
      <TextBlock Grid.Row="0"
                 Grid.ColumnSpan="2"
                 Text="{Binding ContentInfo}"
                 FontSize="22"
                 Foreground="{DynamicResource TextBrush}"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Margin="240,0,0,34"
                 MaxWidth="1200"
                 IsHitTestVisible="False"
                 TextTrimming="CharacterEllipsis"
                 IsVisible="{Binding ShowsContentInfo}"/>

      <!--
        The pointer's handle to the screen's own menu, for the shelves that lay their menu UNDER themselves.

        A cover, a stack and the three dimensional row have no rail to their left - the reference hung their
        menu in the two hundred points below the window's floor and slid the room up over it - and a menu that
        arrives from under the television has no edge a hand can see. This mark is that edge: it stands at the
        foot of the content, centred on the room's width, and it is painted inside the room, so it rides up with
        the room and comes to rest above the row of plates it opened. Put the menu away and it travels back down
        with it, which is what keeps one mark in one place through the whole move instead of leaving a handle
        behind at the window's edge claiming an edge the menu already left.

        It is an icon button and nothing more - see Button.nereus-panel-mark in this face's styles, which is
        where its quiet, its answer to the pointer and its refusal to outlive the pointer are written - and the
        icon is the move the click makes, which the view model names. The shelf's own key (the reference's Info)
        opens and closes the same menu, and needs no mark to say so.
      -->
      <Panel Grid.Row="0"
             Grid.ColumnSpan="2"
             IsVisible="{Binding IsCoverLayout}">
        <Button Name="bottomMenuMark"
                Classes="nereus-panel-mark"
                Command="{Binding ToggleMediaMenuCommand}"
                ToolTip.Tip="Menu"
                Focusable="False"
                Width="48"
                Height="48"
                Margin="0,0,0,8"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom">
          <Path Data="{Binding MenuMarkIcon, Converter={x:Static views:SkinIconGeometryConverter.Instance},
                                ConverterParameter='MediaMenu/{0}'}"
                Fill="{DynamicResource TextBrush}"
                Width="30"
                Height="30"
                Stretch="Uniform"/>
        </Button>
      </Panel>
    </Grid>

    <!--
      THE SEARCH, standing in the head line the window would wear here.  The shelf stows that line away to keep
      its fanart whole (MediaBrowserView.axaml.cs, SetChromeHeaderStowed), so the question "which title?" is
      answered in the band the head line would have taken: the same hundred points of darkened picture at the
      top edge, nothing of the wall moved out of the way for it.

      It stands at the LEFT of that band and to the RIGHT of the pointer's own marks - the way back, the way
      home and the menu's handle, which are the window's furniture and are laid before this screen's (see
      ShellWindow.CornerNavRightEdge, which is what the code behind reads to push this row clear of them).  A
      search field laid under those marks would be a field with half its plate missing whenever a hand is on a
      desk, and the marks cannot give way: they are the only way out for that hand.

      ONE thing stands here, and it is off the screen until it is asked for (Viewer note 2026-11-10: the head
      line wears no magnifier waiting to be clicked - the search comes when the viewer calls it and not before).
      Two doors put it there - the shelf's own menu row "Search" and the Find key - and while it stands, the
      arrow lifted off the head of the wall steps back into it; the wall keeps its nod at its head while no
      field waits above it.  Whichever door was taken, the field grows into this band: one plaque in the corner
      the details row's plaques wear and five points lower than they are (43 to Border.details-logo's 48, and
      hung from its top edge, so the plate costs the wall nothing), the magnifier at its left hand, the typed
      words in the middle and the mark that takes the search away at its right.  Back or Escape takes it away
      from wherever the caret stands, which is the same answer as that mark; Up and Right nod the plate at its
      own edges, and no word is written beside the plaque, because nothing else on this screen spells out in
      words what a picture says.
    -->
    <StackPanel Name="searchStrip"
                Orientation="Horizontal"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="10,9,18,0"
                ClipToBounds="False">
      <Border Name="searchField"
              Classes="search-field"
              IsVisible="{Binding ShowsSearch}"
              VerticalAlignment="Top">
        <DockPanel>
          <Path DockPanel.Dock="Left"
                Classes="search-mark"
                Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                              ConverterParameter='MediaMenu/search'}"
                Fill="{DynamicResource TextBrush}"
                Width="24"
                Height="24"
                Margin="0,0,12,0"
                Stretch="Uniform"
                VerticalAlignment="Center"/>
          <Button Name="clearSearchMark"
                  DockPanel.Dock="Right"
                  Classes="nereus-corner-button nereus-corner-small"
                  Width="38"
                  Height="38"
                  CornerRadius="19"
                  VerticalAlignment="Center"
                  Command="{Binding CloseSearchCommand}"
                  Focusable="False"
                  ToolTip.Tip="Take the search away"
                  IsVisible="{Binding ShowsSearch}">
            <Path Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                                  ConverterParameter='PowerMenu/close'}"
                  Fill="{DynamicResource TextBrush}"
                  Width="18"
                  Height="18"
                  Stretch="Uniform"/>
          </Button>
          <TextBox Name="searchBox"
                   Classes="search-box"
                   views:VirtualKeyboardService.Trigger="Menu"
                   Text="{Binding SearchText, Mode=TwoWay}"
                   PlaceholderText="Find a title"
                   Width="340"
                   VerticalContentAlignment="Center"/>
        </DockPanel>
      </Border>
      <!-- The one keyboard button to the on-screen keys that a hand without a keyboard can find: it stands beside the
           plate, opens the keys for the field with a press, and takes them away again with another.  It is
           focusable, which the mark that takes the search away deliberately is not - that one is a way out,
           this one is a place the caret can stand on. -->
      <Button Name="keyboardToggle"
              Classes="search-keyboard"
              IsVisible="{Binding ShowsSearch}"
              Click="OnKeyboardToggleClicked"
              ToolTip.Tip="Type with the keys on the screen">
        <Panel>
          <Path Name="keyboardMark"
                Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                              ConverterParameter='MediaMenu/keyboard'}"
                Fill="{DynamicResource TextBrush}"
                Width="26"
                Height="26"
                Stretch="Uniform"/>
          <Path Name="keyboardOffMark"
                Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                              ConverterParameter='MediaMenu/keyboard_off'}"
                Fill="{DynamicResource TextBrush}"
                Width="26"
                Height="26"
                Stretch="Uniform"
                IsVisible="False"/>
        </Panel>
      </Button>
    </StackPanel>

    <!--
      Nothing is painted over the shelf at its head or its foot; see the note below where the two gradient bands
      used to stand.
    -->
    <!--
      The head and the floor used to be painted here, over the shelf, in the reference's own seven stops.  They
      were the black bars: master_bare_media.xaml:50-90 lays its head band in the hundred points ABOVE the client
      area and its floor under it, over the fanart, where ninety hundredths of black is a picture going dark;
      stood over a wall of posters the same band is a black slab lying across the first row, and it did not even
      answer whether the wall had anything left above it - it was simply always there.  The same answer is what the
      shelf's own edge fade is now asked for and asked for alone (ApplyShelfFade): an end the wall has left
      something standing out of the picture dissolves that end, an end the wall has reached leaves its row standing
      whole, and the reference - which fades nothing at all in any of its three media shapes - is not contradicted
      more than that.  Nothing is painted over the pictures themselves.
    -->

    <!--
      The selected title's menu, standing over the shelf the way the reference's DialogEditMenu stood over the
      list it was opened for: the shelf stays where it is, the menu speaks about one row, and Back puts it
      away. What the menu asks is decided by what the server can actually answer - today exactly one thing,
      whether a title was watched through - and where the library has no answer to give, the menu says so in
      words instead of pressing a button that would do nothing.

      The frame is this skin's own dialog frame, the very one the menu editor wears (the DialogHeadedFrame
      template): the dark grey ground, the corners of twenty-five, the white halo falling off outward from the
      panel's edge with nothing painted for it, the heading centred at the dialog title's size and nothing
      drawn between heading and body, and the answers on the skin's primary button. Behind it the ground stands
      washed dark, which is what the skin's dialog screens ask their home to be; a dialog over a wall of
      readable detail would ask the viewer to read two things at once. The wall is washed <em>and</em> thrown
      out of focus: the shell photographs its whole layout at the skin's <c>DialogBackdropBlur</c>, softened
      the way the workflow's dialogs soften it, and this dialog wears that photograph under its wash - the
      live wall hides under the picture, and a viewer who is being asked something is not watching the shelves
      behind them scroll.
    -->
    <Panel Name="menuScrim" Background="Transparent" IsVisible="{Binding MenuVisible}">
      <!-- The photograph of the ground, worn by the dialog rather than by the shell's own backdrop layer -
           that one sits over the whole layout and would bury a dialog standing inside a screen with its own
           ground. It is filled when the dialog opens and emptied when the dialog goes; a skin that names no
           blur leaves it bare and the wall stays live behind the wash. -->
      <Rectangle Name="menuGround" IsHitTestVisible="False"/>
      <Panel Background="{DynamicResource DialogWashBrush}"/>
      <Border Name="menuDialog"
              Background="{DynamicResource DialogGroundBrush}"
              CornerRadius="{DynamicResource DialogFrameCornerRadius}"
              BoxShadow="0 0 120 0 #59FFFFFF, 0 0 26 0 #FFFFFFFF"
              Margin="50"
              MaxWidth="760"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              RenderTransformOrigin="50%,50%">
        <DockPanel>
          <!-- Fifteen to each side rather than ten, the same five the shared headed frame keeps (templates.xaml
               "DialogHeadedFrameTemplate"): a heading that runs the width of the panel ends flush with the panel's
               own edge, and a word standing against an edge reads as cut off even when it is not. -->
          <TextBlock DockPanel.Dock="Top"
                     Text="{Binding MenuTitle}"
                     FontSize="{DynamicResource DialogTitleFontSize}"
                     FontWeight="Bold"
                     Foreground="{DynamicResource TextBrush}"
                     Margin="15,5"
                     Padding="0,5"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
          <StackPanel Margin="10" MinWidth="460">
            <!--
              The contents plate: a sheet of DialogPlateBrush inside the frame, its own smaller corner inside the
              frame's, holding everything the dialog answers WITH - the lines and the two quiet lines under them.
              Nothing stands under the sheet: a way out is not an answer, and three hands already take the
              question away - the back key (MediaBrowserView.axaml.cs:861-866), a press beside the dialog on the
              scrim (:557-565) and the info key that opened it (:766-770). The mockup the viewer drew this from
              gave the sheet five of margin against the body's ten and fifteen within against the lines, so the
              lines and the sheet's own top edge keep the same distance the rows keep to one another.
            -->
            <Border Name="menuPlate"
                    Background="{DynamicResource DialogPlateBrush}"
                    CornerRadius="{DynamicResource DialogPlateCornerRadius}"
                    Margin="5"
                    Padding="10,15">
              <StackPanel>
                <!--
                  The answers this title has, one line each, straight off the table the home wall reads too
                  (MediaTitleActions.For). Above this the dialog carried one button per answer and the table lived
                  in nothing, which is how the reference's list ended up as a single button here: adding the second
                  answer meant adding markup, and the reference's remaining answers would have meant more of the
                  same. The order and the availability of a line are the reference's
                  (MediaItemsActionModel.cs:373-392); what the table leaves out, it says why.

                  Every line fills the sheet's width - the reference stretched its dialog lines too
                  (HorizontalContentAlignment=Stretch on its own button, Buttons.xaml) and a ragged left-aligned
                  list of pills read as words laid on a ground rather than as things to press. The ten between
                  the lines is the ten the sheet keeps to its own top edge; the corner twenty-eight of a line
                  needs that much of a neighbour's corner not to graze it.
                -->
                <ItemsControl Name="menuActionList" ItemsSource="{Binding TitleActions}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="10"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MediaTitleAction">
                      <Button Classes="nereus-primary"
                              Content="{Binding Word}"
                              HorizontalAlignment="Stretch"
                              IsEnabled="{Binding IsCommand}"
                              Command="{Binding $parent[UserControl].DataContext.RunTitleActionCommand}"
                              CommandParameter="{Binding}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Name="menuAnswerLine"
                           FontSize="18"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Text="{Binding MenuAnswer}"
                           IsVisible="{Binding MenuAnswer, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <TextBlock Text="{Binding MenuWords}"
                           FontSize="18"
                           Margin="0,8,0,0"
                           Opacity="0.75"
                           TextWrapping="Wrap"
                           IsVisible="{Binding MenuWords, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </DockPanel>
      </Border>
    </Panel>
  </Panel>
</UserControl>