# Linux verification for the portability canary.
#
#   docker build -f scripts/ci/Dockerfile.canary -t mp2-canary .
#   docker run --rm mp2-canary
#
# Only the canary project and the MediaPortal.Utilities sources it links are copied, so the
# context stays small and the image cannot accidentally pull in a Windows-only project.
# The .editorconfig is copied too: analyzer severities must match the Windows build, or a
# green run here would not mean what it appears to mean.
# The canary targets the same TFM as the tree (net10.0 since 2026-10-18), so the image must carry an
# SDK able to build it - an 8.0 SDK answers NETSDK1045 and the run would prove nothing. The tag is a
# build ARG so the canary can still be replayed against an older toolchain on purpose.
ARG SDK_TAG=10.0
FROM mcr.microsoft.com/dotnet/sdk:${SDK_TAG}

WORKDIR /src

COPY MediaPortal/.editorconfig ./MediaPortal/.editorconfig
COPY MediaPortal/Tests/Canary.Portable/ ./MediaPortal/Tests/Canary.Portable/
COPY MediaPortal/Source/Core/MediaPortal.Utilities/ ./MediaPortal/Source/Core/MediaPortal.Utilities/

# Show the actual platform the assertions are running on - this line is the point of the file.
RUN dotnet --info | head -n 12 && uname -a

CMD ["dotnet", "test", "/src/MediaPortal/Tests/Canary.Portable/Canary.Portable.csproj", "-c", "Debug", "--nologo", "-v", "q"]
