<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MediaPortal.Frontend.ViewModels"
        xmlns:views="using:MediaPortal.Frontend.Views"
        xmlns:theming="using:MediaPortal.Frontend.Theming"
        x:Class="MediaPortal.Frontend.Views.SettingsView"
        x:DataType="vm:SettingsViewModel"
        Background="Transparent"
        >

  <!--
    The settings as the reference kept them: not one question, but the list of places a household configures -
    the front end's own machine first, then the server behind it - and a place with pages underneath opening
    those pages first rather than thirty rows at once.

    <b>Two shapes, one screen.</b> The reference put a single list on the screen and switched its <i>style</i>
    on one question: while nothing was open the list wore SettingsMenuListViewStyle, a wall of plates that
    wraps (master_configuration_menu.xaml:143-147, styles/OtherControlsOverrides.xaml:1079), and the moment a
    leaf was picked it wore MainMenuListViewStyle, the narrow list, with the leaf's own screen beside it in a
    480-wide left panel (:125-130). Both shapes are here, in the same order of thinking: a wall of plates with
    nothing open, a narrowed list with a screen beside it once something is open. Which one stands is the
    view-model's ShowingContents, this front end's answer to the reference's Show_Contents.

    The plates carry the section's picture where the worn skin has one: the reference asked the skin for
    SettingsMenu\&lt;path&gt;.jpg and MP2 ships those pictures with its default skin images
    (Source\UI\UiComponents\SkinBase\Skin\default\images\SettingsMenu), which is what the pictures in
    Skins\&lt;skin&gt;\images\SettingsMenu here are. A section this front end has on top of MP2's tree names a
    picture nobody carries and stands bare.

    <b>No heading of its own.</b> The shell's header already names the screen the viewer is on, so this screen
    never says the word "Settings" a second time under it; where the viewer stands in the tree rides on the
    Back button as its tool tip instead, which is where the question "where does this take me" gets asked.
  -->

  <Panel>

    <!-- The home's own ground: the skin's Background.png stretched over the whole screen, asked for exactly
         the way Nereus' and WMC's home backgrounds ask for it (home.xaml, HomeBackgroundTemplate). A settings
         wall is configuration, but it is configuration inside the same room, and the room's ground is the
         skin's picture rather than bare black. -->
    <Image Source="{Binding Converter={x:Static views:SkinImageConverter.Instance}, ConverterParameter=Background.png}"
           Stretch="Fill"
           IsHitTestVisible="False"/>

  <Grid RowDefinitions="Auto,*" RowSpacing="8" Margin="40,20">

    <!-- The way back, alone on the right. The reference let the back key out of its configuration screen
         altogether; this hub stops at the first level, where the shell takes the key on. -->
    <Button Grid.Row="0" Name="backButton" Classes="nereus-text-action" Content="Back"
            HorizontalAlignment="Right"
            ToolTip.Tip="{Binding Location}"
            IsVisible="{Binding CanGoBack}" Click="OnBackClick"/>

    <Panel Grid.Row="1">

      <!-- The wall. A WrapPanel of plates, the reference's ItemsPanel spelled the same way; the plates
           themselves belong to the worn skin, which dresses them as its own SettingsMenuItemDataTemplate
           dresses the reference's (OtherControlsOverrides.xaml:632). -->
      <ListBox Name="wallList"
               Classes="settings-tile-wall"
               IsVisible="{Binding IsWall}"
               Focusable="True"
               ItemsSource="{Binding Sections}"
               SelectedItem="{Binding Selected, Mode=TwoWay}"
               theming:SkinTemplates.TileTemplate="SettingsTileTemplate"
               Background="Transparent"
               BorderThickness="0">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <!-- Centred on the height it is given: the reference's wall was a block that stood in the middle
                 of the space under its header, not one glued to the top edge. When the plates do need more
                 room than the screen has, the scroll above takes over and the wrap answers from its top
                 again. -->
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SettingsSection">
            <!-- The plate a screen with no skin worn still stands: #222222, the section's picture over it at
                 eight tenths, black fading up from its bottom edge, and the icon and the name
                 inside that band - the reference's own numbers, unscaled, because no skin is asking for its
                 own here. -->
            <Border Width="355" Background="#222222" Margin="8">
              <Panel>
                <Image Source="{Binding Picture,
                                        Converter={x:Static views:SkinImageConverter.Instance},
                                        ConverterParameter='SettingsMenu/{0}'}"
                       Stretch="Fill"
                       Opacity="0.8"/>
                <Grid Height="65" VerticalAlignment="Bottom" ColumnDefinitions="77,*">
                  <Border Grid.ColumnSpan="2">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#00000000"/>
                        <GradientStop Offset="1" Color="#CC000000"/>
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>
                  <Image Source="{Binding Icon,
                                          Converter={x:Static views:SkinImageConverter.Instance},
                                          ConverterParameter='SettingsMenu/Icon_{0}'}"
                         Stretch="Uniform"
                         Margin="7"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Opacity="0.6"/>
                  <TextBlock Classes="settings-tile-name" Grid.Column="1"
                             Text="{Binding Name}"
                             VerticalAlignment="Center"
                             Margin="0,-5,5,1"
                             TextTrimming="CharacterEllipsis"
                             MaxLines="1"/>
                </Grid>
              </Panel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- The narrowed list beside the open screen, which is the shape this hub had before it had walls. -->
      <Grid ColumnDefinitions="330,*" ColumnSpacing="24" IsVisible="{Binding ShowingContents}">

        <ListBox Name="sectionList" Grid.Column="0"
                 Focusable="True"
                 ItemsSource="{Binding Sections}"
                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                 theming:SkinTemplates.TileTemplate="SettingsRowTemplate"
                 FontSize="18"
                 Background="Transparent"
                 BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SettingsSection">
              <!-- The reference's rows said the section's name and, when it had one, its help line - and nothing
                   else. Whose answer a section is (the front end's own or the server's) is a fact of building
                   this hub, not a line a household reads, so it stays out of the row. -->
              <StackPanel Spacing="1" Margin="0,5,8,7">
                <TextBlock Text="{Binding Name}" FontSize="19"/>
                <TextBlock Text="{Binding Description}" FontSize="13" Opacity="0.65" TextWrapping="Wrap"
                           IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Column="1" RowDefinitions="*,Auto">
          <ContentControl Name="sectionView" Grid.Row="0" Content="{Binding CurrentView}"/>
          <TextBlock Grid.Row="1" Name="statusLine" Text="{Binding Status}" FontSize="14" Opacity="0.8"
                     TextWrapping="Wrap"/>
        </Grid>
      </Grid>

      <!-- A wall has nothing beside it, so what the hub has to say - "Media opens 9 page(s)", or why a folder
           could not be opened - stands under the wall too rather than only beside an open screen. -->
      <TextBlock Name="wallStatus" VerticalAlignment="Bottom" Text="{Binding Status}" FontSize="14" Opacity="0.8"
                 IsVisible="{Binding IsWall}" TextWrapping="Wrap"/>
    </Panel>
  </Grid>

    <!--  Head and foot, in the home's own numbers and stops (home.xaml, HomeOverlaysTemplate - the very
          Top/Bottom Gradient Overlay bands of master_homemenu.xaml): the top ninth-of-the-screen darkening
          that carries the floating clock and the screen's word over any ground, and the bottom band of the
          depth this face has always had. Endpoints in PERCENT, as the home file warns - bare fractions make
          Avalonia read absolute pixels and leave a hard black stripe where the band begins.  -->
    <Border VerticalAlignment="Top" Height="130" HorizontalAlignment="Stretch" IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
          <GradientStop Color="#E6000000" Offset="0" />
          <GradientStop Color="#78000000" Offset="0.3" />
          <GradientStop Color="#46000000" Offset="0.45" />
          <GradientStop Color="#21000000" Offset="0.6" />
          <GradientStop Color="#0C000000" Offset="0.75" />
          <GradientStop Color="#01000000" Offset="0.87" />
          <GradientStop Color="#00000000" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Border VerticalAlignment="Bottom" Height="220" HorizontalAlignment="Stretch" IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="50%,100%" EndPoint="50%,0%">
          <GradientStop Color="#E6000000" Offset="0" />
          <GradientStop Color="#78000000" Offset="0.3" />
          <GradientStop Color="#46000000" Offset="0.45" />
          <GradientStop Color="#21000000" Offset="0.6" />
          <GradientStop Color="#0C000000" Offset="0.75" />
          <GradientStop Color="#01000000" Offset="0.87" />
          <GradientStop Color="#00000000" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
  </Panel>
</UserControl>