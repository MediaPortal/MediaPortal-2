<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MediaPortal.Frontend.ViewModels"
        xmlns:api="using:MediaPortal.Frontend.Api"
        x:Class="MediaPortal.Frontend.Views.HomeWindow"
        x:DataType="vm:HomeViewModel"
        Name="home"
        Width="1280" Height="720"
        WindowState="Maximized"
        Background="#FF101418"
        Title="MediaPortal 2">

  <!--
    The home screen of the new front end, sized for a television: one list of what the library is made of, and
    the selected aspect's attributes next to it. Font sizes are large because the viewer is three metres away,
    and the two areas are what the remote's left/right keys move between - see DpadNavigation for why that ring
    is stated in code rather than inferred.
  -->

  <DockPanel Margin="48,36">

    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,20">
      <TextBlock Text="MediaPortal 2"
                 FontSize="40"
                 FontWeight="SemiBold" />
      <TextBlock Text="{Binding ServerDescription}"
                 FontSize="20"
                 Opacity="0.85"
                 TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding Status}"
                 FontSize="16"
                 Opacity="0.6"
                 TextTrimming="CharacterEllipsis" />
      <!-- What the server is doing right now, as the server itself said so: "Filing 120 of 340 in D:\Films" while
           an import runs, "Listening to the server" when it is idle, "Lost the server" when the connection went.
           Gone when nothing is being listened to, because a media centre that has nothing to say should not spend
           a line of a television saying it. -->
      <TextBlock Text="{Binding ServerActivity}"
                 FontSize="14"
                 Opacity="0.5"
                 IsVisible="{Binding HasServerActivity}"
                 TextTrimming="CharacterEllipsis" />
      <TextBlock FontSize="14"
                 Opacity="0.4"
                 Text="{Binding ServerUrl, StringFormat='Server: {0}'}" />
    </StackPanel>

    <!-- The main menu, and it is on screen before a server has answered: the parts a media centre is made of,
         each with either its count or the reason it cannot be opened here. The names and the order are MP2's own
         (see MainMenu for which plugin contributes which entry), because a viewer who has used MediaPortal before
         should not have to learn a new set of words to find the same things. -->
    <ListBox Name="menuList"
             DockPanel.Dock="Top"
             Focusable="True"
             ItemsSource="{Binding Menu}"
             FontSize="22"
             Padding="0"
             Margin="0,0,0,14"
             Background="Transparent"
             BorderThickness="0">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <!-- Two rows, whatever the count: the screen is 720 lines tall and the menu shares it with the strip
               below, so a list that grows downwards eats the room the strip and the buttons need. Measured on this
               very frame: a wrap panel laid these nine entries out in three rows and 211 lines of ink, and the
               same entries in a grid of two rows take 126 - which is the difference between the buttons sitting
               above the bottom margin and sitting in the last thirty lines of it. -->
          <UniformGrid Rows="2" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:MainMenuEntry">
          <StackPanel Spacing="2" Margin="0,4,18,10">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding Badge}"
                         FontSize="24"
                         Width="30"
                         TextAlignment="Center"
                         Opacity="0.75" />
              <TextBlock Text="{Binding Label}"
                         FontSize="22"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <!-- What pressing does, or what stops it: "4 films" on a tile that opens, "not on this server" on one
                 that does not, and "no TV backend" on one this build has no way to serve. A tile that is silent
                 about all three reads as a broken front end. -->
            <TextBlock Text="{Binding Detail}"
                       FontSize="14"
                       Opacity="0.55"
                       Margin="8,0,0,0"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- What somebody left half way. Between the tiles and the buttons because it is the only thing here that is
         about tonight rather than about the library in general, and below the tiles because the tiles are still
         what somebody came to look at. It is off screen when there is nothing in it - see HomeViewModel, which
         keeps the heading up when a part of the library refused to answer, so that an empty shelf and a silent
         server do not look the same. -->
    <StackPanel Name="unfinishedPanel"
                DockPanel.Dock="Top"
                IsVisible="{Binding HasUnfinished}"
                Spacing="4"
                Margin="0,0,0,18">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <TextBlock Text="Left half way"
                   FontSize="22"
                   FontWeight="SemiBold" />
        <TextBlock Text="{Binding UnfinishedStatus}"
                   FontSize="14"
                   Opacity="0.55"
                   VerticalAlignment="Center" />
      </StackPanel>
      <ListBox Name="unfinishedList"
               Focusable="True"
               ItemsSource="{Binding Unfinished}"
               FontSize="20"
               MaxHeight="240"
               Background="Transparent"
               BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TitleViewModel">
            <Grid ColumnDefinitions="1.5*,0.9*,1.3*,0.9*" ColumnSpacing="16" MinWidth="760" Margin="0,2">
              <TextBlock Grid.Column="0"
                         Text="{Binding Line}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1"
                         Text="{Binding Detail}"
                         Opacity="0.55"
                         TextTrimming="CharacterEllipsis" />
              <!-- The time the server says this title was last opened, which is the row's claim to be on this
                   strip at all. -->
              <TextBlock Grid.Column="2"
                         Text="{Binding LastPlayedText}"
                         Opacity="0.7" />
              <!-- How far this viewer got, when the server was told who is asking. Empty on a server that only
                   counts the household's viewings, which is why it is the last column and not part of the
                   title: a strip whose rows say "0% watched" on every row is claiming a precision it does not
                   have. -->
              <TextBlock Grid.Column="3"
                         Text="{Binding ResumeText}"
                         Opacity="0.85"
                         TextTrimming="CharacterEllipsis" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>

    <!-- The two things a viewer can do from the home screen: ask the server again, and open what is playing.
         The playback button is only there when the application has a player to show (see App), so a machine
         without libVLC does not get a button that leads to a screen that cannot play anything. -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="16" Margin="0,0,0,24">
      <Button Name="refreshButton"
              Content="Refresh"
              Command="{Binding RefreshCommand}"
              HorizontalAlignment="Left"
              HorizontalContentAlignment="Center"
              MinWidth="180"
              Padding="28,10"
              FontSize="20" />
      <Button Name="nowPlayingButton"
              Content="Now playing"
              Click="OnNowPlaying"
              IsVisible="False"
              HorizontalAlignment="Left"
              HorizontalContentAlignment="Center"
              MinWidth="180"
              Padding="28,10"
              FontSize="20" />
      <!-- Where the server is comes from a screen, not from a command line: whoever sits in front of a television
           cannot edit an argument, and a machine whose address changed (a reinstalled server, a new router) would
           otherwise be a media centre that only ever says it found no media. -->
      <Button Name="connectButton"
              Content="Server"
              Click="OnConnect"
              IsVisible="False"
              HorizontalAlignment="Left"
              HorizontalContentAlignment="Center"
              MinWidth="180"
              Padding="28,10"
              FontSize="20" />
    </StackPanel>

    <Grid ColumnDefinitions="420,*" ColumnSpacing="40">

      <!-- Below the tiles on purpose: what the database is made of is the answer to "why is there no tile for
           X?", and the tiles are the reason somebody came to the screen. -->

      <!-- Focusable is stated rather than trusted: measured on this very screen, the list reported itself not
           focusable, which left the remote's arrow keys unable to reach it at all. A control the viewer has to
           walk into with a remote says so on the screen. -->
      <ListBox Name="aspectsList"
               Focusable="True"
               ItemsSource="{Binding Aspects}"
               SelectedItem="{Binding SelectedAspect, Mode=TwoWay}"
               FontSize="22">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:AspectViewModel">
            <DockPanel MinWidth="340" Margin="0,7">
              <TextBlock DockPanel.Dock="Right"
                         Text="{Binding CountText}"
                         Opacity="0.7"
                         FontWeight="SemiBold" />
              <TextBlock Text="{Binding Name}" />
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Grid.Column="1" Spacing="12">
        <!-- A server with MP2's own configuration keeps its titles from strangers, so the front end has to be
             able to say who it is. The password is a box with dots rather than a PasswordBox because a
             PasswordBox cannot be bound: a screen that cannot read what was typed cannot sign anybody in. What
             is typed is handed to the server and forgotten straight afterwards. -->
        <StackPanel Name="signInRow" Orientation="Horizontal" Spacing="12"
                    IsVisible="{Binding SignedInAs, Converter={x:Static ObjectConverters.IsNull}}">
          <TextBox Name="signInName"
                   Text="{Binding SignInName}"
                   Watermark="User name"
                   FontSize="18"
                   MinWidth="200" />
          <TextBox Name="signInPassword"
                   Text="{Binding SignInPassword}"
                   PasswordChar="•"
                   Watermark="Password"
                   FontSize="18"
                   MinWidth="200" />
          <Button Name="signInButton"
                  Content="Sign in"
                  Command="{Binding SignInCommand}"
                  FontSize="18"
                  Padding="20,8" />
        </StackPanel>
        <TextBlock Name="signedInAs"
                   FontSize="16"
                   Opacity="0.75"
                   IsVisible="{Binding SignedInAs, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Text="{Binding SignedInAs, StringFormat='Signed in as {0}'}" />

        <TextBlock Text="{Binding SelectedAspect.Name}"
                   FontSize="28"
                   FontWeight="SemiBold" />
        <TextBlock FontSize="15"
                   Opacity="0.6"
                   Text="Attributes - indexed ones can be filtered and sorted cheaply" />

        <ItemsControl ItemsSource="{Binding SelectedAspect.Attributes}" FontSize="18">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="api:AspectAttribute">
              <Grid ColumnDefinitions="2*,3*,1.4*,1*" ColumnSpacing="16" Margin="0,4">
                <TextBlock Text="{Binding Name}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Type}"
                           Opacity="0.7"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2"
                           Text="indexed"
                           Opacity="0.7"
                           IsVisible="{Binding Indexed}" />
                <TextBlock Grid.Column="3"
                           Text="list"
                           Opacity="0.7"
                           IsVisible="{Binding Collection}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

    </Grid>
  </DockPanel>
</Window>
