<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MediaPortal.Frontend.ViewModels"
             xmlns:theming="using:MediaPortal.Frontend.Theming"
             x:Class="MediaPortal.Frontend.Views.StartupView"
             x:DataType="vm:StartupViewModel"
             Name="startup"
             Background="Black">

  <!--
    The start of the front end. The household's wallpaper fills the window scaled to fit - nothing is cut,
    the dark around it belongs to the picture - and the wake's ring plays its one turn over it while the
    machine reads. What stands on the picture after that is one of three things: the wake's own words while
    it waits, the round face with four boxes when a PIN is asked, and the wall of the household's faces when
    somebody is not who the machine remembered.

    There is no way past the question by key: the back key is swallowed while it stands, because the point
    of the question is that it is answered. Only the wall of faces answers the back key, and it answers it
    by leaving the room as it was.
  -->

  <UserControl.Styles>
    <Style Selector="Border.pinBox">
      <Setter Property="Background" Value="#D80E1319"/>
      <Setter Property="BorderBrush" Value="#33FFFFFF"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Border.pinBox.next">
      <Setter Property="BorderBrush" Value="#E6E2621B"/>
    </Style>
    <Style Selector="Border.pinBox.filled">
      <Setter Property="BorderBrush" Value="#66FFB066"/>
    </Style>
    <!-- Two places to stand on, and each says so. The picture wears the room's orange when the keyboard
         stands on it - the same light the reference's User_focus.png pair was for - which is how a viewer
         walking out of the numbers knows they left them. -->
    <Style Selector="Button.wakeFace">
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="Background" Value="#D80E1319"/>
      <Setter Property="BorderBrush" Value="#55E2621B"/>
      <Setter Property="BorderThickness" Value="3"/>
    </Style>
    <Style Selector="Button.wakeFace:focus">
      <Setter Property="BorderBrush" Value="#FFFFB066"/>
      <Setter Property="BorderThickness" Value="4"/>
    </Style>
  </UserControl.Styles>

  <Panel>

    <!-- The wallpaper, scaled to fit. -->
    <Image Source="avares://MediaPortal.Frontend/Assets/startup-wallpaper.png"
           Stretch="Uniform"/>

    <!-- The veil the content stands on: a wash over the whole picture at a fourth, so the picture keeps its
         glow and a name is still readable over an explosion. -->
    <Border Background="#40000000" IsHitTestVisible="False"/>

    <!-- The wake: a ring of the portal's own orange turning over the halo that breathes under it. No bar.
         The code-behind turns the ring and breathes the halo on a timer, the same way the fanart dissolve
         counts its steps - numbers the screen can be trusted with rather than guessed by a transition.

         It is shown once: one turn of the ring, and then it fades out and is gone for the rest of the
         screen's life - the four boxes do not need company for as long as somebody stands reading a name.
         Its life is the screen's own clock rather than the model's reading phase, because the reads answer
         in a heartbeat on a living-room network and an animation that dies with them is an animation nobody
         sees. While the wake still holds the wallpaper to itself - the no-PIN case, the model's seconds -
         the turn simply carries on, because then it is the whole show. -->
    <Panel Name="wakeRing" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="26" HorizontalAlignment="Center">
        <Panel Width="170" Height="170" HorizontalAlignment="Center">
          <Ellipse Name="halo" Width="150" Height="150"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
              <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Ellipse.RenderTransform>
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Offset="0" Color="#00000000"/>
                <GradientStop Offset="0.70" Color="#00000000"/>
                <GradientStop Offset="0.94" Color="#55FF8A3C"/>
                <GradientStop Offset="1" Color="#00000000"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>
          <Border Name="ring" Width="110" Height="110" CornerRadius="55"
                  BorderThickness="5"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
              <RotateTransform Angle="0"/>
            </Border.RenderTransform>
            <Border.BorderBrush>
              <ConicGradientBrush>
                <GradientStop Offset="0" Color="#FFE2621B"/>
                <GradientStop Offset="0.25" Color="#80E2621B"/>
                <GradientStop Offset="0.55" Color="#00E2621B"/>
                <GradientStop Offset="0.85" Color="#66E2621B"/>
                <GradientStop Offset="1" Color="#FFE2621B"/>
              </ConicGradientBrush>
            </Border.BorderBrush>
          </Border>
          <Ellipse Width="12" Height="12" Fill="#FFFFC08A"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"/>
        </Panel>
        <!-- The words the wake says while it reads. Once the question stands, the card under the face says
             everything the model has to say - two lines of the same sentence would be two lines. -->
        <TextBlock Text="{Binding Status}"
                   IsVisible="{Binding Busy}"
                   FontSize="24"
                   Foreground="#F2FFFFFF"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="900"/>
      </StackPanel>
    </Panel>

    <!-- The question, stood at the HEAD of the picture - the same margin it carried at the foot, ninety-six
         of it, only measured from the top now: the person in a round container that is itself the way to
         somebody else, their four boxes beside the face. No pad of numbers - a keyboard or a remote types
         them, the fourth one being the answer. -->
    <Panel IsVisible="{Binding NeedsPin}" HorizontalAlignment="Center" VerticalAlignment="Top">
      <StackPanel Name="pinCard" HorizontalAlignment="Center" Margin="0,96,0,0">
        <StackPanel Orientation="Horizontal" Spacing="34" HorizontalAlignment="Center">
          <StackPanel Spacing="12" VerticalAlignment="Center">
            <Button Name="userPicture" Classes="wakeFace" Command="{Binding SwitchUserCommand}" Padding="0"
                    ToolTip.Tip="Somebody else?"
                    Width="140" Height="140" CornerRadius="70"
                    HorizontalAlignment="Center">
              <!-- The person's own picture, cut to the round container: the household put it on the profile
                   through the users screen, and the door is where it goes looking for it. The initial is what
                   a container wears until somebody brings a picture, not what it wears instead of one. -->
              <Border Width="134" Height="134" CornerRadius="67" ClipToBounds="True">
                <Panel>
                  <Image Source="{Binding PersonPicture}" Stretch="UniformToFill"
                         IsVisible="{Binding HasPersonPicture}"/>
                  <TextBlock Text="{Binding Initials}"
                             FontSize="60" FontWeight="SemiBold"
                             Foreground="#FFFFB066"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsVisible="{Binding !HasPersonPicture}"/>
                </Panel>
              </Border>
            </Button>
            <TextBlock Text="{Binding PersonName}"
                       FontSize="26" FontWeight="SemiBold"
                       Foreground="#F2FFFFFF"
                       HorizontalAlignment="Center"/>
          </StackPanel>

          <StackPanel Spacing="16" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
              <!-- One dot per number typed, dead centre in its box. The number itself is never painted: a
                   number that stands on a television in the living room is a secret the whole room can read,
                   and the only thing the person typing needs back is the count of what they have typed. -->
              <Border Name="box0" Classes="pinBox" Width="72" Height="92" CornerRadius="16">
                <Ellipse Name="dot0" Width="22" Height="22" Fill="#F2FFFFFF" IsVisible="False"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border Name="box1" Classes="pinBox" Width="72" Height="92" CornerRadius="16">
                <Ellipse Name="dot1" Width="22" Height="22" Fill="#F2FFFFFF" IsVisible="False"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border Name="box2" Classes="pinBox" Width="72" Height="92" CornerRadius="16">
                <Ellipse Name="dot2" Width="22" Height="22" Fill="#F2FFFFFF" IsVisible="False"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border Name="box3" Classes="pinBox" Width="72" Height="92" CornerRadius="16">
                <Ellipse Name="dot3" Width="22" Height="22" Fill="#F2FFFFFF" IsVisible="False"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding Status}"
                       FontSize="19"
                       Foreground="#C8FFFFFF"
                       TextWrapping="Wrap"
                       MaxWidth="460"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Panel>

    <!-- The others. Standing on a name picks it - a PIN person takes the boxes, a person without one
         simply arrives; the row answers like the server list on the connection screen answers. -->
    <!-- The household, opened by a press on the round picture. It stands on the worn skin's own dialog frame
         - the same frame the close screen and the notification shelf wear - and it holds nothing but faces:
         a round picture, the name under it, and nothing else. A press on a face is the whole answer, and the
         back key leaves the room exactly as it was. -->
    <Panel Background="#A0000000" IsVisible="{Binding Switching}">
      <ContentControl HorizontalAlignment="Center" VerticalAlignment="Center"
                      theming:SkinTemplates.OverlayTemplate="DialogFrameTemplate">
        <ListBox Name="othersList"
                 ItemsSource="{Binding Household}"
                 Background="Transparent" BorderThickness="0"
                 MinWidth="560" MaxWidth="900" MaxHeight="620">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="16,12"/>
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Spacing="12" Width="176">
                <Border Width="140" Height="140" CornerRadius="70" ClipToBounds="True"
                        HorizontalAlignment="Center">
                  <Panel>
                    <Image Source="{Binding Picture}" Stretch="UniformToFill"
                           IsVisible="{Binding HasPicture}"/>
                    <TextBlock Text="{Binding Initials}"
                               FontSize="56" FontWeight="SemiBold"
                               Foreground="#FFFFB066"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding !HasPicture}"/>
                  </Panel>
                </Border>
                <TextBlock Text="{Binding Name}"
                           FontSize="22" TextTrimming="CharacterEllipsis"
                           TextAlignment="Center" HorizontalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </ContentControl>
    </Panel>
  </Panel>
</UserControl>
