<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MediaPortal.Frontend.ViewModels"
        xmlns:views="using:MediaPortal.Frontend.Views"
        xmlns:theming="using:MediaPortal.Frontend.Theming"
        x:Class="MediaPortal.Frontend.Views.NowPlayingView"
        x:DataType="vm:NowPlayingViewModel"
        Name="nowPlaying"
        Background="Black"
        >

  <!--
    The playback screen: the film alone on the television, which is what both reference skins did with it.
    Nothing of the screen's own stands over the picture while it plays - no name above it, no frame around it,
    no poster behind it, no second progress line under it - because every one of those is a piece of the
    furniture that used to sit between a viewer and the film. What a remote reaches for waits along the foot,
    away until the Info key, a press of a key in its room, or the mouse arriving calls it.
  -->

  <UserControl.Resources>
    <!-- The shadow the audio screen's words wear: Avalonia's own drop shadow, which softens the lettering for
         real (BlurRadius is a gaussian over the drawn glyphs) rather than standing a darkened copy of the word
         behind it. Two strengths, because a label of twenty lines need not cast what a value of thirty three
         lines casts. One instance each, shared by the cells: these numbers never change while the screen stands.
         An effect is painted only inside the bounds of the visual it hangs on - measured, not assumed: with a ten
         line blur and no room to spill the shadow ended at the very pixel of the word's own right edge (39 on one
         line, 44 on the next, at exactly the width the layout had given the word) and cast nothing above the word
         at all. So every shadowed word carries padding - the reach of its blur, plus the offset under its foot -
         and the very same numbers back as a negative margin, which puts the lettering where it stood and still
         leaves the shadow ground to fall on. -->
    <DropShadowEffect x:Key="audioValueShadow" Color="#FF000000" Opacity="0.75" BlurRadius="8"
                      OffsetX="0" OffsetY="3"/>
    <DropShadowEffect x:Key="audioLabelShadow" Color="#FF000000" Opacity="0.6" BlurRadius="5"
                      OffsetX="0" OffsetY="2"/>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- The glass plate of these buttons lives in PlayerGlassStyles.axaml now, shared with the compact
         bar at the foot of the other screens. What follows here is only what this screen draws for
         itself: the position line, the track pickers, the name of the film and the marks of it. -->
    <StyleInclude Source="avares://MediaPortal.Frontend/Views/PlayerGlassStyles.axaml"/>

    <!-- The mark that says "this opens a list", which has to be read from a sofa: at the button's own height
         rather than as a footnote beside the picture. -->
    <Style Selector="Button.glass TextBlock.chevron">
      <Setter Property="FontSize" Value="40"/>
      <Setter Property="Opacity" Value="0.8"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <!-- Play, in the middle of everything: the biggest thing in the panel, and now the only control filled plain
         white with its mark struck in black - the one button a viewer looks for first, so it wears the loudest
         dress on the screen. -->
    <Style Selector="Button.glass.transport">
      <Setter Property="Width" Value="99"/>
      <Setter Property="Height" Value="99"/>
      <Setter Property="CornerRadius" Value="50"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="36"/>
      <Setter Property="Background" Value="#FFFFFFFF"/>
      <Setter Property="BorderBrush" Value="#33000000"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#FF000000"/>
      <Setter Property="Margin" Value="12,0"/>
    </Style>
    <Style Selector="Button.glass.transport Path">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Fill" Value="#FF000000"/>
    </Style>
    <!-- Standing on the white plate cannot light it up (it is already the brightest thing here) and cannot ring it
         in white (a white ring on a white plate is no ring at all), so its frame darkens to a firm black ring -
         but the light that stands round it is the same quiet white every other control glows with, so play answers
         a standing place with the very same halo the rest of the panel does, only bounded by the black ring. Written
         against the transport's own class rather than left to the shared glass rules, which would fill it blue and
         ring it white - the fill lost on white, the ring invisible on white. -->
    <Style Selector="Button.glass.transport:focus">
      <Setter Property="Background" Value="#FFFFFFFF"/>
      <Setter Property="BorderBrush" Value="#FF000000"/>
      <Setter Property="BorderThickness" Value="3"/>
    </Style>
    <Style Selector="Window:not(.pointer-resting) Button.glass.transport:pointerover">
      <Setter Property="Background" Value="#FFFFFFFF"/>
      <Setter Property="BorderBrush" Value="#FF000000"/>
      <Setter Property="BorderThickness" Value="3"/>
    </Style>
    <Style Selector="Button.glass.transport:focus Path">
      <Setter Property="Fill" Value="#FF000000"/>
      <Setter Property="Effect" Value="{x:Null}"/>
    </Style>
    <Style Selector="Window:not(.pointer-resting) Button.glass.transport:pointerover Path">
      <Setter Property="Fill" Value="#FF000000"/>
      <Setter Property="Effect" Value="{x:Null}"/>
    </Style>
    <Style Selector="Button.glass.transport:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="0 0 22 4 #73FFFFFF"/>
    </Style>
    <Style Selector="Window:not(.pointer-resting) Button.glass.transport:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="0 0 22 4 #73FFFFFF"/>
    </Style>

    <!-- The name of the film. It is a name, not a mark in the row: the ring never stands on it, so it draws no
         frame and takes no cursor - a label that grows a box when something walks past it claims to be a button
         and is not one. A press of it still says what the library knows about the title, for the one hand that
         presses names. -->
    <Style Selector="Button.title">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Border" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- The position line as a control: the whole row is its surface, so a press anywhere along it lands on the
       film at that point and a keyboard or a remote can stand on the line itself. It is drawn by nothing at rest
       and by nothing under a hand either - a frame round a line that already spans the screen is a second frame
       over the film - and says where the viewer stands on it by growing the knob of the playhead, below. -->
    <Style Selector="Button.seek">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <!-- Nothing of its own is rounded here, so a corner radius would do one thing only: cut the knob of the
           playhead where it grows over either end of the line. The toolkit rounds what a control's content
           presenter is given, and it cuts by that rounding. -->
      <Setter Property="CornerRadius" Value="0"/>
      <!-- The knob of the playhead grows six pixels past its rest at either end of the line and the control is
           cut at its own bounds, so the line is held ten pixels in from those bounds - the same room the line
           of the sound is given, for the same reason. -->
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
      <!-- The line of the film is as wide as the room between the two numbers beside it, not as wide as the knob
           painted on it: without this the button keeps to its content's measure and the film's line is a hand's
           breadth in the middle of the screen. -->
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <!-- The two that open a list: the subtitles and the sound, each carrying the track it stands on. A capsule
         rather than a circle, because the name of a track is a word and a word needs room; the picture at its
         head and the mark at its tail say what the word belongs to. -->
    <Style Selector="Button.glass.pick">
      <Setter Property="MinWidth" Value="230"/>
      <Setter Property="Height" Value="70"/>
      <Setter Property="Padding" Value="22,0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="21"/>
      <Setter Property="CornerRadius" Value="35"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style Selector="Window:not(.pointer-resting) Button.glass.pick:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#46658BAA"/>
      <Setter Property="BorderBrush" Value="#FFFFFFFF"/>
      <Setter Property="BorderThickness" Value="3"/>
    </Style>
    <Style Selector="Button.glass.pick:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#46658BAA"/>
      <Setter Property="BorderBrush" Value="#FFFFFFFF"/>
      <Setter Property="BorderThickness" Value="3"/>
    </Style>

    <!-- The line the hand presses on to set the sound (Button.hit), the knob that says where on a line a viewer
         stands (Border.knob) and the numbers beside them (TextBlock.time) are dressed by PlayerGlassStyles.axaml
         now, because the sound's dialog is worn by the compact row at the foot of every other screen as well. -->

    <!-- What the medium is, beside the name of the film. Said only when the file said it: an invented "HDR"
         next to a file nobody checked is a lie about a film somebody is watching. -->
    <Style Selector="Border.tag">
      <Setter Property="Background" Value="#3D63809B"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="11,5"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.tag TextBlock">
      <Setter Property="Foreground" Value="#FFF2F7FC"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- One plaque of what the file is made of, above the cover. The same box the browser's details row uses
         (MediaBrowserView.axaml:537-544, "details-logo"): one height written once, so a logo and a word stand in
         boxes of one size, and a codec the skin carries no picture of is written in words inside the very same
         box rather than left out. -->
    <Style Selector="Border.audio-plaque">
      <Setter Property="Background" Value="#33FFFFFF"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.audio-plaque TextBlock">
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <!-- Where a chapter begins, on the position line. Every mark is the same and says nothing: the line they
         stand on is where they differ, and a label per chapter would be a row of words over the film. -->
    <Style Selector="Border.tick">
      <Setter Property="Width" Value="5"/>
      <!-- As tall as the twelve points of the line it stands on, and level with it: the mark is a notch in the
          line, not a stake driven through it, so it grows neither over its top nor under its bottom. Square,
          because a round notch in a straight line reads as a hole. -->
      <Setter Property="Height" Value="12"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Background" Value="#DCE8F8"/>
    </Style>

    <!-- The position line itself: the film's own blue, six pixels of it, with the playhead standing on it.
         Nothing in it answers a pointer - the row's button does that for the whole line, so that one film has
         one thing a press can land on. -->
    <Style Selector="ProgressBar.track">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <!-- Where a viewer stands on a line is said by the knob of it growing, not by a frame round the line: the
         line of a film already reaches from one number of its length to the other, so a box drawn round it is a
         frame over the picture rather than a mark on the control. Written once for the pointer and once for the
         ring, because the pointer's half has to carry the window's gate - and the knob is the same size either
         way, which is what makes it one effect rather than two. The knob itself, its upright half for the line
         of the sound, and the sound line's own half of these two rules are in PlayerGlassStyles.axaml. -->
    <Style Selector="Window:not(.pointer-resting) Button.seek:pointerover Border.knob">
      <Setter Property="RenderTransform" Value="scale(1.55)"/>
    </Style>
    <Style Selector="Button.seek:focus Border.knob">
      <Setter Property="RenderTransform" Value="scale(1.55)"/>
    </Style>

    <!-- A row of the list a viewer picks a subtitle or a sound from. Named like the button it is and wearing
         the panel's shape, but left aligned and as wide as the list: a picker is read down the page, not
         across it. The row the film is on is lit, because a list that cannot say what is currently chosen
         leaves a viewer guessing. -->
    <Style Selector="Button.choice">
      <Setter Property="Background" Value="#182E4050"/>
      <Setter Property="BorderBrush" Value="#40FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="18,12"/>
      <Setter Property="MinHeight" Value="52"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!-- One box for both hands: the pointer and the ring are answered by the same setters, so a row that lights
         up under the mouse lights up identically when the d-pad walks onto it. The pointer's half carries the
         window's own "the pointer is about" gate, which is what lets it outrank the worn skin's rule that dresses
         every button of the program under a pointer. -->
    <Style Selector="Window:not(.pointer-resting) Button.choice:pointerover">
      <Setter Property="Background" Value="#46658BAA"/>
      <Setter Property="BorderBrush" Value="#FFFFFFFF"/>
      <Setter Property="BorderThickness" Value="3"/>
    </Style>
    <Style Selector="Button.choice:focus">
      <Setter Property="Background" Value="#46658BAA"/>
      <Setter Property="BorderBrush" Value="#FFFFFFFF"/>
      <Setter Property="BorderThickness" Value="3"/>
    </Style>
    <Style Selector="Button.choice.current">
      <Setter Property="Background" Value="#42618CB8"/>
      <Setter Property="BorderBrush" Value="#80FFFFFF"/>
    </Style>
    <!-- The tune that is playing wears the tunes' own inversion: a white plate with its words in black. Every
         other row of that list is a hole cut in the shade of the panel, so the one row that names what the room
         is hearing is the brightest thing beside the equalizer and needs no second mark. Only the tunes wear
         this - the pickers of sound and subtitles keep the lit row they have always had. The plate carries no rim
         of its own: a rim belongs to the caret, and the caret belongs to the ring, so a row that merely plays
         stands edge to edge on the shade. Where the ring (or a hand) does stand on it, the caret is the one dark
         rim in the program - a white ring on a white plate is no mark at all - and the words have to be said in
         black by the face itself, because the theme dresses a focused button's face in the screen's white, which
         on a white plate is a word nobody can read. -->
    <Style Selector="Button.choice.tune.current">
      <Setter Property="Background" Value="#FFFFFFFF"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="#FF000000"/>
    </Style>
    <Style Selector="Button.choice.tune.current:focus">
      <Setter Property="Background" Value="#FFFFFFFF"/>
      <Setter Property="BorderBrush" Value="#B3000000"/>
      <Setter Property="BorderThickness" Value="3"/>
      <Setter Property="Foreground" Value="#FF000000"/>
    </Style>
    <Style Selector="Button.choice.tune.current:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="#FF000000"/>
    </Style>
    <Style Selector="Window:not(.pointer-resting) Button.choice.tune.current:pointerover">
      <Setter Property="Background" Value="#FFFFFFFF"/>
      <Setter Property="BorderBrush" Value="#B3000000"/>
      <Setter Property="BorderThickness" Value="3"/>
      <Setter Property="Foreground" Value="#FF000000"/>
    </Style>
    <Style Selector="Window:not(.pointer-resting) Button.choice.tune.current:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="#FF000000"/>
    </Style>
    <!-- The card the tunes stand on glows while the caret stands inside it, with the one glow this screen's glass
         knows: twenty two of blur and four of spread in white at forty five per cent, which is what a plate of the
         transport wears the moment a hand or a ring is on it (PlayerGlassStyles.axaml:136,139). Reaching some
         fifteen lines out, it stays well inside the card's own margins - sixty two lines to the right edge of the
         screen, three hundred and twenty two to its foot - so no part of it is cut. Only a walk of the viewer's own
         can bring it here, since a row offers no place for the caret until StandOnTune opens one. -->
    <Style Selector="Border#audioQueue:focus-within">
      <Setter Property="BoxShadow" Value="0 0 22 4 #73FFFFFF"/>
    </Style>
    <!-- The fill of the position line is white in both its states, not the theme's turquoise: a played part of a
         film reads as a clean white mark over the line. At rest it stands at three quarters strength, and where a
         viewer stands on the line it comes up to full white, so the line answers the caret by brightening rather
         than by changing hue. The colour comes from a style rather than the bar itself on purpose: a colour written
         on the bar would outrank the focused answer and never change. -->
    <Style Selector="ProgressBar#progressBar">
      <Setter Property="Foreground" Value="#BFFFFFFF"/>
    </Style>
    <Style Selector="Button.seek:focus ProgressBar#progressBar">
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
    </Style>

    <!-- WHERE THE SOUND AND THE WORDS STAND, and where they stand once the record's list is drawn beside them.
         Both the bars and the three words of the record begin on the cover's middle axis, at seven hundred and
         two, and both used to run to the screen's standing right margin of sixty-two. When the list of tunes is
         drawn - which is whenever a record plays and never otherwise - the bars stop twenty four lines before
         the list begins, and the two words that can be as long as a record's title break into their second line
         earlier rather than running under it. These four rules are here rather than numbers on the controls
         because the room a control has is the stage's business, and the stage is the only thing that knows
         whether the list is standing there. -->
    <Style Selector="views|AudioSpectrumBars">
      <Setter Property="Margin" Value="702,0,62,322"/>
    </Style>
    <Style Selector="Panel#audioArea.squeezed views|AudioSpectrumBars">
      <!-- Sixty-two of standing margin, four hundred and forty-six of list, and the twenty four of air between
           them: the same three numbers the list is placed by. -->
      <Setter Property="Margin" Value="702,0,532,322"/>
    </Style>
    <!-- At the full width a word wraps at five hundred and twenty, the width the table of the template measured.
         Squeezed, the six hundred and eighty-six lines between the bars' first bar and the list have to hold the
         year and the two gaps of forty-five as well, which leaves two hundred and sixty for each of the two words
         that wrap. -->
    <Style Selector="StackPanel#audioTable TextBlock.wrapping">
      <Setter Property="MaxWidth" Value="520"/>
    </Style>
    <Style Selector="Panel#audioArea.squeezed StackPanel#audioTable TextBlock.wrapping">
      <Setter Property="MaxWidth" Value="260"/>
    </Style>
  </UserControl.Styles>

  <Panel>

    <!--
      The picture, over the whole screen: a film wears the television and the bars above and below it are black,
      which is the one thing both reference skins agreed on about a playing film. VideoSurface draws the frames
      the player hands over and stays empty when there are none - an empty black screen that tells the viewer
      what the player is doing is the truth, and a fake preview would not be. There is no poster behind it: a
      picture of a film next to the film it pictures covers half of it, which is what this frame used to do.
    -->
    <Panel Name="videoArea" Background="{DynamicResource VideoBrush}">
      <views:VideoSurface Name="videoSurface"/>

      <!--
        What the player is doing, said as a shape in the middle of the picture: the worn skin's mark for the
        state (NowPlayingViewModel.StateGlyph) - its pause mark over a paused film, its stop mark over a
        stopped one, its error mark over a file that would not open. The word is not gone, it is only not
        painted over the film: the foot bar of both faces carries it, and a screen reader reads it from the
        model. While the film runs the model names no shape, so a running film is left to itself.

        A hundred points across at four fifths strength, in the text colour, with the soft dark shadow the face
        gives everything standing over artwork (styles.xaml's home-shortcut-caption) - a white glow, the face's
        other shadow, would be gone the moment the film shows snow. The two marks over the film carry this
        written out rather than shared in a style, because a mark that silently fails to be styled is a mark
        nobody sees, and these two are the whole of what the screen says over a picture.
      -->
      <Path Name="stateGlyph" Width="100" Height="100" Stretch="Uniform" Opacity="0.8"
            Fill="{DynamicResource TextBrush}" IsHitTestVisible="False"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Data="{Binding StateGlyph, Converter={x:Static views:SkinIconGeometryConverter.Instance}}">
        <Path.Effect>
          <DropShadowEffect BlurRadius="7" Color="#CC000000" OffsetX="0" OffsetY="1"/>
        </Path.Effect>
      </Path>

      <!--
        The reference's player-state overlay: a centred mark saying the picture is waiting for something. The
        reference shows it while its player is rate-seeking; this engine seeks by jumping, so the mark answers
        the escalating skip ladder instead - the moment a viewer is actually in, on this front end -
        fast-forward while the run is pointing forwards, fast-rewind while it points back, gone the moment the
        jump lands or is cancelled. It is drawn from the same two vectors the row of buttons draws its
        transport marks from (PlayerControl/fast_forward and PlayerControl/fast_rewind) out of the same
        catalog, so overlay and buttons cannot drift apart the way a second picture always does; a skin that
        carries neither draws nothing, which is the same silence the reference keeps on a missing texture.
      -->
      <Path Name="stateIcon" Width="100" Height="100" Stretch="Uniform" Opacity="0.8"
            Fill="{DynamicResource TextBrush}" IsHitTestVisible="False" IsVisible="False"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <Path.Effect>
          <DropShadowEffect BlurRadius="7" Color="#CC000000" OffsetX="0" OffsetY="1"/>
        </Path.Effect>
      </Path>

      <!-- What the library knows about this title, said over the picture at the side where it does not cover
           the film or the row of buttons along its foot: the Info button in the transport row calls it and
           hides it again (the I key got the reference's own job instead - it is the Info key, and that
           toggles the display). It is read once per title and cleared with it, so an old film's plot never
           outlives its film. -->
      <Border Name="mediaInfo"
              IsVisible="False"
              MaxWidth="860"
              Margin="40,0,0,0"
              Padding="16,12"
              Opacity="0.94"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Background="{DynamicResource PanelRaisedBrush}"
              BorderBrush="{DynamicResource OutlineBrush}"
              BorderThickness="1">
        <TextBlock Text="{Binding MediaInfoText}"
                   FontSize="18"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextBrush}"/>
      </Border>
    </Panel>

    <!--
      The audio arrangement, for the one kind of media that has no picture of its own.

      A song played onto the film's screen arrives at a black rectangle with a row of buttons over it, and the
      screen then says "nothing is playing" about the very thing that is playing. Everything a song can be shown
      with stands here instead: the cover, the record it came off turning behind it, what the file is packed in,
      what the library knows about the title, and the shade the row of buttons stands inside.

      The arrangement is the one the mockup was drawn and measured at (1920x1080, every number below from it), and
      it is drawn over the same stage the film wears: the row along the foot is the film's own row, untouched, with
      its two track lists put away because a song's sound is not a choice between three dubs. Nothing here is
      drawn for a film, and nothing of the film's arrangement is drawn here; which of the two the screen wears is
      the model's answer to "is this music" (NowPlayingViewModel.IsAudio).

      Every piece of it stands only where the library had something to say: no cover picture, no cover; no rating,
      no stars; no album on the tag, no cell for one. A control that answers nothing is worse than the space it
      would stand in, and that rule was written for the film's panel.
    -->
    <Panel Name="audioArea" IsVisible="{Binding IsAudio}" IsHitTestVisible="False"
           Classes.squeezed="{Binding ShowsAudioQueue}">
      <!--
        The first layer is the album's own picture across the whole stage, as the mockup lays it (its
        <c>.fanart</c> is the stage's first child) and as the reference's audio screen had it
        (screens/FullScreenContentAudio.xaml). A film brings its own pictures; a song has none, and the screen of a
        song stood on the record's artwork. Where the library keeps no such picture nothing is drawn here - the
        mockup hides its fanart for that case too, and an invented background would be a lie about a library.
      -->
      <Image Name="audioFanart"
             Source="{Binding Fanart, Converter={x:Static views:ArtworkConverter.Instance},
                                       ConverterParameter=backdrop}"
             Stretch="UniformToFill"/>

      <!--
        One shade over the whole stage - black at the lower edge, a tenth of it left at the top - rather than the
        band the film's row carries on its own panel: the row is the same row, but on this screen it stands inside
        the shade instead of over a picture of its own. The steps are the mockup's, close together so that the
        black sits against the lower edge and the row is already standing in it.

        A layer of its own and not the panel's background, because the panel's background is painted under its
        children: as a background this shade would sit <em>behind</em> the fanart and the fanart would hide it.
      -->
      <Panel Name="audioShade">
        <Panel.Background>
          <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,0%">
            <GradientStop Offset="0.00" Color="#FF000000"/>
            <GradientStop Offset="0.08" Color="#C7000000"/>
            <GradientStop Offset="0.16" Color="#99000000"/>
            <GradientStop Offset="0.24" Color="#75000000"/>
            <GradientStop Offset="0.36" Color="#57000000"/>
            <GradientStop Offset="0.52" Color="#40000000"/>
            <GradientStop Offset="0.70" Color="#2E000000"/>
            <GradientStop Offset="0.86" Color="#21000000"/>
            <GradientStop Offset="1.00" Color="#1A000000"/>
          </LinearGradientBrush>
        </Panel.Background>
      </Panel>

      <!--
        The record, behind the cover and starting on the cover's middle axis, so that it only shows out of the
        right hand side (406 in a 420 cover: seven lines of air above and below). It turns while the song plays and
        stands still the moment the engine stops - a record that turns over a paused song lies about the machine -
        and where the library keeps no picture of it the skin's own record is drawn in its place, which is what the
        reference's <c>FallbackSource="CD.png"</c> did and what the mockup's note says (index.html:26). Turned by
        the screen's own clock, the way the wake's ring is turned (NowPlayingView._discTurn), at the mockup's four
        and a half seconds a revolution.
      -->
      <Border Name="audioDisc" Width="406" Height="406"
              IsVisible="{Binding ShowsDisc}"
              Margin="272,0,0,249" HorizontalAlignment="Left" VerticalAlignment="Bottom">
        <Panel>
          <Image Source="{Binding Disc, Converter={x:Static views:ArtworkConverter.Instance},
                                               ConverterParameter=tile}"
                 Stretch="Uniform"/>
          <Image Source="{Binding Disc, Converter={x:Static views:SkinImageConverter.Instance},
                                               ConverterParameter=CD}"
                 Stretch="Uniform"
                 IsVisible="{Binding Disc, Converter={x:Static ObjectConverters.IsNull}}"/>
        </Panel>
      </Border>

      <!--
        The cover: four hundred and twenty lines square on the left, its foot two hundred and forty two lines over
        the lower edge, its corners rounded by twenty and its edge the door border the rest of the face uses. The
        box itself stands whatever the library holds - the reference drew the black housing always and put its
        skin's <c>audio.png</c> inside, inset by fifty, where no cover picture arrived (index.html:111,1506), which
        is the difference between "no cover" and "no screen".
      -->
      <!-- Two surfaces, because a shadow cannot live on a clipped edge (HomeView.axaml:242-246 wrote that rule
           for the wall tiles and it holds here): the outer border is the ground the cover stands on and casts the
           shadow the browser's covers already cast (MediaBrowserView.axaml, "0 12 34 0 #A6000000"), the inner one
          is the face the picture stands on and does the rounding. -->
      <Border Name="audioCover" Width="420" Height="420" CornerRadius="20" BoxShadow="0 12 34 0 #A6000000"
              Margin="62,0,0,242" HorizontalAlignment="Left" VerticalAlignment="Bottom">
        <!-- The corners are cut on the inner one, so the shadow of the outer one is not chopped by its own edge.
             And the face carries no stroke: the template had a one line rim of twenty hundredths white, invisible
             while the cover lay flat on the fanart, but once the cover cast a shadow that rim read as a pale hair
             all the way round the picture. The shadow draws the edge now. -->
        <Border CornerRadius="20" Background="#FF000000" ClipToBounds="True">
          <Panel>
            <Image Source="{Binding Cover, Converter={x:Static views:ArtworkConverter.Instance},
                                     ConverterParameter=tile}"
                   Stretch="UniformToFill"/>
            <Image Source="{Binding Cover, Converter={x:Static views:SkinImageConverter.Instance},
                                     ConverterParameter=audio}"
                   Stretch="Uniform" Margin="50"
                   IsVisible="{Binding Cover, Converter={x:Static ObjectConverters.IsNull}}"/>
          </Panel>
        </Border>
      </Border>

      <!--
        What the file is made of, in the boxes the browser's details row uses, standing above the cover: the codec
        the importer named, the channels it counted, and the two rates in one line. No word names the row - a
        caption of its own in front of three boxes the film's row already reads without one was measured and struck
        out. Where the skin carries a picture of the answer, the picture is drawn; where it carries none, the word
        stands in the same box, which is what SkinImageMissingConverter exists for.
      -->
      <!--
        The record's own lettering, drawn as a picture and not as type: what a media manager leaves beside the
        files as clearart.png or clearlogo.png. It stands over the row of boxes, on the same left line the cover
        and the boxes stand on, and takes only the room the picture needs - the reference's own measure for this
        picture is two hundred and fifty wide by a hundred and twenty high (CurrentlyPlayingAudioDetails.inc),
        which is what it is capped at here. Most libraries carry none, and the row of boxes then simply stands
        higher up the screen's left edge, which is the ordinary answer rather than a complaint.

        It is asked for under the tune's own id: the server's walk through the album's folder answers ClearArt and
        Logo for a track too (LocalFanArtSearch.KINDS), and the importer files both names from the album's folder
        (AudioTagFanArtHandler.ExtractAlbumFolderCover). A library that filed its lettering under "Logo" only is
        answered by the second question the reader asks, exactly as the browser's album panel is.
      -->
      <Image Name="audioClearArt" MaxWidth="250" MaxHeight="120" Stretch="Uniform"
             HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="62,0,0,750"
             Source="{Binding ClearArt, Converter={x:Static views:ArtworkConverter.Instance},
                              ConverterParameter=small}"
             IsVisible="{Binding ShowsAudioClearArt}"/>

      <StackPanel Orientation="Horizontal" Spacing="10"
                  IsVisible="{Binding ShowsAudioPlaques}"
                  Margin="62,0,0,682" HorizontalAlignment="Left" VerticalAlignment="Bottom">
        <Border Classes="audio-plaque" IsVisible="{Binding AudioLine.ShowsCodec}">
          <Grid>
            <Image Source="{Binding AudioLine.CodecToken,
                                     Converter={x:Static views:SkinImageConverter.Instance},
                                     ConverterParameter='MediaLogos/audio/{0}'}"
                   Height="34" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"/>
            <TextBlock Text="{Binding AudioLine.CodecWord}"
                       IsVisible="{Binding AudioLine.CodecToken,
                                           Converter={x:Static views:SkinImageMissingConverter.Instance},
                                           ConverterParameter='MediaLogos/audio/{0}'}"/>
          </Grid>
        </Border>
        <Border Classes="audio-plaque" IsVisible="{Binding AudioLine.ShowsChannels}">
          <Grid>
            <Image Source="{Binding AudioLine.ChannelsToken,
                                     Converter={x:Static views:SkinImageConverter.Instance},
                                     ConverterParameter='MediaLogos/audio/{0}'}"
                   Height="34" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"/>
            <TextBlock Text="{Binding AudioLine.ChannelsWord}"
                       IsVisible="{Binding AudioLine.ChannelsToken,
                                           Converter={x:Static views:SkinImageMissingConverter.Instance},
                                           ConverterParameter='MediaLogos/audio/{0}'}"/>
          </Grid>
        </Border>
        <Border Classes="audio-plaque" IsVisible="{Binding AudioLine.ShowsRates}">
          <TextBlock Text="{Binding AudioLine.RatesText}"/>
        </Border>
      </StackPanel>

      <!--
        The equalizer: the sound made visible, thirty-two bars from the low drums to the cymbals, drawn by the
        control that the reference's audio screen has always carried (FullScreenContentAudio.xaml:274-276). It
        stands on its own on the stage - its first bar on the same line the rating's stars start on, its foot
        thirty-five lines above the button row so the knobs stay clear beneath it - which are the mockup's
        .spektrum numbers (index.html:84-109) and the reference's own bar count and spacing. Without an engine
        that can listen to itself it rests at its floor, as it does in the reference when nothing plays. The
        libVLC engine listens: it opens the song a second time in a silent engine of its own and the bars are
        measured off the spectrum picture that engine draws, because libVLC hands its sound out to no listener
        (VisualSpectrumTap.cs).
      -->
      <views:AudioSpectrumBars Name="audioSpectrum" Source="{Binding Spectrum}" Bands="{Binding BandSpectrum}"
                               Height="300" VerticalAlignment="Bottom"/>

      <!--
        What the library knows about the title, beginning flush with where the equalizer will stand (the cover's
        middle axis, the record's width, and twenty four lines of air: seven hundred and two): the rating on its
        own line without the word "rating" in front of it, and under it the three answers that belong to the
        record itself - the album, the year, the kind of music. The value over its label, as the reference wrote
        its figures; a cell the tag stayed silent about is not drawn.
      -->
      <StackPanel Margin="702,0,0,652" HorizontalAlignment="Left" VerticalAlignment="Bottom" Spacing="26">
        <StackPanel Orientation="Horizontal" Spacing="12" Height="33"
                    IsVisible="{Binding ShowsRating}">
          <ItemsControl ItemsSource="{Binding Stars}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:Double">
                <!-- The number IS the star's light: whole for a star the rating filled, a quarter of it for a star
                     the rating never reached. Computed where the rating is computed, because a picture cannot be
                     told "six and a half of ten". -->
                <Image Source="{Binding Converter={x:Static views:SkinImageConverter.Instance},
                                        ConverterParameter=star}"
                       Width="25" Height="25" Margin="0,0,4,0" Opacity="{Binding}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding RatingWords}" FontSize="22" Opacity="0.85"
                     VerticalAlignment="Center" Foreground="#FFFFFFFF"/>
        </StackPanel>

        <!-- No line height and no trimming on any of these words. A line height as tall as the lettering cuts the
             top off a capital and the foot off a "g" (measured on the screen: the "P" of "Pop" came away), and a
             long album is worth a second line rather than a name with three dots behind it. The padding and the
             matching negative margin are the shadow's ground - see the shadows in the resources - and keep the
             lettering on the lines the template measured. -->
        <StackPanel Name="audioTable" Orientation="Horizontal" Spacing="45">
          <StackPanel Spacing="15"
                      IsVisible="{Binding AlbumName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding AlbumName}" Classes.wrapping="True" FontSize="33" FontWeight="Bold"
                       Foreground="#FFFFFFFF" TextWrapping="Wrap" Effect="{StaticResource audioValueShadow}"
                       Padding="10,6,10,12" Margin="-10,-6,-10,-12"/>
            <TextBlock Text="Album" FontSize="20" Foreground="#99FFFFFF"
                       Effect="{StaticResource audioLabelShadow}" Padding="7,4,7,9" Margin="-7,-4,-7,-9"/>
          </StackPanel>
          <StackPanel Spacing="15"
                      IsVisible="{Binding YearText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding YearText}" FontSize="33" FontWeight="Bold" Foreground="#FFFFFFFF"
                       Effect="{StaticResource audioValueShadow}" Padding="10,6,10,12" Margin="-10,-6,-10,-12"/>
            <TextBlock Text="Year" FontSize="20" Foreground="#99FFFFFF"
                       Effect="{StaticResource audioLabelShadow}" Padding="7,4,7,9" Margin="-7,-4,-7,-9"/>
          </StackPanel>
          <StackPanel Spacing="15"
                      IsVisible="{Binding GenreName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding GenreName}" Classes.wrapping="True" FontSize="33" FontWeight="Bold"
                       Foreground="#FFFFFFFF" TextWrapping="Wrap" Effect="{StaticResource audioValueShadow}"
                       Padding="10,6,10,12" Margin="-10,-6,-10,-12"/>
            <TextBlock Text="Genre" FontSize="20" Foreground="#99FFFFFF"
                       Effect="{StaticResource audioLabelShadow}" Padding="7,4,7,9" Margin="-7,-4,-7,-9"/>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Panel>

    <!--
      The record's own tunes, standing in the room the equalizer gives up. A song is a piece of a record, and the
      record is the thing a viewer chose: the list says what has been heard, what is coming, and where in it the
      player stands - which is also the only way a viewer finds out that a queue exists at all without waiting for
      the first tune to end.

      It is drawn whenever a record plays and never otherwise, so it carries no door of its own: a panel that is
      always there does not need a handle. The rows are the same rows the subtitle picker uses (Button.choice,
      the row the film is on lit), because "the one we are on" is one idiom in this program and not two. A press
      on a row plays that tune.

      The card, its corner and its rim are the cover's numbers - twenty of corner, the plate white at a fifth of
      its strength - over a ground of the black this screen's own shade wears at three eighths, so the words stay
      readable over a bright fanart without covering it with a second panel. Thirty-two lines of the screen's
      standing margin keep it off the right edge, and its foot stands on the line the equalizer's foot stands on,
      three hundred and twenty two above the floor.

      What the viewer drew round it is a maximum and not a shape: the list may reach from seventy six lines under
      the top of the screen down to two hundred and twenty three above the floor, but it only ever wears the height
      its rows need. Ten rows on a screen as tall as the picture, four in a window of seven hundred and twenty, and
      the rows that do not fit are a key away rather than painted over the edge.
    -->
    <Border Name="audioQueue" Width="446" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,62,322" Background="#4D000000" BorderBrush="#33FFFFFF" BorderThickness="1"
            CornerRadius="20" IsVisible="{Binding ShowsAudioQueue}">
      <StackPanel>
        <Grid Height="66" ColumnDefinitions="*,Auto" Margin="20,0">
          <TextBlock Grid.Column="0" Text="{Binding AudioQueueRecord}" FontSize="22" FontWeight="Bold"
                     Foreground="#FFFFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     AutomationProperties.Name="Which record is playing"/>
          <TextBlock Grid.Column="1" Text="{Binding AudioQueuePosition}" FontSize="20" Opacity="0.6"
                     Foreground="#FFFFFFFF" VerticalAlignment="Center" Margin="12,0,0,0"
                     AutomationProperties.Name="Where in the record the player stands"/>
        </Grid>
        <ItemsControl Name="audioQueueRows" ItemsSource="{Binding AudioQueueRows}" Margin="12,0,12,14">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AudioQueueRow">
              <!-- No place for the caret until the viewer walks in (StandOnTune opens a row). The list is drawn
                   from the first second of a record and is the first thing on this whole screen a caret could stand
                   on, so an open row would take the window's very first focus - and the tune that plays would wear
                   a dark caret the whole record through with nobody pointing at it. A click still answers: a row is
                   pressed, not stood on.

                   The padding is two lines tighter than the picker rows wear (eighteen and ten, against eighteen and
                   twelve) because a row under the caret pays three lines of rim to the side instead of one: that is
                   taken out of the padding and not out of the card, which would otherwise grow four lines and push
                   the whole list up the screen every time the caret walked in. Ten rows of fifty two lines plus four
                   of margin are what the fit in the code behind counts. -->
              <Button Classes="choice" Classes.tune="True" Classes.current="{Binding IsCurrent}"
                      Focusable="False" Click="OnQueueRow" Margin="0,2" Padding="18,10"
                      HorizontalContentAlignment="Stretch"
                      AutomationProperties.Name="{Binding Spoken}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"/>
                  <!-- The tune's minutes, which the shelf never carried and the library answers one tune at a
                       time. A tune nobody wrote a length for stands empty rather than at "0:00". -->
                  <TextBlock Grid.Column="1" Text="{Binding LengthWords}" VerticalAlignment="Center" Opacity="0.6"
                             Margin="12,0,2,0"/>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!--
      The display a viewer calls over a film: one glass panel along the foot of the picture, three rows tall,
      with the film itself still the whole screen behind it. The rows are the ones every viewer already knows -
      the film's name with the transport in the middle of it, the position line with its two numbers either side
      of it, and the choices along the bottom - and the panel is the only thing this screen puts over a picture
      that is playing.

      Nothing else is on the screen. No title line above the film, no second position line, no poster in the
      middle of the film it pictures, no status word over a film that is plainly playing, and not the worn skin's
      own strip either: the shipped Nereus skin still answers NowPlayingOverlayTemplate with a slab of its own -
      title, position, its own bar, the volume - and a screen that wore it ended up drawing its reading twice.

      Only what works is drawn, which is the whole design rule here. The chapter marks are for a file that names
      chapters and the two chapter buttons for a film one can still move between them in; "Subtitles" appears
      when the media has a subtitle to show and "Audio" when it has a second sound; the tags beside the name are
      there when the container said how big the picture is and what codes it, and are simply absent when it did
      not. A control that answers nothing is worse than the space it would stand in.

      The way out of this panel is the same key that gets a viewer out of anything else: Back closes the panel
      first and leaves the film running, and closes the screen when the panel is already away. Stopping is the
      remote's Stop key, and what the library knows about the title is behind its name.
    -->
    <!--
      The panel, and it stands in no container of its own. What separates its buttons from the film is a band of
      shade rising out of the bottom edge of the screen: black at four fifths over the foot of the picture,
      thinner as it climbs until at its top the film is untouched. This is the shade every player a viewer knows
      puts under its controls - the words and the glyphs stay readable over a bright scene, and the film keeps
      the whole screen. A pane of frosted glass was tried in this place twice and both ways cost the film its
      frames, once by sampling the picture in managed code and once with the compositor's own blur, which is a
      price no band of shade asks: a gradient is two colours and a line.
    -->
    <Panel Name="osdArea" VerticalAlignment="Bottom" IsVisible="False">
      <!--
        The shade is drawn by a band that asks for no clicks of its own. Worn as the panel's own background it was
        never painted at all - a Panel's background is not drawn here - and it swallowed every press falling
        anywhere inside its height, which is exactly where the record's tune list stands. The band paints the two
        colours the row was always described with and lets the press through to whatever stands behind it: the
        panel's own controls take the press for themselves as they always did, and the view's "a click calls the
        display" question is asked of the whole screen and not of this band.

        It is a band over a picture, so a song does not wear it. The audio arrangement already rises out of one
        gradient of its own along the whole stage - black at the foot, a tenth of a lid at the top - and the row
        stands inside that gradient by design; a second shade over the cover's lower third and over the bars was
        measured and struck out with the mockup.
      -->
      <Border IsHitTestVisible="False" IsVisible="{Binding !IsAudio}">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,0%">
            <GradientStop Offset="0" Color="#CC000000"/>
            <GradientStop Offset="1" Color="#00000000"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <StackPanel Margin="62,120,62,15" Spacing="0">

        <!--
          Row one: what is playing, on the left, and the transport in the middle of the television where the
          hand reaches for it. The name is the file's own name including its extension, because a viewer holding
          a folder of files reads that; the library's title stays where a library name is the only name there is.
          A press of the name says what the library knows about the film, but the name is never stood on: it is a
          name, not a mark in the row, and a label that grows a frame when something walks past it lies about
          being a button.
        -->
        <Grid Height="180" ColumnDefinitions="*,Auto,*">
          <!--
            The title's own lettering - its ClearArt, the name drawn as a picture - stood where its name used to
            be: over the film's upper-left hand, above the controls along the foot and clear of the picture's
            middle, which is where the reference hung a film's lettering. Most libraries carry none, and the image
            then costs nothing: it is simply not there.
          -->
          <Image Grid.Column="0" Name="clearArt"
                 Source="{Binding ClearArt, Converter={x:Static views:ArtworkConverter.Instance}, ConverterParameter=small}"
                 IsVisible="{Binding ShowsClearArt}"
                 Height="176" MaxWidth="840" Stretch="Uniform" StretchDirection="DownOnly"
                 Margin="6,0,12,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                 IsHitTestVisible="False"/>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                      Margin="0,50,0,30">
            <!--
              A chapter jump is drawn when the film has a chapter to jump to that way, and not drawn when it has
              none: this panel shows only what works, and a mark that has never done anything is a promise the
              file never made. The row's length therefore belongs to the film - the jumps stand there exactly as
              often as there is somewhere to jump, which is the same answer the marks on the line and the two
              pickers of tracks already give.
            -->
            <!--
              The two marks of a record stand at the two ends of the row, outside everything else, because they
              are not steps through the tune but rules for the whole record: what order the rest of it plays in,
              and whether it ends at all. Both are drawn only while a record is playing - a lone file and a film
              have no "rest of it" to order, and a mark that can only ever refuse is the promise the file never
              made. Their skin pictures are the two the viewer chose; a mark that is on wears the lit plate.
            -->
            <Button Classes="glass icon" Name="shuffleButton" Click="OnShuffle"
                    Classes.lit="{Binding AudioQueueShuffled}"
                    IsVisible="{Binding ShowsAudioQueue}"
                    AutomationProperties.Name="Play the record in a different order">
              <Path Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                                      ConverterParameter='PlayerControl/shuffle'}"/>
            </Button>
            <Button Classes="glass icon" Name="chapterBackButton" Click="OnChapterBack"
                    IsVisible="{Binding CanChapterBack}"
                    AutomationProperties.Name="Previous chapter">
              <Path Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                                      ConverterParameter='PlayerControl/previous'}"/>
            </Button>
            <Button Classes="glass icon" Name="backButton" Click="OnBack"
                    IsVisible="{Binding CanTransport}"
                    AutomationProperties.Name="{Binding SkipBackCaption}">
              <Path Data="{Binding SkipBackGlyph,
                          Converter={x:Static views:SkinIconGeometryConverter.Instance}}"/>
            </Button>
            <!-- The step of a whole tune, next to the step of half a minute. The two belong beside each other and
                 wear the same two pictures the film's chapter jumps wear, because they are the same kind of thing
                 - the mark before this one - asked of a different thing: a song's chapters are its tunes, and a
                 song has no others. Only a record offers the step; for a film the row keeps the marks the file can
                 answer. -->
            <Button Classes="glass icon" Name="tuneBackButton" Click="OnTuneBack"
                    IsVisible="{Binding ShowsAudioQueue}"
                    AutomationProperties.Name="Previous tune">
              <Path Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                                      ConverterParameter='PlayerControl/previous'}"/>
            </Button>
            <Button Classes="glass transport" Name="pauseButton" Click="OnPause"
                    IsVisible="{Binding CanTransport}"
                    AutomationProperties.Name="{Binding TransportLabel}">
              <Path Data="{Binding TransportGlyph,
                          Converter={x:Static views:SkinIconGeometryConverter.Instance}}"/>
            </Button>
            <!-- Stop beside play/pause: the remote has always had its stop key, and a viewer working with a
                 mouse asked for the same door on the bar. Like the key, it ends the film and leaves the
                 screen, back to where the viewer came from. -->
            <Button Classes="glass icon" Name="stopButton" Click="OnStop"
                    IsVisible="{Binding CanTransport}"
                    AutomationProperties.Name="Stop">
              <Path Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                                      ConverterParameter='PlayerControl/stop'}"/>
            </Button>
            <Button Classes="glass icon" Name="tuneForwardButton" Click="OnTuneForward"
                    IsVisible="{Binding ShowsAudioQueue}"
                    AutomationProperties.Name="Next tune">
              <Path Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                                      ConverterParameter='PlayerControl/next'}"/>
            </Button>
            <Button Classes="glass icon" Name="forwardButton" Click="OnForward"
                    IsVisible="{Binding CanTransport}"
                    AutomationProperties.Name="{Binding SkipForwardCaption}">
              <Path Data="{Binding SkipForwardGlyph,
                          Converter={x:Static views:SkinIconGeometryConverter.Instance}}"/>
            </Button>
            <Button Classes="glass icon" Name="chapterForwardButton" Click="OnChapterForward"
                    IsVisible="{Binding CanChapterForward}"
                    AutomationProperties.Name="Next chapter">
              <Path Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                                      ConverterParameter='PlayerControl/next'}"/>
            </Button>
            <!-- The third answer of this mark is the same two arrows with a one beside them, because the skin
                 carries no third picture and inventing a glyph of the same weight by hand would be a mark nobody
                 recognising a record's tune. The one stands in the mark's empty lower right corner, which the
                 arrows leave to it, in the same white the glyph wears. -->
            <Button Classes="glass icon" Name="repeatButton" Click="OnRepeat"
                    Classes.lit="{Binding AudioQueueRepeats}"
                    IsVisible="{Binding ShowsAudioQueue}"
                    AutomationProperties.Name="{Binding RepeatCaption}">
              <Panel>
                <Path Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                                        ConverterParameter='PlayerControl/repeat'}"/>
                <TextBlock Text="1" FontSize="15" FontWeight="Bold" IsHitTestVisible="False"
                           Foreground="{DynamicResource ButtonTextBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-3"
                           IsVisible="{Binding AudioQueueRepeatsOne}"/>
              </Panel>
            </Button>
          </StackPanel>
        </Grid>

        <!--
          Row two: the position line, and only one of it. Its two numbers stand at either end of it rather than
          in a caption, because that is where a viewer reads them against the line. The marks on the line are
          where the file says its chapters begin - the file's own positions, spaced along the line by their own
          share of it, so they keep their places when the window changes width.

          The line is the only thing in this panel a press can land on besides a button: the bar, its fill and
          the marks are all out of the way of the pointer, and the transparent surface over them answers for the
          whole row. Pressing it puts the film there; holding and dragging moves the film along as the hand
          moves. A remote reaches the line as a control of its own and walks it with left and right.
        -->
        <Grid Height="55" ColumnDefinitions="Auto,*,Auto">
          <TextBlock Name="positionLabel" Grid.Column="0" Classes="time" MinWidth="104" Margin="6,0,20,0"
                     VerticalAlignment="Center" Text="{Binding PositionLabel}"
                     AutomationProperties.Name="Where the viewer stands in the film"/>
          <!--
            The line and the control it is pressed on are one and the same rectangle: the track, its filled part,
            the chapter marks and the playhead are this button's own content, so a pointer, a screen reader and
            an automation tool all find the same area to stand on, and the line is not a decoration with an
            invisible strip of something else laid over it. Nothing of the look changed by this - the button is
            drawn by nothing at rest.
          -->
          <Button Name="seekBar" Grid.Column="1" Classes="seek" IsVisible="{Binding CanSeek}"
                  AutomationProperties.Name="Position in the film">
            <Panel Name="progressRow" Height="40">
              <Border Height="12" CornerRadius="6" VerticalAlignment="Center" Opacity="0.6"
                      Background="{DynamicResource VideoOutlineBrush}" IsHitTestVisible="False"/>
              <ProgressBar Name="progressBar" Classes="track" Minimum="0" Maximum="1"
                           Value="{Binding Progress}" MinHeight="12" CornerRadius="6"
                           Background="Transparent"/>
              <!-- The chapter marks. Not a list bound to the chapters: the toolkit takes an ItemsControl's
                   containers back whenever the film turns over, and the Canvas.Left a mark had been given went
                   back with them, so every mark of a chaptered film ended up standing at the start of the
                   line. The screen lays these out itself and keeps them, which the film needs. -->
              <Canvas Name="chapterMarks" Height="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <Border Name="scrubKnob" Classes="knob"/>
            </Panel>
          </Button>
          <TextBlock Name="durationLabel" Grid.Column="2" Classes="time" MinWidth="104" Margin="20,0,6,0"
                     VerticalAlignment="Center" TextAlignment="Right" Text="{Binding DurationLabel}"
                     AutomationProperties.Name="How long the film is"/>
        </Grid>

        <!--
          Row three: the name of the film at the left, and every control a viewer stands on pushed to the right
          hand - the two that open a list, then the three switches of the machine. Nothing stands in the middle;
          the film behind it is the thing a viewer is watching. The name sits at the bottom-left now, under the
          position line: its lettering (the ClearArt up by the transport) is the picture form of the same words,
          so the name no longer has to stand at the top as well. The two that open a list say which track they are
          on in their own body, because a viewer choosing between subtitles wants to read what is currently chosen
          without opening anything first.
        -->
        <Grid Height="92" ColumnDefinitions="Auto,*,Auto">
          <Button Grid.Column="0" Name="infoButton" Classes="title" Click="OnMediaInfo"
                  IsEnabled="{Binding CanInform}"
                  AutomationProperties.Name="What the library knows about this title"
                  HorizontalAlignment="Left" VerticalAlignment="Center">
            <Panel>
              <!-- The film's own name over the year the library knows, as it stood before a song got a screen of
                   its own. -->
              <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center"
                          IsVisible="{Binding !IsAudio}">
                <TextBlock Text="{Binding Title}" FontSize="34" FontWeight="SemiBold"
                           Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis"/>
                <!-- The year the library knows, in the smaller voice under the name - where the file's own name
                     used to stand. It shows only when the library named a year, so a title it knows nothing about
                     wears its name alone. -->
                <TextBlock Text="{Binding YearText}" FontSize="20" Foreground="#B3FFFFFF"
                           IsVisible="{Binding YearText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              </StackPanel>

              <!-- A song's name over whoever sings it, in the same two sizes the film's name and year stand in
                   above: thirty four semi bold over twenty. The mockup had the reference's small and smaller
                   letters here (Consts.xaml:19-20, thirty three and twenty seven) and a viewer found them too big
                   next to the rest of the row, so the screen keeps one lettering for both media. No line height
                   (it cuts the top off capitals) and no trimming (a name is not cut short). The line of bitrate,
                   sample rate and channels that used to stand under a name is gone here for a song - those answers
                   now wear the plaques above the cover. -->
              <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center" Name="audioName"
                          MaxWidth="560"
                          IsVisible="{Binding IsAudio}">
                <TextBlock Text="{Binding Title}" FontSize="34" FontWeight="SemiBold"
                           Foreground="#FFFFFFFF" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ArtistName}" FontSize="20" Foreground="#99FFFFFF"
                           TextWrapping="Wrap" IsVisible="{Binding ShowsArtist}"/>
              </StackPanel>
            </Panel>
          </Button>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                      Name="rowSwitches">
            <Button Classes="glass pick" Name="subtitleButton" Click="OnSubtitles"
                    IsVisible="{Binding ShowsTrackLists}"
                    AutomationProperties.Name="{Binding SubtitleTrackLine}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Path Data="{Binding SubtitlesGlyph,
                            Converter={x:Static views:SkinIconGeometryConverter.Instance}}"/>
                <TextBlock Text="{Binding SubtitleTrackName}" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                <TextBlock Classes="chevron" Text="&#8250;"/>
              </StackPanel>
            </Button>
            <Button Classes="glass pick" Name="audioButton" Click="OnAudio"
                    IsVisible="{Binding ShowsTrackLists}"
                    AutomationProperties.Name="{Binding AudioTrackLine}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Path Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                                        ConverterParameter='MediaMenu/track'}"/>
                <TextBlock Text="{Binding AudioTrackName}" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                <TextBlock Classes="chevron" Text="&#8250;"/>
              </StackPanel>
            </Button>
            <Button Classes="glass icon" Name="volumeButton" Click="OnVolume"
                    AutomationProperties.Name="{Binding VolumeCaption}">
              <Path Data="{Binding VolumeGlyph,
                          Converter={x:Static views:SkinIconGeometryConverter.Instance}}"/>
            </Button>
            <Button Classes="glass icon" Name="fullscreenButton" Click="OnFullScreen"
                    AutomationProperties.Name="Full screen">
              <Path Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                                      ConverterParameter='PlayerControl/fullscreen'}"/>
            </Button>
            <Button Classes="glass icon" Name="settingsButton" Click="OnSettings"
                    AutomationProperties.Name="Playback settings">
              <Path Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                                      ConverterParameter='NotificationMenu/settings'}"/>
            </Button>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Panel>

    <!--
      The sound, in a dialog of its own rather than as a line along the foot of the film. A line of sound laid
      among the buttons steals the keys a viewer needs to walk to and from those buttons: standing on the line,
      left and right mean the volume, and standing beside it they mean the next button, which is one key saying
      two things depending on where nobody is looking. Asked for by the loudspeaker mark and shut by the back key
      like the two lists beside it, the level has room for its own line here - pressed, dragged, or stepped with
      the keys.
      Upright, and read from the top down: the number of it, the mark that lifts the sound, the line a hand
      slides along, the mark that lowers it, and the mark that silences the film last of all. The sound grows
      upward, which is how a viewer thinks of it, and the line is turned the same way rather than being a
      horizontal line stood on its end.
      It stands at the right hand side of the screen and above the row of buttons rather than over them: over the
      buttons it would hide the very things a viewer is watching the film by, and at the right it is out of the
      picture's middle. How far above the buttons it has to stand is the height the buttons take, which only the
      layout knows - see PlaceVolumeDialog.
    -->
    <views:VolumePicker Name="volumePicker" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="48,0,48,24"/>

    <!--
      The list a viewer picks a subtitle or a sound from, raised over the middle of the film by the two buttons
      that point onward. It is the panel's own dialog rather than a screen of the navigation: choosing a
      subtitle is a word about the film that is playing, not a place a viewer walked to, and Back goes back to
      the film rather than out of a screen. The row the film is already on is marked as it, because a list that
      does not say what is currently chosen leaves the viewer guessing - which is the whole complaint about the
      subtitle menus it replaces.
    -->
    <Border Name="trackDialog" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
            MinWidth="520" MaxWidth="760" MaxHeight="620" Padding="24,20" CornerRadius="24"
            Background="#F2101A24" BorderBrush="#80FFFFFF" BorderThickness="1">
      <StackPanel Spacing="14">
        <TextBlock Name="trackDialogTitle" FontSize="26" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
        <ScrollViewer Name="trackDialogScroll" MaxHeight="440">
          <StackPanel Name="trackDialogRows" Spacing="8"/>
        </ScrollViewer>
        <TextBlock Name="trackDialogHint" FontSize="16" Foreground="#A6FFFFFF"
                   Text="Back closes this list. The film keeps playing while it is open."/>
      </StackPanel>
    </Border>

    <!--
      The reference's opening breath (AnimationL on its full-screen grid): the picture starts behind a black
      overlay that fades away within half a second of the screen showing, so a film does not begin with a
      hard cut from whatever screen came before. It replays every time this screen is shown, because the
      reference's trigger fires on showing, not once per application.
    -->
    <Border Name="openFade" Background="Black" IsHitTestVisible="False"/>
  </Panel>
</UserControl>

