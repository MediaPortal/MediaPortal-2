<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MediaPortal.Frontend.ViewModels"
        xmlns:theming="clr-namespace:MediaPortal.Frontend.Theming"
        x:Class="MediaPortal.Frontend.Views.SkinSettingsView"
        x:DataType="vm:SkinSettingsViewModel"
        Name="skinSettings"
        Background="{DynamicResource ScreenBackgroundBrush}"
        >

  <!--
    The worn skin's own switches, one row each, in the order the reference's settings class filed them -
    and every row carries the control that works it: a checkbox for a switch with two answers, a button
    for everything with a list of them, which shows the current answer right on its face. A row you can
    only look at is a wall chart, not a settings screen. Enter and the remote's OK work the highlighted
    row exactly like its control: a checkbox flips, a button walks to its next answer. See
    SkinSettingsViewModel for why the colour of Nereus is one button through eight families.
  -->

  <DockPanel Margin="48,14">

    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,8">
      <TextBlock Text="{Binding Heading}"
                 FontSize="24"
                 FontWeight="SemiBold" />
      <TextBlock Text="{Binding Subtitle}"
                 FontSize="14"
                 Opacity="0.7"
                 TextWrapping="Wrap"
                 MaxWidth="1500"
                 HorizontalAlignment="Left" />
    </StackPanel>

    <TextBlock DockPanel.Dock="Bottom"
               Name="statusLine"
               Text="{Binding Status}"
               FontSize="14"
               Opacity="0.85"
               Margin="0,8,0,0"
               TextWrapping="Wrap" />

    <ListBox Name="settingsList" theming:SkinTemplates.TileTemplate="SettingsOptionTemplate"
             Focusable="True"
             ItemsSource="{Binding Options}"
             SelectedItem="{Binding Selected, Mode=TwoWay}"
             FontSize="15">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="12,2"/>
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:SkinSettingOption">
          <Grid ColumnDefinitions="380,170,*" Margin="2,1">
            <TextBlock Text="{Binding Label}"
                       FontSize="16"
                       VerticalAlignment="Center" />
            <!-- The two faces of a row, and only one of them is ever up: the checkbox is the whole control
                 for a switch, and the button - whose label is the current answer, in the accent - is the
                 whole control for a choice. Both save at once; the status line says so under the list. -->
            <CheckBox Grid.Column="1"
                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                      IsVisible="{Binding IsToggle}"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left" />
            <Button Grid.Column="1"
                    Content="{Binding ValueText}"
                    IsVisible="{Binding !IsToggle}"
                    Click="OnChoiceClick"
                    MinWidth="150"
                    HorizontalAlignment="Left" />
            <TextBlock Grid.Column="2"
                       Text="{Binding Description}"
                       FontSize="13"
                       Opacity="0.6"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>