<Project>

  <!--
    Shared build settings for projects directly under MediaPortal\ that are not covered by
    Source\Directory.Build.props: Incubator\, Tests\, Tools\, Resources\, Setup\, Graveyard\.

    MSBuild stops walking upwards at the first Directory.Build.props it finds, so the projects
    under Source\ keep using theirs and never see this file. The two must be kept consistent.

    Same single rule as there: .NET Framework reference assemblies, and only when a non-Windows
    host is asked to build a net48 target. On Windows this file contributes nothing, so desktop
    builds are unchanged.
  -->
  <ItemGroup Condition="'$(OS)' != 'Windows_NT' AND '$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
