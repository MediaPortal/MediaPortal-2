<Plugin
    DescriptorVersion="1.0"
    Name="OnlineLibraries"
    PluginId="{B32504F3-4374-4640-94A1-16E1DEE84C3C}"
    Author="Morpheus_xx, Valk"
    Copyright="GPL"
    Description="Library plugin providing online libaries access (TMDB, TheTvDB...) needed for some default metadata extractors">

  <Version
    PluginVersion="1.1"
    ReleaseDate="2016-12-20 01:00:00 GMT+01:00"
    CurrentAPI="2"/>

  <DependsOn>
    <CoreDependency Name="MediaPortal.Common" CompatibleAPI="2" />
    <CoreDependency Name="MediaPortal.Utilities" CompatibleAPI="1" />
  </DependsOn>

  <Runtime>
    <Assembly FileName="OnlineLibraries.dll"/>
  </Runtime>

  <Register Location="/Services">   
   <!--Geo Location Service-->
    <Service Id="GeoLocationService" RegistrationClassName="MediaPortal.Extensions.OnlineLibraries.Libraries.IGeoLocationService"
        ServiceClassName="MediaPortal.Extensions.OnlineLibraries.GeoLocationService"/>
    <!--Online Matcher Service-->
    <Service Id="OnlineMatcherService" RegistrationClassName="MediaPortal.Extensions.OnlineLibraries.Libraries.IOnlineMatcherService"
        ServiceClassName="MediaPortal.Extensions.OnlineLibraries.OnlineMatcherService"/>
    <!--
      The one method of the matcher that a local metadata extractor needs, as its own service. The NFO
      extractors ask for IOnlineMovieMatcher rather than for IOnlineMatcherService above because that
      interface lives in this assembly, which is built for Windows; a plugin that reads a .nfo file off
      a disk should not inherit that. This is a forwarder to the same OnlineMatcherService instance
      (see OnlineMovieMatcher), so registering it costs the server nothing but a type.
    -->
    <Service Id="OnlineMovieMatcher" RegistrationClassName="MediaPortal.Common.MediaManagement.IOnlineMovieMatcher"
        ServiceClassName="MediaPortal.Extensions.OnlineLibraries.OnlineMovieMatcher"/>
  </Register>

</Plugin>
