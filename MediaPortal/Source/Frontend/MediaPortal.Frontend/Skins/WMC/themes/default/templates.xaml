<?xml version="1.0" encoding="utf-8"?>
<!--
  WMC screen templates: how this skin draws the items of the screens that ask.

  WMC never drew a menu as a list of quiet text rows. Its home menu was a stack of broad coloured bands with
  the word set big on them - the tile is the whole width and the accent is the band's underline, not a marker
  beside the text. That difference is what this file is for: the same list, the same keys, the same bindings,
  and a visibly different screen. The reference's WMC skin spelled the same thought with its own ControlTemplates
  in screens/ and styles/; this is that intent in the markup this front end reads.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:MediaPortal.Frontend.ViewModels"
                    xmlns:views="clr-namespace:MediaPortal.Frontend.Views">

  <!--
    The home menu as WMC wore it: a full-width band the entry sits on, its own tile picture from this skin's
    images/HomeMenu - the reference painted those for the same workflow action Ids, in this skin under the
    Id's 'Focus' spelling, and that focused coloured variant is the one a band on the television wants - the
    word large, and the count or the refusal sitting on the band's right edge where WMC put its state, on the
    tile, never under it. The reference WMC home screen had no local-media tile, so that entry is this skin's
    one letter badge.
  -->
  <!--
    The settings list as WMC wore its configuration menu: a full-width band like the home tiles, the
    section's name large and bold on it, the one sentence of what you can do here under it, and whose
    machine it belongs to sitting on the band's right edge where WMC put a band's state - on the band,
    never under it.
  -->
  <DataTemplate x:Key="SettingsRowTemplate" x:DataType="vm:SettingsSection">
    <Border Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="0,0,0,3"
            CornerRadius="{DynamicResource DialogBorderCornerRadius}"
            Padding="18,10,18,10"
            Margin="0,4,10,6">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="Bold"
                     Foreground="{DynamicResource TextBrush}"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Description}"
                     FontSize="{DynamicResource SmallerFontSize}"
                     Foreground="{DynamicResource MutedTextBrush}"
                     TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding Owner}"
                   FontSize="{DynamicResource SmallerFontSize}"
                   Foreground="{DynamicResource AccentBrush}"
                   VerticalAlignment="Bottom"/>
      </Grid>
    </Border>
  </DataTemplate>

  <!--
    The component screens as WMC wore them: everything on a band. The headline sits large on the band with
    its paper and hour on the band's right edge, a coming day names itself and its span on the edge, and a
    song coming up in the party carries who sings it under its line. Where Nereus writes sentences under
    words, WMC uses the whole width and puts the state on the edge - the same lists, a visibly different
    screen.
  -->
  <DataTemplate x:Key="NewsHeadlineTemplate" x:DataType="vm:NewsHeadlineRow">
    <Border Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="0,0,0,3"
            CornerRadius="{DynamicResource DialogBorderCornerRadius}"
            Padding="18,10,18,10"
            Margin="0,4,10,6">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
        <TextBlock Grid.Column="0"
                   Text="{Binding Title}"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextBrush}"
                   TextTrimming="CharacterEllipsis"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Bottom">
          <TextBlock Text="{Binding FeedName}"
                     FontSize="{DynamicResource SmallerFontSize}"
                     Foreground="{DynamicResource MutedTextBrush}"/>
          <TextBlock Text="{Binding DateText}"
                     FontSize="{DynamicResource SmallerFontSize}"
                     Foreground="{DynamicResource AccentBrush}"/>
        </StackPanel>
      </Grid>
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="WeatherDayTemplate" x:DataType="vm:WeatherDayRow">
    <Border Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="0,0,0,3"
            CornerRadius="{DynamicResource DialogBorderCornerRadius}"
            Padding="18,10,18,10"
            Margin="0,4,10,6">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="14">
        <!-- The day's picture in the band's left edge, the way the reference's weather rows carried their
             numbered icon; it stands empty when no skin pictures the day. -->
        <Image Grid.Column="0"
               Source="{Binding Icon,
                                Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='Weather/64x64/{0}'}"
               Width="42"
               Height="42"
               Stretch="Uniform"
               VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1"
                   Text="{Binding DateText}"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextBrush}"
                   VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2"
                   Text="{Binding Overview}"
                   FontSize="{DynamicResource SmallerFontSize}"
                   Foreground="{DynamicResource MutedTextBrush}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
        <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Bottom">
          <TextBlock Text="{Binding Range}"
                     FontSize="{DynamicResource SmallerFontSize}"
                     Foreground="{DynamicResource AccentBrush}"
                     HorizontalAlignment="Right"/>
          <TextBlock Text="{Binding Rain}"
                     FontSize="{DynamicResource SmallerFontSize}"
                     Foreground="{DynamicResource MutedTextBrush}"
                     HorizontalAlignment="Right"/>
        </StackPanel>
      </Grid>
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="PartyQueueTemplate" x:DataType="vm:TitleViewModel">
    <Border Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="0,0,0,3"
            CornerRadius="{DynamicResource DialogBorderCornerRadius}"
            Padding="18,10,18,10"
            Margin="0,4,10,6">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Line}"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextBrush}"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding Detail}"
                   FontSize="{DynamicResource SmallerFontSize}"
                   Foreground="{DynamicResource MutedTextBrush}"
                   TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="HomeMenuTileTemplate" x:DataType="vm:MainMenuEntry">
    <Border Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="0,0,0,3"
            Padding="18,10,18,10"
            Margin="0,4,10,6">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
        <Panel MinWidth="36">
          <Image Source="{Binding HomeImageId,
                                  Converter={x:Static views:SkinImageConverter.Instance},
                                  ConverterParameter='HomeMenu/{0}Focus'}"
                 Height="30"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"/>
          <!-- The "this shelf is playing" mark, the very picture WMC carries under the name IsPlaying. It
               sits to the right of the tile picture, where WMC put a band's state, and it appears with the
               picture and not before it: a mark with nothing under it is the hole in the tile that a media
               centre is judged by. -->
          <Image Source="{Binding Label,
                                  Converter={x:Static views:SkinImageConverter.Instance},
                                  ConverterParameter=IsPlaying}"
                 Height="14"
                 Stretch="Uniform"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,2,2,0"
                 IsVisible="{Binding IsPlaying, Mode=OneWay}"/>
          <TextBlock Text="{Binding Badge}" FontSize="24" Opacity="0.85"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource TextBrush}"
                     IsVisible="{Binding HomeImageId,
                                         Converter={x:Static views:SkinImageMissingConverter.Instance},
                                         ConverterParameter='HomeMenu/{0}Focus'}"/>
        </Panel>
        <TextBlock Grid.Column="1" Text="{Binding Label}"
                   FontSize="26" FontWeight="Bold"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextBrush}"/>
        <TextBlock Grid.Column="2" Text="{Binding Detail}"
                   FontSize="{DynamicResource SmallerFontSize}"
                   Foreground="{DynamicResource AccentBrush}"
                   VerticalAlignment="Bottom"
                   Margin="12,0,0,3"
                   TextTrimming="CharacterEllipsis"/>
      </Grid>
    </Border>
  </DataTemplate>

  <!--
    A title's row: WMC's list rows are rows of tiles too - the name large, the state on the right, the seen
    mark folded into the band. No thin grey subtitle anywhere; that is Nereus' voice, not this one.
  -->
  <DataTemplate x:Key="TitleRowTemplate" x:DataType="vm:TitleViewModel">
    <Border Background="{DynamicResource PanelBrush}"
            Padding="14,8"
            Margin="0,3,8,5"
            MinWidth="700">
      <Grid ColumnDefinitions="Auto,5*,1.4*" ColumnSpacing="20">
        <TextBlock Text="{Binding SeenMark}" MinWidth="34"
                   Foreground="{DynamicResource AccentBrush}"/>
        <TextBlock Grid.Column="1" Text="{Binding Line}" FontSize="24" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextBrush}"/>
        <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="16"
                   HorizontalAlignment="Right"
                   Foreground="{DynamicResource MutedTextBrush}"
                   TextTrimming="CharacterEllipsis"/>
      </Grid>
    </Border>
  </DataTemplate>

  <!--
    The media tiles as WMC wore its grid (themes/default/styles/MediaStyles.xaml, GridViewMovieItemTemplate
    and its Banner/Thumbnail siblings). Three things set this skin's shelf apart from Nereus' and they are all
    the reference's own: the picture stands without a frame but with rounded corners (the reference's
    CornerRadius="6" opacity mask), a title without a picture gets the skin's diagonal gradient ground with
    video.png on it (MediaItemBackgroundColor1/2, #F2447da7 over #F2124273, StartPoint 0,1 to EndPoint 1,0),
    and a picture that is there carries no name bar - WMC let the poster speak and said the name in the
    details beside the shelf. The sizes are this skin's MediaConsts: poster 162.5x250, banner 460x105,
    thumbnail 263x162, cover 260x410. The watched and offline corners are the skin's own pictures, asked
    from the worn skin like everywhere else, and they obey the grid's flag setting as Nereus' tiles do.

    The one liberty taken: where the reference left a picture-less tile as a gradient with a video mark and
    no word about it, these tiles add the name on the ground - a television shelf of identical gradients is
    something the reference could name from its focus ribbon and this front end's grid cannot.
  -->
  <DataTemplate x:Key="MediaTilePosterTemplate" x:DataType="vm:TitleViewModel">
    <Panel Width="163" Height="250" Margin="8,8,8,14">
      <Border CornerRadius="6" ClipToBounds="True">
        <Image Source="{Binding Artwork, Converter={x:Static views:ArtworkConverter.Instance},
                                ConverterParameter='tile'}"
               Stretch="UniformToFill"/>
      </Border>
      <!-- no picture: the skin's gradient ground, its mark, the name -->
      <Panel IsVisible="{Binding HasNoArtwork}">
        <Border CornerRadius="6">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
              <GradientStop Color="#F2447DA7" Offset="0"/>
              <GradientStop Color="#F2124273" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='video.png'}"
               Stretch="Uniform" Width="70" Height="70" Opacity="0.6"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"
                   FontSize="{DynamicResource SmallFontSize}" TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis" MaxLines="4" TextAlignment="Center"
                   Margin="10,10,10,10" VerticalAlignment="Bottom"/>
      </Panel>
      <!-- watched corners, if the grid's setting allows corners at all -->
      <Panel IsVisible="{Binding WatchFlagsShown}">
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='watched.png'}"
               Height="33" Stretch="Uniform" Opacity="0.9"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
               IsVisible="{Binding IsWatched}"/>
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='partlywatched.png'}"
               Height="33" Stretch="Uniform" Opacity="0.9"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
               IsVisible="{Binding IsPartlyWatched}"/>
      </Panel>
      <!-- a title without a file behind it: WMC's corner flag with its offline mark -->
      <Panel IsVisible="{Binding IsOffline}">
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='flag.png'}"
               Height="90" Stretch="Uniform"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"/>
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='offline.png'}"
               Height="35" Stretch="Uniform"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,7,0"/>
      </Panel>
    </Panel>
  </DataTemplate>

  <DataTemplate x:Key="MediaTileBannerTemplate" x:DataType="vm:TitleViewModel">
    <Panel Width="460" Height="105" Margin="8,6,8,10">
      <Border CornerRadius="6" ClipToBounds="True">
        <Image Source="{Binding Artwork, Converter={x:Static views:ArtworkConverter.Instance},
                                ConverterParameter='tile'}"
               Stretch="UniformToFill"/>
      </Border>
      <Panel IsVisible="{Binding HasNoArtwork}">
        <Border CornerRadius="6">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
              <GradientStop Color="#F2447DA7" Offset="0"/>
              <GradientStop Color="#F2124273" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='video.png'}"
               Stretch="Uniform" Width="60" Height="60" Opacity="0.6"
               HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"
                   FontSize="{DynamicResource SmallFontSize}" TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis" MaxLines="2"
                   Margin="60,10,10,10" VerticalAlignment="Center"/>
      </Panel>
      <Panel IsVisible="{Binding WatchFlagsShown}">
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='watched.png'}"
               Height="28" Stretch="Uniform" Opacity="0.9"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
               IsVisible="{Binding IsWatched}"/>
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='partlywatched.png'}"
               Height="28" Stretch="Uniform" Opacity="0.9"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
               IsVisible="{Binding IsPartlyWatched}"/>
      </Panel>
      <!-- the corner flag of a title without a file, shrunk to the banner's height -->
      <Panel IsVisible="{Binding IsOffline}">
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='flag.png'}"
               Height="45" Stretch="Uniform"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"/>
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='offline.png'}"
               Height="22" Stretch="Uniform"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"/>
      </Panel>
    </Panel>
  </DataTemplate>

  <DataTemplate x:Key="MediaTileThumbnailTemplate" x:DataType="vm:TitleViewModel">
    <Panel Width="263" Height="162" Margin="8,6,8,10">
      <Border CornerRadius="6" ClipToBounds="True">
        <Image Source="{Binding Artwork, Converter={x:Static views:ArtworkConverter.Instance},
                                ConverterParameter='tile'}"
               Stretch="UniformToFill"/>
      </Border>
      <Panel IsVisible="{Binding HasNoArtwork}">
        <Border CornerRadius="6">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
              <GradientStop Color="#F2447DA7" Offset="0"/>
              <GradientStop Color="#F2124273" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='video.png'}"
               Stretch="Uniform" Width="64" Height="64" Opacity="0.6"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"
                   FontSize="{DynamicResource SmallFontSize}" TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis" MaxLines="2" TextAlignment="Center"
                   Margin="10,10,10,8" VerticalAlignment="Bottom"/>
      </Panel>
      <Panel IsVisible="{Binding WatchFlagsShown}">
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='watched.png'}"
               Height="30" Stretch="Uniform" Opacity="0.9"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
               IsVisible="{Binding IsWatched}"/>
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='partlywatched.png'}"
               Height="30" Stretch="Uniform" Opacity="0.9"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
               IsVisible="{Binding IsPartlyWatched}"/>
      </Panel>
      <Panel IsVisible="{Binding IsOffline}">
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='flag.png'}"
               Height="60" Stretch="Uniform"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"/>
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='offline.png'}"
               Height="26" Stretch="Uniform"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0"/>
      </Panel>
    </Panel>
  </DataTemplate>

  <!--
    The cover: the same picture bigger than in the grid, at the reference's POSTER_COVER size, without a
    frame and without a name bar - what WMC says about a cover it says in the details, not on the cover.
  -->
  <DataTemplate x:Key="MediaTileCoverTemplate" x:DataType="vm:TitleViewModel">
    <Panel Width="260" Height="410" Margin="10,8,10,12">
      <Border CornerRadius="6" ClipToBounds="True">
        <Image Source="{Binding Artwork, Converter={x:Static views:ArtworkConverter.Instance},
                                ConverterParameter='tile'}"
               Stretch="UniformToFill"/>
      </Border>
      <Panel IsVisible="{Binding HasNoArtwork}">
        <Border CornerRadius="6">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
              <GradientStop Color="#F2447DA7" Offset="0"/>
              <GradientStop Color="#F2124273" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='video.png'}"
               Stretch="Uniform" Width="90" Height="90" Opacity="0.6"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"
                   FontSize="{DynamicResource SmallFontSize}" TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis" MaxLines="4" TextAlignment="Center"
                   Margin="14,14,14,14" VerticalAlignment="Bottom"/>
      </Panel>
      <Panel IsVisible="{Binding WatchFlagsShown}">
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='watched.png'}"
               Height="36" Stretch="Uniform" Opacity="0.9"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
               IsVisible="{Binding IsWatched}"/>
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='partlywatched.png'}"
               Height="36" Stretch="Uniform" Opacity="0.9"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
               IsVisible="{Binding IsPartlyWatched}"/>
      </Panel>
      <Panel IsVisible="{Binding IsOffline}">
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='flag.png'}"
               Height="96" Stretch="Uniform"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"/>
        <Image Source="{Binding Name, Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter='offline.png'}"
               Height="36" Stretch="Uniform"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,7,0"/>
      </Panel>
    </Panel>
  </DataTemplate>

  <!--
    The playback screen's bar, as this skin would have read it: WMC said everything on a band - the blue panel of
    its tiles, its own accent as the band's edge, and the word set bold and large on top - rather than in Nereus'
    quiet text on a dark ground. The corners are the skin's own DialogBorderCornerRadius, the very measurement its
    superlayers round their slabs with, so the bar and its overlays are cut the same way. The progress line is the
    reference's ProgressBarFillColor over its ProgressBarBorderColor, which this skin keeps as its accent and its
    video outline.

    Like the Nereus bar, this one reads the playback and never drives it: skin markup has nothing behind it to
    catch a press, and the keys stay the screen's own row.
  -->
  <DataTemplate x:Key="NowPlayingOverlayTemplate" x:DataType="vm:NowPlayingViewModel">
    <Border Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,3"
            CornerRadius="{DynamicResource DialogBorderCornerRadius}"
            Padding="20,10,20,12" Margin="0,14,0,0"
            IsVisible="{Binding HasMedia}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Title}"
                     FontSize="26" FontWeight="Bold"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource TextBrush}"/>
          <StackPanel Orientation="Horizontal" Spacing="14">
            <TextBlock Text="{Binding PositionText}"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"
                       VerticalAlignment="Center"/>
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}"
                         Width="460" Height="6" VerticalAlignment="Center"
                         Foreground="{DynamicResource AccentBrush}"
                         Background="{DynamicResource VideoOutlineBrush}"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <!--
            The state of play, in this skin's own pictures of it: WMC's themes/default/styles/Buttons.xaml hangs
            PlayerControl\PLAY.NOFOCUS.PNG and its PAUSE sibling at height 45 for its transport row, and the band
            wears the same two files at a bar's height to say what the player is doing rather than to ask for a
            press it cannot take. One of them is up while the film runs or waits; neither is up when it stopped,
            finished or failed, and the word beside them is left to say that on its own. The bound word only gives
            the converter something to answer with - the name is the parameter, as it is on this skin's tiles.
          -->
          <Image Source="{Binding Title, Converter={x:Static views:SkinImageConverter.Instance},
                                  ConverterParameter='PlayerControl/PLAY.NOFOCUS'}"
                 Height="26" Stretch="Uniform" VerticalAlignment="Center"
                 IsVisible="{Binding IsPlaying, Mode=OneWay}"/>
          <Image Source="{Binding Title, Converter={x:Static views:SkinImageConverter.Instance},
                                  ConverterParameter='PlayerControl/PAUSE.NOFOCUS'}"
                 Height="26" Stretch="Uniform" VerticalAlignment="Center"
                 IsVisible="{Binding IsPaused, Mode=OneWay}"/>
          <TextBlock Text="{Binding StateText}"
                     FontSize="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource MutedTextBrush}"
                     VerticalAlignment="Center"/>
          <!-- The loudness on the band, WMC stating it as plainly as it states a count on a menu tile. -->
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="Volume" FontSize="18"
                       Foreground="{DynamicResource MutedTextBrush}"/>
            <TextBlock Text="{Binding Volume}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
  </DataTemplate>

  <!--
    The dialog frame: the card a dialog stands on. WMC's dialogs were rounded boxes, and this skin's own
    DialogBorderCornerRadius is the measurement of that roundness; the accent edge along the bottom is the
    trim its bands - the settings rows, the home tiles - already wear. Like the rest of its bands the frame
    frames whatever a screen opens and no view model's property bag, so this is the one template in the file
    that names no view model: it is pinned to Object and its single pathless binding only passes the dialog's
    own body through.
  -->
  <DataTemplate x:Key="DialogFrameTemplate" x:DataType="x:Object">
    <Border Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="0,0,0,3"
            CornerRadius="{DynamicResource DialogBorderCornerRadius}"
            Padding="28,22"
            MaxWidth="760"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
      <ContentPresenter Content="{Binding}"/>
    </Border>
  </DataTemplate>

</ResourceDictionary>
