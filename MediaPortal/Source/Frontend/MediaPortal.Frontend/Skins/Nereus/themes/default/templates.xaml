            <StackPanel IsVisible="{Binding HasNoArtwork}" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="8" Margin="10,0">
              <Path Data="{Binding FallbackIcon, Converter={x:Static views:SkinIconGeometryConverter.Instance}}"
                    Fill="{DynamicResource TextBrush}" Width="46" Height="46" Opacity="0.55" Stretch="Uniform"
                    HorizontalAlignment="Center"/>
