<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MediaPortal.Frontend.ViewModels"
        xmlns:api="using:MediaPortal.Frontend.Api"
        x:Class="MediaPortal.Frontend.Views.NetworkCredentialsView"
        x:DataType="vm:NetworkCredentialsViewModel"
        Name="networkCredentials"
        Background="{DynamicResource ScreenBackgroundBrush}"
        >

  <!--
    What the server offers to the network's shares. The dictionary of paths on the left exactly as the
    provider keeps it, the editor on the right: the path (empty means the provider's root, the reference's
    one and only slot), the user, an optional domain, and a password box that starts empty every time - a
    stored password never travels to this side. Every press writes to the server right there and the status
    line says what came back.
  -->

  <DockPanel Margin="48,14">

    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,8">
      <TextBlock Text="{Binding Heading}"
                 FontSize="24"
                 FontWeight="SemiBold" />
      <TextBlock Text="{Binding Subtitle}"
                 FontSize="14"
                 Opacity="0.7"
                 TextWrapping="Wrap"
                 MaxWidth="1500"
                 HorizontalAlignment="Left" />
    </StackPanel>

    <TextBlock DockPanel.Dock="Bottom"
               Name="statusLine"
               Text="{Binding Status}"
               FontSize="14"
               Opacity="0.85"
               Margin="0,8,0,0"
               TextWrapping="Wrap" />

    <Grid ColumnDefinitions="520,*" ColumnSpacing="30">

      <DockPanel>
        <Button DockPanel.Dock="Bottom"
                Name="reloadButton"
                Content="Read the list again"
                Command="{Binding LoadCommand}"
                FontSize="16"
                Focusable="True"
                HorizontalAlignment="Left"
                Margin="0,10,0,0" />

        <ListBox Name="credentialsList"
                 Focusable="True"
                 ItemsSource="{Binding Credentials}"
                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                 FontSize="18">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="api:NetworkCredentialInfo">
              <TextBlock Text="{Binding Label}"
                         FontSize="17"
                         Margin="2,6"
                         TextWrapping="Wrap" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Top">

        <Grid ColumnDefinitions="200,360" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4,0,4">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Share path" FontSize="16" VerticalAlignment="Center" Margin="0,6" />
          <TextBox Grid.Row="0" Grid.Column="1"
                   Name="pathBox"
                   Text="{Binding PathText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Watermark="empty means the server's root"
                   FontSize="16"
                   Focusable="True"
                   Padding="10,4"
                   Margin="0,4" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="User name" FontSize="16" VerticalAlignment="Center" Margin="0,6" />
          <TextBox Grid.Row="1" Grid.Column="1"
                   Name="userBox"
                   Text="{Binding UserText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   FontSize="16"
                   Focusable="True"
                   Padding="10,4"
                   Margin="0,4" />
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Domain" FontSize="16" VerticalAlignment="Center" Margin="0,6" />
          <TextBox Grid.Row="2" Grid.Column="1"
                   Name="domainBox"
                   Text="{Binding DomainText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   FontSize="16"
                   Focusable="True"
                   Padding="10,4"
                   Margin="0,4" />
          <TextBlock Grid.Row="3" Grid.Column="0" Text="New password" FontSize="16" VerticalAlignment="Center" Margin="0,6" />
          <TextBox Grid.Row="3" Grid.Column="1"
                   Name="passwordBox"
                   Text="{Binding PasswordText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   FontSize="16"
                   Focusable="True"
                   UseMask="True"
                   RevealPassword="True"
                   Padding="10,4"
                   Margin="0,4" />
        </Grid>

        <TextBlock Text="{Binding SelectionSays}"
                   FontSize="14"
                   Opacity="0.6"
                   TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,8,0,0">
          <Button Name="storeButton"
                  Content="Store this credential"
                  Command="{Binding StoreCommand}"
                  FontSize="16"
                  Focusable="True"
                  Padding="18,8" />
          <Button Name="removeButton"
                  Content="Remove this entry"
                  Command="{Binding RemoveSelectedCommand}"
                  IsEnabled="{Binding HasSelection}"
                  FontSize="16"
                  Focusable="True"
                  Padding="18,8" />
          <Button Name="removeAllButton"
                  Content="Remove every entry"
                  Command="{Binding RemoveAllCommand}"
                  FontSize="16"
                  Focusable="True"
                  Padding="18,8" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </DockPanel>
</UserControl>
