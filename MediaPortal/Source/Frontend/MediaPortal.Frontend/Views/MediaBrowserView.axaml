<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MediaPortal.Frontend.ViewModels"
        xmlns:theming="using:MediaPortal.Frontend.Theming"
        xmlns:views="using:MediaPortal.Frontend.Views"
        xmlns:lg="using:LiquidGlassAvaloniaUI"
        x:Class="MediaPortal.Frontend.Views.MediaBrowserView"
        x:DataType="vm:MediaBrowserViewModel"
        Name="browser"
        Background="Transparent"
        >

  <!--
    THE LIBRARY SCREEN AS NEREUS LAID IT OUT

    Everything here is a translation of two reference files: <c>master_bare_media.xaml</c> (the room: a hundred
    points of head, the shelf in the middle, two hundred and sixty points of floor) and
    <c>master_mediamenu.xaml</c> (the way a screen's own menu is hung into that room). What those two files say,
    and what is therefore done here:

    - The whole content is one grid shifted two hundred points off the left edge (ClientGrid Margin
      "-200,0,0,-200", columns "200,*"), and the menu panel stands in the two hundred points that are off the
      screen. Opening the menu does not show anything - it slides the content two hundred points to the right and
      the menu walks into the space that used to be off the screen, which is why the menu never covers the shelf.
    - Covers are the exception: their menu hangs under the screen (rows "*,200" with the panel in the second row,
      pushed two hundred points down) and slides up, because a row of covers has nothing to the left of it that a
      rail could stand in.
    - The details are a wide column beside the shelf, drawn on a translucent ground with the title's fanart
      behind it; only covers put their details above their own row instead, centred on a horizontal gradient.
    - Where the details are not beside the shelf, its bottom edge carries the home strip: the title, the studio's
      sentence, the plot and the facts, over the fanart.
    - A hundred points of gradient fall from the top edge and rise from the bottom, so that whatever the shelf
      stands on stays readable.
  -->
  <UserControl.Resources>

    <!-- One row of the shelf, the way this screen is written: picture, mark, name, state. -->
    <DataTemplate x:Key="BuiltinRowsTemplate" x:DataType="vm:TitleViewModel">
      <Panel>
        <!--
          The ground the reference laid under the row it was standing on (ButtonListViewControlStyle in
          Buttons.xaml): the medium of the skin's colour over the whole row, a bar of the light of it eight
          points wide along the left edge, a shadow of a tenth of a point hanging below so that the row lifts
          off the shelf, and a whisper of white at the right edge.  It stands under the row and not around it -
          Nereus never drew a box the height of one row's text, and it never drew the accent as a rectangle a
          name sits inside.  The skin's styles decide when it is visible; nothing here decides.
        -->
        <Panel Classes="nereus-row-ground" IsVisible="False" IsHitTestVisible="False">
          <Border Background="{DynamicResource PanelRaisedBrush}"/>
          <Border Width="8" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}"/>
          <Border Height="10" VerticalAlignment="Bottom" Margin="0,0,0,-10">
            <Border.Background>
              <!--  Bare numbers in StartPoint/EndPoint are pixels for Avalonia, not the fractions WPF
                    reads from them; only '%' says "of the panel".  -->
              <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                <GradientStop Color="#66000000" Offset="0"/>
                <GradientStop Color="#00000000" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <Border Width="14" HorizontalAlignment="Right">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                <GradientStop Color="#80000000" Offset="0"/>
                <GradientStop Color="#00000000" Offset="0.02"/>
                <GradientStop Color="#00000000" Offset="0.5"/>
                <GradientStop Color="#26FFFFFF" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>
        </Panel>
        <Grid ColumnDefinitions="Auto,Auto,5*,1.4*" ColumnSpacing="20" MinWidth="700" Margin="30,8">
        <!--
          The title's picture, in the column MP2's own shelves put it: first, so that the eye runs down a
          column of pictures rather than past the names to find out what a row is. The box behind the image
          is what a viewer sees when the library has no picture for a title, which is most of them; it is
          drawn as a fixed square so that a shelf of titles with art and one without line up identically,
          and the image is laid over it rather than swapped for it because a poster that arrives a moment
          after the row should not move the row.
        -->
        <Panel Width="64" Height="64">
          <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" />
          <Image Source="{Binding Artwork, Converter={x:Static views:ArtworkConverter.Instance}, ConverterParameter=tile}"
                 Stretch="Uniform"
                 Width="64"
                 Height="64" />
        </Panel>
        <!--
          The tick in front of a title the library was told was watched. It is a column of its own rather
          than a character glued to the name so that the names of marked and unmarked rows start at the same
          x, which is what lets a viewer scan a shelf by eye; the reserved width says nothing about a row,
          only the mark does.
        -->
        <TextBlock Grid.Column="1"
                   Text="{Binding SeenMark}"
                   MinWidth="34"
                   Opacity="0.55" />
        <TextBlock Grid.Column="2" Text="{Binding Line}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="3"
                   Text="{Binding Detail}"
                   HorizontalAlignment="Right"
                   Opacity="0.65"
                   TextTrimming="CharacterEllipsis" />
        </Grid>
      </Panel>
    </DataTemplate>

    <!--
      A tile for a skin that draws none: the poster standing in its frame with the name under it, the watched
      corner obeying the layout's flag like the skin tiles do. Narrow enough that a full-hd shelf lays four
      across, which is what the reference's grid laid.
    -->
    <DataTemplate x:Key="BuiltinTilesTemplate" x:DataType="vm:TitleViewModel">
      <Border Width="232"
              Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource OutlineBrush}"
              BorderThickness="1"
              Padding="10"
              Margin="8">
        <StackPanel Spacing="7">
          <Panel Width="208" Height="300">
            <Border Background="{DynamicResource ScreenBackgroundBrush}" />
            <Image Source="{Binding Artwork, Converter={x:Static views:ArtworkConverter.Instance}, ConverterParameter=tile}" Stretch="Uniform" />
          </Panel>
          <TextBlock Text="{Binding SeenMark}"
                     IsVisible="{Binding WatchFlagsShown}"
                     HorizontalAlignment="Center"
                     Opacity="0.8" />
          <TextBlock Text="{Binding Line}"
                     FontSize="18"
                     TextAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     TextWrapping="Wrap"
                     MaxHeight="48" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- A cover for a skin that draws none: the same poster one step larger and the name larger with it,
         which is the difference the reference drew between its grid tile and its cover. -->
    <DataTemplate x:Key="BuiltinCoversTemplate" x:DataType="vm:TitleViewModel">
      <Border Width="300"
              Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource OutlineBrush}"
              BorderThickness="1"
              Padding="12"
              Margin="10">
        <StackPanel Spacing="9">
          <Panel Width="272" Height="392">
            <Border Background="{DynamicResource ScreenBackgroundBrush}" />
            <Image Source="{Binding Artwork, Converter={x:Static views:ArtworkConverter.Instance}, ConverterParameter=tile}" Stretch="Uniform" />
          </Panel>
          <TextBlock Text="{Binding SeenMark}"
                     IsVisible="{Binding WatchFlagsShown}"
                     HorizontalAlignment="Center"
                     Opacity="0.8" />
          <TextBlock Text="{Binding Line}"
                     FontSize="22"
                     TextAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     TextWrapping="Wrap"
                     MaxHeight="60" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!--
      A row of the screen's own menu. It wears the shortcut tile's GLASS: the same liquid surface the home
      shortcuts lens the wall through, the same veil over it, the same ring over the seam, and the name on the
      glass with a shadow instead of a plate - because the rail's rows and the shortcut's squares answer the
      same question ("which way now?"), and a menu that dresses differently from the wall it slides out of
      reads as a second program. Every number on the surface is the shortcut's own, written where the shortcut
      writes it (HomeView); the glass bends the ground and the fanart standing behind this screen, which is
      what it does to the wallpaper on the home.

      Two deviations from the shortcut tile remain on purpose. The picture is no PNG: a command's icon is a
      shape out of the skin's vector catalog, painted in the text's own colour, dressed the way the rail's
      icons were asked for - four tenths at rest, full white and the corner button's glow under a viewer. And
      the white bar at the tile's left edge - the very bar the main menu gives its selected tile - marks the
      row that is the screen's answer already.
    -->
    <DataTemplate x:Key="MediaMenuTile" x:DataType="vm:MediaBrowserMenuEntry">
      <Border Classes="home-tile-shadow"
              Margin="6"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              lg:LiquidGlassBackdrop.IsExcludedFromCapture="True">
        <Panel>
          <!-- Transparent ground under the glass, which is what the shortcut tile's Button carries too: a
               plate painted under a lens is a plate a viewer sees, not a glass - the class is kept here for
               its corner, and the plate it paints from the skin styles is laid aside. -->
          <Border Classes="nereus-menu-tile" Background="Transparent" ClipToBounds="True" Width="145" Height="145">
            <Panel>
              <!-- One glass, and it is liquid glass: the shortcut's lens, at the shortcut's numbers. Clipped
                   by hand for the shortcut's own reason - the library turns clipping off in the surface's
                   statics, and a rail of ten unclipped lenses came out as one plate. -->
              <lg:LiquidGlassSurface ClipToBounds="True"
                                     CornerRadius="10"
                                     BlurRadius="10"
                                     Vibrancy="1.15"
                                     SurfaceColor="#33030810"
                                     RefractionHeight="20"
                                     RefractionAmount="45"
                                     DepthEffect="True"
                                     ChromaticAberration="True"
                                     HighlightWidth="0.5"
                                     HighlightOpacity="0.2"
                                     ShadowEnabled="False"/>
              <!-- The veil of the glass, above the lens it veils. -->
              <Border Classes="home-shortcut-tint"/>
              <!-- The command's shape, asked of the worn skin's vectors the way a shortcut asks for its
                   picture, at the size the rail was asked to carry - thirty-two hundredths of the tile,
                   lifted off the name the way the shortcut lifts its glyph. -->
              <Path Classes="media-menu-icon"
                    Data="{Binding Icon, Converter={x:Static views:SkinIconGeometryConverter.Instance},
                                   ConverterParameter='MediaMenu/{0}'}"
                    Fill="{DynamicResource TextBrush}"
                    Width="46"
                    Height="46"
                    Stretch="Uniform"
                    Margin="0,0,0,19"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
              <!-- The name, on the glass and not on a band of its own - the shortcut's own answer: a shadow
                   instead of a plate, so it reads over the frost without covering any of it. -->
              <TextBlock Classes="home-shortcut-caption"
                         Text="{Binding Label}"
                         TextTrimming="CharacterEllipsis"/>
              <!-- The bar of the row that is what the screen answers already - the grid in a list of
                   layouts, the year in a list of orders - worn as the main menu wears it on its selected
                   tile: five of white down the tile's left edge. -->
              <Rectangle Fill="White"
                         Width="4"
                         HorizontalAlignment="Left"
                         IsVisible="{Binding IsCurrent}"/>
            </Panel>
          </Border>
          <!-- The resting ghost ring, exactly as the shortcut tiles and the wall's covers wear it. -->
          <Border Classes="home-tile-edge" IsHitTestVisible="False"/>
        </Panel>
      </Border>
    </DataTemplate>

    <!--
      One pair of what is known about a title: the answer, and the word under it, exactly as the reference's
      detail panels wrote it (MediaItemListDetails.inc:109 - the answer first, the word under it in the smaller
      size and at four tenths of its light). A pair is only ever in this list when the library knows the answer,
      so the word never stands over an empty space.
    -->
    <DataTemplate x:Key="MediaFactTemplate" x:DataType="vm:MediaBrowserFact">
      <StackPanel Spacing="2" Margin="0,0,26,10">
        <TextBlock Text="{Binding Value}"
                   FontSize="22"
                   Foreground="{DynamicResource TextBrush}"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding Label}"
                   FontSize="15"
                   Foreground="{DynamicResource TextBrush}"
                   Opacity="0.4"/>
      </StackPanel>
    </DataTemplate>

    <!-- A person of the title, as both people bands draw it.  The face fills the whole tile the way a cover's
      poster fills its place on the wall, and the name stands in front of the black veil at the picture's foot:
      the same veil the home screen's news pictures wear (HomeView.axaml:627-633), whose one job is to keep the
      words readable on whatever the photograph behind them happens to be.

      The photograph is cut by a second, inner face and not by the card itself, because a shadow cannot live on a
      clipped edge - the outer border casts the tile's shadow, which has to fall OUTSIDE its own edges, while the
      inner face is what stops the picture spilling over the rounded corner.  The wall's tiles are built in
      exactly these two surfaces for exactly this reason (HomeView.axaml:753-756, with the face at
      styles.xaml:505).  Where the library holds no portrait, the skin's own person figure - the vector its media
      menu wears for an actor - stands in the MIDDLE of the face, at the size a glyph of this front end is written
      and at the menu glyph's quietness, and not blown over the whole face the way the skin's standing bitmap used
      to be: a card without a picture says that it has no picture, which is a different thing from saying it louder
      than the name it carries.  The name keeps its veil either way, so a card is never a wordless rectangle.

      The veil lies OUTSIDE that clipped face, over it, and not among the pictures inside it.  A face is one
      hundred and fifty-four design lines tall, which at this screen's scale ends between two device pixels, so a
      veil cut by the face was painted on its last line only by a third - the picture shone through that line as a
      bright hairline across the foot of every card (measured on 2026-11-09: one row of #515151 between the veil's
      #272727 above and the plate's #222222 below).  Lying outside the clip, the veil reaches the plate instead of
      the clip, and a hairline of its own darkening over a dark plate asks for nothing.  It therefore has to carry
      the face's corner itself - a veil that lies outside a clip is cut by nothing, so the rounding it shows is the
      rounding it asks for, and a square one here darkened the two corners the face had left in the open. -->
    <DataTemplate x:Key="PersonCardTile" x:DataType="vm:PersonCard">
      <Border Classes="trackcard person-card home-tile-shadow"
              Focusable="True"
              Width="150"
              Height="160"
              Margin="0,0,8,0">
        <Panel>
          <Border Classes="person-face" ClipToBounds="True">
            <Panel>
              <Image Source="{Binding Portrait,
                                      Converter={x:Static views:ArtworkConverter.Instance},
                                      ConverterParameter=tile}"
                     Stretch="UniformToFill"
                     IsVisible="{Binding ShowsPortrait}"
                     IsHitTestVisible="False"/>
              <Path Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                                    ConverterParameter='MediaMenu/actor'}"
                    Fill="{DynamicResource TextBrush}"
                    Opacity="0.4"
                    Width="64"
                    Height="64"
                    Stretch="Uniform"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding !ShowsPortrait}"
                    IsHitTestVisible="False"/>
            </Panel>
          </Border>
          <Border Classes="person-veil" IsHitTestVisible="False"/>
          <TextBlock Text="{Binding Name}"
                     FontSize="15"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     MaxLines="2"
                     TextTrimming="CharacterEllipsis"
                     Margin="8,0,8,8"
                     VerticalAlignment="Bottom"
                     Foreground="{DynamicResource TextBrush}"/>
        </Panel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <!--
    The styles both halves of the screen's menu wear. They are here and not in the worn skin's styles for the
    reason the tile template gives: this menu is the screen's own, no skin was ever written for it, and a menu
    whose plate and band came from skin styles would be invisible on a machine wearing no skin. What they do is
    what the reference's MediaMenuListViewStyle and its item container did, and nothing more:

    - the platform's selection plate, its focus rectangle and its padding are taken away, down to the item's own
      template, so that neither the row a viewer stands on nor the row the pointer rests on can grow a border of
      the toolkit's own (the same reason the skin's rail gives at styles.xaml:135 - the part is deliberately not
      named PART_ContentPresenter, because the platform's theme styles are aimed at that name);
    - the command's shape goes from three quarters of its light to whole, and grows a tenth, under a viewer
      or a pointer - the very answer the skin's shortcut art gives its tile, so the rail and the wall agree.
  -->
  <UserControl.Styles>
    <Style Selector="ListBox.media-menu">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="ListBox.media-menu ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
      <Setter Property="ClipToBounds" Value="False"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="mediaMenuPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </ControlTemplate>
      </Setter>
    </Style>
    <!-- The command's shape, dressed the way the face dresses its corner lights: four-tenths while the tile
         waits, and on the row a viewer stands on it comes to full white with the top bar's glow - the same
         white DropShadow the four corner buttons light their glyphs with (styles.xaml's nereus-corner-button),
         and it fits here because the glyph sits a good deal farther from the tile's edge than the blur spreads.
         The pointer lights the mark only when a hand is really on it, which is the corner buttons' guard too. -->
    <!-- The rail took a sixth off its tiles, and the name on the glass comes along: thirteen points where the
         shortcut's own caption keeps fifteen, so the word stays in proportion with the forty-six-point mark
         above it. Only here; the home's shortcuts wear their own size untouched. -->
    <Style Selector="ListBox.media-menu TextBlock.home-shortcut-caption">
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="ListBox.media-menu ListBoxItem Path.media-menu-icon">
      <Setter Property="Opacity" Value="0.4"/>
      <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
      <Setter Property="RenderTransform" Value="scale(1)"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBox.media-menu ListBoxItem:selected Path.media-menu-icon,
                    ListBox.media-menu ListBoxItem:focus Path.media-menu-icon,
                    Window:not(.pointer-resting) ListBox.media-menu ListBoxItem:pointerover Path.media-menu-icon">
      <Setter Property="Opacity" Value="1"/>
      <Setter Property="Effect">
        <DropShadowEffect BlurRadius="16" Color="#FFFFFFFF" OffsetX="0" OffsetY="0" Opacity="1"/>
      </Setter>
    </Style>
    <Style Selector="ListBox.media-menu ListBoxItem:selected:focus Path.media-menu-icon,
                    ListBox.media-menu ListBoxItem:selected:pointerover Path.media-menu-icon">
      <Setter Property="RenderTransform" Value="scale(1.06)"/>
    </Style>
    <!-- What standing on the rail's glass does - the shortcut's own answer, at the shortcut's numbers: the
         veil lightens, the ring comes up to full light, and the name stands at whole white. The rail wears
         the skin's shortcut classes, but the shortcut's state rules are written against the shortcut's
         Button, and these tiles stand in a list; the same four stops are therefore said here for the rail. -->
    <Style Selector="ListBox.media-menu ListBoxItem:selected Border.home-shortcut-tint,
                    ListBox.media-menu ListBoxItem:focus Border.home-shortcut-tint,
                    Window:not(.pointer-resting) ListBox.media-menu ListBoxItem:pointerover Border.home-shortcut-tint">
      <Setter Property="Opacity" Value="1"/>
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0" Color="#66FFFFFF"/>
          <GradientStop Offset="0.3" Color="#40FFFFFF"/>
          <GradientStop Offset="0.7" Color="#33141C26"/>
          <GradientStop Offset="1" Color="#4D0C1218"/>
        </LinearGradientBrush>
      </Setter>
    </Style>
    <Style Selector="ListBox.media-menu ListBoxItem:selected Border.home-tile-edge,
                    ListBox.media-menu ListBoxItem:focus Border.home-tile-edge,
                    Window:not(.pointer-resting) ListBox.media-menu ListBoxItem:pointerover Border.home-tile-edge">
      <Setter Property="BorderBrush">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0" Color="#FFFFFFFF"/>
          <GradientStop Offset="0.35" Color="#B3FFFFFF"/>
          <GradientStop Offset="0.72" Color="#66FFFFFF"/>
          <GradientStop Offset="1" Color="#CCFFFFFF"/>
        </LinearGradientBrush>
      </Setter>
    </Style>
    <Style Selector="ListBox.media-menu ListBoxItem:selected TextBlock.home-shortcut-caption,
                    ListBox.media-menu ListBoxItem:focus TextBlock.home-shortcut-caption,
                    Window:not(.pointer-resting) ListBox.media-menu ListBoxItem:pointerover TextBlock.home-shortcut-caption">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <!--
      One plaque for every answer the details row wears as a picture, so that the row's boxes are one and the
      same box: the subtitle glyph, the 3D logo, the codec, the size and the proportion's glyph all stand in a
      plaque of the same height, and a figure the worn skin carries no picture of stands in the very same plaque
      written in words.  A height is written here rather than padding, because padding lets every picture decide
      the size of its own box - which is what made the row's boxes differ by a dozen lines.
    -->
    <Style Selector="Border.details-logo">
      <Setter Property="Background" Value="#33FFFFFF"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- The cards of the two track bands, and the ring one of them wears once the caret stands on it.  A track
         card is looked at rather than chosen - nothing is ever "played" by standing on it - but the caret still
         belongs on the card itself and not on the band around it: the question a viewer asks is " WHICH track",
         and a ring around five cards answers nothing.  The ring is the white the viewer asked the focus to wear
         everywhere (2026-11-02); the arrows walk from card to card and the band slides along by itself. -->
    <Style Selector="Border.trackcard">
      <Setter Property="BorderThickness" Value="3"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Border.trackcard:focus">
      <Setter Property="BorderBrush" Value="#FFFFFFFF"/>
    </Style>

    <!-- A person's card.  Its ground is the dark plate a cover without a picture stands on at the wall
         (#222222, HomeView.axaml:781-785 - the worn skin's own plate, frosted by nothing), and the ring it grows
         under a caret is the ring every other card of this reading already wears, from Border.trackcard above.

         The inner face carries the corner the photograph is cut to: the ten points of rounding the tile wears
         (styles.xaml:505-507), less the three points of ring that lie over it, so the picture's corner runs
         under the ring instead of butting against it.

         The veil is the home screen's news veil (HomeView.axaml:627-633) with its darkening pulled down to the
         foot of a much smaller tile: over a hundred and sixty lines a veil that starts darkening at a third of
         the height would grey the whole face, so it starts below the middle. -->
    <Style Selector="Border.person-card">
      <Setter Property="Background" Value="#222222"/>
    </Style>
    <Style Selector="Border.person-face">
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Background" Value="#222222"/>
    </Style>
    <Style Selector="Border.person-veil">
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0.45" Color="#00000000"/>
          <GradientStop Offset="0.72" Color="#8C000000"/>
          <GradientStop Offset="1.00" Color="#D9000000"/>
        </LinearGradientBrush>
      </Setter>
    </Style>
  </UserControl.Styles>
  <!--
    The ground the whole screen stands on, in the one arrangement the worn skin uses everywhere and therefore
    on the home screen too: this skin's Background.PNG fills the screen, and the highlighted title's fanart
    lies over it wearing the skin setting's opacity as its OWN opacity - so the setting dims the fanart towards
    the ground instead of dropping a black veil over everything, and a screen whose titles carry no fanart was
    always only ever the ground. Whether there is a fanart at all is the skin setting's answer, not this file's.
  -->
  <Panel>

    <Image Source="{Binding Converter={x:Static views:SkinImageConverter.Instance}, ConverterParameter=Background.PNG}"
           Stretch="Fill"/>
    <views:DissolveImage Stretch="UniformToFill"
           Opacity="{Binding FanartOverlay}"
           IsVisible="{Binding HasBackgroundArtwork}">
      <views:DissolveImage.Source>
        <MultiBinding Converter="{x:Static views:SkinFanartConverter.Instance}">
          <Binding Path="BackgroundArtwork"/>
          <Binding Path="FanartBlurRadius"/>
        </MultiBinding>
      </views:DissolveImage.Source>
    </views:DissolveImage>

    <!--
      THE TWO BANDS AT THE EDGES.  Nothing but paint, and it stands between the picture and everything the screen
      has to say: the ground and the fanart are darkened at the top and bottom edges, the wall, the menu and the
      details column are laid over them untouched.

      This is not an invention of this front end.  The reference's own media master hung exactly these two controls
      over its layout (master_bare_media.xaml:69-73, TopGradient in the head row and BottomGradient in the floor
      row, both drawn from TopGradient_Template and BottomGradient_Template), and those templates carry the seven
      stops that the home's bands carry too - the same brush read from the top edge down and from the bottom edge
      up.  The depths are what that master's rows measured: a hundred points of head, two hundred and sixty of
      floor.  IsHitTestVisible="False" on the panel, so that a band which only paints can never stand between a
      pointer and a tile.
    -->
    <Panel IsHitTestVisible="False">
      <Border VerticalAlignment="Top" Height="100" HorizontalAlignment="Stretch">
        <Border.Background>
          <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
            <GradientStop Color="#E6000000" Offset="0"/>
            <GradientStop Color="#78000000" Offset="0.3"/>
            <GradientStop Color="#46000000" Offset="0.45"/>
            <GradientStop Color="#21000000" Offset="0.6"/>
            <GradientStop Color="#0C000000" Offset="0.75"/>
            <GradientStop Color="#01000000" Offset="0.87"/>
            <GradientStop Color="#00000000" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Border VerticalAlignment="Bottom" Height="260" HorizontalAlignment="Stretch">
        <Border.Background>
          <LinearGradientBrush StartPoint="50%,100%" EndPoint="50%,0%">
            <GradientStop Color="#E6000000" Offset="0"/>
            <GradientStop Color="#78000000" Offset="0.3"/>
            <GradientStop Color="#46000000" Offset="0.45"/>
            <GradientStop Color="#21000000" Offset="0.6"/>
            <GradientStop Color="#0C000000" Offset="0.75"/>
            <GradientStop Color="#01000000" Offset="0.87"/>
            <GradientStop Color="#00000000" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>
    </Panel>

    <!--
      THE ROOM. Two hundred points of its left edge and two hundred of its bottom are off the screen: that is
      where the two menus stand while they are shut (master_mediamenu.xaml:124-186). The code behind moves this
      panel right by the two hundred points of the rail or up by the two hundred points of the floor, which is
      the whole of the reference's opening animation - the menu does not appear, the room makes room for it.

      Nothing here clips. The menus' pictures (MenuGlow, MenuGlowBottom) are made to spill past the edge of the
      panel they stand in, and the details column is laid with negative margins so that its ground reaches the
      very top and bottom edges of the window behind the shelf.
    -->
    <Grid Name="room"
          Margin="-200,0,0,-200"
          ColumnDefinitions="200,*"
          RowDefinitions="*,200"
          ClipToBounds="False">
      <Grid.RenderTransform>
        <!--
          The transform the screen's menu slides the room along, and the two transitions that make the sliding:
          the reference animated exactly this transform on exactly these two axes with two storyboards of three
          hundred and fifty milliseconds each (Animations.xaml:8-38, aimed at ClientGrid's TranslateTransform), so
          the sliding here is declared the same way rather than driven from a timer of the front end's own. That
          is not a preference: a dispatcher timer of one's own ticks on a window that is really being drawn and
          nowhere else - neither in a test queue that is pumped by hand nor in the render probe, which is headless
          - so a slide built on one is a slide that nobody but a television has ever seen arrive, while a
          transition is the same mechanism the worn skin's own tile glow and the home wall's scrolling move on.
          What a test and a probe read is the value the room was told to stand at; what happens between the old
          value and that one belongs to the transition, exactly as it belonged to the storyboard there.
        -->
        <TranslateTransform X="0" Y="0">
          <TranslateTransform.Transitions>
            <Transitions>
              <DoubleTransition Property="X" Duration="00:00:00.35"/>
              <DoubleTransition Property="Y" Duration="00:00:00.35"/>
            </Transitions>
          </TranslateTransform.Transitions>
        </TranslateTransform>
      </Grid.RenderTransform>

      <!--
        What the two hundred off-screen points to the left hold: the screen's menu, for grid and list. Its top
        edge starts below the head band (the reference's rail began where its master's head band ended), and it
        runs past the bottom edge so that the glow along its right edge has ground to stand on; the glow itself is
        lifted off the bottom by the two hundred points of the floor band, exactly as the reference's was.
      -->
      <Panel Name="sideMenu"
             Grid.RowSpan="2"
             Grid.Column="0"
             Margin="0,90,0,0"
             ClipToBounds="False"
             IsVisible="{Binding !IsCoverLayout}">
        <!-- The ground. The reference laid a black rectangle at nine tenths over the whole panel and the glow
             picture along its right edge, so that the rail does not end at a line but pales into the shelf. -->
        <!--border Background="Black" Opacity="0.9"/-->

        <DockPanel Margin="10,0,0,0">
          <!-- Every row of the screen's menu. The list is the reference's ListView with MediaMenuListViewStyle
               on it; the styles that dress it are with the other menu styles above, for both halves. It is docked
               rather than stacked so that the list is measured against the height that is left and can scroll a
               menu longer than the rail.  The panel is a plain stack and not the toolkit's virtualizing one:
               the rail never carries more than eight rows, and the virtualizing panel - measured against the
               collapsed height a closing animation leaves behind while the room slides - realized a single row
               and left the rows below it as empty plates until a key press woke the list up.

               The bottom margin is the two hundred points of the floor band: the rail's ground runs past the
               window's bottom edge on purpose (the glow stands on it), but the LIST is measured to the bottom
               edge a viewer can see, so a menu longer than the rail scrolls the way the home's main menu
               scrolls its tiles - under the wheel, and after the caret walks onto a row that stood below.
               The heading left the top of this panel for the line at the room's foot below, which stands
               where the home says its media line. -->
          <ListBox Name="mediaMenuList"
                   Classes="media-menu"
                   ItemsSource="{Binding MediaMenu}"
                   ItemTemplate="{StaticResource MediaMenuTile}"
                   Margin="0,14,0,200"
                   Focusable="True"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Hidden">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical"/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>
        </DockPanel>
      </Panel>

      <!--
        What the two hundred off-screen points at the bottom hold: the same menu, for covers. Its row IS the two
        hundred points below the window's bottom edge, so the panel only has to fill the row - the reference's
        panel needed a two hundred and fifty point shove because its row stood in the master's floor band, which
        this room has no floor band to be.
      -->
      <Panel Name="bottomMenu"
             Grid.Row="1"
             Grid.ColumnSpan="2"
             ClipToBounds="False"
             IsVisible="{Binding IsCoverLayout}">
        <Border Background="Black" Opacity="0.9" Margin="200,10,0,-10"/>
        <Image Source="{Binding Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter=MenuGlowBottom}"
               Height="270"
               VerticalAlignment="Top"
               Margin="230,-28,30,-30"
               IsHitTestVisible="False"/>
        <Image Source="{Binding Converter={x:Static views:SkinImageConverter.Instance},
                                ConverterParameter=BottomMenuIndicator}"
               Width="50"
               Height="25"
               Opacity="0.9"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               Margin="230,-15,30,0"
               IsHitTestVisible="False"/>
        <!-- The same rows, laid sideways. The reference's cover menu is its one list in its one style with the
             panel turned; the left margin is the two hundred points that are off the screen while the menu is
             shut, so that the row of plates stands centred on what a viewer can actually see. -->
        <ListBox Name="mediaMenuListBottom"
                 Classes="media-menu"
                 ItemsSource="{Binding MediaMenu}"
                 ItemTemplate="{StaticResource MediaMenuTile}"
                 Margin="200,14,0,0"
                 Focusable="True"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 ScrollViewer.HorizontalScrollBarVisibility="Hidden">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
      </Panel>

      <!--
        THE CONTENT, which the reference called the ContentPanel: the shelf and whatever is laid beside it. It
        stands in the second column and the first row, which together are the part of the room on the screen while
        the menus are shut; when a menu opens, this is the thing that moves.
      -->
      <Panel Name="contentPanel"
             Grid.Row="0"
             Grid.Column="1"
             Margin="10,0,10,10">
        <!--
          The shelf and the details column, measured against each other in proportions rather than in points. The
          reference could afford to hand its details column a thousand fixed points because its screens were
          televisions of a known width; this front end is stood on desktop windows of every shape too, and a
          details column that keeps its thousand points on a small window leaves the shelf a gutter to lay its
          tiles in. At the width the reference drew for - nineteen hundred and twenty - the two columns come out at
          the eight hundred and sixty points of shelf and the thousand of details that file had, because these two
          numbers are that split.
        -->
        <Grid Name="contentGrid" ColumnDefinitions="45,55" ColumnSpacing="0" ClipToBounds="False">

          <!--
            The way out of a reading. The reference's media information was a screen pushed over the list, so its
            Back left the screen; here the reading is a state of this one screen, and with the wall away there is
            nothing left on this side of the window to hold the caret. The caret comes to this button instead, and
            Escape and the back key answer the reading the same way from the keyboard (MediaBrowserView's key
            chain asks the reading before it asks the menus and the screen).
          -->
          <Panel Grid.Column="0" ClipToBounds="False" IsVisible="{Binding InfoShown}">
            <!--
              WHAT THE FILE CARRIES, stood on this side of the window, which is where the reference stood it.  Its
              information screen is a grid of two columns - the words in a thousand points at the right, and
              everything else in the column that is left of them (MediaInfoVideo.xaml:85-89 for the two columns,
              with the details field named Grid.Column="1" at :92).  Into that left column it put four bands under
              one another, in this order and with these measures (MediaInfoVideo.xaml:296-459, the band grid at
              :296): audio tracks, subtitle tracks, actors, director - each one a header of forty lines with a
              twenty seven point picture and a word at half light (the audio header at :326-333, the subtitle
              header at :364-371), and under the header a band of one hundred and seventy five lines carrying a
              row of cards that runs sideways (the two list styles at
              themes/default/styles/CurrentlyPlayingStyles.xaml:304-346, an horizontal stack of three hundred point
              cards, :45-120 for the audio card and :126-192 for the subtitle one).

              Two things are said here rather than left to be found.  The cards wear the reference's own pictures -
              the flag of a language, the loudspeaker of a channel count, the logo of a codec, the frame a format
              stands in - out of the same logo folders the old skin shipped, which this skin carries now too under
              MediaLogos\ (MediaStreamLogos asks for them by name, the view spells the folder); only where the skin
              carries no picture of a name does a corner write its figure in words.  And the caret stands on a card
              rather than on the band around it - the question a viewer asks in front of a track is WHICH track, so
              the arrows walk the cards and the band slides along with the caret, which is what a scroller does when
              the thing it holds walks out of sight.  The cards wear the skin's shared Border.home-tile-shadow, and
              the band gives that shadow the room it needs outside the card - which is what the band's padding is
              for, and not for looks: the shadow the shared class paints stands nineteen points right of a card,
              twenty below it, thirteen left of it and twelve above it, while the band clips at its own bounds (a
              band that did not clip let a scrolled card paint itself across the rest of the screen).  Measured the
              first version of this had the band at one hundred and ninety five lines and the items panel clipping
              at the exact height of a card, which cut the shadow off above and below and left the cards sitting
              flat on the page - a test measures it now
              (TestMediaBrowser.TheShadowOfATrackCardIsNotCutByTheBandItStandsIn), because a cut shadow is exactly
              what a headless picture cannot show.

              The room the shadow asks for is ALL the room a band takes, and that is the whole of the distance a
              header stands above its cards: twenty four points of air at either end, fifteen above a card and
              twenty three below it, which makes a band of one hundred and ninety three lines around a card of a
              hundred and fifty five (and one hundred and ninety eight around a person's card of a hundred and
              sixty).  Thirty above and thirty below it stood until 2026-11-02, which set the header's word forty
              three lines above the cards it names - the viewer called that far too much and asked for a third of
              it, so the header's row keeps no height of its own, stands hard against the band, and everything
              between the word and the cards is the shadow's own air and nothing else.
            -->
            <StackPanel VerticalAlignment="Top"
                        Margin="60,40,60,170"
                        Spacing="18"
                        IsVisible="{Binding ShowsTracks}">
              <!--
                VIDEO.  What the file's picture is answerable by, read here: whether it is stereoscopic, its codec,
                its size, its high dynamic range, its proportion and its rate.  The viewer moved the row over here
                on 2026-11-02, over the word that says what the band is about, so that the three bands under the
                story read Video - Audiotrack - Subtitle.  Four of these answers are ALSO read behind the rating in
                the details (the codec, the size, the HDR and the first track's channels): the viewer asked for
                those four to be kept there, not carried over, and said so the same evening - a thing that is read
                in two places is read in two places on purpose.  Whether the file carries text is read over there
                only; it travelled back on the same evening and was not left behind here.

                The plaques are the same grey plaques as ever (Border.details-logo, one height written once), and
                they are still asked for by name out of the worn skin's logo folders (MediaStreamLogos); where the
                skin carries no picture of a name the plaque writes its figure in words instead of drawing a hole.
                What the reference could not do - name a codec its 2014 catalog never saw - is still done here.
              -->
              <StackPanel Spacing="6" IsVisible="{Binding ShowsPictureLine}">
                <StackPanel Orientation="Horizontal" Spacing="12" Height="40">
                  <TextBlock Text="Video"
                             FontSize="21"
                             Opacity="0.5"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
                <!-- The plaques stand at the same left edge the track and subtitle cards stand at, and not at the
                     edge of the column: the bands put their cards twenty four points in from that edge - the air a
                     card's shadow lies in - and the viewer asked on 2026-11-02 for these plaques to be flush with
                     those cards rather than to start in that air. -->
                <StackPanel Orientation="Horizontal"
                            Spacing="10"
                            Margin="24,0,0,0"
                            HorizontalAlignment="Left">
                  <!-- A stereoscopic file wears its logo with the type's own word under it, and an ordinary file
                       wears nothing (MediaInfoVideo.xaml:176-194, which drew these only for HSBS, SBS, HTAB, TAB). -->
                  <Border Classes="details-logo"
                          IsVisible="{Binding DetailsPicture.ShowsStereoscopic}">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="2">
                      <Image Source="{Binding Converter={x:Static views:SkinImageConverter.Instance},
                                              ConverterParameter='MediaLogos/video/3d'}"
                             Height="24"
                             HorizontalAlignment="Center"
                             Stretch="Uniform"/>
                      <TextBlock Text="{Binding DetailsPicture.StereoscopicType}"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Center"
                                 Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                  </Border>

                  <!-- Which codec the file's picture is packed in, out of the skin's own video folder and at the
                       reference's own size (MediaInfoVideo.xaml:196-203).  Where its 2014 catalog has no picture of
                       the name - "HEVC" was young then - the plaque writes the name instead of drawing a hole. -->
                  <Border Classes="details-logo"
                          IsVisible="{Binding DetailsPicture.ShowsCodec}">
                    <Grid>
                      <Image Source="{Binding DetailsPicture.CodecToken,
                                              Converter={x:Static views:SkinImageConverter.Instance},
                                              ConverterParameter='MediaLogos/video/{0}'}"
                             Height="34"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Stretch="Uniform"/>
                      <TextBlock Text="{Binding DetailsPicture.CodecWord}"
                                 FontSize="17"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding DetailsPicture.CodecToken,
                                                     Converter={x:Static views:SkinImageMissingConverter.Instance},
                                                     ConverterParameter='MediaLogos/video/{0}'}"
                                 Foreground="{DynamicResource TextBrush}"/>
                    </Grid>
                  </Border>

                  <!-- How big the picture is, at the reference's own bounds and out of its own folder
                       (MediaInfoVideo.xaml:205-214), which named the file "1080p" and the word alike. -->
                  <Border Classes="details-logo"
                          IsVisible="{Binding DetailsPicture.ShowsResolution}">
                    <Grid>
                      <Image Source="{Binding DetailsPicture.Resolution,
                                              Converter={x:Static views:SkinImageConverter.Instance},
                                              ConverterParameter='MediaLogos/resolution/{0}'}"
                             Height="34"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Stretch="Uniform"/>
                      <TextBlock Text="{Binding DetailsPicture.Resolution}"
                                 FontSize="17"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding DetailsPicture.Resolution,
                                                     Converter={x:Static views:SkinImageMissingConverter.Instance},
                                                     ConverterParameter='MediaLogos/resolution/{0}'}"
                                 Foreground="{DynamicResource TextBrush}"/>
                    </Grid>
                  </Border>

                  <!-- Whether the picture was mastered in a high dynamic range format, and which one.  The
                       reference never asked this question - it had no HDR answer to give - so this plaque is this
                       front end's own, and it wears its word alone: the word says "HDR" twice over, so a glyph
                       beside it would only repeat the answer.  An ordinary file leaves the plaque away entirely,
                       which is the viewer's rule for it: no HDR, no container. -->
                  <Border Classes="details-logo"
                          IsVisible="{Binding DetailsPicture.ShowsHdr}">
                    <TextBlock Text="{Binding DetailsPicture.HdrFormat}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"/>
                  </Border>

                  <!-- The proportion: the frame's own glyph and both sayings of it together on one line - the class
                       and the measured figure, "21:9 Ã‚Â· 2.39:1".  The reference wrote those two on opposite edges of
                       its proportion picture (MediaInfoVideo.xaml:226-244); read beside a glyph they are one
                       answer, which is what they always were. -->
                  <Border Classes="details-logo"
                          IsVisible="{Binding DetailsPicture.ShowsRatio}">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="10">
                      <Grid Width="24"
                            Height="24">
                        <Path Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                                                ConverterParameter='MediaInfo/aspect_ratio'}"
                              Fill="{DynamicResource TextBrush}"
                              Stretch="Uniform"/>
                      </Grid>
                      <TextBlock Text="{Binding DetailsPicture.RatioText}"
                                 FontSize="17"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                  </Border>

                  <!-- The two figures the reference never had a picture for, said as one line about the file's rate
                       - "3663 kbps Ã‚Â· 24 fps" - with the frame glyph in front of them.  The reference stacked them in
                       its own cell (MediaInfoVideo.xaml:246-255); read together they take one line.  Both figures
                       still stand or fall on their own: a file whose bitrate never arrived says only its frame rate,
                       and says it with the same dot left out. -->
                  <Border Classes="details-logo"
                          IsVisible="{Binding DetailsPicture.ShowsRate}">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="10">
                      <Grid Width="22"
                            Height="22">
                        <Path Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                                                ConverterParameter='MediaInfo/frames'}"
                              Fill="{DynamicResource TextBrush}"
                              Stretch="Uniform"/>
                      </Grid>
                      <TextBlock Text="{Binding DetailsPicture.RateText}"
                                 FontSize="17"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>

              <!-- AUDIOTRACK, SUBTITLE: the words the viewer asked these two headers to carry on 2026-11-02, in
                   place of the glyph each of them wore.  They are the English words and not the skin's German
                   strings - [Nereus.Info.AudioTracks] and [Nereus.Info.Subtitles] - because a word written into the
                   skin is a word every language would have to translate by hand. -->
              <StackPanel Spacing="0" IsVisible="{Binding ShowsAudioTracks}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="Audiotrack"
                             FontSize="21"
                             Opacity="0.5"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
                <ScrollViewer Name="audioTracksScroller"
                              Height="193"
                              Padding="24,15,24,23"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              ClipToBounds="True">
                  <ItemsControl ItemsSource="{Binding DetailsAudioTracks}"
                                VerticalAlignment="Center"
                                ClipToBounds="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AudioTrackCard">
                        <!-- What one audio card says, and where the viewer asked to see it said (2026-11-03).  The
                             four facts are the reference's (CurrentlyPlayingStyles.xaml:45-120) - the flag of the
                             language, the channels as a loudspeaker picture of the plain count, the codec as a
                             logo, and the bitrate over the sample rate - and so is the rule that a figure the worn
                             skin has no picture of is written in words instead.  Where they stand is not: the
                             picture, the channels and the codec stand in ONE LINE across the top of the card, and
                             under them the language reads its NAME ("German", not "DE") over its two numbers.  The
                             reference had the language as a two-letter abbreviation beside its flag and the codec
                             under it, which left the top of the card to one picture and the bottom to two words;
                             the line of pictures is what a viewer scans, and the words are what they read after.
                             The card itself takes the caret - the viewer looks AT a track, and the caret standing
                             on it says which one is being looked at, exactly as it does on a tile of the wall.  The
                             shadow is the skin's shared one, the same the wall's tiles, the news cards and the
                             weather cards stand in - a card of this screen is no flatter than a tile of the wall. -->
                        <Border Classes="trackcard home-tile-shadow"
                                Focusable="True"
                                Width="300"
                                Height="155"
                                Background="#26FFFFFF"
                                Padding="16,10,16,12"
                                Margin="0,0,8,0">
                          <Grid RowDefinitions="Auto,Auto,*"
                                ColumnDefinitions="Auto,*,Auto"
                                VerticalAlignment="Center">
                            <Panel Grid.Row="0"
                                   Grid.Column="0"
                                   VerticalAlignment="Center">
                              <Image Source="{Binding FlagToken,
                                                      Converter={x:Static views:SkinImageConverter.Instance},
                                                      ConverterParameter='MediaLogos/flags/{0}'}"
                                     Height="44"
                                     Stretch="Uniform"
                                     HorizontalAlignment="Left"
                                     IsVisible="{Binding ShowsFlag}"/>
                              <Image Source="{Binding Converter={x:Static views:SkinImageConverter.Instance},
                                                      ConverterParameter='MediaLogos/flags/Unknown'}"
                                     Height="44"
                                     Stretch="Uniform"
                                     HorizontalAlignment="Left"
                                     IsVisible="{Binding ShowsUnknownFlag}"/>
                            </Panel>
                            <Panel Grid.Row="0"
                                   Grid.Column="1"
                                   Margin="16,0,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center">
                              <Image Source="{Binding ChannelsToken,
                                                      Converter={x:Static views:SkinImageConverter.Instance},
                                                      ConverterParameter='MediaLogos/audio/{0}'}"
                                     Height="48"
                                     Stretch="Uniform"
                                     HorizontalAlignment="Left"
                                     IsVisible="{Binding ShowsChannels}"/>
                              <TextBlock Text="{Binding Channels}"
                                         FontSize="23"
                                         FontWeight="SemiBold"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding ChannelsToken,
                                                     Converter={x:Static views:SkinImageMissingConverter.Instance},
                                                     ConverterParameter='MediaLogos/audio/{0}'}"
                                         Foreground="{DynamicResource TextBrush}"/>
                            </Panel>
                            <Panel Grid.Row="0"
                                   Grid.Column="2"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center">
                              <Image Source="{Binding CodecToken,
                                                      Converter={x:Static views:SkinImageConverter.Instance},
                                                      ConverterParameter='MediaLogos/audio/{0}'}"
                                     Height="44"
                                     Stretch="Uniform"
                                     HorizontalAlignment="Right"
                                     IsVisible="{Binding ShowsCodec}"/>
                              <TextBlock Text="{Binding Encoding}"
                                         FontSize="19"
                                         Opacity="0.85"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding CodecToken,
                                                     Converter={x:Static views:SkinImageMissingConverter.Instance},
                                                     ConverterParameter='MediaLogos/audio/{0}'}"
                                         Foreground="{DynamicResource TextBrush}"/>
                            </Panel>
                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="3"
                                       Margin="0,8,0,0"
                                       Text="{Binding Language}"
                                       FontSize="22"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="3"
                                       Margin="0,2,0,0"
                                       Text="{Binding Detail}"
                                       FontSize="19"
                                       Opacity="0.85"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Foreground="{DynamicResource TextBrush}"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>

              <StackPanel Spacing="0" IsVisible="{Binding ShowsSubtitleTracks}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="Subtitle"
                             FontSize="21"
                             Opacity="0.5"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
                <ScrollViewer Name="subtitleTracksScroller"
                              Height="193"
                              Padding="24,15,24,23"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              ClipToBounds="True">
                  <ItemsControl ItemsSource="{Binding DetailsSubtitleTracks}"
                                VerticalAlignment="Center"
                                ClipToBounds="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SubtitleTrackCard">
                        <!-- What one subtitle card says, in the order the viewer asked to read it (2026-11-03).  Its
                             facts are the reference's (CurrentlyPlayingStyles.xaml:126-192) - the flag of its
                             language, the picture of whether the track lies inside the file, its format standing
                             inside the skin's picture of a frame, and the word "Forced" for a track the file
                             insists on, that word the reference wrote in English in the skin itself, the one corner
                             of this card it never had a picture for.  Under the line of pictures the language reads
                             its NAME ("German", not "de") and the word "Forced" stands under that, at the left.
                             As in the band above, the card is what the caret stands on, and as in the band above it
                             wears the skin's shared shadow. -->
                        <Border Classes="trackcard home-tile-shadow"
                                Focusable="True"
                                Width="300"
                                Height="155"
                                Background="#26FFFFFF"
                                Padding="16,10,16,12"
                                Margin="0,0,8,0">
                          <Grid RowDefinitions="Auto,Auto,*"
                                ColumnDefinitions="Auto,*,Auto"
                                VerticalAlignment="Center">
                            <Panel Grid.Row="0"
                                   Grid.Column="0"
                                   VerticalAlignment="Center">
                              <Image Source="{Binding FlagToken,
                                                      Converter={x:Static views:SkinImageConverter.Instance},
                                                      ConverterParameter='MediaLogos/flags/{0}'}"
                                     Height="44"
                                     Stretch="Uniform"
                                     HorizontalAlignment="Left"
                                     IsVisible="{Binding ShowsFlag}"/>
                              <Image Source="{Binding Converter={x:Static views:SkinImageConverter.Instance},
                                                      ConverterParameter='MediaLogos/flags/Unknown'}"
                                     Height="44"
                                     Stretch="Uniform"
                                     HorizontalAlignment="Left"
                                     IsVisible="{Binding ShowsUnknownFlag}"/>
                            </Panel>
                            <Panel Grid.Row="0"
                                   Grid.Column="1"
                                   Margin="16,0,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding ShowsFormat}">
                              <TextBlock Text="{Binding Format}"
                                         FontSize="19"
                                         Opacity="0.85"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource TextBrush}"/>
                              <!-- The word stands IN the frame, not beside it (CurrentlyPlayingStyles.xaml:177-182),
                                   and in the middle of it: the reference pinned it to the frame's left edge, which
                                   read as a word that had not quite got into its box. -->
                              <Image Source="{Binding Converter={x:Static views:SkinImageConverter.Instance},
                                                      ConverterParameter='MediaLogos/subtitle/Frame'}"
                                     Height="46"
                                     Stretch="Uniform"
                                     HorizontalAlignment="Left"
                                     IsHitTestVisible="False"/>
                            </Panel>
                            <Panel Grid.Row="0"
                                   Grid.Column="2"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center">
                              <Image Source="{Binding CarriageToken,
                                                      Converter={x:Static views:SkinImageConverter.Instance},
                                                      ConverterParameter='MediaLogos/subtitle/{0}'}"
                                     Height="42"
                                     Stretch="Uniform"
                                     HorizontalAlignment="Right"/>
                              <TextBlock Text="{Binding Carriage}"
                                         FontSize="21"
                                         Opacity="0.85"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding CarriageToken,
                                                     Converter={x:Static views:SkinImageMissingConverter.Instance},
                                                     ConverterParameter='MediaLogos/subtitle/{0}'}"
                                         Foreground="{DynamicResource TextBrush}"/>
                            </Panel>
                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="3"
                                       Margin="0,8,0,0"
                                       Text="{Binding Language}"
                                       FontSize="22"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="3"
                                       Margin="0,2,0,0"
                                       Text="{Binding Forced}"
                                       FontSize="19"
                                       Opacity="0.85"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Foreground="{DynamicResource TextBrush}"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>

              <!--
                ACTORS, DIRECTOR: the people the title names, in the two parts the reference showed them in.  Its
                information screen stood both in the same left column as the tracks - actors in the third row,
                director in the fourth, each a head of forty lines with a twenty seven point picture and a word at
                half light over a band of cards that runs sideways
                (MediaInfoVideo.xaml:384-420 for the actors, :421-457 for the director, both lists wearing
                PersonCPListViewStyle, whose card is a hundred and forty five points of portrait over sixty lines of
                name - themes/default/styles/CurrentlyPlayingStyles.xaml:194-237).

                Here the two bands SHARE one row, which the viewer agreed to on 2026-11-03: four bands of two
                hundred and sixty lines do not stand above the foot of a window that is a thousand and eighty lines
                tall, and a band a viewer cannot reach is no band at all - the same reason the caret walks out of a
                band rather than stopping at its edge.  Since 2026-11-04 the row is split one card to the left: a
                title has ONE director, so the director's column is exactly wide enough for the one card it holds
                and everything left of it belongs to the actors, who are a dozen strong for a series.  The heads
                carry the reference's English words out of its own language file (Language/strings_en.xml:108 and
                :110, "Director" and "Actors") in place of its two glyphs, which is what the viewer asked the track
                heads to wear the same evening.  Neither band shows a scrollbar: the caret walks a band and the
                wheel turns it, so the bar would only eat a line of the picture (see KeepCardInSight for how a
                card walking out of a band is brought back with the reference's own margin around it).

                A portrait is asked for per person, under that person's own id, and where the library has none the
                card draws the skin's standing figure - exactly the two states the reference's card had
                (CurrentlyPlayingStyles.xaml:216-222, Person.png shown by Path=!HasImage).  The cards take the caret
                and wear the skin's shared shadow like the track cards above them, and the shadow is given the room
                it needs outside the card by this band's padding - twenty five lines above and below a card of a
                hundred and sixty standing in a band of two hundred and ten - which is what the test that measures a
                cut shadow looks at.  A band that clips is where a shadow dies, so the clip that keeps a long list
                from painting over its neighbour sits on the row of items and not on the band.
              -->
              <Grid ColumnDefinitions="*,Auto"
                    ColumnSpacing="18"
                    IsVisible="{Binding ShowsPersons}">
                <StackPanel Grid.Column="0" Spacing="0" IsVisible="{Binding ShowsActors}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Actors"
                               FontSize="21"
                               Opacity="0.5"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"/>
                  </StackPanel>
                  <ScrollViewer Name="actorsScroller"
                                Height="198"
                                Padding="24,15,24,23"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Disabled"
                                ClipToBounds="True">
                    <ItemsControl ItemsSource="{Binding DetailsActors}"
                                  VerticalAlignment="Center"
                                  ClipToBounds="False"
                                  ItemTemplate="{StaticResource PersonCardTile}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
                <!-- Wide enough for the one card a director is, and no wider: a hundred and fifty of card, eight of
                     the gap that separates cards, and the twenty four of shadow air the band keeps at either end
                     (the room Border.home-tile-shadow's shadow falls into, which the shadow test measures). -->
                <StackPanel Grid.Column="1" Spacing="0" Width="206" IsVisible="{Binding ShowsDirectors}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Director"
                               FontSize="21"
                               Opacity="0.5"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"/>
                  </StackPanel>
                  <ScrollViewer Name="directorsScroller"
                                Height="198"
                                Padding="24,15,24,23"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Disabled"
                                ClipToBounds="True">
                    <ItemsControl ItemsSource="{Binding DetailsDirectors}"
                                  VerticalAlignment="Center"
                                  ClipToBounds="False"
                                  ItemTemplate="{StaticResource PersonCardTile}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Panel>

          <!-- The shelf itself, with its heading, its search field, its foot and the two overlays the reference
               laid over its bottom or its top edge. Put away while one title is being read, which is what the
               reference's media information screen is: its workflow (MediaInfoAction.cs:69-90) pushed a screen of
               its own over the list rather than drawing another copy of the facts beside the wall. -->
          <Panel Grid.Column="0" ClipToBounds="False" IsVisible="{Binding !InfoShown}">
            <DockPanel>
              <!--
                What the shelf has to say about itself.  The reference gave its media master a head band of a
                hundred points (master_bare_media.xaml:57-59) and let the wall of titles begin under it, which on
                a television of this height hangs the wall low: four rows of posters stand one under the other,
                the last one is cut in half by the bottom edge, and the whole block leans to the floor while the
                details column beside it is read from the top down.  The viewer asked for the wall to be pulled up
                and stood in the middle of the room, so it begins fifty-one points down - still clear of the top
                edge, still under nothing, because this screen wears no head line - and gives seventy-three points
                back to the floor, which is where the count of the wall is said.
              -->
              <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,51,0,6">
                <!--
                  The reference's shelf head carries the heading and nothing else - it never tells the viewer
                  "1130 of 1136, sorted by year" - so the screen's one line of speech only stands when the shelf
                  has a problem to report: nothing to show, a server that will not answer, a search that found
                  too little.  A filled shelf says nothing, and then its head takes no room at all.
                -->
                <TextBlock Text="{Binding Status}"
                           FontSize="15"
                           Foreground="{DynamicResource TextBrush}"
                           Opacity="0.62"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding !HasTitles}"/>
              </StackPanel>

              <!--
                Finding a title by typing its name. The reference kept the box off the screen until a viewer asked
                for it - its search was a command in this very menu - and the shelf has no room to spare, so the
                box does not stand here while nobody types: it comes up when the menu's Search row or the Find key
                asks for it, and stays up while a search is being held. Escape in the box puts the whole shelf
                back, Enter asks the server.
              -->
              <WrapPanel DockPanel.Dock="Top"
                         Name="searchRow"
                         Margin="0,0,0,8"
                         IsVisible="{Binding ShowsSearch}">
                <TextBox Name="searchBox"
                         views:VirtualKeyboardService.Trigger="Menu"
                         Text="{Binding SearchText, Mode=TwoWay}"
                         PlaceholderText="Find a title"
                         Width="300"
                         FontSize="22"
                         Padding="14,8"
                         Margin="0,0,10,4"/>
                <Button Name="findButton"
                        Content="Find"
                        Command="{Binding FindCommand}"
                        MinWidth="110"
                        Padding="20,8"
                        FontSize="22"
                        Margin="0,0,10,4"/>
                <Button Name="clearButton"
                        Content="Clear"
                        Command="{Binding ClearSearchCommand}"
                        IsVisible="{Binding HasSearch}"
                        MinWidth="110"
                        Padding="20,8"
                        FontSize="22"
                        Margin="0,0,10,4"/>
              </WrapPanel>

              <!--
                The keys this screen answers are not written on it.  A remote carries its labels on itself and
                a keyboard viewer learns the keys by pressing them; a line of small print at the foot of the
                shelf took room from the wall and told anybody who already knew the keys nothing.
              -->
              <!--
                The shelf. The pictures it wears are the worn skin's answer to the tile key its layout names
                (theming:SkinTemplates.TileTemplate), and the panel it lays them in is the view's own promise -
                the wrap for a grid, the sideways stack for covers - which is what the code behind swaps.  The
                wall is not stretched to the scroller: it takes the width its own rows of tiles need and stands
                in the middle of what the scroller offers (VirtualizingTilePanel), which leaves the same breath
                of fanart at its left and at its right hand and keeps the scroller's bar at the edge of the
                room, away from the last column of posters.
              -->
              <ListBox Name="titlesList"
                       Focusable="True"
                       ItemsSource="{Binding Titles}"
                       SelectedItem="{Binding Selected, Mode=TwoWay}"
                       ItemTemplate="{StaticResource BuiltinRowsTemplate}"
                       FontSize="24"
                       Margin="0,0,0,53"
                       ClipToBounds="False"/>
            </DockPanel>

            <!--
              THE DETAILS OF A COVER, centred above its row: MultiDetailsCover.inc, which the reference laid over
              a horizontal gradient - dark in the middle of the screen and clear at both edges, so that the strip
              of covers keeps its own light at either end. The cover layout never has a column beside its row,
              which is why its details had to go where the covers are.
            -->
            <Border Name="coverDetailsPanel"
                    Height="480"
                    VerticalAlignment="Top"
                    Margin="70,96,70,0"
                    IsVisible="{Binding ShowsCoverDetails}"
                    IsHitTestVisible="False">
              <!--  The reference's MultiDetailsCoverGradient: dark in the middle of the strip, clear at
                    both edges.  It has to say '%' at both ends: bare numbers are pixels for Avalonia, and
                    a brush "from 0 to 1" is a gradient one pixel long - which is what left a single dark
                    column of black at the panel's left edge instead of a wash across the whole screen.  -->
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                  <GradientStop Color="#00000000" Offset="0"/>
                  <GradientStop Color="#80000000" Offset="0.3"/>
                  <GradientStop Color="#80000000" Offset="0.7"/>
                  <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <StackPanel Spacing="10" VerticalAlignment="Top">
                <TextBlock Text="{Binding DetailsHeading}"
                           FontSize="42"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding DetailsTagline}"
                           FontSize="26"
                           FontStyle="Italic"
                           Foreground="{DynamicResource TextBrush}"
                           Opacity="0.75"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           IsVisible="{Binding DetailsTagline, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <TextBlock Text="{Binding DetailsLine}"
                           FontSize="20"
                           Foreground="{DynamicResource TextBrush}"
                           Opacity="0.7"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding DetailsText}"
                           FontSize="21"
                           LineHeight="29"
                           Foreground="{DynamicResource TextBrush}"
                           Opacity="0.92"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxHeight="230"/>
              </StackPanel>
            </Border>

            <!--
              The reference's foot, and in the same pieces it drew there: the shelf's two numbers - where the
              highlight stands, and how many titles there are - at the right hand end of the bottom edge, inside
              the room so that they slide with the shelf. The numbers answer in every view, covers included,
              because a cover viewer wants to know how deep the shelf is too. It is paint, not a control.
            -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,40,26"
                        Spacing="9"
                        IsHitTestVisible="False"
                        IsVisible="{Binding HasTitles}">
              <TextBlock Text="{Binding SelectedNumber}" FontSize="18" VerticalAlignment="Center" Opacity="0.75"/>
              <TextBlock Text="|" FontSize="22" VerticalAlignment="Center" Opacity="0.45"/>
              <TextBlock Text="{Binding TotalNumber}" FontSize="18" VerticalAlignment="Center" Opacity="0.75"/>
            </StackPanel>
          </Panel>

          <!--
            THE DETAILS BESIDE THE SHELF: what the reference called MultiDetails.xml, as it laid it for grid and
            list - a thousand points wide, on a ground of a fifth of black over the title's own fanart (which is
            the screen's fanart already, since the fanart follows the highlighted row), with the skin's
            List_overlay darkening that ground further and the skin's ContentGlow along the column's left edge so
            that it does not end at a line. The negative margins are the reference's: the ground has to reach past
            the shelf's head and past the window's bottom edge, because a column that stopped level with the shelf
            would float over the picture it belongs to.
          -->
          <Border Name="detailsPanel"
                  Grid.Column="1"
                  Margin="45,-96,-10,-270"
                  ClipToBounds="False"
                  IsVisible="{Binding ShowsSideDetails}">
            <Border.Background>
              <!--  Avalonia reads a bare number in StartPoint/EndPoint as an amount in
                    device-independent pixels, not as the 0..1 fraction WPF uses: the
                    "1,0.3" -> "0,0.5" version was a line one DIP long in the top left
                    corner, which is why the wash never appeared. Only the '%' suffix
                    means "of the panel". The wash stands 60 % black (#99 = 0.6 * 255)
                    from the right corner out to sixty hundredths of the line and only
                    then thins to nothing at the left edge, so the words sit on an even
                    ground instead of on a gradient that starts thinning behind them.  -->
              <LinearGradientBrush StartPoint="100%,45%" EndPoint="3%,50%">
                <GradientStop Color="#99000000" Offset="0"/>
                <GradientStop Color="#99000000" Offset="0.6"/>
                <GradientStop Color="#00000000" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <Panel ClipToBounds="False">
              <!--Border Background="#33000000"/>
              <Image Source="{Binding Converter={x:Static views:SkinImageConverter.Instance},
                                      ConverterParameter=List_overlay}"
                     Stretch="Fill"
                     IsHitTestVisible="False"/>
              <Image Source="{Binding Converter={x:Static views:SkinImageConverter.Instance},
                                      ConverterParameter=ContentGlow}"
                     Width="13"
                     HorizontalAlignment="Left"
                     Stretch="Fill"
                     IsHitTestVisible="False"/-->

              <!--
                The column of words beside the shelf, laid as the reference laid its MediaItemListMovieDetails.inc:
                a head of everything that is said once - the name, the rating, the studio's sentence and the facts -
                and under it the story, which is given all the height that is left (that file's own row for the
                description is Height="*", under a row of Auto for the name). It is not given a cap of its own,
                because a cap is what left a long story ending mid-sentence while a third of the column stood empty.
                The bottom margin is bigger than the visible window needs: the ground behind these words runs past
                the window's lower edge (the reference's own negative margin), and words may not follow it there.
              -->
              <!--
                The bottom of this grid used to sit three hundred and ten lines above the window's edge, which was
                drawn when the panel's only children were the head, the facts and the story. The progress ring and
                the title's lettering stand at the foot of the head now - where the reference stood them - and on a
                living-room window of nine hundred and sixty lines that pushed the ring, and with it the last lines
                of the story, past the bottom edge of the screen. Two hundred leaves the ground still running past
                the edge (which is what it is for) and keeps the words and the ring inside the picture.
              -->
              <Grid Margin="0,140,50,200">
                <Grid.RowDefinitions>
                  <!-- The band the picture used to be described in.  The viewer moved those answers to the left
                       hand side of the reading on 2026-11-02, under the word "Video"; four plaques were asked to
                       stay here, and they now stand behind the stars (see the row below).  The row is not taken
                       out of the grid because every row under it is named by its number, but it asks for nothing:
                       nothing stands in it. -->
                  <RowDefinition Height="Auto"/>
                  <!-- The head, which is said once: the name, its stars and the studio's sentence. -->
                  <RowDefinition Height="Auto"/>
                  <!-- The row the four pairs stand in, under the head and above the story. -->
                  <RowDefinition Height="Auto"/>
                  <!-- The story's row.  A floor of its own, because a row of "*" shrinks to whatever the head and
                       the foot leave, and on a screen that is stood up small or measured before it has a size that
                       leaves nothing at all - which is not "a short story", it is a control with no room to be
                       laid out.  The reference's row for the description was "*" too (MediaItemListMovieDetails.inc:17). -->
                  <RowDefinition Height="*" MinHeight="160"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <!-- Two columns, but only the bottom row uses them: the story's column and the picture's column,
                       which is how the reference split the same panel (MediaItemListMovieDetails.inc:19-23 - six
                       hundred for the description, the rest for the poster).  The picture's column is a written
                       number rather than Auto, because an Auto column is asked what it wants before the story is
                       asked what it needs, and it grew to two thousand one hundred of the panel's pixels on a
                       title whose poster had never been measured. -->
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="400"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="12">
                <!-- The title, and the reference's rule about it: as big as it needs to be, but on one line -
                     its own label style trimmed the title rather than letting three words take two bands off the
                     plot that every viewer actually reads. -->
                <TextBlock Text="{Binding DetailsHeading}"
                           FontSize="45"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <!-- The rating, as the reference's movie panel wrote it: the skin's own five stars filled to half
                     the number the library recorded - TotalRating/2 onto a Maximum of five - and the number itself
                     after them, in brackets and in the smaller light. A library that recorded no rating (no number
                     at all, or a nought) says nothing at all, which is that file's condition too: the stars and
                     their number stand or fall with TotalRating through ReferenceToBoolConverter. -->
                <!-- Fourteen here, twelve that the column itself puts between every pair of its children (the
                     tagline stands here even when a title has none, and an invisible child still costs its
                     twelve), and four the facts band carries above itself: thirty lines of ground between a
                     rating and the answers under it - twenty were asked for first, then ten more on the
                     viewer's word. Measured, not reckoned: the facts stood one hundred ninety-eight lines
                     down with four here, and ten lower with this. -->
                <!--
                  The rating on the left, and the file's answers on the right of the same line.  The viewer set
                  that on 2026-11-02: the rating stays where it has always stood - at the left edge, the first
                  thing said on the line - while the plaques are pushed to the right edge of the panel, so that
                  the two ends of the line are two ends and not one crowded crowd.

                  Five answers stand here: the codec, the size, the high dynamic range the file was mastered in,
                  the loudspeaker of the first audio track's channels (the picture the first audio card wears at
                  its top right corner, which is the answer a viewer reaches for before reading a single track -
                  "is this a surround file?"), and the framed "CC" that says whether the file carries text at all.
                  That last one travelled over from the reader's side on the same evening, and it travelled - it
                  was not copied: it is read here and nowhere else.  Every plaque wears its inner ground on
                  itself (twenty points on each side) rather than taking it from the style, so that a logo of one
                  width and a word of another stand in boxes measured the same way.

                  The row outlives the rating: a library that recorded no number (none at all, or a nought) says
                  nothing with stars - the reference's rule, through ReferenceToBoolConverter - but the file still
                  has a codec, a size and its tracks, and those answers are not the rating's to withhold.  That is
                  why the stars stand in a panel of their own inside this line rather than being the line itself,
                  and why the line is a grid of "what the rating needs" and "all the room that is left": with no
                  rating to its left the row still holds its plaques at the right edge.

                  Fourteen here, twelve that the column itself puts between every pair of its children (the
                  tagline stands here even when a title has none, and an invisible child still costs its
                  twelve), and four the facts band carries above itself: thirty lines of ground between a
                  rating and the answers under it - twenty were asked for first, then ten more on the
                  viewer's word. Measured, not reckoned: the facts stood one hundred ninety-eight lines
                  down with four here, and ten lower with this.
                -->
                <Grid ColumnDefinitions="Auto,*"
                      Margin="0,0,0,14">
                  <StackPanel Grid.Column="0"
                              Orientation="Horizontal"
                              Spacing="12"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              IsVisible="{Binding DetailsRating, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <ItemsControl ItemsSource="{Binding DetailsStars}" VerticalAlignment="Center">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:Double">
                          <!-- The number IS the star's light: whole for a star the rating filled, a quarter of it
                               for a star the rating never reached. Computed where the rating is computed, because a
                               control cannot do arithmetic. -->
                          <Image Source="{Binding Converter={x:Static views:SkinImageConverter.Instance},
                                                  ConverterParameter=star}"
                                 Width="25"
                                 Height="25"
                                 Margin="0,0,4,0"
                                 Opacity="{Binding}"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding DetailsRatingWords}"
                               FontSize="22"
                               Foreground="{DynamicResource TextBrush}"
                               Opacity="0.85"
                               VerticalAlignment="Center"/>
                  </StackPanel>

                  <!-- Every plaque of this row is the same grey plaque the reader's side uses
                       (Border.details-logo, one height written once), and every one of them is a logo the worn skin
                       carries or - where it carries no picture of that name - the figure in words.  Which is the
                       one thing these rows do that the reference could not: a codec its 2014 catalog never saw
                       ("HEVC", "MLP FBA") is named here rather than being silently missing. -->
                  <StackPanel Grid.Column="1"
                              Orientation="Horizontal"
                              Spacing="10"
                              Margin="28,0,0,0"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              IsVisible="{Binding ShowsTracks}">
                    <!-- Whether the file carries subtitle tracks at all, said with the glyph for it rather than with
                         a word: the framed "CC" when the file has text, the same frame crossed out when it has none
                         (MediaInfoVideo.xaml:157-174, "AspectCount < 1").  It stands at the head of this row because
                         the reference asked that question first, and it stands here only: the reader's side lost its
                         copy on 2026-11-02, since two answers of the same question on one screen is one answer too
                         many.  Named because a test asks the screen whether the plaque was moved or copied. -->
                    <Border Classes="details-logo"
                            Name="subtitlesPlaque"
                            Padding="20,0">
                      <Grid Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Path Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                                                ConverterParameter='PlayerControl/subtitles'}"
                              Fill="{DynamicResource TextBrush}"
                              Stretch="Uniform"
                              IsVisible="{Binding ShowsSubtitleTracks}"/>
                        <Path Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                                                ConverterParameter='PlayerControl/subtitles_off'}"
                              Fill="{DynamicResource TextBrush}"
                              Stretch="Uniform"
                              Opacity="0.6"
                              IsVisible="{Binding !ShowsSubtitleTracks}"/>
                      </Grid>
                    </Border>

                    <Border Classes="details-logo"
                            Padding="20,0"
                            IsVisible="{Binding DetailsPicture.ShowsCodec}">
                      <Grid>
                        <Image Source="{Binding DetailsPicture.CodecToken,
                                                Converter={x:Static views:SkinImageConverter.Instance},
                                                ConverterParameter='MediaLogos/video/{0}'}"
                               Height="34"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Stretch="Uniform"/>
                        <TextBlock Text="{Binding DetailsPicture.CodecWord}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding DetailsPicture.CodecToken,
                                                       Converter={x:Static views:SkinImageMissingConverter.Instance},
                                                       ConverterParameter='MediaLogos/video/{0}'}"
                                   Foreground="{DynamicResource TextBrush}"/>
                      </Grid>
                    </Border>

                    <!-- How big the picture is, at the reference's own bounds and out of its own folder
                         (MediaInfoVideo.xaml:205-214), which named the file "1080p" and the word alike. -->
                    <Border Classes="details-logo"
                            Padding="20,0"
                            IsVisible="{Binding DetailsPicture.ShowsResolution}">
                      <Grid>
                        <Image Source="{Binding DetailsPicture.Resolution,
                                                Converter={x:Static views:SkinImageConverter.Instance},
                                                ConverterParameter='MediaLogos/resolution/{0}'}"
                               Height="34"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Stretch="Uniform"/>
                        <TextBlock Text="{Binding DetailsPicture.Resolution}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding DetailsPicture.Resolution,
                                                       Converter={x:Static views:SkinImageMissingConverter.Instance},
                                                       ConverterParameter='MediaLogos/resolution/{0}'}"
                                   Foreground="{DynamicResource TextBrush}"/>
                      </Grid>
                    </Border>

                    <!-- Whether the picture was mastered in a high dynamic range format, and which one.  The
                         reference never asked this question - it had no HDR answer to give - so this plaque is this
                         front end's own, and it wears its word alone: the word says "HDR" twice over, so a glyph
                         beside it would only repeat the answer.  An ordinary file leaves the plaque away entirely,
                         which is the viewer's rule for it: no HDR, no container. -->
                    <Border Classes="details-logo"
                            Padding="20,0"
                            IsVisible="{Binding DetailsPicture.ShowsHdr}">
                      <TextBlock Text="{Binding DetailsPicture.HdrFormat}"
                                 FontSize="17"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextBrush}"/>
                    </Border>

                    <!-- The channels of the file's FIRST audio track, as the first audio card shows them at its
                         top right corner: the loudspeaker picture of the plain count out of the skin's own folder
                         (MediaLogos\audio\6.png for a 5.1 arrangement), and the trade's word for it where the skin
                         carries no picture of that count.  Said here because it is the one question a viewer asks
                         before reading any track list. -->
                    <Border Classes="details-logo"
                            Padding="20,0"
                            IsVisible="{Binding ShowsFirstAudioChannels}">
                      <Grid>
                        <Image Source="{Binding FirstAudioChannelsToken,
                                                Converter={x:Static views:SkinImageConverter.Instance},
                                                ConverterParameter='MediaLogos/audio/{0}'}"
                               Height="34"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Stretch="Uniform"/>
                        <TextBlock Text="{Binding FirstAudioChannelsWord}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding FirstAudioChannelsToken,
                                                       Converter={x:Static views:SkinImageMissingConverter.Instance},
                                                       ConverterParameter='MediaLogos/audio/{0}'}"
                                   Foreground="{DynamicResource TextBrush}"/>
                      </Grid>
                    </Border>
                  </StackPanel>
                </Grid>
                <TextBlock Text="{Binding DetailsTagline}"
                           FontSize="30"
                           FontStyle="Italic"
                           Foreground="{DynamicResource TextBrush}"
                           Opacity="0.75"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"
                           IsVisible="{Binding DetailsTagline, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

                <!--
                  The facts, in the pairs the reference's panels printed (MediaItemListDetails.inc:109 - the answer
                  first, the word under it in the smaller size).  They stand in their own row under the head and they
                  have the whole width for themselves - only the story and the picture share the panel below them.
                  They used to be said twice, once as a sentence above the story and once here, and to wait at the
                  foot of the column below a band of nothing.
                -->
                <ItemsControl Grid.Row="2"
                              Grid.ColumnSpan="2"
                              ItemsSource="{Binding DetailsFacts}"
                              ItemTemplate="{StaticResource MediaFactTemplate}"
                              Margin="0,4,0,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!--
                  The poster, in the story's row and standing on the story's first line, which is where it was asked
                  for: the top margin is the same forty the story's own column carries, so the two begin together -
                  when the episode's name pushes the story down, the poster is pushed with it and stays flush.
                  The reference stood its MoviePoster at the right hand end of the panel with the picture inset in a
                  box of its own (MediaItemListMovieDetails.inc:23-38); the size here is the box that was drawn for
                  it.  A title the library keeps no poster of leaves the box empty - not a poster standing in for a
                  poster that is not there.

                  The frame is the picture's own and not a fixed box: it is told the greatest width and height the
                  box may take and then shrinks to the poster that arrives in it, because the corners are rounded on
                  the frame and a frame wider than its picture would round nothing.  The rounding is the tiles'
                  rounding (Border.home-tile-face, ten points) at twice the size, which is what the viewer asked for
                  and what a picture this large can carry.
                -->
                <Border Grid.Row="3"
                        Grid.Column="1"
                        MaxWidth="380"
                        MaxHeight="500"
                        Margin="20,40,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        CornerRadius="10"
                        ClipToBounds="True"
                        IsVisible="{Binding DetailsArtwork, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <Image Source="{Binding DetailsArtwork, Converter={x:Static views:ArtworkConverter.Instance}}"
                         Stretch="Uniform"/>
                </Border>

                <!--
                  Where the file stands is not said here any more.  A viewer choosing a film reads a story, not a
                  resource address, and the line lay across the foot of the screen like a footnote nobody asked
                  for; the screen still knows it (MediaBrowserViewModel.DetailsPath), it is simply not painted.
                -->
                <!--
                  The story, in the room that is left. The reference gave its description the whole second row of
                  the panel (MediaItemListMovieDetails.inc:16-19: a row of Auto for the name and a row of "*" for
                  MediaItemDescription, that one wrapping by Wrap="True") and never a height of its own; the plot
                  of the player's own information area (MediaStyles.xaml:156) is the one that additionally reads
                  itself down the screen, which is what PlotAutoScroll is for.  Neither of them was ever veiled:
                  the reference's Label carries no mask of any kind, so a story that ends two thirds down the
                  column ends in readable words rather than in a fade nobody asked for.
                -->
                <StackPanel Grid.Row="3"
                            Grid.Column="0"
                            Spacing="8"
                            Margin="0,40,0,0">
                  <!--
                    HOW FAR THIS VIEWER GOT, in the figure the reference drew in the middle of its detail panels:
                    a ring round a centre, filled as far as the library counted progress for whoever asked, and
                    the number itself standing in the middle
                    (MediaInfoMovieDetails.inc:206-351, the sector styles in
                    themes/default/styles/CircularIndicator.xaml:8-45).

                    The reference stepped that ring in twenty marks, one for every five percent. This one sweeps in
                    one piece instead, which is away from the reference and was asked for that way: at the sizes
                    this panel works at, twenty marks read as a heap of bits where one band of the same diameter
                    reads as what it is.  Everything that can be measured stayed the reference's - the box of a
                    hundred and fifty points shrunk to seven tenths of itself, the band's outer edge on the edge of
                    that box, the turning beginning at the top and going to the right, the number spelled
                    "{0:F0}%".  Two things are not: the grain of the answer, since the reference counted fives and
                    this counts every percent, and the colour, since the reference lit the watched part with the
                    skin's accent (NereusColorLight, Colors.xaml:39) while this lights it with the skin's white -
                    the colour everything else here that deserves attention is lit with.

                    It stands at the foot of the head and above the story, in the words' own column, which is where
                    the reference stood it: its head stack ran name, stars, year, kinds, length and then this ring
                    (MediaInfoMovieDetails.inc:110-362), while the poster hung in the column beside it and the story
                    took the row under both. The lettering goes to the row's right hand end because the reference
                    stood it there too - its Image was aligned to the right of that row, a hundred and forty lines
                    tall and asked of the server no wider than two hundred and forty (MediaInfoMovieDetails.inc:353-359),
                    which are the two numbers the frame below repeats.

                    Both shapes are arithmetic in PlayPercentageDial and arrive here as paths that name their own
                    radius and their own endpoints, so nothing on this screen has to agree with anybody about where
                    a turning point lies - the first dial asked exactly that question and its twenty marks landed
                    in a heap at the top of the box with the number standing under them.  A Path drawn as a stroke
                    needs no place of its own either, so both paths lie at the corner of the box and their
                    coordinates do the work.

                    The track the sweep turns in is NOT the reference's black at a fifth of its light: that black
                    was laid over the reference's own bright fanart, and over this panel's darkened ground it
                    vanished, which left a ring that could only say how far somebody had got and never how far they
                    had left. A white at a third of its light reads on both grounds.
                  -->
                  <DockPanel LastChildFill="False"
                             Margin="0,0,0,16"
                             IsVisible="{Binding ShowsProgressRow}">
                    <Panel Width="105" Height="105"
                           DockPanel.Dock="Left"
                           IsVisible="{Binding DetailsProgressShown}">
                      <!-- The track first and the sweep over it, both on the same circle of the same box: the
                           track is drawn whole, the sweep as far as this viewer got. An untouched title answers a
                           path that paints nothing, so the track stands bare and the ring still says "nothing of
                           this was seen" rather than showing no ring at all. -->
                      <Path Data="{Binding DetailsDialTrack}"
                            Stroke="#4DFFFFFF"
                            StrokeThickness="{x:Static vm:PlayPercentageDial.BAND}"/>
                      <Path Data="{Binding DetailsDialArc}"
                            Stroke="{DynamicResource TextBrush}"
                            StrokeThickness="{x:Static vm:PlayPercentageDial.BAND}"
                            StrokeLineCap="Round"/>
                      <TextBlock Text="{Binding DetailsProgressWords}"
                                 FontSize="20"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Panel>
                    <!--
                      The title's own lettering, which is a picture of its own kind and not the poster written
                      again: the reference asked for it under the name ClearArt and stood it beside the ring
                      (MediaInfoMovieDetails.inc:355-362). Most libraries hold none, and the frame then costs
                      nothing - the ring keeps its place at the column's left edge either way.
                    -->
                    <Image Source="{Binding DetailsClearArt, Converter={x:Static views:ArtworkConverter.Instance}}"
                           DockPanel.Dock="Right"
                           Height="140"
                           MaxWidth="240"
                           Margin="60,0,0,0"
                           Stretch="Uniform"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           IsVisible="{Binding DetailsClearArt, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                  </DockPanel>
                  <!-- The episode's name, in bold over its own story and out of the fact list: the story under
                       it is this episode's sentence, and a title over its sentence is what a viewer reads -
                       a number row cannot carry it without the story losing its head. Only episodes wear it;
                       every other title answers the empty string and the row costs nothing. -->
                  <TextBlock Text="{Binding DetailsEpisodeName}"
                             FontSize="26"
                             FontWeight="Bold"
                             Foreground="{DynamicResource TextBrush}"
                             TextWrapping="Wrap"
                             IsVisible="{Binding DetailsEpisodeName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  <ScrollViewer Name="plotScroller"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Hidden">
                    <TextBlock Name="detailsText"
                               Text="{Binding DetailsText}"
                               FontSize="23"
                               LineHeight="32"
                               Foreground="{DynamicResource TextBrush}"
                               TextWrapping="Wrap"/>
                  </ScrollViewer>
                </StackPanel>
              </Grid>
            </Panel>
          </Border>
        </Grid>
      </Panel>

      <!--
        The word the rail speaks, laid at the room's foot. The viewer asked for it moved out of the rail's top
        and down to where the home says its media line - the one line about the title a walker stands on - and
        that line is the measure of this one in position as well as in letters: two and twenty points of the
        face's own text, thirty-four points above the window's bottom edge, and two hundred and forty in from
        the room's left, which is the rail's two hundred and the gap of forty the home leaves beside its rail.
        It spans both columns so the margin counts from the room's own left edge, it is painted over the wall
        the way the home's line is painted over its fanart, and it goes when the rail goes, because it is the
        rail's word and not the wall's.
      -->
      <TextBlock Grid.Row="0"
                 Grid.ColumnSpan="2"
                 Text="{Binding MediaMenuHeading}"
                 FontSize="22"
                 Foreground="{DynamicResource TextBrush}"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Margin="240,0,0,34"
                 IsHitTestVisible="False"
                 TextTrimming="CharacterEllipsis"
                 IsVisible="{Binding MediaMenuVisible}"/>
    </Grid>

    <!--
      Nothing is painted over the shelf at its head or its foot; see the note below where the two gradient bands
      used to stand.
    -->
    <!--
      The head and the floor used to be painted here, over the shelf, in the reference's own seven stops.  They
      were the black bars: master_bare_media.xaml:50-90 lays its head band in the hundred points ABOVE the client
      area and its floor under it, over the fanart, where ninety hundredths of black is a picture going dark;
      stood over a wall of posters the same band is a black slab lying across the first row, and it did not even
      answer whether the wall had anything left above it - it was simply always there.  The same answer is what the
      shelf's own edge fade is now asked for and asked for alone (ApplyShelfFade): an end the wall has left
      something standing out of the picture dissolves that end, an end the wall has reached leaves its row standing
      whole, and the reference - which fades nothing at all in any of its three media shapes - is not contradicted
      more than that.  Nothing is painted over the pictures themselves.
    -->

    <!--
      The selected title's menu, standing over the shelf the way the reference's DialogEditMenu stood over the
      list it was opened for: the shelf stays where it is, the menu speaks about one row, and Back puts it
      away. What the menu asks is decided by what the server can actually answer - today exactly one thing,
      whether a title was watched through - and where the library has no answer to give, the menu says so in
      words instead of pressing a button that would do nothing.

      The frame is this skin's own dialog frame, the very one the menu editor wears (the DialogHeadedFrame
      template): the dark grey ground, the corners of twenty-five, the white halo falling off outward from the
      panel's edge with nothing painted for it, the heading centred at the dialog title's size and nothing
      drawn between heading and body, and the answers on the skin's primary button. Behind it the ground stands
      washed dark, which is what the skin's dialog screens ask their home to be; a dialog over a wall of
      readable detail would ask the viewer to read two things at once. The wall is washed <em>and</em> thrown
      out of focus: the shell photographs its whole layout at the skin's <c>DialogBackdropBlur</c>, softened
      the way the workflow's dialogs soften it, and this dialog wears that photograph under its wash - the
      live wall hides under the picture, and a viewer who is being asked something is not watching the shelves
      behind them scroll.
    -->
    <Panel Name="menuScrim" Background="Transparent" IsVisible="{Binding MenuVisible}">
      <!-- The photograph of the ground, worn by the dialog rather than by the shell's own backdrop layer -
           that one sits over the whole layout and would bury a dialog standing inside a screen with its own
           ground. It is filled when the dialog opens and emptied when the dialog goes; a skin that names no
           blur leaves it bare and the wall stays live behind the wash. -->
      <Rectangle Name="menuGround" IsHitTestVisible="False"/>
      <Panel Background="{DynamicResource DialogWashBrush}"/>
      <Border Name="menuDialog"
              Background="{DynamicResource DialogGroundBrush}"
              CornerRadius="{DynamicResource DialogFrameCornerRadius}"
              BoxShadow="0 0 120 0 #00FFFFFF, 0 0 26 0 #FFFFFFFF"
              Margin="50"
              MaxWidth="760"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              RenderTransformOrigin="50%,50%">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                     Text="{Binding MenuTitle}"
                     FontSize="{DynamicResource DialogTitleFontSize}"
                     FontWeight="Bold"
                     Foreground="{DynamicResource TextBrush}"
                     Margin="10,5"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
          <StackPanel Margin="10" MinWidth="460">
            <!--
              The answers this title has, one line each, straight off the table the home wall reads too
              (MediaTitleActions.For). Above this the dialog carried one button per answer and the table lived in
              nothing, which is how the reference's list ended up as a single button here: adding the second
              answer meant adding markup, and the reference's remaining answers would have meant more of the same.
              The order and the availability of a line are the reference's (MediaItemsActionModel.cs:373-392);
              what the table leaves out, it says why.
            -->
            <ItemsControl Name="menuActionList" ItemsSource="{Binding TitleActions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MediaTitleAction">
                  <Button Classes="nereus-primary"
                          Content="{Binding Word}"
                          IsEnabled="{Binding IsCommand}"
                          Command="{Binding $parent[UserControl].DataContext.RunTitleActionCommand}"
                          CommandParameter="{Binding}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Name="menuAnswerLine"
                       FontSize="18"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Text="{Binding MenuAnswer}"
                       IsVisible="{Binding MenuAnswer, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding MenuWords}"
                       FontSize="18"
                       Margin="0,8,0,0"
                       Opacity="0.75"
                       TextWrapping="Wrap"
                       IsVisible="{Binding MenuWords, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <Button Name="menuBackButton"
                    Classes="nereus-primary"
                    Content="Back"
                    Command="{Binding CloseMenuCommand}"
                    Margin="0,10,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </Panel>
  </Panel>
</UserControl>
