<UserControl x:Class="MediaPortal.Frontend.Views.PeopleView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MediaPortal.Frontend.ViewModels"
             xmlns:views="using:MediaPortal.Frontend.Views"
             x:DataType="vm:PeopleViewModel">
  <!--
    A wall of people: the names one shelf was made by, worn like a media screen wears its shelf.

    This screen owns exactly two things - the square a face is drawn in and the row a name reads in - and nothing
    else.  Every other piece of furniture is the shelf's own and is worn from the shelf's own files: the ground and
    the two bands (ShelfChromeStyles.axaml, classes shelf-backdrop / shelf-band-top / shelf-band-bottom), the
    rail's styles and its plates (the same two files), the room's measures and the way it slides, the empty head
    that only costs its fifty-one points, the column of words at the right hand end with its wash and its
    negative margins, the line at the foot, and the ring a tile answers a caret with (Border.home-tile-edge, the
    shelf's own).  A viewer who learned on a shelf of records where a picture stands, where the rail comes out,
    how far the words reach and what a stood tile looks like finds all of it standing where they left it.

    What a wall has that a shelf has not is written down in the two templates below and nowhere else.
  -->
  <UserControl.Styles>
    <StyleInclude Source="avares://MediaPortal.Frontend/Views/ShelfChromeStyles.axaml"/>
  </UserControl.Styles>

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://MediaPortal.Frontend/Views/ShelfChrome.axaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!--
        One person as a tile, built surface for surface out of the shelf's own person card (PersonCardTile in
        ShelfChrome.axaml): the outer border carries the shadow, the clipped face carries the picture to the
        tile's own corner, the veil lies OVER the face and outside the clip so no hairline of picture shines
        through its last line, and the edge ring is drawn last of all so the face's clip cannot saw its outer
        half off.  Classes, not copies: every one of those four surfaces is dressed by the shelf's rules, which is
        what makes the ring light under a caret the way a cover of the home wall lights.

        Two numbers differ from the card's, both for the same reason - a wall is read from further off than a band
        of cards standing inside a title's reading, and a name has to be readable from the sofa: the tile's own
        measure, and the name's fifteen points grown to eighteen.  Nothing else is added and nothing is left out.

        No number of works on the tile, which the viewer decided when the wall was planned: a thousand names with
        a count each would be a screen of arithmetic.
      -->
      <DataTemplate x:Key="PersonWallTile" x:DataType="vm:PersonTile">
        <Border Classes="trackcard person-card home-tile-shadow"
                Focusable="True"
                Width="205"
                Height="195"
                Margin="8,8,8,14">
          <Panel>
            <Border Classes="person-face" ClipToBounds="True">
              <Panel>
                <!--
                  The face is the fanart filed under the person's own id, asked at the small width the tile can
                  paint - the same measure and the same fetch the shelf's cards use, so one answer serves both
                  screens.  A wall does not wait for its faces: the names are painted as they arrive and a face
                  goes onto the tile that is already standing.  Where the library holds nothing under that id -
                  not one face among this household's 7543 film actors - the skin's own person figure stands in
                  the middle of the face, at the menu glyph's quietness, as the shelf's cards do.
                -->
                <Image Classes="home-tile-art"
                       Source="{Binding Portrait,
                                        Converter={x:Static views:ArtworkConverter.Instance},
                                        ConverterParameter=small}"
                       Stretch="UniformToFill"
                       IsVisible="{Binding ShowsPortrait}"
                       IsHitTestVisible="False"/>
                <Path Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                                      ConverterParameter='MediaMenu/actor'}"
                      Fill="{DynamicResource TextBrush}"
                      Opacity="0.4"
                      Width="86"
                      Height="86"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsVisible="{Binding !ShowsPortrait}"
                      IsHitTestVisible="False"/>
              </Panel>
            </Border>
            <Border Classes="person-veil" IsHitTestVisible="False"/>
            <TextBlock Text="{Binding Name}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxLines="2"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Bottom"
                       Margin="8,0,8,8"
                       Foreground="{DynamicResource TextBrush}"
                       IsHitTestVisible="False"/>
            <!-- The ring, over the finished edge and drawn last: at rest the skin's ghost of a ring, under a caret
                 full light, by the shelf's own rule for these two classes. -->
            <Border Classes="home-tile-edge" IsHitTestVisible="False"/>
          </Panel>
        </Border>
      </DataTemplate>

      <!--
        One person as a row, cut on this skin's own row of titles (templates.xaml's TitleRowTemplate): the same
        two grids in the same Panel, the same measurements - a resting grid of Auto,5*,1.4* with twenty points
        between its columns, a seven hundred point floor and thirty points at each end, and a stood grid of Auto,1*
        standing eighty-nine points tall with fifteen points at the leading end - and the same two class names, so
        that it is the skin that decides when either grid shows, what sheet the stood row wears and how bold its
        words are.  Nothing here draws a sheet or picks a colour for a stood row: a wall that invented those would
        be a second look, and a wall of names is meant to read as the shelf reads.

        A resting row carries no picture, which is the shelf's law for its rows: the picture arrives with the sheet,
        the way a record's cover arrives when a track is stood on.  The frame is the frame a record's cover gets -
        the row's own eighty-nine points square, the picture cut to it rather than letterboxed beside it - because a
        person's face is filed as the same picture a record is, is asked at the same width, and stands square on the
        wall's tiles: a name that changed shape between the two shapes of the same wall would be one person drawn
        by two hands.  The skin's portrait frame (58 across, for the films' and series' posters) therefore stands
        nowhere on this screen, and the figure the skin draws for a name whose library holds no face stands in the
        same square, so that a name does not change its shape with the luck of the library.
      -->
      <DataTemplate x:Key="PersonWallRow" x:DataType="vm:PersonTile">
        <Panel>
          <Grid Classes="nereus-row-rest" ColumnDefinitions="Auto,5*,1.4*" ColumnSpacing="20" MinWidth="700"
                Margin="30,4">
            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="2" Text="{Binding BornWord}" HorizontalAlignment="Right" Opacity="0.65"
                       TextTrimming="CharacterEllipsis"/>
          </Grid>
          <Grid Classes="nereus-row-focus" ColumnDefinitions="Auto,1*" ColumnSpacing="20" MinWidth="700"
                MinHeight="89" Margin="15,4,30,4">
            <Border Classes="nereus-row-cover" Width="89" Height="89" CornerRadius="5" ClipToBounds="True"
                    Background="#222222">
              <Panel>
                <Image Source="{Binding Portrait,
                                       Converter={x:Static views:ArtworkConverter.Instance},
                                       ConverterParameter=small}"
                       Stretch="UniformToFill"
                       IsVisible="{Binding ShowsPortrait}"
                       IsHitTestVisible="False"/>
                <Path Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                                     ConverterParameter='MediaMenu/actor'}"
                      Fill="{DynamicResource TextBrush}"
                      Opacity="0.55"
                      Width="34"
                      Height="34"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsVisible="{Binding !ShowsPortrait}"
                      IsHitTestVisible="False"/>
              </Panel>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Classes="nereus-row-second" Text="{Binding BornWord}" Opacity="0.7"
                         TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding BornWord, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
          </Grid>
        </Panel>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <!-- THE GROUND, the shelf's own: this skin's background over the whole screen, the stood name's fanart lying over
      it with the skin's overlay as its OWN opacity, and the two bands the reference's media master hung over those
      - a hundred points at the head, two hundred and sixty at the foot.
      The wall, the rail and the column of words are laid over the bands untouched; the bands only paint, so they
      are asked for by wearing the classes and stand between the picture and everything the screen has to say. -->
  <Panel ClipToBounds="True">
    <Image Classes="shelf-backdrop"
           Source="{Binding Converter={x:Static views:SkinImageConverter.Instance}, ConverterParameter=Background.PNG}"/>
    <!-- The room's picture, in the shelf's own words: the fanart of whoever the caret stands on, dimmed to the
         skin's overlay and thrown out of focus by the skin's blur, and asked for only once the caret has stood
         still - see FanartBackdrop.cs for the law and its timings.  A name the library has no fanart for leaves
         the plain ground, which is exactly what a shelf of titles without fanart looks like. -->
    <views:DissolveImage Stretch="UniformToFill"
           Opacity="{Binding FanartOverlay}"
           IsVisible="{Binding HasBackgroundArtwork}">
      <views:DissolveImage.Source>
        <MultiBinding Converter="{x:Static views:SkinFanartConverter.Instance}">
          <Binding Path="BackgroundArtwork"/>
          <Binding Path="FanartBlurRadius"/>
        </MultiBinding>
      </views:DissolveImage.Source>
    </views:DissolveImage>
    <Panel IsHitTestVisible="False">
      <Border Classes="shelf-band-top"/>
      <Border Classes="shelf-band-bottom"/>
    </Panel>

    <!--
      THE ROOM, two hundred points of its left edge and two hundred of its bottom off the screen, which is where
      the rail stands while it is shut.  The transform is what travels, exactly as the shelf's does: a margin would
      have the layout ask what a moving room measures at every one of the frames, and a reference that drove the
      same points with a TranslateTransform is not a reference to argue with about which property is the cheap one.
      Nothing here clips - the rail's picture is made to spill past the panel it stands in, and the column of words
      is laid with negative margins so that its ground reaches past the head and past the window's bottom edge.
    -->
    <Grid Name="room"
          Margin="-200,0,0,-200"
          ColumnDefinitions="200,*"
          RowDefinitions="*,200"
          ClipToBounds="False">
      <Grid.RenderTransform>
        <TranslateTransform X="0" Y="0">
          <TranslateTransform.Transitions>
            <Transitions>
              <DoubleTransition Property="X" Duration="00:00:00.35"/>
              <DoubleTransition Property="Y" Duration="00:00:00.35"/>
            </Transitions>
          </TranslateTransform.Transitions>
        </TranslateTransform>
      </Grid.RenderTransform>

      <!--
        THE RAIL, standing in the two hundred points that are off the room's left edge, from under the head band
        down past the bottom of the window so that the glow along its right edge has ground to stand on.  Its
        plates, its glass and its behaviour are the shelf's - the styles are included above, its rows are the
        shelf's own MediaMenuTile and the walking is ShelfRail - so nothing about this panel is new but its rows.
      -->
      <Panel Name="sideMenu"
             Grid.RowSpan="2"
             Grid.Column="0"
             Margin="0,90,0,0"
             IsVisible="False"
             ClipToBounds="False">
        <DockPanel Margin="10,0,0,0">
          <ListBox Name="mediaMenuList"
                   Classes="media-menu"
                   ItemsSource="{Binding MediaMenu}"
                   ItemTemplate="{StaticResource MediaMenuTile}"
                   Margin="0,14,0,200"
                   Focusable="True"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Hidden">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical"/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>
        </DockPanel>
      </Panel>

      <!--
        THE WALL AND ITS WORDS, in the shelf's own room: ten points of panel, then the wall's column and the
        column of words.  The two columns are divided by the same measure the shelf divides them by
        (ShelfDetailsColumn, which the shelf asks too), so a wall and a shelf of the same library at the same
        window width stand their tiles and their words at the same x.  While the words are away the wall has the
        room to itself, which is what the shelf does when a viewer turns them off.
      -->
      <Panel Grid.Row="0"
             Grid.Column="1"
             Margin="10,0,10,10">
        <Grid Name="contentGrid" ColumnDefinitions="*,0" ColumnSpacing="0" ClipToBounds="False">

          <DockPanel Grid.Column="0" ClipToBounds="False">
            <!--
              The head, which is empty on purpose and stands for its fifty-one points of offset alone: the
              reference's shelf head carries the heading and nothing else, never "1130 of 1136, sorted by year",
              and never writes a sentence over the wall.  What a wall has to say for itself is said at its foot.
            -->
            <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,51,0,6"/>

            <!--
              THE WALL.  A list like the shelf's, because everything a wall has to be - walked by a caret,
              virtualized by a thousand names, laid in the same tile panel the shelf's grid lays its posters in,
              dressed by the plate template the shelf's grouping uses - is what that control already is.  Its item
              template and its panel are put on by the code behind, which is the only place that knows which of the
              two shapes the wall wears.
            -->
            <ListBox Name="peopleList"
                     Classes="nereus-shelf-tiles"
                     Focusable="True"
                     ItemsSource="{Binding Rows}"
                     SelectedItem="{Binding Selected, Mode=TwoWay}"
                     ItemTemplate="{StaticResource PersonWallTile}"
                     FontSize="24"
                     Margin="0,0,0,53"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ClipToBounds="False"/>
          </DockPanel>

          <!--
            THE COLUMN OF WORDS about the name the caret stands on: the shelf's details column, its measures and
            all - Grid.Column 1, forty-five points of air before it and ten past the window's edge, ninety-six
            above the head and two hundred and seventy past the bottom, because a column that stopped level with
            the wall would float over the picture it belongs to.  The wash is the shelf's wash: sixty hundredths of
            black from the right corner, standing until six tenths of the line and thinning to nothing at the left
            edge, so the words sit on an even ground and the wall behind the column is still a wall.
          -->
          <Border Name="detailsPanel"
                  Grid.Column="1"
                  Margin="45,-96,-10,-270"
                  ClipToBounds="False"
                  IsVisible="{Binding ShowsDetailsWords}">
            <Border.Background>
              <!--  A bare number in StartPoint/EndPoint is device-independent pixels to Avalonia, not the fraction
                    WPF reads, so a wash written without the '%' suffix is a line one point long: only '%' means
                    "of the panel". -->
              <LinearGradientBrush StartPoint="100%,45%" EndPoint="3%,50%">
                <GradientStop Color="#99000000" Offset="0"/>
                <GradientStop Color="#99000000" Offset="0.6"/>
                <GradientStop Color="#00000000" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <!--
              The words, in the shelf's own box: a hundred and forty lines below the top of the ground, which is
              where the head band ends and a column's words begin, two hundred above its lower edge, and clipped
              so that neither a word nor a picture gets past it by some route the measuring did not think of.
              The head is said once and the life is given everything the head leaves - the reference's own
              arrangement, whose description row was Height="*".
            -->
            <Grid Name="detailsWords"
                  Margin="0,140,50,200"
                  VerticalAlignment="Top"
                  RowDefinitions="Auto,*"
                  ClipToBounds="True">
              <!--
                The head, as the reference laid its MediaItemListPersonDetails.inc: its picture row, then the name,
                then the years, then the place.  The face wears the same two surfaces as a tile - the plate, the
                clipped face - because a person is drawn one way on this screen.
              -->
              <StackPanel Grid.Row="0" Spacing="8">
                <Border Name="detailsFace"
                        Classes="person-card"
                        Width="220"
                        Height="220"
                        HorizontalAlignment="Left"
                        ClipToBounds="False">
                  <Border Classes="person-face" ClipToBounds="True">
                    <Panel>
                      <Image Classes="home-tile-art"
                             Source="{Binding DetailsPortrait,
                                              Converter={x:Static views:ArtworkConverter.Instance},
                                              ConverterParameter=small}"
                             Stretch="UniformToFill"
                             IsVisible="{Binding ShowsPortrait}"
                             IsHitTestVisible="False"/>
                      <Path Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                                            ConverterParameter='MediaMenu/actor'}"
                            Fill="{DynamicResource TextBrush}"
                            Opacity="0.4"
                            Width="92"
                            Height="92"
                            Stretch="Uniform"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding !ShowsPortrait}"
                            IsHitTestVisible="False"/>
                    </Panel>
                  </Border>
                </Border>
                <TextBlock Text="{Binding DetailsName}"
                           FontSize="31"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           MaxLines="2"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="{Binding DetailsYears}"
                           FontSize="19"
                           Opacity="0.6"
                           IsVisible="{Binding ShowsYears}"
                           Foreground="{DynamicResource TextBrush}"/>
                <!--
                  The place, which no offline library ever answers: 369 artists and 7757 actors were never asked
                  where they come from.  It therefore stands in the markup and stays away on screen - the reference
                  hid the same row the same way, by the text's own existence rather than by a guess.
                -->
                <TextBlock Text="{Binding DetailsOrigin}"
                           FontSize="19"
                           Opacity="0.6"
                           TextWrapping="Wrap"
                           IsVisible="{Binding ShowsOrigin}"
                           Foreground="{DynamicResource TextBrush}"/>
              </StackPanel>

              <!--
                The life, in the row that is given everything the head leaves.  It is read rather than cut, because
                the longest biography this household holds runs eight thousand six hundred and thirty five
                characters and a band that trimmed that to two lines would be showing the first words of a life and
                calling it the life.  The keys stay with the wall, which is walked a name at a time, so this field
                is moved by the wheel and by its own slider.
              -->
              <ScrollViewer Name="biographyScroller"
                            Grid.Row="1"
                            Margin="0,26,0,0"
                            IsVisible="{Binding ShowsBiography}"
                            VerticalScrollBarVisibility="Hidden"
                            HorizontalScrollBarVisibility="Disabled">
                <TextBlock Text="{Binding DetailsBiography}"
                           FontSize="19"
                           LineHeight="27"
                           TextWrapping="Wrap"
                           Opacity="0.85"
                           Foreground="{DynamicResource TextBrush}"/>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </Panel>

      <!--
        THE LINE AT THE FOOT, in the place the shelf reserves for it: two hundred and forty from the room's left
        hand, thirty-four above its bottom, where a whole line lies free and nothing stands to be covered.  The two
        lines and the law between them are the shelf's own, word for word: while the rail is out it names the plate
        the caret stands on and what that plate adds, and it goes when the rail goes, because it is the rail's word
        and not the wall's.  With the details column turned away the one line about the stood-on name stands here -
        the name, the years, what the library says this person is - because the viewer turned the column off, not the
        knowledge, and a wall of tiles whose column is away would otherwise answer nothing about the name the caret
        is on.  What is said nowhere at all is the wall's own name and its number of names: no shelf of titles
        stands under a caption, so neither does this.
      -->
      <TextBlock Grid.Row="0"
                 Grid.ColumnSpan="2"
                 Text="{Binding MediaMenuFootLine}"
                 FontSize="22"
                 Foreground="{DynamicResource TextBrush}"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Margin="240,0,0,34"
                 IsHitTestVisible="False"
                 TextTrimming="CharacterEllipsis"
                 IsVisible="{Binding MediaMenuVisible}"/>
      <TextBlock Grid.Row="0"
                 Grid.ColumnSpan="2"
                 Text="{Binding ContentInfo}"
                 FontSize="22"
                 Foreground="{DynamicResource TextBrush}"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Margin="240,0,0,34"
                 MaxWidth="1200"
                 IsHitTestVisible="False"
                 TextTrimming="CharacterEllipsis"
                 IsVisible="{Binding ShowsContentInfo}"/>
    </Grid>

    <!--
      THE SEARCH, standing in the head band exactly where a shelf of titles stands its own (MediaBrowserView.axaml,
      searchStrip) - one plaque in the corner the details plaques wear, the magnifier at its left hand, the typed
      words in the middle, the mark that takes the search away at its right, and the one keyboard button beside it.
      Nothing else on this screen answers the question "which name?", and the rail has always had a row called
      "Search" that was meant to bring this field up.

      It is off the screen until somebody asks for it, and three doors ask: the rail's row, the Find key, and the
      arrow lifted off the head of the wall while the field already stands there.  While no field waits above the
      wall, the arrow at the wall's head keeps its nod (viewer note 2026-11-10, quoted by the shelf).  The code
      behind pushes this row clear of the pointer's own marks at the window's corner, which are the window's
      furniture and cannot give way to a screen's field.
    -->
    <StackPanel Name="searchStrip"
                Orientation="Horizontal"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="10,9,18,0"
                ClipToBounds="False">
      <Border Name="searchField"
              Classes="search-field"
              IsVisible="{Binding ShowsSearch}"
              VerticalAlignment="Top">
        <DockPanel>
          <Path DockPanel.Dock="Left"
                Classes="search-mark"
                Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                              ConverterParameter='MediaMenu/search'}"
                Fill="{DynamicResource TextBrush}"
                Width="24"
                Height="24"
                Margin="0,0,12,0"
                Stretch="Uniform"
                VerticalAlignment="Center"/>
          <Button Name="clearSearchMark"
                  DockPanel.Dock="Right"
                  Classes="nereus-corner-button nereus-corner-small"
                  Width="38"
                  Height="38"
                  CornerRadius="19"
                  VerticalAlignment="Center"
                  Command="{Binding CloseSearchCommand}"
                  Focusable="False"
                  ToolTip.Tip="Take the search away"
                  IsVisible="{Binding ShowsSearch}">
            <Path Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                                  ConverterParameter='PowerMenu/close'}"
                  Fill="{DynamicResource TextBrush}"
                  Width="18"
                  Height="18"
                  Stretch="Uniform"/>
          </Button>
          <TextBox Name="searchBox"
                   Classes="search-box"
                   views:VirtualKeyboardService.Trigger="Menu"
                   Text="{Binding SearchText, Mode=TwoWay}"
                   PlaceholderText="Find a name"
                   Width="340"
                   VerticalContentAlignment="Center"/>
        </DockPanel>
      </Border>
      <!-- The one keyboard button to the on-screen keys that a hand without a keyboard can find, exactly as the
           shelf wears it: focusable (unlike the mark that takes the search away, which is a way out and not a
           place a caret can stand on), and it walks the caret onto itself from the end of the field's words. -->
      <Button Name="keyboardToggle"
              Classes="search-keyboard"
              IsVisible="{Binding ShowsSearch}"
              Click="OnKeyboardToggleClicked"
              ToolTip.Tip="Type with the keys on the screen">
        <Panel>
          <Path Name="keyboardMark"
                Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                              ConverterParameter='MediaMenu/keyboard'}"
                Fill="{DynamicResource TextBrush}"
                Width="26"
                Height="26"
                Stretch="Uniform"/>
          <Path Name="keyboardOffMark"
                Data="{Binding Converter={x:Static views:SkinIconGeometryConverter.Instance},
                              ConverterParameter='MediaMenu/keyboard_off'}"
                Fill="{DynamicResource TextBrush}"
                Width="26"
                Height="26"
                Stretch="Uniform"
                IsVisible="False"/>
        </Panel>
      </Button>
    </StackPanel>
  </Panel>
</UserControl>
