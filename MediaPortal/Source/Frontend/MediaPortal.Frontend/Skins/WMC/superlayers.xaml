<?xml version="1.0" encoding="utf-8"?>
<!--
  WMC superlayers: the overlays that briefly cover the screen to say one thing - the volume reading while
  the volume keys are held, and the busy spinner while something loads. WMC drew its volume as a small
  centred slab rather than Nereus' big lower-third line; the two skins disagree on purpose.

  Both templates are ContentControl templates: whatever the window puts in Content is the sentence, and
  nothing here binds against the chrome - TemplateBinding only.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The volume: a small slab in the middle, the way WMC interrupted the picture. -->
  <ControlTemplate x:Key="Superlayer_Volume" TargetType="ContentControl">
    <Border Background="{DynamicResource ScrimBrush}" IsHitTestVisible="False">
      <Border Background="{DynamicResource PanelBrush}" CornerRadius="{DynamicResource DialogBorderCornerRadius}"
              HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30,15">
        <TextBlock Text="{TemplateBinding Content}"
                   Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource NormalFontSize}"/>
      </Border>
    </Border>
  </ControlTemplate>

  <!--
    The skip step: the reference's SkipStepOSD measured from its file - a 350x100 slab held in the
    centre with a five-point air gap, the WMC blue the reference paints right into the brush (the blue
    diagonal and the see-through white frame are the reference's own numbers, not palette colours, and
    they stay that way because that is what the reference shows), four points of corner, and the step
    named in the normal font, centred.
  -->
  <ControlTemplate x:Key="Superlayer_SkipStep" TargetType="ContentControl">
    <Border Background="Transparent" IsHitTestVisible="False">
      <Border Width="350" Height="100" Margin="5" CornerRadius="4" BorderThickness="3"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.BorderBrush>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0.02,1.4">
            <GradientStop Color="#8CFFFFFF" Offset="0"/>
            <GradientStop Color="#8CFFFFFF" Offset="0.7"/>
            <GradientStop Color="#8CFFFFFF" Offset="1"/>
          </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Background>
          <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
            <GradientStop Color="#F2447da7" Offset="0"/>
            <GradientStop Color="#F2124273" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <TextBlock Text="{TemplateBinding Content}" Margin="5"
                   Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource NormalFontSize}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
    </Border>
  </ControlTemplate>

  <!-- Busy: the screen dims, the words are centred, and the accent line underneath is still moving. -->
  <ControlTemplate x:Key="Superlayer_Busy" TargetType="ContentControl">
    <Border Background="{DynamicResource ScrimBrush}" IsHitTestVisible="False">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
        <TextBlock Text="{TemplateBinding Content}"
                   Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource NormalFontSize}"
                   HorizontalAlignment="Center"/>
        <ProgressBar IsIndeterminate="True" Width="400" Height="3"
                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource OutlineBrush}"/>
      </StackPanel>
    </Border>
  </ControlTemplate>
</ResourceDictionary>
